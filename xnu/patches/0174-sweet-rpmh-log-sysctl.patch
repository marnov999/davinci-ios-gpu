+/*
+ * Every line below, also kept here (the newest 8 KB): the kernel's message buffer holds only seconds of
+ * a boot, so the reason a vote was refused is gone before USB comes up. sysctl kern.sweet_rpmhlog.
+ */
+static char rh_log_buf[8192];
+static unsigned rh_log_len;
+
+static int
+rh_log_sysctl SYSCTL_HANDLER_ARGS
+{
+#pragma unused(oidp, arg1, arg2)
+	return SYSCTL_OUT(req, rh_log_buf, rh_log_len);
+}
+SYSCTL_PROC(_kern, OID_AUTO, sweet_rpmhlog, CTLTYPE_OPAQUE | CTLFLAG_RD | CTLFLAG_LOCKED, 0, 0,
+    rh_log_sysctl, "A", "the RPMh vote helper's messages");
+
+static void rh_log(const char *format, ...) __printflike(1, 2);
+
+static void
+rh_log(const char *format, ...)
+{
+	char line[200];
+	va_list list;
+
+	va_start(list, format);
+	vsnprintf(line, sizeof(line), format, list);
+	va_end(list);
+	printf("SWEET RPMH: %s", line);
+	size_t n = strlen(line);
+	if (rh_log_len + n > sizeof(rh_log_buf)) {
+		unsigned drop = sizeof(rh_log_buf) / 2;
+		memmove(rh_log_buf, rh_log_buf + drop, rh_log_len - drop);
+		rh_log_len -= drop;
+	}
+	memcpy(rh_log_buf + rh_log_len, line, n);
+	rh_log_len += (unsigned)n;
+}
