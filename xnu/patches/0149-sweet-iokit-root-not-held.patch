diff --git a/iokit/Kernel/IOService.cpp b/iokit/Kernel/IOService.cpp
index 59c834e..140651a 100644
--- a/iokit/Kernel/IOService.cpp
+++ b/iokit/Kernel/IOService.cpp
@@ -1191,6 +1191,8 @@ IOService::startDeferredMatches(void)
 #endif /* !NO_KEXTD */
 }
 
+bool gIOServiceRootHeldForDaemon = true;     /* IOStartIOKit's busy count on the root, for the IOKit daemon */
+
 void
 IOService::iokitDaemonLaunched(void)
 {
@@ -1200,7 +1202,9 @@ IOService::iokitDaemonLaunched(void)
 	}
 	IOServiceTrace(IOSERVICE_KEXTD_READY, 0, 0, 0, 0);
 	startDeferredMatches();
-	getServiceRoot()->adjustBusy(-1);
+	if (gIOServiceRootHeldForDaemon) {      /* (SWEET: IOStartIOKit may not have held it) */
+		getServiceRoot()->adjustBusy(-1);
+	}
 	IOService::publishUserResource(gIOResourceIOKitKey);
 #endif /* !NO_KEXTD */
 }
diff --git a/iokit/Kernel/IOStartIOKit.cpp b/iokit/Kernel/IOStartIOKit.cpp
index d74c063..3c38302 100644
--- a/iokit/Kernel/IOStartIOKit.cpp
+++ b/iokit/Kernel/IOStartIOKit.cpp
@@ -46,6 +46,8 @@
 #include <IOKit/IOKitKeysPrivate.h>
 #include <IOKit/IOInterruptAccountingPrivate.h>
 #include <IOKit/assert.h>
+
+extern bool gIOServiceRootHeldForDaemon;    /* IOService.cpp */
 #include <sys/conf.h>
 
 #include "IOKitKernelInternal.h"
@@ -194,6 +196,16 @@ StartIOKitMatching(void)
 		 * messages the kernel after the in-kernel linker has been
 		 * removed and personalities have been sent.
 		 */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+		/* SWEET: driverkitd is killed at boot here (jetsam, its per-process memory limit) and never
+		 * checks in, so the root stayed busy for good: IOKitWaitQuiet never returned and every
+		 * SCNetworkInterface lookup (Settings > General > About, the Ethernet row) sat out its
+		 * timeout -- minutes for the About page. The root is not held unless boot-arg sweetiokitd=1. */
+		int hold = 0;
+		(void)PE_parse_boot_argn("sweetiokitd", &hold, sizeof(hold));
+		gIOServiceRootHeldForDaemon = hold != 0;
+		if (hold)
+#endif
 		IOService::getServiceRoot()->adjustBusy(1);
 	}
 #endif
