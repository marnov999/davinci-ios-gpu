+/*
+ * Back from a powered-off panel, dsi_panel_power_on and dsi_panel_enable's order: the supply (L18A)
+ * on, the reset sequence (qcom,mdss-dsi-reset-sequence <0 1 1 10>: low 1 ms, high 10 ms), the on
+ * commands with their waits (sleep out, the panel's set-up, display on), then the display engine's
+ * refresh as it was (panel_dcs_cmd 0x29 with refresh back).
+ */
+static int
+panel_power_up(void)
+{
+	int bad = 0, sent = 0;
+	printf("SWEET PANEL: vdda (L18A) vote on -> %d\n", sweet_rpmh_vreg_vote("ldoa18", 3000, true));
+	gmub_udelay(10000);
+	panel_reset_line(false);
+	gmub_udelay(1000);
+	panel_reset_line(true);
+	gmub_udelay(10000);
+	for (unsigned j = 0; j + 7 <= sizeof(panel_on_commands);) {
+		const uint8_t *c = &panel_on_commands[j];
+		unsigned n = ((unsigned)c[5] << 8) | c[6];
+		if (j + 7 + n > sizeof(panel_on_commands)) {
+			break;
+		}
+		if (panel_dsi_packet(c[0], c + 7, n, true) != 0) {
+			bad++;
+		}
+		sent++;
+		if (c[4]) {
+			gmub_udelay((uint32_t)c[4] * 1000u);
+		}
+		j += 7 + n;
+	}
+	int on = panel_dcs_cmd(0x29, false);         /* display on again, and the refresh back */
+	printf("SWEET PANEL: on-commands %d sent, %d failed; display on %d\n", sent, bad, on);
+	return bad ? -bad : on;
+}
