diff --git a/bsd/dev/sweet_prof.c b/bsd/dev/sweet_prof.c
new file mode 100644
index 0000000..16c2d8d
--- /dev/null
+++ b/bsd/dev/sweet_prof.c
@@ -0,0 +1,177 @@
+/*
+ * SWEET profiler: where does a process spend its processor time? (The window server draws 20-30
+ * frames a second on a phone that does 60 under Android; the profile says why.)
+ *
+ *   sysctl kern.sweetprof=S   sample the process named in boot-arg sweetprof_name (default
+ *                             backboardd) for S seconds (1..30)
+ *
+ * The samples are taken in osfmk/arm64/sleh.c: every interrupt that comes while a thread of that
+ * process runs in user mode notes its pc, lr and thread. When the time is up this prints:
+ *   PRF begin <name>[<pid>] <n> samples in <ms> ms
+ *   SMP ...                  the shared cache's slide and every thread (sweet_sample_task)
+ *   PRF img <load> <path>    every image outside the shared cache (dyld's list in the task)
+ *   PRF s <pc> <lr> <tid> <cpu>
+ *   PRF end
+ * for tools/sweet-prof.py to put names to (the shared cache with its slide; our dylibs by load
+ * address).
+ */
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/proc.h>
+#include <sys/proc_internal.h>
+#include <sys/sysctl.h>
+#include <kern/task.h>
+#include <kern/thread.h>
+#include <kern/clock.h>
+#include <mach/task_info.h>
+#include <vm/vm_map.h>
+#include <pexpert/pexpert.h>
+#include <os/atomic_private.h>
+
+struct sweet_prof_sample {
+	uint64_t pc, lr;
+	uint32_t tid, cpu;
+};
+#define SWEET_PROF_MAX 16384
+extern task_t                    sweet_prof_target;
+extern volatile uint32_t         sweet_prof_n;
+extern struct sweet_prof_sample  sweet_prof_buf[SWEET_PROF_MAX];
+extern void sweet_sample_task(const char *name, int pid, task_t task);   /* osfmk/kern/exception.c */
+extern task_t proc_task(proc_t);
+extern vm_map_t get_task_map(task_t);
+extern int hz;
+
+static int sweet_prof_seconds;          /* asked for, 0: nothing to do */
+static int sweet_prof_busy;
+static char sweet_prof_name[32] = "backboardd";
+
+struct sweet_prof_find {
+	task_t task;
+	int pid;
+};
+
+static int
+sweet_prof_proc(proc_t p, void *arg)
+{
+	struct sweet_prof_find *f = arg;
+	char name[32];
+	proc_name(proc_pid(p), name, sizeof(name));
+	if (f->task == TASK_NULL && strcmp(name, sweet_prof_name) == 0) {
+		f->task = proc_task(p);
+		f->pid = proc_pid(p);
+		if (f->task != TASK_NULL) {
+			task_reference(f->task);
+		}
+	}
+	return PROC_RETURNED;
+}
+
+/* dyld's list of the task's images: those outside the shared cache, with their load addresses. */
+static void
+sweet_prof_images(task_t task)
+{
+	struct task_dyld_info info;
+	mach_msg_type_number_t count = TASK_DYLD_INFO_COUNT;
+	vm_map_t map = get_task_map(task);
+	struct {
+		uint32_t version, count;
+		uint64_t array;
+	} all;
+	if (task_info(task, TASK_DYLD_INFO, (task_info_t)&info, &count) != KERN_SUCCESS || info.all_image_info_addr == 0 ||
+	    vm_map_read_user(map, (vm_map_address_t)info.all_image_info_addr, &all, sizeof(all)) != KERN_SUCCESS) {
+		printf("PRF img none (no dyld image list)\n");
+		return;
+	}
+	for (uint32_t i = 0; i < all.count && i < 2048u; i++) {
+		struct {
+			uint64_t load, path, date;
+		} img;
+		char path[200];
+		if (vm_map_read_user(map, (vm_map_address_t)(all.array + 24ull * i), &img, sizeof(img)) != KERN_SUCCESS) {
+			break;
+		}
+		bzero(path, sizeof(path));
+		if (img.path == 0 || vm_map_read_user(map, (vm_map_address_t)img.path, path, sizeof(path) - 1) != KERN_SUCCESS) {
+			/* (a path may end close to the end of its page: shorter tries) */
+			if (img.path == 0 || vm_map_read_user(map, (vm_map_address_t)img.path, path, 64) != KERN_SUCCESS) {
+				continue;
+			}
+		}
+		path[sizeof(path) - 1] = 0;
+		if (strncmp(path, "/System/", 8) == 0 || strncmp(path, "/usr/lib/", 9) == 0) {
+			continue;               /* in the shared cache: named by its address and the slide */
+		}
+		printf("PRF img 0x%llx %s\n", img.load, path);
+	}
+}
+
+static void
+sweet_prof_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	static int chan;
+	(void)PE_parse_boot_argn("sweetprof_name", sweet_prof_name, sizeof(sweet_prof_name));
+	for (;;) {
+		struct sweet_prof_find f = { TASK_NULL, 0 };
+		uint64_t start, ns;
+		uint32_t n;
+		int secs;
+		while (sweet_prof_seconds == 0) {
+			(void)tsleep(&chan, PZERO, "sweetprf", hz / 4);
+		}
+		secs = sweet_prof_seconds;
+		proc_iterate(PROC_ALLPROCLIST, sweet_prof_proc, &f, NULL, NULL);
+		if (f.task == TASK_NULL) {
+			printf("PRF no process named %s\n", sweet_prof_name);
+			sweet_prof_seconds = 0;
+			continue;
+		}
+		sweet_prof_n = 0;
+		start = mach_absolute_time();
+		os_atomic_store(&sweet_prof_target, f.task, release);
+		(void)tsleep(&chan, PZERO, "sweetprf", secs * hz);
+		os_atomic_store(&sweet_prof_target, TASK_NULL, release);
+		absolutetime_to_nanoseconds(mach_absolute_time() - start, &ns);
+		n = sweet_prof_n < SWEET_PROF_MAX ? sweet_prof_n : SWEET_PROF_MAX;
+		delay(2000);                    /* (an interrupt that saw the target may still be writing) */
+		printf("PRF begin %s[%d] %u samples in %llu ms\n", sweet_prof_name, f.pid, n, ns / 1000000ull);
+		sweet_sample_task(sweet_prof_name, f.pid, f.task);
+		sweet_prof_images(f.task);
+		for (uint32_t i = 0; i < n; i++) {
+			printf("PRF s %llx %llx %u %u\n", sweet_prof_buf[i].pc, sweet_prof_buf[i].lr, sweet_prof_buf[i].tid,
+			    sweet_prof_buf[i].cpu);
+			if ((i & 255u) == 255u) {
+				(void)tsleep(&chan, PZERO, "sweetprf", hz / 20);   /* (the USB log streams 100 ms at a time) */
+			}
+		}
+		printf("PRF end\n");
+		task_deallocate(f.task);
+		sweet_prof_seconds = 0;
+	}
+}
+
+static int
+sweet_prof_sysctl SYSCTL_HANDLER_ARGS
+{
+	int v = 0, error = sysctl_handle_int(oidp, &v, 0, req);
+	if (error || req->newptr == USER_ADDR_NULL) {
+		return error;
+	}
+	if (v < 1 || v > 30) {
+		return EINVAL;
+	}
+	if (!sweet_prof_busy) {
+		thread_t t;
+		sweet_prof_busy = 1;
+		if (kernel_thread_start(sweet_prof_thread, NULL, &t) == KERN_SUCCESS) {
+			thread_deallocate(t);
+		}
+	}
+	if (sweet_prof_seconds != 0) {
+		return EBUSY;
+	}
+	sweet_prof_seconds = v;
+	return 0;
+}
+
+SYSCTL_PROC(_kern, OID_AUTO, sweetprof, CTLTYPE_INT | CTLFLAG_RW | CTLFLAG_ANYBODY | CTLFLAG_LOCKED, NULL, 0,
+    sweet_prof_sysctl, "I", "profile boot-arg sweetprof_name (backboardd) for this many seconds");
diff --git a/osfmk/arm64/sleh.c b/osfmk/arm64/sleh.c
index 24f1abc..995c05a 100644
--- a/osfmk/arm64/sleh.c
+++ b/osfmk/arm64/sleh.c
@@ -1847,6 +1847,39 @@ handle_simd_trap(arm_saved_state_t *state, uint32_t esr)
 	__builtin_unreachable();
 }
 
+#if defined(SWEET)
+/*
+ * The SWEET profiler (bsd/dev/sweet_prof.c): while a task is named here, every interrupt that comes
+ * while one of its threads runs in user mode notes where it was (pc, lr, which thread) -- where
+ * that task spends its processor time, as kperf's timer sampling would say. Nothing is noted
+ * otherwise.
+ */
+struct sweet_prof_sample {
+	uint64_t pc, lr;
+	uint32_t tid, cpu;
+};
+#define SWEET_PROF_MAX 16384
+task_t                    sweet_prof_target;
+volatile uint32_t         sweet_prof_n;
+struct sweet_prof_sample  sweet_prof_buf[SWEET_PROF_MAX];
+
+static inline void
+sweet_prof_irq(arm_saved_state_t *state)
+{
+	uint32_t i;
+	if (!PSR64_IS_USER(get_saved_state_cpsr(state)) || current_task() != sweet_prof_target) {
+		return;
+	}
+	i = os_atomic_inc_orig(&sweet_prof_n, relaxed);
+	if (i < SWEET_PROF_MAX) {
+		sweet_prof_buf[i].pc = get_saved_state_pc(state);
+		sweet_prof_buf[i].lr = get_saved_state_lr(state);
+		sweet_prof_buf[i].tid = (uint32_t)thread_tid(current_thread());
+		sweet_prof_buf[i].cpu = (uint32_t)cpu_number();
+	}
+}
+#endif
+
 void
 sleh_irq(arm_saved_state_t *state)
 {
@@ -1864,6 +1897,10 @@ sleh_irq(arm_saved_state_t *state)
 	uint64_t iar = __builtin_arm_rsr64("ICC_IAR1_EL1");
 	uint32_t intid = (uint32_t)(iar & 0xFFFFFF);
 
+	if (__improbable(sweet_prof_target != TASK_NULL)) {
+		sweet_prof_irq(state);
+	}
+
 	if (intid >= 1020 && intid <= 1023) {
 		return; /* spurious */
 	}
