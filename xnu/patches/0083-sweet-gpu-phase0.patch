+		uint32_t info = gmub_rd(GMUB_GMU2HOST_INTR_INFO);
+		uint32_t s = gmub_rd(GMUB_SPTPRAC_PWR_CLK_STS);
+		printf("SWEET GMU: [F3] GPU_SET: intr_info=%#x ack(b24)=%d polls=%u; "
