+#define GMUB_CHIPID               0x06018000u  /* (0x06010800: minor<<12|patch<<8) */
+/* AHB_FENCE_RANGE_0 = BIT(31)|(upper<<18)|lower, legacy upper=0xA lower=0xA0
+ * => 0x802800A0 (mainline a6xx_gmu_fw_start). Prior 0x80A008A0 was transposed. */
+#define GMUB_FENCE_RANGE_MASK     0x802800A0u
+/* PWR_COL_INTER_FRAME_CTRL: plain value on idle_level=ACTIVE (no IFPC/SPTP
+ * collapse bits). Was wrongly OR'd with 0x5 which enabled power-collapse. */
+#define GMUB_PWR_COL_INTER_FRAME_VAL 0x09C40400u
+/* GMU reg dwords added for the fw_start/power_config prerequisites. */
+#define GMUB_SYS_BUS_CONFIG       0x1F40Fu
+#define GMUB_CM3_CFG              0x1F82Du   /* =0x4052: route CM3 faults, no NMI jump */
+#define GMUB_AO_AHB_FENCE_CTRL    0x23B10u   /* must be 0 (allow) or CPU writes drop */
+#define GMUB_NMI_CONTROL_STATUS   0x1CBF0u
+#define GMUB_AO_HOST_INTR_STATUS  0x23B05u
+#define GMUB_AHB_FENCE_STATUS     0x23B13u
+#define GMUB_CX_GMU_RPMH_PWR_STATE 0x1F8ECu
+#define GMUB_FW_INIT_SUCCESS      0xBABEFACEu
+#define GMUB_LOAD_MODE_TCM        0x2u          /* MARK: TCM_BOOT enum value */
+#define GMUB_SPTP_ENABLE_MASK     0x5u          /* BIT(2)|BIT(0) (unused now) */
