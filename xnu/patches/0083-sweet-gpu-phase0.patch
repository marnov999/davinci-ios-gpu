+	 * always-on counter runs off the CX always-on domain and must advance
+	 * between two reads; (G2) lift the RBBM soft reset (the classic "clock +
+	 * lift reset", which the GMU is nominally supposed to have done); (G3)
+	 * re-test. The write-read is on CP_SQE_INSTR_BASE_LO (CP block) - if the
+	 * counter ticks and RBBM_STATUS reads sane but this write never latches,
+	 * the core is up and only the CP is secure-gated => the zap is the unlock.
+	 * Each sub-stage flushes the USB log so a hang can't swallow the reading
+	 * that came before it. ---- */
+	{
+		vm_offset_t core = ml_io_map(A6XX_GPU_CORE_PA_, A6XX_GPU_CORE_SIZE_);
+		if (!core) {
+			printf("SWEET GMU: [G] GPU core map failed\n");
+			gmub_flush();
+			return 0;
+		}
