+		CW(0xB604u, 0x2u);                 /* TPL1_NC_MODE_CNTL */
+		CW(0xAE02u, 0x2u);                 /* SP_NC_MODE_CNTL (SP block clocked?) */
+		CW(0xE01u, 0x00200000u);           /* UCHE_MODE_CNTL */
+		CW(0x01Fu, 0x40CFFFFFu);           /* RBBM_INTERFACE_HANG_INT_CNTL */
+		CW(0xE19u, 0x1u);                  /* UCHE_CLIENT_PF */
+		__asm__ volatile("dsb osh" ::: "memory");
+		printf("SWEET GMU: [Ic] NC_MODE+UCHE_MODE+hang written\n"); gmub_flush();
