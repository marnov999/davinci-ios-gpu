+++ b/iokit/Kernel/arm/SweetSurface.cpp
@@ -77,6 +77,50 @@ static uint64_t      sweet_surface_wired;       /* bytes of buffer surfaces */
 
 OSDefineMetaClassAndStructors(SweetSurface, OSObject);
 
+/*
+ * The display pool (boot-arg sweetfb_scanout=1): CoreAnimation's full-screen surfaces have to be one
+ * physical piece for the display engine to fetch them (SweetFramebuffer scanOut), and 11 MB in one
+ * piece is not to be had once the system has run a while -- so three are made at the start, while
+ * memory is whole, and a full-screen surface takes a free one (it goes back when the surface goes).
+ */
+#define SWEET_DISPLAY_POOL      3
+#define SWEET_DISPLAY_W         1125u
+#define SWEET_DISPLAY_H         2436u
+#define SWEET_DISPLAY_BPR       4608u
+static IOBufferMemoryDescriptor *sweet_display_pool[SWEET_DISPLAY_POOL];
+bool sweet_display_busy[SWEET_DISPLAY_POOL];
+
+void
+sweet_surface_display_pool_init(void)
+{
+	vm_size_t size = round_page((vm_size_t)SWEET_DISPLAY_BPR * SWEET_DISPLAY_H);
+	for (unsigned i = 0; i < SWEET_DISPLAY_POOL; i++) {
+		IOByteCount seg = 0;
+		if (sweet_display_pool[i] != NULL) {
+			continue;
+		}
+		sweet_display_pool[i] = IOBufferMemoryDescriptor::inTaskWithPhysicalMask(kernel_task,
+		    kIODirectionInOut | kIOMemoryPhysicallyContiguous, size, 0x00000000FFFFF000ull);
+		addr64_t pa = sweet_display_pool[i] ? sweet_display_pool[i]->getPhysicalSegment(0, &seg, kIOMemoryMapperNone) : 0;
+		IOLog("SWEET SURF: display buffer %u: %s at %#llx, %llu of %lu bytes in one piece\n", i,
+		    sweet_display_pool[i] ? "made" : "NOT MADE", (unsigned long long)pa, (unsigned long long)seg, (unsigned long)size);
+	}
+}
+
+static IOBufferMemoryDescriptor *
+sweet_display_take(uint32_t size, uint32_t *slot)
+{
+	for (unsigned i = 0; i < SWEET_DISPLAY_POOL; i++) {
+		if (sweet_display_pool[i] != NULL && !sweet_display_busy[i] && sweet_display_pool[i]->getLength() >= size) {
+			sweet_display_busy[i] = true;
+			sweet_display_pool[i]->retain();
+			*slot = i + 1;
+			return sweet_display_pool[i];
+		}
+	}
+	return NULL;
+}
+
