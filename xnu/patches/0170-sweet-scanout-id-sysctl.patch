diff --git a/bsd/kern/sweet_amfi.c b/bsd/kern/sweet_amfi.c
index 56d78c3..9790f0a 100644
--- a/bsd/kern/sweet_amfi.c
+++ b/bsd/kern/sweet_amfi.c
@@ -531,4 +531,13 @@ sysctl_sweet_rtc SYSCTL_HANDLER_ARGS
 SYSCTL_PROC(_kern, OID_AUTO, sweet_rtc, CTLTYPE_QUAD | CTLFLAG_RD | CTLFLAG_LOCKED, 0, 0,
     sysctl_sweet_rtc, "Q", "PMIC RTC counter, seconds (free-running)");
 
+/*
+ * kern.sweet_scanout_id: the IOSurface the display engine fetches now (AppleCLCD::scanOut sets it at
+ * every flip). Screenshots read that surface: with VIG0 scaling the presented one itself, a fixed id
+ * went stale whenever backboardd's buffers changed (and a frozen phone looked like a live one).
+ */
+uint32_t sweet_fb_scanout_id;
+SYSCTL_UINT(_kern, OID_AUTO, sweet_scanout_id, CTLFLAG_RD | CTLFLAG_LOCKED, &sweet_fb_scanout_id, 0,
+    "IOSurface id scanned out now");
+
 #endif /* ARM64_BOARD_CONFIG_SWEET */
