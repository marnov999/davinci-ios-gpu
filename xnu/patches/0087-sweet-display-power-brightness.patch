 OSDefineMetaClassAndStructors(AppleCLCD, IOMobileFramebuffer);
 
+/*
+ * What iOS sets on the framebuffer (logged, the first forty times): CoreBrightness's Display.m
+ * names IOMFBBrightnessLevel among the panel's properties; a number under it goes to the panel as
+ * on SweetBacklight (AppleARMBacklight), on a 0..65536 scale.
+ */
+extern "C" int sweet_panel_brightness(uint32_t level);
+IOReturn
+AppleCLCD::setProperties(OSObject *properties)
+{
+	static unsigned logged;
+	OSDictionary *dict = OSDynamicCast(OSDictionary, properties);
+	OSNumber *n = dict ? OSDynamicCast(OSNumber, dict->getObject("IOMFBBrightnessLevel")) : NULL;
+	if (logged < 40) {
+		OSSerialize *s = OSSerialize::withCapacity(512);
+		logged++;
+		if (s && properties->serialize(s)) {
+			IOLog("SWEET FB: set %.400s\n", s->text());
+		}
+		OSSafeReleaseNULL(s);
+	}
+	if (n) {
+		uint32_t v = n->unsigned32BitValue(), level = (uint32_t)(((uint64_t)(v > 65536u ? 65536u : v) * 2047u) / 65536u);
+		IOLog("SWEET FB: IOMFBBrightnessLevel %u -> panel %u: %d\n", v, level, sweet_panel_brightness(level ? level : (v ? 1 : 0)));
+	}
+	return kIOReturnSuccess;
+}
