+sweet_rpmh_vreg_vote(const char *res, unsigned mv, bool on)
 {
 	/* Board-specific helper: do not apply PMIC5-LDO policy to arbitrary resources. */
-	if (!res || strcmp(res, "ldoc11") || mv < 2950 || mv > 3400) {
-		printf("SWEET RPMH: expected ldoc11 and 2950..3400 mV\n");
+	if (!res || !((!strcmp(res, "ldoc11") && mv >= 2950 && mv <= 3400) ||
+	    (!strcmp(res, "ldoa18") && mv >= 2950 && mv <= 3050))) {
+		printf("SWEET RPMH: expected ldoc11 (2950..3400 mV) or ldoa18 (2950..3050 mV)\n");
 		return EINVAL;
 	}
 	if (__atomic_exchange_n(&rh_lock, 1, __ATOMIC_ACQUIRE)) {
@@ -346,7 +355,7 @@ sweet_rpmh_vreg_enable(const char *res, unsigned mv)
