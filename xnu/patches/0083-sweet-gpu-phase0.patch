+		 * load may leave TRUST_CNTL non-secure-writable). If [Ie3] is MISSING => the
+		 * write aborts => zap required. Each step flushed+marked to pinpoint. */
+		CW(0xF803u, 0x0u);                 /* RBBM_SECVID_TSB_CNTL */
+		CW(0xF800u, 0x0u); CW(0xF801u, 0x0u); /* TSB_TRUSTED_BASE lo/hi */
+		CW(0xF802u, 0x0u);                 /* TSB_TRUSTED_SIZE */
+		__asm__ volatile("dsb osh" ::: "memory");
+		printf("SWEET GMU: [Ie1] SECVID TSB teardown written\n");
+		gmub_flush();
+		CW(0xF810u, 0x1u);                 /* TSB_ADDR_MODE_CNTL (writable per mainline) */
+		__asm__ volatile("dsb osh" ::: "memory");
