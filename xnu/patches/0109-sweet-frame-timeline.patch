-		if (!sweet_gpu_surface_wait(id, SWEET_SWAP_GPU_MS)) {
+		bool gpu_done = sweet_gpu_surface_wait(id, SWEET_SWAP_GPU_MS);
+		if (sweet_tl_on && layer == 0) {
