+/* A PON register other than SOFT_RB_SPARE, by the same channel. */
+static int
+spmi_pon_wr(unsigned apid, uint8_t reg, uint8_t val)
+{
+	vm_offset_t ch = ml_io_map(SPMI_CHNLS_PA + 0x10000u * apid, 0x1000u);
+	unsigned i;
+	if (!ch) {
+		return -1;
+	}
+	*(volatile uint32_t *)(ch + 0x10u) = val;
+	__asm__ volatile("dsb osh" ::: "memory");
+	*(volatile uint32_t *)(ch + 0x00u) = (0u << 27) | ((reg & 0xffu) << 4) | 0u;
+	__asm__ volatile("dsb osh" ::: "memory");
+	for (i = 0; i < 1000u; ++i) {
+		uint32_t st = *(volatile uint32_t *)(ch + 0x08u);
+		if (st & 1u) {
+			return (st & 0x0eu) ? -2 : 0;
+		}
+		gmub_udelay(1);
+	}
+	return -3;
+}
