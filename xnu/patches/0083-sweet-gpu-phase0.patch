+		 * Find which power/clock domain is actually off. ALL READS, no writes.
+		 * GPUCC shows the GX/CX GDSC rails + the gfx3d clock branch; the GMU
+		 * shows SPTPRAC (SP/TP retention+clock). GDSCR bit31=PWR_ON; a clock
+		 * CBCR bit31=CLK_OFF (1 => the branch is NOT running). gpu_gpucc is the
+		 * GPUCC window mapped back in gpu_probe. ---- */
+		uint32_t gxg     = gpu_rd(gpu_gpucc, 0x100cu); /* GX GDSCR */
+		uint32_t cxg     = gpu_rd(gpu_gpucc, 0x106cu); /* CX GDSCR */
+		uint32_t gfx3d   = gpu_rd(gpu_gpucc, 0x1054u); /* gpu_cc_gx_gfx3d_clk CBCR */
+		uint32_t sptp_st = gmub_rd(0x1F8D0u);          /* GMU SPTPRAC_PWR_CLK_STATUS */
+		uint32_t sptp_ct = gmub_rd(0x1A881u);          /* GMU GX_SPTPRAC_POWER_CONTROL */
+		printf("SWEET GMU: [G1b] GPUCC gx_gdsc=%#x(on=%d) cx_gdsc=%#x(on=%d) "
+		    "gfx3d_cbcr=%#x(clk_off=%d)\n", gxg, (gxg >> 31) & 1u, cxg,
