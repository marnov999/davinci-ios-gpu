+/* bsd/dev/sweet_prof.c: every thread's processor time so far (user + system, mach units). */
+int sweet_task_thread_times(task_t task, uint64_t *tid, uint64_t *mach, int max);
+int
+sweet_task_thread_times(task_t task, uint64_t *tid, uint64_t *mach, int max)
+{
+	thread_t thread;
+	int n = 0;
+	task_lock(task);
+	queue_iterate(&task->threads, thread, thread_t, task_threads) {
+		if (n < max) {
+			tid[n] = thread_tid(thread);
+			mach[n] = recount_thread_time_mach(thread);
+			n++;
+		}
+	}
+	task_unlock(task);
+	return n;
+}
