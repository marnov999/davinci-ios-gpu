+		gmub_udelay(100);
+		uint32_t aon2 = gpu_rd(core, A6XX_CP_AON_COUNTER_LO_ << 2);
+		uint32_t st  = gpu_rd(core, A6XX_RBBM_STATUS_ << 2);
+		uint32_t st3 = gpu_rd(core, 0x213u << 2);        /* RBBM_STATUS3 */
+		gpu_wr(core, 0x830u << 2, 0xCAFE1234u);          /* CP_SQE_INSTR_BASE_LO */
+		__asm__ volatile("dsb osh" ::: "memory");
+		uint32_t wr_pre = gpu_rd(core, 0x830u << 2);
+		gpu_wr(core, 0x830u << 2, 0u);                   /* restore */
+		printf("SWEET GMU: [G1] clocked? aon %#x->%#x (adv=%d) rbbm_status=%#x "
+		    "status3=%#x cp_wr_pre=%#x (want 0xcafe1234)\n",
+		    aon1, aon2, (aon2 != aon1), st, st3, wr_pre);
+		gmub_flush();
