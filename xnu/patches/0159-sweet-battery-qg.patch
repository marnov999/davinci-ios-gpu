+f64 sf_exp(f64 x)
+{
+	unsigned abstop = (unsigned)(x >> 52) & 0x7ff;
+	int special = 0;
+	f64 z, kd, r, r2, tail, tmp, scale, p1, t1, p2;
+	int64_t ki;
+	uint64_t idx, sbits;
