+#define SWEET_VM_MEM_MODIFIED   0x01            /* osfmk/vm/pmap.h VM_MEM_MODIFIED */
+#define SWEET_PMAP_FF_WIRED     0x10000         /* osfmk/vm/pmap.h PMAP_OPTIONS_FF_WIRED */
