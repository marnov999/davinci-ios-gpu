+/*
+ * The display off and on (IOMFB RequestPowerChange from backboardd, the power button / auto-lock).
+ * Level 0 alone only dims an AMOLED: the last frame stayed on, faintly. So, as the panel driver does
+ * (dsi_panel off/on commands): brightness 0, DCS display off (0x28) and enter sleep (0x10), and the
+ * display engine's refresh left off while asleep (no frames fetched); back: exit sleep (0x11), the
+ * 120 ms it needs, refresh on, display on (0x29), the brightness. While off, the clocks thread runs
+ * everything at its lowest (g_clocks_dark). Boot-arg sweetpanel_sleep=0: the old dimming only.
+ */
+static int panel_dcs_cmd(uint8_t cmd, bool refresh_stays_off);
+static bool     g_panel_asleep;
+static uint32_t g_panel_refresh = ~0u;     /* INTF1 autorefresh config before sleep (~0: none saved) */
+
 int
 sweet_panel_power(int on)
 {
-	g_panel_off = !on;
-	return panel_dcs_brightness(on ? g_panel_level : 0u);
+	static int sleep_ok = -1;
+	int r;
+	if (sleep_ok < 0) {
+		sleep_ok = 1;
+		(void)PE_parse_boot_argn("sweetpanel_sleep", &sleep_ok, sizeof(sleep_ok));
+	}
+	if (!on) {
+		g_panel_off = true;
+		r = panel_dcs_brightness(0u);
+		if (sleep_ok && !g_panel_asleep) {
+			/* MIUI's qcom,mdss-dsi-off-command for this panel (dtbo 14, "ss ea fhd cmd dsi panel"):
+			 * 05 .. 28 (display off), 05 .. 78 .. 10 (enter sleep, then 0x78 = 120 ms) */
+			int a = panel_dcs_cmd(0x28, false), b = panel_dcs_cmd(0x10, true);
+			gmub_udelay(120000);
+			g_panel_asleep = true;
+			printf("SWEET PANEL: asleep (display off %d, sleep in %d)\n", a, b);
+		}
+		return r;
+	}
+	if (g_panel_asleep) {
+		int a = panel_dcs_cmd(0x11, true);
+		gmub_udelay(120000);                    /* exit sleep -> display on: 120 ms (MIPI DCS) */
+		int b = panel_dcs_cmd(0x29, false);
+		g_panel_asleep = false;
+		printf("SWEET PANEL: awake (sleep out %d, display on %d)\n", a, b);
+	}
+	g_panel_off = false;
+	return panel_dcs_brightness(g_panel_level);
 }
 
