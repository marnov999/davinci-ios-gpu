+/* Allocate one physically-contiguous zeroed page in the low 4 GiB.
+ * Returns kernel VA in *va and physical address in *pa (0 on failure). */
+static int
+gmub_alloc_phys(vm_offset_t *va, uint64_t *pa, vm_size_t size)
+{
+	ppnum_t max_pnum = (ppnum_t)((0x100000000ULL / PAGE_SIZE) - 1); /* cap < 4 GiB */
+	ppnum_t pn;
+	*va = 0;
+	*pa = 0;
+	if (kmem_alloc_contig(kernel_map, va, size, PAGE_MASK, max_pnum, 0,
+	        KMA_DATA | KMA_ZERO | KMA_PERMANENT, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		return -1;
+	}
+	pn = pmap_find_phys(kernel_pmap, (addr64_t)(*va));
+	if (!pn) {
+		return -1;
+	}
+	*pa = ptoa_64(pn);
+	if ((*pa >> 32) != 0) {       /* must be 32-bit for the GMU address regs */
+		return -1;
+	}
+	return 0;
+}
