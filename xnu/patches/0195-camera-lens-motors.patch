+/* ---- the lens motors (wide, tele) ------------------------------------------------------------------- */
+
+/*
+ * The wide and the tele lenses move on voice coils driven by a Dongwoon DW9763 each, on their sensor's own
+ * I2C (the module files' actuatorDriver: "davinci_imx582_dw9763_*" at 8-bit 0x18, "davinci_ov8856_dw9763_*"
+ * at 0x1c), powered by VAF: a fixed 2.8 V regulator that PM6150L GPIO 11 switches (both motors'). The
+ * modules' initialisation, as it is: 0x02 = 0x01 (power down), 0x02 = 0x00 and 1 ms, 0x02 = 0x02 (ring
+ * control), 0x06 = 0x60 (SAC mode), 0x07 = 0x02 (its timing); the position is ten bits, 0x03 (the high two)
+ * and 0x04 written together (registerParam). As HackiOS's DW9800 (redwood_camera.c): at the end the lens is
+ * let down in steps, the chip powered down and VAF switched off. A motor that does not answer leaves the
+ * camera fixed-focus for the session -- never the camera given up.
+ */
+#define AF_CONTROL              0x02
+#define AF_POSITION             0x03
+#define AF_MODE                 0x06
+#define AF_TIMING               0x07
+#define AF_VAF_PGPIO            11
+#define AF_FIRST_POSITION       180             /* the modules' first figure after their settings */
+
+static uint32_t af_position = SWEET_CAMERA_NO_FOCUS;
+static bool af_vaf_on;
+
+static bool
+af_write(uint8_t reg, uint16_t value)
+{
+	uint8_t out[3] = { reg, (uint8_t)value, 0 };
+
+	if (hw->af_address == 0) {
+		return false;
+	}
+	if (reg == AF_POSITION) {
+		out[1] = (uint8_t)(value >> 8 & 3);
+		out[2] = (uint8_t)value;
+	}
+	return i2c_transfer(&cci_bus, hw->af_address, out, reg == AF_POSITION ? 3 : 2, NULL, 0);
+}
+
+/* VAF on through GPIO 11 -- only if it is ours to write (a refusal is no reason to give the camera up) */
+static bool
+af_vaf(bool on)
+{
+	unsigned owner = 7, apid;
+
+	if (!on) {
+		if (af_vaf_on) {
+			(void)pgpio_drive(AF_VAF_PGPIO, false);
+			pgpio_restore(AF_VAF_PGPIO);
+			af_vaf_on = false;
+		}
+		return true;
+	}
+	if (!spmi_up()) {
+		return false;
+	}
+	lck_mtx_lock(&spmi_lock);
+	apid = spmi_apid(SID_PM6150L, PGPIO_PERIPH(AF_VAF_PGPIO), &owner);
+	lck_mtx_unlock(&spmi_lock);
+	if (apid == 0xffff || owner != 0) {
+		say("the lens motors' VAF (PM6150L GPIO %u): APID %#x owner EE %u, not ours: fixed focus\n", AF_VAF_PGPIO, apid, owner);
+		return false;
+	}
+	af_vaf_on = pgpio_drive(AF_VAF_PGPIO, true);
+	return af_vaf_on;
+}
+
+static void
+af_up(void)
+{
+	af_position = SWEET_CAMERA_NO_FOCUS;
+	if (hw->af_address == 0 || broken) {
+		return;
+	}
+	if (!af_vaf(true) || broken) {
+		return;
+	}
+	wait_ms(2);
+	if (!af_write(AF_CONTROL, 0x01) || !af_write(AF_CONTROL, 0x00)) {
+		say("the %s lens motor (DW9763 at %#x) does not answer: fixed focus this session\n", hw->name, hw->af_address);
+		(void)af_vaf(false);
+		return;
+	}
+	wait_ms(1);
+	if (!af_write(AF_CONTROL, 0x02) || !af_write(AF_MODE, 0x60) || !af_write(AF_TIMING, 0x02) ||
+	    !af_write(AF_POSITION, AF_FIRST_POSITION)) {
+		say("the %s lens motor stopped answering during its initialisation: fixed focus this session\n", hw->name);
+		(void)af_vaf(false);
+		return;
+	}
+	af_position = AF_FIRST_POSITION;
+	say("the %s lens motor (DW9763 at %#x) is up, the lens at %u\n", hw->name, hw->af_address, af_position);
+}
+
+static void
+af_move(uint32_t position)
+{
+	if (af_position == SWEET_CAMERA_NO_FOCUS) {
+		return;
+	}
+	position = position > 1023 ? 1023 : position;
+	if (position != af_position && af_write(AF_POSITION, (uint16_t)position)) {
+		af_position = position;
+	}
+}
+
+static void
+af_down(void)
+{
+	if (af_position != SWEET_CAMERA_NO_FOCUS) {
+		/* down in steps, not to knock the lens against its stop */
+		while (af_position > 0) {
+			uint32_t was = af_position;
+
+			af_move(af_position > 48 ? af_position - 48 : 0);
+			if (af_position == was) {
+				break;
+			}
+			wait_ms(10);
+		}
+		(void)af_write(AF_CONTROL, 0x01);
+		af_position = SWEET_CAMERA_NO_FOCUS;
+	}
+	(void)af_vaf(false);
+}
