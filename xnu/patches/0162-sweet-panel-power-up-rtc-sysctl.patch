+/*
+ * The panel's reset line, TLMM GPIO 9 (dtbo 14 qcom,platform-reset-gpio; sdmmagpie's NORTH tile:
+ * 0x03400000 + 0x500000 + 9 * 0x1000, io register +4 bit 1 the level, ctl bit 9 output enable).
+ * Driven only if the boot loader left it a GPIO output (function 0), else left alone and said so.
+ */
+static void
+panel_reset_line(bool high)
+{
+	static vm_offset_t g9;
+	if (!g9 && !(g9 = ml_io_map(0x03909000u, 0x1000u))) {
+		return;
+	}
+	uint32_t ctl = gpu_rd(g9, 0x0u);
+	if (((ctl >> 2) & 0xfu) != 0 || !(ctl & (1u << 9))) {
+		printf("SWEET PANEL: reset GPIO 9 ctl %#x is not a GPIO output: left alone\n", ctl);
+		return;
+	}
+	gpu_wr(g9, 0x4u, high ? (1u << 1) : 0u);
+	__asm__ volatile("dsb sy" ::: "memory");
+}
