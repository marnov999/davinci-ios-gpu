  */
 
+/* VIG0's last flush taken by the display engine (or MS gone by): what is written now is all taken together at the next */
+static bool
+sweet_fb_flush_taken(volatile uint32_t *r, uint32_t ms)
+{
+	uint64_t until = 0;
+	clock_interval_to_deadline(ms, kMillisecondScale, &until);
+	while ((r[SWEET_MDP_CTL0_FLUSH / 4] & SWEET_MDP_FLUSH_VIG0) != 0) {
+		if (mach_absolute_time() >= until) {
+			return false;
+		}
+		IODelay(100);
+	}
+	return true;
+}
+
+/*
+ * VIG0 fetching SW x SH and its scaler giving DW x DH to LM0, as the vendor driver sets a pipe up when
+ * nobody gave it scaler data (sde_plane.c _sde_plane_setup_scaler3 -> sde_hw_sspp.c setup_rects,
+ * setup_pe, sde_hw_util.c sde_hw_setup_scaler3): bilinear, so no coefficient tables to load; a phase
+ * step of SW / DW source pixels (21 fraction bits: 1125 -> 1080 is 0x215555, 2436 -> 2340 0x215015);
+ * initial phase 0; the preload of QSEED3 (4 across, 3 down); no pixel extension (the pipe's
+ * PE_OVERRIDE is set, so REQ_PIXELS is what it fetches: the whole source). The scaler's op mode last.
+ */
+static unsigned
+sweet_fb_scaler_config(struct sweet_fb_reg *c, uint32_t sw, uint32_t sh, uint32_t dw, uint32_t dh, bool alpha)
+{
+	uint32_t src = (sh << 16) | sw, dst = (dh << 16) | dw;
+	uint32_t step_x = (uint32_t)(((uint64_t)sw << SWEET_QSEED_PHASE_SHIFT) / dw);
+	uint32_t step_y = (uint32_t)(((uint64_t)sh << SWEET_QSEED_PHASE_SHIFT) / dh);
+	uint32_t preload = SWEET_QSEED_PRELOAD_H | (SWEET_QSEED_PRELOAD_V << 8) | (SWEET_QSEED_PRELOAD_H << 16) |
+	    (SWEET_QSEED_PRELOAD_V << 24);
+	uint32_t op = SWEET_QSEED_OP_ENABLE | SWEET_QSEED_OP_Y_BILINEAR | SWEET_QSEED_OP_BLEND | SWEET_QSEED_OP_8BIT;
+	const uint32_t q = SWEET_MDP_VIG0_QSEED;
+	unsigned n = 0;
+
+	if (alpha) {
+		op |= SWEET_QSEED_OP_ALPHA | SWEET_QSEED_OP_A_BILINEAR;
+	}
+	c[n++] = { SWEET_MDP_VIG0_SRC_SIZE, src };
+	c[n++] = { SWEET_MDP_VIG0_SRC_XY, 0 };
+	c[n++] = { SWEET_MDP_VIG0_OUT_SIZE, dst };
+	c[n++] = { SWEET_MDP_VIG0_OUT_XY, 0 };
+	c[n++] = { SWEET_MDP_VIG0_DECIMATION, 0 };
+	for (uint32_t i = 0; i < 3; i++) {     /* colour 0, colours 1 and 2, colour 3: LR, TB, REQ_PIXELS */
+		c[n++] = { SWEET_MDP_VIG0_PE(i) + 0x0u, 0 };
+		c[n++] = { SWEET_MDP_VIG0_PE(i) + 0x4u, 0 };
+		c[n++] = { SWEET_MDP_VIG0_PE(i) + 0x8u, src };
+	}
+	c[n++] = { q + SWEET_QSEED_INIT_Y_H + 0x0u, 0 };
+	c[n++] = { q + SWEET_QSEED_INIT_Y_H + 0x4u, 0 };
+	c[n++] = { q + SWEET_QSEED_INIT_Y_H + 0x8u, 0 };
+	c[n++] = { q + SWEET_QSEED_INIT_Y_H + 0xcu, 0 };
+	c[n++] = { q + SWEET_QSEED_STEP_Y_H + 0x0u, step_x };
+	c[n++] = { q + SWEET_QSEED_STEP_Y_H + 0x4u, step_y };
+	c[n++] = { q + SWEET_QSEED_STEP_Y_H + 0x8u, step_x };      /* (RGB: no subsampled chroma) */
+	c[n++] = { q + SWEET_QSEED_STEP_Y_H + 0xcu, step_y };
+	c[n++] = { q + SWEET_QSEED_PRELOAD, preload };
+	c[n++] = { q + SWEET_QSEED_SRC_SIZE_Y + 0x0u, src };
+	c[n++] = { q + SWEET_QSEED_SRC_SIZE_Y + 0x4u, src };
+	c[n++] = { q + SWEET_QSEED_DST_SIZE, dst };
+	c[n++] = { q + SWEET_QSEED_OP_MODE, op };
+	return n;
+}
+#define SWEET_FB_SCALER_SRC     0       /* (indexes into that: logged) */
+#define SWEET_FB_SCALER_OUT     2
+#define SWEET_FB_SCALER_REQ     7
+#define SWEET_FB_SCALER_STEP    18
+#define SWEET_FB_SCALER_DST     25
+
+/*
+ * The scaler on (VIG0 fetching the presented size): the first time, its version read (a scaler that
+ * is not there, or the first QSEED3 with its other phase registers, is not used: the frames are then
+ * copied, scaled by the CPU) and what the boot loader had in these registers kept. Written while no
+ * flush is pending, so that the next flush (scanOut's, with the address) has the engine take all of
+ * them at one frame's start.
+ */
+bool
+AppleCLCD::scalerOn(void)
+{
+	volatile uint32_t *r = (volatile uint32_t *)fMdp;
+	struct sweet_fb_reg c[SWEET_FB_SCALER_REGS];
+	bool alpha = (r[SWEET_MDP_VIG0_FORMAT / 4] & SWEET_MDP_VIG0_FORMAT_ALPHA) != 0;
+	unsigned n = sweet_fb_scaler_config(c, fLogicalW, fLogicalH, fWidth, fHeight, alpha);
+
+	if (fScalerState < 0) {
+		return false;
+	}
+	if (fScalerState == 0) {
+		uint32_t version = r[(SWEET_MDP_VIG0_QSEED + SWEET_QSEED_VERSION) / 4];
+		if (version == 0 || version == 0xffffffffu || version == 0x1002u) {
+			IOLog("SWEET FB: VIG0's scaler reads version %#x: not used (frames copied, scaled by the CPU)\n", version);
+			fScalerState = -1;
+			return false;
+		}
+		for (unsigned i = 0; i < n; i++) {
+			fScalerSave[i].off = c[i].off;
+			fScalerSave[i].val = r[c[i].off / 4];
+		}
+		fScalerRegs = n;
+		fScalerState = 1;
+		IOLog("SWEET FB: VIG0's scaler version %#x; the boot loader's src %#x out %#x req %#x, scaler op %#x step %#x/%#x "
+		    "dst %#x\n", version, fScalerSave[SWEET_FB_SCALER_SRC].val, fScalerSave[SWEET_FB_SCALER_OUT].val,
+		    fScalerSave[SWEET_FB_SCALER_REQ].val, fScalerSave[n - 1].val, fScalerSave[SWEET_FB_SCALER_STEP].val,
+		    fScalerSave[SWEET_FB_SCALER_STEP + 1].val, fScalerSave[SWEET_FB_SCALER_DST].val);
+	}
+	if (!sweet_fb_flush_taken(r, 40)) {
+		IOLog("SWEET FB: scaler on: VIG0's last flush still not taken after 40 ms\n");
+	}
+	for (unsigned i = 0; i < n; i++) {
+		r[c[i].off / 4] = c[i].val;
+	}
+	fScaled = true;
+	IOLog("SWEET FB: VIG0 scaled: %ux%u -> %ux%u, step %#x/%#x, scaler op %#x\n", fLogicalW, fLogicalH, fWidth,
+	    fHeight, c[SWEET_FB_SCALER_STEP].val, c[SWEET_FB_SCALER_STEP + 1].val, c[n - 1].val);
+	return true;
+}
+
+/* The boot loader's 1:1 setup back (the next flush takes it), for its framebuffer. */
+void
+AppleCLCD::scalerOff(void)
+{
+	volatile uint32_t *r = (volatile uint32_t *)fMdp;
+	if (!fScaled) {
+		return;
+	}
+	(void)sweet_fb_flush_taken(r, 40);
+	for (unsigned i = 0; i < fScalerRegs; i++) {
+		r[fScalerSave[i].off / 4] = fScalerSave[i].val;
+	}
+	fScaled = false;
+}
