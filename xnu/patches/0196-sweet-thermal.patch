index 0000000..ca7b3b1
--- /dev/null
+++ b/bsd/dev/sweet_thermal.c
@@ -0,0 +1,237 @@
+/*
+ * SWEET thermal: the SoC's temperature sensors, a line in the log, and a power-off for a phone that is getting too
+ * hot to be left alone. Only with boot-arg sweetthermal=1. Ported from HakiOS's drivers/power/hakios.thermal.c
+ * (oosexgang, MIT), with the Mi 9T's own sensors.
+ *
+ * The SM7150 has two TSENS blocks (live DT: tsens@c222000 and tsens@c223000, compatible qcom,tsens24xx, which
+ * MIUI's drivers/thermal/tsens2xxx.c drives; their readings at 0xc263000 and 0xc265000). They measure by
+ * themselves and keep each sensor's last reading in a status word, TM + 0xa0 + 4 * sensor: bits [11:0] the
+ * temperature in tenths of a degree, signed, bit 21 set when there is a reading. THIS ONLY READS those words: no
+ * write, no interrupt, no threshold. Calibration is the secure side's, done before the kernel runs.
+ *
+ * A reading is believed with its valid bit and between -40 and 160 degrees. The table below is the live DT's
+ * thermal-zones (davinci_0.dts, the "-usr" zones): 15 sensors in the first block, 10 in the second. MIUI
+ * starts slowing the CPU at 110 C (the "-step" zones) and gives up at 125 C; nothing here slows anything (our
+ * clocks stay at max), so the stop is the whole protection and sits below that, at 105 C by default.
+ *
+ *   - every sweetthermal_poll ms (2000) all sensors are read;
+ *   - sysctl kern.sweet_thermal_max_mc (the hottest, millidegrees), kern.sweet_thermal_hottest (its name),
+ *     kern.sweet_thermal_sensors ("cpu-0-0=41.2 ..."), kern.sweet_thermal_reads;
+ *   - "SWEET THERMAL:" in the log every sweetthermal_log s (60; 0: only on a rise) and at once when the hottest
+ *     crosses a multiple of 5 degrees upwards from 60;
+ *   - the hottest valid sensor at or above sweetthermal_stop C (105; 0: never) three reads in a row: the phone is
+ *     powered off (sweet_power_off(): a normal shutdown, as "slide to power off", so HFS+ is synced).
+ */
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/reboot.h>
+#include <sys/sysctl.h>
+#include <kern/clock.h>
+#include <libkern/OSAtomic.h>
+#include <kern/thread.h>
+#include <mach/mach_types.h>
+#include <pexpert/pexpert.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
+extern int PEHaltRestart(unsigned int type);
+extern int hz;
+extern void sweet_thermal_init(void);
+extern int sweet_thermal_max_mc(void);
+extern void sweet_power_off(const char *why);
+
+#define TM_SIZE                 0x200u
+#define TM_STATUS(sensor)       (0xa0u + 4u * (sensor))
+#define TM_VALID                (1u << 21)
+#define TEMP_MIN_TENTHS         (-400)
+#define TEMP_MAX_TENTHS         1600
+#define TM0_PA                  0xc263000u
+#define TM1_PA                  0xc265000u
+
+static const struct {
+	const char *name;
+	uint8_t block;
+	uint8_t number;
+} sensors[] = {
+	{ "aoss-0", 0, 0 }, { "cpu-0-0", 0, 1 }, { "cpu-0-1", 0, 2 }, { "cpu-0-2", 0, 3 }, { "cpu-0-3", 0, 4 },
+	{ "cpu-0-4", 0, 5 }, { "cpu-0-5", 0, 6 }, { "cpuss-0", 0, 7 }, { "cpuss-1", 0, 8 }, { "cpu-1-0", 0, 9 },
+	{ "cpu-1-1", 0, 10 }, { "cpu-1-2", 0, 11 }, { "cpu-1-3", 0, 12 }, { "gpuss-0", 0, 13 }, { "gpuss-1", 0, 14 },
+	{ "aoss-1", 1, 0 }, { "cwlan", 1, 1 }, { "audio", 1, 2 }, { "ddr", 1, 3 }, { "q6-hvx", 1, 4 },
+	{ "camera", 1, 5 }, { "mdm-core", 1, 6 }, { "mdm-dsp", 1, 7 }, { "npu", 1, 8 }, { "video", 1, 9 },
+};
+#define NSENSORS        ((unsigned)(sizeof(sensors) / sizeof(sensors[0])))
+
+static vm_offset_t tm_va[2];
+static uint32_t poll_ms = 2000, log_seconds = 60, stop_celsius = 105;
+static uint64_t last_log;
+static int strikes, last_step;
+
+static int thermal_max_mc = -273000;
+static int thermal_reads;
+static char thermal_hottest[16];
+static char thermal_list[NSENSORS * 16 + 8];
+
+SYSCTL_INT(_kern, OID_AUTO, sweet_thermal_max_mc, CTLFLAG_RD | CTLFLAG_LOCKED, &thermal_max_mc, 0,
+    "the hottest valid SoC temperature sensor, millidegrees C (-273000: none read)");
+SYSCTL_STRING(_kern, OID_AUTO, sweet_thermal_hottest, CTLFLAG_RD | CTLFLAG_LOCKED, thermal_hottest, 0,
+    "the name of that sensor");
+SYSCTL_STRING(_kern, OID_AUTO, sweet_thermal_sensors, CTLFLAG_RD | CTLFLAG_LOCKED, thermal_list, 0,
+    "every sensor and its temperature in degrees C");
+SYSCTL_INT(_kern, OID_AUTO, sweet_thermal_reads, CTLFLAG_RD | CTLFLAG_LOCKED, &thermal_reads, 0,
+    "how many times the sensors were read");
+
+/* for other drivers: the hottest temperature in millidegrees; -273000 when not read */
+int
+sweet_thermal_max_mc(void)
+{
+	return thermal_max_mc;
+}
+
+/*
+ * A normal power-off from the kernel, for the guards (thermal here, the battery in SweetBattery.cpp): processes
+ * stopped, disks synced, then PE_halt_restart (sweet_gpu.c, 0148) drops PS_HOLD. Should the shutdown not get
+ * there within 90 s (a sync that hangs), the PMIC is told directly.
+ */
+static const char *power_off_why;
+
+static void
+power_off_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	int error;
+	printf("SWEET POWER: powering off: %s\n", power_off_why);
+	error = reboot_kernel(RB_HALT, __DECONST(char *, power_off_why));
+	/* only back here when a shutdown was already under way (EBUSY): the watchdog gives it its time */
+	printf("SWEET POWER: reboot_kernel returned %d\n", error);
+}
+
+static void
+power_off_watchdog(__unused void *arg, __unused wait_result_t wr)
+{
+	static int chan;
+	(void)tsleep(&chan, PZERO, "sweetoffw", 90 * hz);
+	printf("SWEET POWER: still running 90 s after \"%s\": PS_HOLD now\n", power_off_why);
+	(void)PEHaltRestart(0);                 /* kPEHaltCPU */
+}
+
+void
+sweet_power_off(const char *why)
+{
+	thread_t thread;
+	if (!OSCompareAndSwapPtr(NULL, __DECONST(void *, why), (void * volatile *)&power_off_why)) {
+		return;                         /* already asked */
+	}
+	if (kernel_thread_start(power_off_watchdog, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+	if (kernel_thread_start(power_off_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	} else {
+		(void)PEHaltRestart(0);
+	}
+}
+
+static void
+text_of(char *out, size_t size, int32_t tenth)
+{
+	int whole = tenth / 10, frac = tenth % 10;
+	snprintf(out, size, "%s%d.%d", (tenth < 0 && whole == 0) ? "-" : "", whole, frac < 0 ? -frac : frac);
+}
+
+static void
+look(void)
+{
+	int32_t hottest = INT32_MIN;
+	unsigned hot = 0, good = 0, i;
+	char list[sizeof(thermal_list)], one[16];
+
+	list[0] = 0;
+	for (i = 0; i < NSENSORS; i++) {
+		uint32_t status = *(volatile uint32_t *)(tm_va[sensors[i].block] + TM_STATUS(sensors[i].number));
+		int32_t value = (int32_t)(status << 20) >> 20;
+		if (!(status & TM_VALID) || value < TEMP_MIN_TENTHS || value > TEMP_MAX_TENTHS) {
+			continue;
+		}
+		good++;
+		if (value > hottest) {
+			hottest = value;
+			hot = i;
+		}
+		text_of(one, sizeof(one), value);
+		if (strlen(list) + strlen(sensors[i].name) + strlen(one) + 3 < sizeof(list)) {
+			strlcat(list, sensors[i].name, sizeof(list));
+			strlcat(list, "=", sizeof(list));
+			strlcat(list, one, sizeof(list));
+			strlcat(list, " ", sizeof(list));
+		}
+	}
+	thermal_reads++;
+	if (good == 0) {
+		if (thermal_reads == 1) {
+			printf("SWEET THERMAL: no sensor has a reading (status of cpu-0-0 %#x)\n",
+			    *(volatile uint32_t *)(tm_va[0] + TM_STATUS(1)));
+		}
+		return;
+	}
+	strlcpy(thermal_list, list, sizeof(thermal_list));
+	strlcpy(thermal_hottest, sensors[hot].name, sizeof(thermal_hottest));
+	thermal_max_mc = hottest * 100;
+
+	uint64_t now = mach_absolute_time(), ns;
+	int step = hottest >= 600 ? hottest / 50 : 0;           /* a step each 5 degrees from 60 */
+	absolutetime_to_nanoseconds(now - last_log, &ns);
+	if (step > last_step || last_log == 0 || (log_seconds != 0 && ns / NSEC_PER_SEC >= log_seconds)) {
+		text_of(one, sizeof(one), hottest);
+		printf("SWEET THERMAL: %u of %u read; hottest %s %s C; %s\n", good, NSENSORS, sensors[hot].name, one,
+		    thermal_list);
+		last_log = now;
+	}
+	last_step = step;
+
+	strikes = (stop_celsius != 0 && hottest >= (int32_t)stop_celsius * 10) ? strikes + 1 : 0;
+	if (strikes == 3) {
+		text_of(one, sizeof(one), hottest);
+		printf("SWEET THERMAL: %s at %s C, at or above sweetthermal_stop=%u three reads in a row\n",
+		    sensors[hot].name, one, stop_celsius);
+		sweet_power_off("SoC too hot (sweetthermal_stop)");
+	}
+}
+
+static void
+thermal_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	static int chan;
+	for (;;) {
+		look();
+		(void)tsleep(&chan, PZERO, "sweettherm", (int)((poll_ms * (uint32_t)hz + 999u) / 1000u));
+	}
+}
+
+void
+sweet_thermal_init(void)
+{
+	uint32_t enabled = 0, value;
+	thread_t thread;
+
+	if (!PE_parse_boot_argn("sweetthermal", &enabled, sizeof(enabled)) || enabled == 0) {
+		return;
+	}
+	if (PE_parse_boot_argn("sweetthermal_poll", &value, sizeof(value)) && value >= 200 && value <= 60000) {
+		poll_ms = value;
+	}
+	if (PE_parse_boot_argn("sweetthermal_log", &value, sizeof(value)) && value <= 86400) {
+		log_seconds = value;
+	}
+	if (PE_parse_boot_argn("sweetthermal_stop", &value, sizeof(value)) && value <= 160) {
+		stop_celsius = value;
+	}
+	tm_va[0] = ml_io_map(TM0_PA, TM_SIZE);
+	tm_va[1] = ml_io_map(TM1_PA, TM_SIZE);
+	if (tm_va[0] == 0 || tm_va[1] == 0) {
+		printf("SWEET THERMAL: the sensor blocks would not map; off\n");
+		return;
+	}
+	printf("SWEET THERMAL: %u sensors (%#x, %#x), every %u ms; power off at %u C%s\n", NSENSORS, TM0_PA, TM1_PA,
+	    poll_ms, stop_celsius, stop_celsius ? "" : " (never)");
+	if (kernel_thread_start(thermal_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}
