+	/* GX/MX_VOTE_IDX are cmd-db gfx.lvl/mx.lvl INDICES, not voltages. Index 0=OFF,
+	 * 1=RETENTION on every ARC .lvl array (that is why vote=0 left rpmh_pwr=0xf and
+	 * never acked). Index 2 = MIN_SVS = davinci's default pwrlevel (initial-pwrlevel
+	 * 7 = 180 MHz = MIN_SVS) = the lowest real ON GX corner. cmd-db is read+printed
+	 * after Stage H to confirm the exact index for next time. */
+	gmub_wr(GMUB_BOOT_SLUMBER_OPTION, 0);
+	gmub_wr(GMUB_GX_VOTE_IDX, 2);
+	gmub_wr(GMUB_MX_VOTE_IDX, 2);
+	__asm__ volatile("dsb osh" ::: "memory");
+	gmub_wr(GMUB_HOST2GMU_INTR_SET, GMUB_OOB_BOOT_SLUMBER_SET);
+	__asm__ volatile("dsb osh" ::: "memory");
+	polls = 0;
+	(void)gmub_poll(GMUB_GMU2HOST_INTR_INFO, GMUB_OOB_BOOT_SLUMBER_ACK,
+	    GMUB_OOB_BOOT_SLUMBER_ACK, &polls);
