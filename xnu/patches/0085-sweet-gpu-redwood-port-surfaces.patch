+/*
+ * The GPU's hold on a surface (HackiOS RedwoodGPU surfaceBuffer: "the surface is held for as
+ * long as the buffer is there"), its seed (bumped by whoever writes it and unlocks it), and
+ * its pixels pushed out of this processor's cache: the GPU maps surfaces uncached, and what a
+ * CPU writer left in the cache would otherwise be read stale -- and evict later over what the
+ * GPU drew. Cache maintenance by VA acts on the physical lines whatever the VA's attributes,
+ * so the buffer's own (cached) kernel address is used when there is one, else the kernel map.
+ */
+extern "C" void *
+sweet_surface_gpu_ref(uint32_t id)
+{
+	return sweet_surface_copy(id);
+}
+
+extern "C" void
+sweet_surface_gpu_unref(void *surface)
+{
+	if (surface != NULL) {
+		((SweetSurface *)surface)->release();
+	}
+}
+
+extern "C" uint32_t
+sweet_surface_gpu_seed(void *surface)
+{
+	return *sweet_surface_seed((SweetSurface *)surface);
+}
+
+extern "C" void
+sweet_surface_gpu_flush(void *surface)
+{
+	SweetSurface *s = (SweetSurface *)surface;
+	IOBufferMemoryDescriptor *bmd;
+	uintptr_t va, line, end;
+	if (s == NULL || s->memory == NULL) {
+		return;
+	}
+	bmd = OSDynamicCast(IOBufferMemoryDescriptor, s->memory);
+	va = bmd != NULL ? (uintptr_t)bmd->getBytesNoCopy() : s->kernelAddress();
+	if (va == 0) {
+		return;
+	}
+	end = va + s->memory->getLength();
+	for (line = va & ~(uintptr_t)63; line < end; line += 64) {
+		__asm__ volatile ("dc civac, %0" : : "r" (line) : "memory");
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
