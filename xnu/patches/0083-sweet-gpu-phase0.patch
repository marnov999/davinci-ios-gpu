+/* sweetwifi=6 CROSS-PROBE: PAS-authenticate a NON-GPU, NON-MODEM subsystem (ipa_fws, pas-id 15) from XNU,
+ * validate-only (init_image then shutdown; nothing is loaded, reset, or released). This discriminates the
+ * modem 0xffcffff6 wall: if ipa_fws init_image returns 0 -> TZ accepts non-GPU PAS from our OS, so the modem
+ * reject is modem/radio-specific (anti-rollback/modemst/regulatory); if ipa_fws ALSO returns 0xffcffff6 ->
+ * TZ gates ALL non-GPU PAS from our (unsigned) OS. ipa_fws is not otherwise loaded by this kernel, so the
+ * init_image is clean. mdt is embedded (byte-exact from davinci vendor /firmware), so no device file needed. */
+#define WIPA_PAS_ID 15u
+static void
+wifi_pas_crossprobe(void)
+{
+	vm_offset_t cva = 0, io = 0;
+	uint64_t pa = 0, x0, x1 = 0;
+	size_t i, n = sizeof(wifi_ipa_mdt);
+	printf("SWEET WIFI: [6] PAS CROSS-PROBE ipa_fws (pas-id %u, non-GPU/non-modem); validate-only, nothing released\n", WIPA_PAS_ID);
+	if (gmub_alloc_phys(&cva, &pa, 0x4000) != 0 || !(io = ml_io_map(pa, 0x4000))) {
+		printf("SWEET WIFI: [6] cannot get mdt buffer\n"); return;
+	}
+	for (i = 0; i < n; i++) { ((volatile unsigned char *)io)[i] = wifi_ipa_mdt[i]; }
+	__asm__ volatile("dsb sy" ::: "memory");
+	gmub_flush();
+	printf("SWEET WIFI: [6] ipa_fws.mdt copied to pa %#llx (%lu bytes), elf %02x%02x%02x%02x (want 7f454c46)\n",
+	    (unsigned long long)pa, (unsigned long)n, ((volatile unsigned char *)io)[0],
+	    ((volatile unsigned char *)io)[1], ((volatile unsigned char *)io)[2], ((volatile unsigned char *)io)[3]);
+	x1 = 0;
+	x0 = gpu_scm_pas(WMODEM_SCM_INIT_IMAGE, 0x82u, (uint64_t)WIPA_PAS_ID, pa, 0, &x1);
+	printf("SWEET WIFI: [6] PAS init_image(ipa_fws=%u) -> x0=%#llx x1=%#llx  [0 => TZ ACCEPTS non-GPU PAS from XNU => modem reject is modem-specific; 0xffcffff6 => blanket non-GPU PAS gate from our OS]\n",
+	    WIPA_PAS_ID, (unsigned long long)x0, (unsigned long long)x1);
+	x1 = 0;
+	(void)gpu_scm_pas(WMODEM_SCM_SHUTDOWN, 0x01u, (uint64_t)WIPA_PAS_ID, 0, 0, &x1);
