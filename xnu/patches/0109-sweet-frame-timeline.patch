diff --git a/iokit/Kernel/arm/SweetFramebuffer.cpp b/iokit/Kernel/arm/SweetFramebuffer.cpp
index 6176315..facfcae 100644
--- a/iokit/Kernel/arm/SweetFramebuffer.cpp
+++ b/iokit/Kernel/arm/SweetFramebuffer.cpp
@@ -77,6 +77,72 @@ enum {
 #define SWEET_MDP_VIG0_ADDR     (0x5000u + 0x014u)
 #define SWEET_MDP_VIG0_STRIDE   (0x5000u + 0x024u)
 #define SWEET_MDP_FLUSH_VIG0    0x1u
+
+/*
+ * The frame timeline (asked with the profiler, bsd/dev/sweet_prof.c): for every swap, when it came
+ * (SwapEnd), when the GPU was done with it, when it was flipped, when the display engine took the
+ * flip, and when SwapWait for it was entered and returned; and every vsync tick. Microseconds of
+ * mach_absolute_time, as the GL bridge's "tl:" lines, for tools/sweet-timeline.py.
+ */
+struct sweet_tl_swap {
+	uint32_t id;
+	uint64_t arrive, gpu, flip, latch, win, wout;
+};
+#define SWEET_TL_SWAPS 600
+#define SWEET_TL_TICKS 600
+static struct sweet_tl_swap sweet_tl[SWEET_TL_SWAPS];
+static uint64_t sweet_tl_tick[SWEET_TL_TICKS];
+static volatile uint32_t sweet_tl_on, sweet_tl_n, sweet_tl_nt;
+
+static uint64_t
+sweet_tl_us(void)
+{
+	uint64_t ns;
+	absolutetime_to_nanoseconds(mach_absolute_time(), &ns);
+	return ns / 1000ull;
+}
+
+static struct sweet_tl_swap *
+sweet_tl_find(uint32_t id)
+{
+	uint32_t n = sweet_tl_n < SWEET_TL_SWAPS ? sweet_tl_n : SWEET_TL_SWAPS;
+	for (uint32_t i = n; i > 0 && i + 16 > n; i--) {
+		if (sweet_tl[i - 1].id == id) {
+			return &sweet_tl[i - 1];
+		}
+	}
+	return NULL;
+}
+
+extern "C" void sweet_fb_timeline(int on);
+extern "C" void
+sweet_fb_timeline(int on)
+{
+	if (on) {
+		sweet_tl_n = sweet_tl_nt = 0;
+		sweet_tl_on = 1;
+		return;
+	}
+	sweet_tl_on = 0;
+	uint32_t n = sweet_tl_n < SWEET_TL_SWAPS ? sweet_tl_n : SWEET_TL_SWAPS;
+	uint32_t nt = sweet_tl_nt < SWEET_TL_TICKS ? sweet_tl_nt : SWEET_TL_TICKS;
+	IOLog("TL begin %u swaps %u ticks\n", n, nt);
+	for (uint32_t i = 0; i < nt; i++) {
+		IOLog("TL v %llu\n", sweet_tl_tick[i]);
+		if ((i & 63u) == 63u) {
+			IOSleep(40);
+		}
+	}
+	for (uint32_t i = 0; i < n; i++) {
+		struct sweet_tl_swap *t = &sweet_tl[i];
+		IOLog("TL s %u %llu %llu %llu %llu %llu %llu\n", t->id, t->arrive, t->gpu, t->flip, t->latch, t->win, t->wout);
+		if ((i & 63u) == 63u) {
+			IOSleep(40);
+		}
+	}
+	IOLog("TL end\n");
+}
+
