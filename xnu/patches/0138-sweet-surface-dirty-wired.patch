+			pmap_clear_modify(list[i].pn);
+		}
 		/* by the kernel's own (cached) view of all memory: no mapping to make, none of a different kind */
 		uintptr_t at = (uintptr_t)ml_static_ptovirt((vm_offset_t)ptoa(list[i].pn)) + list[i].poff;
