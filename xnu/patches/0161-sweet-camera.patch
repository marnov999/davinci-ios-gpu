+		.vdig_kind = VDIG_PMIC, .vdig_gpio = 3, .csiphy = 0, .phy_cbcr = 0x6020, .timer_cmd = 0x6004, .timer_cbcr = 0x601c,
+		.regs = REGS_SONY, .bayer = 0, .gain_unity = 256, .gain_max = 16 * 256,
