+		uint32_t scr0 = gpu_rd(smmu, 0x0u);
+		uint32_t smr0 = gpu_rd(smmu, 0x800u);
+		uint32_t s2cr0 = gpu_rd(smmu, 0xC00u);
+		gpu_wr(smmu, 0x8000u + 0x20u, 0xA5A50000u);  /* CB0 TTBR0_LO as scratch */
+		__asm__ volatile("dsb osh" ::: "memory");
+		uint32_t cb0 = gpu_rd(smmu, 0x8000u + 0x20u);
+		gpu_wr(smmu, 0x8000u + 0x20u, 0u);
+		printf("SWEET GMU: [J] SMMU scr0=%#x smr0=%#x s2cr0=%#x(0x200ff=fault) "
+		    "cb0_write=%#x(want 0xa5a50000)\n", scr0, smr0, s2cr0, cb0);
+		gmub_flush();
+		gpu_wr(smmu, 0x800u, 0x80000000u);           /* SMR0 = VALID | ID(0) */
+		gpu_wr(smmu, 0xC00u, 0x00000000u);           /* S2CR0 = TYPE_TRANS(0)|CBNDX(0) */
+		__asm__ volatile("dsb osh" ::: "memory");
+		uint32_t smr0b = gpu_rd(smmu, 0x800u);
+		uint32_t s2cr0b = gpu_rd(smmu, 0xC00u);
+		printf("SWEET GMU: [J] TYPE_TRANS route: smr0=%#x(want 0x80000000) "
