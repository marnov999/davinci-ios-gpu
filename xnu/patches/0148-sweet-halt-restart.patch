+/*
+ * Power off and restart. Nothing set PE_halt_restart, so iOS's "slide to power off" and restart
+ * ended in halt_all_cpus()'s spin. As Linux's msm-poweroff and qpnp-power-on do it: the boot
+ * reason in SOFT_RB_SPARE cleared (sweetgpu_armfb leaves "bootloader" there, which would bring
+ * an intended restart up in fastboot), the PMIC's PS_HOLD reset type (PON 0x5a bits[3:0]; on
+ * this gen2 PON its enable, bit 7, is in 0x5b, cleared while the type changes) set to shutdown
+ * or hard reset, then PS_HOLD dropped: the PMIC does the rest. A restart tries PSCI
+ * SYSTEM_RESET first, as the fastboot reboot does. Panics keep the old path (fastboot when
+ * armed). Boot-arg sweethalt=0 leaves the hook unset.
+ */
+#define PON_PS_HOLD_RST_CTL     0x5au
+#define PON_PS_HOLD_RST_CTL2    0x5bu
+#define PON_RESET_EN            0x80u
+#define PON_TYPE_SHUTDOWN       0x04u
+#define PON_TYPE_HARD_RESET     0x07u
+enum { SWEET_PE_HALT = 0, SWEET_PE_RESTART = 1, SWEET_PE_UPS_HALT = 3 };   /* IOPlatformExpert.h kPE* */
+extern int (*PE_halt_restart)(unsigned int type);
+
+static int
+sweet_halt_restart(unsigned int type)
+{
+	bool off = (type == SWEET_PE_HALT || type == SWEET_PE_UPS_HALT);
+	vm_offset_t core, cfg, obs, ph;
+	unsigned count, apid = 0xffffu;
+	uint8_t spare = 0, ctl = 0, ctl2 = 0;
+	uint64_t r[4];
+
+	if (!off && type != SWEET_PE_RESTART) {
+		return -1;
+	}
+	core = ml_io_map(SPMI_CORE_PA, 0x2000u);
+	cfg = ml_io_map(SPMI_CFG_PA, 0x1000u);
+	obs = ml_io_map(SPMI_OBS_PA, 0x10000u);
+	count = core ? (*(volatile uint32_t *)(core + 4)) & 0x7ffu : 0;
+	if (cfg && obs && count && count <= 512 && spmi_pon_read(core, cfg, obs, count, &apid, &spare) == 0) {
+		int w0 = spmi_pon_wr(apid, PON_SOFT_RB_SPARE, (uint8_t)(spare & 0x01u));
+		(void)spmi_rd8(0, (PON_PERIPH << 8) | PON_PS_HOLD_RST_CTL, &ctl);
+		(void)spmi_rd8(0, (PON_PERIPH << 8) | PON_PS_HOLD_RST_CTL2, &ctl2);
+		int w1 = spmi_pon_wr(apid, PON_PS_HOLD_RST_CTL2, (uint8_t)(ctl2 & ~PON_RESET_EN));
+		gmub_udelay(500);               /* 10 sleep-clock cycles, with Linux's margin */
+		int w2 = spmi_pon_wr(apid, PON_PS_HOLD_RST_CTL,
+		    (uint8_t)((ctl & 0xf0u) | (off ? PON_TYPE_SHUTDOWN : PON_TYPE_HARD_RESET)));
+		int w3 = spmi_pon_wr(apid, PON_PS_HOLD_RST_CTL2, (uint8_t)(ctl2 | PON_RESET_EN));
+		printf("SWEET HALT: %s: reason %#x -> %#x, PS_HOLD type %#x -> %#x, writes %d %d %d %d\n",
+		    off ? "power off" : "restart", spare, spare & 0x01u, ctl,
+		    (ctl & 0xf0u) | (off ? PON_TYPE_SHUTDOWN : PON_TYPE_HARD_RESET), w0, w1, w2, w3);
+	} else {
+		printf("SWEET HALT: %s: PMIC PON not reachable\n", off ? "power off" : "restart");
+	}
+	gmub_flush();
+	gmub_udelay(200000);                    /* the line out over the network first */
+	if (!off) {
+		gpu_smc(PSCI_SYSTEM_RESET, 0, 0, 0, 0, 0, 0, r);
+	}
+	ph = ml_io_map(PSHOLD_PA, 0x1000u);
+	if (ph) {
+		*(volatile uint32_t *)ph = 0u;
+		__asm__ volatile("dsb sy" ::: "memory");
+	}
+	for (;;) {
+		__asm__ volatile("wfe");
+	}
+}
