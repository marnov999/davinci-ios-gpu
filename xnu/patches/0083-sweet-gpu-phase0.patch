+#include <vm/vm_kern.h>
+#include <mach/memory_object_types.h>   /* MAP_MEM_WCOMB, memory_object_size_t/offset_t */
+#include <mach/vm_prot.h>
+#include <mach/vm_inherit.h>
+#include <mach/vm_statistics.h>         /* VM_FLAGS_ANYWHERE */
+#include <mach/vm_types.h>
+#include <sys/conf.h>
+#include <miscfs/devfs/devfs.h>
+#include "a618_gmu_fw.h"
+#include "a615_zap_fw.h"
+#include "a630_sqe_fw.h"
