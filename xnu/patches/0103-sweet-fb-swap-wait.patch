+/*
+ * SwapWait: until the swap is on the panel. CoreAnimation asks this before it draws into the
+ * buffer that swap replaced; answered at once, as before, it drew into the buffer the display
+ * engine was still fetching -- tearing, and frames run ahead of the panel then bunched. On the
+ * panel means: shown at a tick (or a later swap was), and when it was scanned out, the display
+ * engine has taken the new address -- CTL0's flush bits read back set until the engine latches
+ * them at the start of the panel's next frame.
+ */
+bool
+AppleCLCD::swapShown(uint32_t id, uint64_t timeoutMS)
+{
+	static uint32_t told;
+	uint64_t began = mach_absolute_time(), deadline, ns = 0;
+	bool shown = true;
+	clock_interval_to_deadline((uint32_t)timeoutMS, kMillisecondScale, &deadline);
+	IOLockLock(fLock);
+	while ((int32_t)(fShownSwap - id) < 0 && id <= fSwapID) {
+		if (IOLockSleepDeadline(fLock, (event_t)&fShownSwap, *(AbsoluteTime *)&deadline, THREAD_UNINT) == THREAD_TIMED_OUT) {
+			shown = false;
+			break;
+		}
+	}
+	IOLockUnlock(fLock);
+	if (shown && fScanning && fMdp != 0) {
+		volatile uint32_t *r = (volatile uint32_t *)fMdp;
+		while ((r[SWEET_MDP_CTL0_FLUSH / 4] & SWEET_MDP_FLUSH_VIG0) != 0 && mach_absolute_time() < deadline) {
+			IODelay(100);
+		}
+	}
+	if (told < 12) {
+		told++;
+		absolutetime_to_nanoseconds(mach_absolute_time() - began, &ns);
+		IOLog("SWEET FB: swap wait for %u (shown %u, last begun %u): %s after %llu us\n", id, fShownSwap, fSwapID,
+		    shown ? "on the panel" : "timed out", ns / 1000ull);
+	}
+	return shown;
+}
