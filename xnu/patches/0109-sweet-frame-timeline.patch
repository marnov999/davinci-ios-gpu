 			if (pa != 0 && seg >= need && pa + need <= 0x100000000ull && scanOut(s, pa, s->bytesPerRow)) {
+				if (sweet_tl_on) {
+					struct sweet_tl_swap *t = sweet_tl_find(get32(rec, 0x50));
+					if (t != NULL) {
