+/*
+ * One DSI command packet through the test-pattern FIFO and the command DMA, as panel_dcs_cmd and
+ * panel_dcs_brightness send theirs: a short one (0x05, 0x15) as its header alone, a long one (0x39)
+ * as the header {word count, type, last + long} and the payload in words, padded. lp: in low power,
+ * as the panel's on-commands are sent (qcom,mdss-dsi-on-command-state "dsi_lp_mode"). The display
+ * engine's refresh must be off (the caller's, asleep).
+ */
+static int
+panel_dsi_packet(uint8_t dtype, const uint8_t *data, unsigned n, bool lp)
+{
+	static vm_offset_t dsi;
+	uint32_t reg, saved, i, done = 0, len;
+	if (!dsi && !(dsi = ml_io_map(DSI0_PA, 0x400u))) {
+		return -1;
+	}
+	if (!(gpu_rd(dsi, DSI_CTRL_R) & 1u)) {
+		return -2;
+	}
+	if (n > 48) {
+		return -4;
+	}
+	for (i = 0; i < 40000u && (gpu_rd(dsi, DSI_STATUS_R) & (1u << 2)); i++) {
+		gmub_udelay(1);
+	}
+	gpu_wr(dsi, DSI_TPG_CTRL_R, (1u << 1) | (1u << 2) | (3u << 16));
+	if (dtype == 0x39 || dtype == 0x29) {
+		gpu_wr(dsi, DSI_TPG_DMA_INIT_R, n | (uint32_t)dtype << 16 | 0xC0u << 24);
+		for (unsigned w = 0; w < n; w += 4) {
+			uint32_t v = 0;
+			for (unsigned k = 0; k < 4; k++) {
+				v |= (uint32_t)(w + k < n ? data[w + k] : 0xFFu) << (8 * k);
+			}
+			gpu_wr(dsi, DSI_TPG_DMA_INIT_R, v);
+		}
+		len = 4u + ((n + 3u) & ~3u);
+	} else {
+		gpu_wr(dsi, DSI_TPG_DMA_INIT_R, (uint32_t)(n > 0 ? data[0] : 0) | (uint32_t)(n > 1 ? data[1] : 0) << 8 |
+		    (uint32_t)dtype << 16 | 0x80u << 24);
+		len = 4u;
+	}
+	saved = reg = gpu_rd(dsi, DSI_CMD_DMA_CTRL_R);
+	reg &= ~((1u << 31) | (1u << 30) | (1u << 26));
+	reg |= 1u << 28;
+	if (lp) {
+		reg |= 1u << 26;                        /* DSI_CMD_DMA_CTRL low-power transmission */
+	}
+	gpu_wr(dsi, DSI_CMD_DMA_CTRL_R, reg);
+	gpu_wr(dsi, DSI_DMA_CMD_LENGTH_R, len);
+	__asm__ volatile("dsb sy" ::: "memory");
+	gpu_wr(dsi, DSI_DMA_SW_TRIGGER_R, 1u);
+	for (i = 0; i < 20000u; i++) {
+		if ((done = gpu_rd(dsi, DSI_INT_CTRL_R)) & 1u) {
+			break;
+		}
+		gmub_udelay(1);
+	}
+	if (done & 1u) {
+		gpu_wr(dsi, DSI_INT_CTRL_R, done);
+	}
+	gpu_wr(dsi, DSI_TPG_CTRL_R, 0u);
+	gpu_wr(dsi, DSI_TPG_FIFO_RESET_R, 1u);
+	gmub_udelay(1);
+	gpu_wr(dsi, DSI_TPG_FIFO_RESET_R, 0u);
+	gpu_wr(dsi, DSI_CMD_DMA_CTRL_R, saved & ~(1u << 26));
+	return (done & 1u) ? 0 : -3;
+}
