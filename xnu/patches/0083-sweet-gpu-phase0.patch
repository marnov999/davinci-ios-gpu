+/* GMU/RSCC register indices (via GMU_BOFF) [a6xx_regs.h / davinci a6xx_reg.h] */
+#define GMUB_CM3_ITCM_START       0x1B400u
+#define GMUB_ICACHE_CONFIG        0x1F400u
+#define GMUB_DCACHE_CONFIG        0x1F401u
+#define GMUB_CM3_SYSRESET         0x1F800u
+#define GMUB_CM3_BOOT_CONFIG      0x1F801u
+#define GMUB_CX_GMU_WFI_CONFIG    0x1F802u
+#define GMUB_CM3_FW_INIT_RESULT   0x1F81Cu
