+/* The display is coming on: the clocks up now, not at the governor's next 100 ms tick -- the first
+ * frame after a wake (which lights the panel) was drawn at the display-off clocks otherwise. */
+void
+sweet_dvfs_wake_now(void)
+{
+	g_dvfs_active = mach_absolute_time();
+	if (g_dvfs_on) {
+		thread_wakeup((event_t)&g_dvfs_chan);
+	}
