+/* GMU bring-up step 1 (sweetgpu>=4): power on the CX GDSC and start the GMU
+ * clocks. All ops are inside the reachable GPUCC window (no GMU-window access
+ * yet). The cold-state probe showed CX GDSC off + GMU clocks halted; this is
+ * the prerequisite for loading GMU firmware. If PWR_ON never asserts, the CX
+ * rail likely needs an RPMh vote (sweet_rpmh.c) as the next step. */
+static void
+gpu_gmu_step1(void)
+{
+	uint32_t v = gpu_rd(gpu_gpucc, GPUCC_CX_GDSCR);
+	gpu_wr(gpu_gpucc, GPUCC_CX_GDSCR, v & ~GDSC_SW_COLLAPSE); /* de-collapse */
+	unsigned i;
+	for (i = 0; i < 2000u; i++) {
+		if (gpu_rd(gpu_gpucc, GPUCC_CX_GDSCR) & GDSC_PWR_ON) {
+			break;
+		}
+		delay_for_interval(10, NSEC_PER_USEC);
+	}
+	uint32_t cx = gpu_rd(gpu_gpucc, GPUCC_CX_GDSCR);
+	printf("SWEET GPU: CX GDSC enable -> %#x pwr_on=%d (polls=%u)\n",
+	    cx, (cx >> 31) & 1u, i);
+	gpu_wr(gpu_gpucc, GPUCC_CX_GMU_CLK,
+	    gpu_rd(gpu_gpucc, GPUCC_CX_GMU_CLK) | GCC_BRANCH_ENABLE);
+	gpu_wr(gpu_gpucc, GPUCC_CXO_CLK,
+	    gpu_rd(gpu_gpucc, GPUCC_CXO_CLK) | GCC_BRANCH_ENABLE);
+	gpu_wr(gpu_gpucc, GPUCC_AHB_CLK,
+	    gpu_rd(gpu_gpucc, GPUCC_AHB_CLK) | GCC_BRANCH_ENABLE);
+	delay_for_interval(100, NSEC_PER_USEC);
+	printf("SWEET GPU: GMU clks -> cx_gmu=%#x cxo=%#x ahb=%#x\n",
+	    gpu_rd(gpu_gpucc, GPUCC_CX_GMU_CLK), gpu_rd(gpu_gpucc, GPUCC_CXO_CLK),
+	    gpu_rd(gpu_gpucc, GPUCC_AHB_CLK));
+}
+
+/* GMU bring-up step 2 (sweetgpu>=5): now that the CX domain is powered and the
+ * GMU clocks run, map the GMU register window and read its core/AO registers.
+ * Reads only - proves the GMU window is reachable and shows the pre-boot state
+ * (CM3 held in reset, FW_INIT_RESULT not yet 0xBABEFACE) before we load fw. */
+static vm_offset_t gpu_gmu;
+static void
+gpu_gmu_step2(void)
+{
+	gpu_gmu = ml_io_map(A6XX_GMU_PA, A6XX_GMU_SIZE);
+	if (!gpu_gmu) {
+		printf("SWEET GPU: GMU window map failed\n");
+		return;
+	}
+	uint32_t sysreset = gpu_rd(gpu_gmu, GMU_BOFF(GMU_CM3_SYSRESET));
+	uint32_t fwinit = gpu_rd(gpu_gmu, GMU_BOFF(GMU_CM3_FW_INIT_RESULT));
+	uint32_t hfi = gpu_rd(gpu_gmu, GMU_BOFF(GMU_HFI_CTRL_STATUS));
+	uint32_t gen0 = gpu_rd(gpu_gmu, GMU_BOFF(GMU_GENERAL_0));
+	uint32_t wfi = gpu_rd(gpu_gmu, GMU_BOFF(GMU_CX_GMU_WFI_CONFIG));
+	printf("SWEET GPU: GMU window reachable: cm3_sysreset=%#x fw_init=%#x "
+	    "hfi_ctrl=%#x general0=%#x wfi_cfg=%#x\n",
+	    sysreset, fwinit, hfi, gen0, wfi);
+	if (fwinit == 0xBABEFACEu) {
+		printf("SWEET GPU: GMU fw already booted?! (0xBABEFACE)\n");
+	}
+}
