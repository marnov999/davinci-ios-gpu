+/*
+ * Low-battery power-off (after HakiOS's drivers/power/hakios.battguard.c): a run nobody watches must not empty
+ * the battery (the phone is not charged under this kernel). With the QG engine only (MIUI's own number, not the
+ * voltage estimate): MIUI's percentage at or below sweetbattery_stop (5; 0: never) with NO charger on the cable,
+ * three looks 10 s apart in a row, not in the first 2 minutes. An unknown reading (outside 0..100) is never a reason.
+ */
+void
+SweetBattery::guard(void)
+{
+	const struct sweet_qg_status *s = &fQGStatus;
+	uint64_t now;
+	absolutetime_to_nanoseconds(mach_continuous_time(), &now);
+	if (fGuardPercent == 0 || now - fGuardStartNs < 120ull * NSEC_PER_SEC || now - fGuardLastNs < 10ull * NSEC_PER_SEC) {
+		return;
+	}
+	fGuardLastNs = now;
+	if (s->percent < 0 || s->percent > 100 || s->external || (uint32_t)s->percent > fGuardPercent) {
+		fGuardStrikes = 0;
+		return;
+	}
+	if (++fGuardStrikes == 3) {
+		IOLog("SWEET BATTERY: %d%% (%d mV), no charger, at or below sweetbattery_stop=%u three looks in a row\n",
+		    s->percent, s->mv, fGuardPercent);
+		sweet_power_off("battery low (sweetbattery_stop)");
+	}
+}
