+/*
+ * sweetpopup=3: which LPG channel, clock and GPIO 10 function make the step signal (the motor's driver asleep:
+ * nothing moves). Each combination: 50 % PWM, then GPIO 10's level read 100 times; a working one reads about half
+ * high. Every channel is switched off again after its turn.
+ */
+static void
+popup_probe(void)
+{
+	static const uint8_t lpgs[3] = { 0xb1, 0xb2, 0xb3 };
+	/* size/clock (9 bits): 19.2 MHz | 32.768 kHz; prediv/exponent: 19.2 MHz prediv 3 exp 3 (640 us), 32 kHz prediv 1 exp 0 */
+	static const uint8_t clocks[2][2] = { { 3, 0x23 }, { 2, 0x00 } };
+
+	if (!popup_pins()) {
+		return;
+	}
+	popup_out(POPUP_SLEEP, false);                  /* the driver asleep: steps do nothing */
+	for (unsigned c = 0; c < 3; c++) {
+		uint8_t subtype = 0;
+
+		if (!spmi_read(SID_PM6150L_B, (uint16_t)(lpgs[c] << 8 | LPG_SUBTYPE), &subtype)) {
+			say("pop-up probe: LPG%u (%#x) cannot be read\n", c + 1, lpgs[c]);
+			continue;
+		}
+		for (unsigned k = 0; k < 2; k++) {
+			uint8_t size_clk = (uint8_t)(((subtype == 0x0b) ? (1u << 2) : (1u << 4)) | clocks[k][0]);
+			uint16_t b = (uint16_t)(lpgs[c] << 8);
+
+			if (!popup_spmi_put(SID_PM6150L_B, b | LPG_ENABLE_CONTROL, 0) ||
+			    !popup_spmi_put(SID_PM6150L_B, b | LPG_PWM_TYPE_CONFIG, 0x20) ||
+			    !popup_spmi_put(SID_PM6150L_B, b | LPG_PWM_SIZE_CLK, size_clk) ||
+			    !popup_spmi_put(SID_PM6150L_B, b | LPG_PWM_PREDIV_CLK, clocks[k][1]) ||
+			    !popup_spmi_put(SID_PM6150L_B, b | LPG_PWM_VALUE_LSB, 0x00) ||
+			    !popup_spmi_put(SID_PM6150L_B, b | LPG_PWM_VALUE_MSB, 0x01) ||
+			    !popup_spmi_put(SID_PM6150L_B, b | LPG_PWM_SYNC, 1) ||
+			    !popup_spmi_put(SID_PM6150L_B, b | LPG_ENABLE_CONTROL, 0x84)) {
+				broken = false;         /* (a probe: go on with the next one) */
+				say("pop-up probe: LPG%u clock %u: a write did not take\n", c + 1, k);
+				(void)popup_spmi_put(SID_PM6150L_B, b | LPG_ENABLE_CONTROL, 0);
+				broken = false;
+				continue;
+			}
+			for (uint8_t f = 1; f <= 5; f++) {
+				unsigned highs = 0, reads = 0;
+				uint8_t v = 0;
+
+				(void)popup_spmi_put(SID_PM6150L, (uint16_t)(PGPIO_PERIPH(POPUP_PGPIO) << 8 | 0x44), f);
+				popup_wait_ms(5);
+				for (int r = 0; r < 100; r++) {
+					if (spmi_read(SID_PM6150L, (uint16_t)(PGPIO_PERIPH(POPUP_PGPIO) << 8 | 0x10), &v)) {
+						reads++;
+						highs += v & 1;
+					}
+					spin_us(k == 0 ? 37 : 513);
+				}
+				say("pop-up probe: LPG%u (subtype %#x) clock %s, GPIO10 source %u: high %u of %u\n", c + 1, subtype,
+				    k == 0 ? "19.2 MHz" : "32 kHz", f, highs, reads);
+			}
+			(void)popup_spmi_put(SID_PM6150L_B, b | LPG_ENABLE_CONTROL, 0);
+		}
+	}
+	(void)popup_spmi_put(SID_PM6150L, (uint16_t)(PGPIO_PERIPH(POPUP_PGPIO) << 8 | 0x44), 0x02);
+	broken = false;
+	say("pop-up probe: done\n");
+}
