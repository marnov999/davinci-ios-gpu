-					IOByteCount seg = 0;
-					addr64_t pa = mem ? mem->getPhysicalSegment(0, &seg, kIOMemoryMapperNone) : 0;
-					IOLog("SWEET SURF: full-screen surface %u: %s, pa %#llx, %llu of %u bytes in one piece\n", s->id,
