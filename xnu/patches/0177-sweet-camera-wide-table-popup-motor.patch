 /* The mode: sweetcam_mode, else the 4:3-ish one with the fewest pixels at >= 24 fps (the ultra's 2104x1560@60). */
+/*
+ * Which of the footprint's two tables (the wide: IMX586 or IMX582) is the one fitted, before a mode is picked
+ * and frames are sized from it: power up, read the chip ID (read_chip_id() loads the other table if it is
+ * that one), power down. Once known, later sessions load it straight away.
+ */
+static const char *resolved_tab[SENSORS];
+
+static bool
+ctab_load_resolved(void)
+{
+	unsigned index = (unsigned)(hw - sensors);
+
+	if (resolved_tab[index] != NULL) {
+		return ctab_load(resolved_tab[index]);
+	}
+	if (!ctab_load(hw->tab)) {
+		return false;
+	}
+	if (hw->tab_alt == NULL || fake) {
+		return true;
+	}
+	bool ok = power_up() && read_chip_id();
+	power_down();
+	if (ok && !broken) {
+		resolved_tab[index] = ctab_loaded;
+	}
+	return ok && !broken;
+}
