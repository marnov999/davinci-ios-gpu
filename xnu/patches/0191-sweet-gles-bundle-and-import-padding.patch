diff --git a/bsd/dev/sweet_gpu.c b/bsd/dev/sweet_gpu.c
index 272b04e..54b6e34 100644
--- a/bsd/dev/sweet_gpu.c
+++ b/bsd/dev/sweet_gpu.c
@@ -3793,11 +3793,14 @@ static struct {
 } g_stat;
 
 /* A buffer's memory and addresses given up for good: the GPU is done with it. */
+#define SWEET_IMPORT_PAD_BYTES (128u * 0x1000u)   /* drm_do_ios_import's scratch pages after an import */
 static void
 gpu_bo_destroy(vm_offset_t cva, uint64_t gpuaddr, vm_size_t mmapsize, void *surf)
 {
-	gpu_unmap(gpuaddr, mmapsize);
-	gpu_address_free(gpuaddr, mmapsize);
+	/* an imported surface's addresses run on into its scratch pages (drm_do_ios_import) */
+	vm_size_t vsize = surf ? mmapsize + SWEET_IMPORT_PAD_BYTES : mmapsize;
+	gpu_unmap(gpuaddr, vsize);
+	gpu_address_free(gpuaddr, vsize);
 	if (cva) {
 		kmem_free(kernel_map, cva, mmapsize);
 	}
@@ -4765,7 +4768,13 @@ extern int sweet_surface_gpu_pages(uint32_t id, uint64_t *pa, unsigned maxpages,
     unsigned *npages, uint32_t *allocSize, uint32_t *width, uint32_t *height,
     uint32_t *bytesPerRow, uint32_t *pixelFormat);
 #define SWEET_IMPORT_MAX_PAGES 4096u    /* 16 MB: covers a full-screen BGRA surface */
-static uint64_t g_import_pa[SWEET_IMPORT_MAX_PAGES];
+/* Every import is followed in the GPU's address space by this many pages that all alias one
+ * scratch page: a GMEM resolve writes whole bins, and of a 2436x1125 surface (1125 rows, not a
+ * multiple of the bin height) that ran 1 KB past the surface's last page -- an SMMU write fault
+ * that stalled the core for the rest of the boot. What lands past the end now lands in scratch. */
+#define SWEET_IMPORT_PAD_PAGES 128u
+static uint64_t g_import_pa[SWEET_IMPORT_MAX_PAGES + SWEET_IMPORT_PAD_PAGES];
+static uint64_t g_import_scratch_pa;
 static int
 drm_do_ios_import(uint32_t surf_id, uint32_t *out_handle)
 {
@@ -4798,7 +4807,20 @@ drm_do_ios_import(uint32_t surf_id, uint32_t *out_handle)
 		printf("SWEET DRM: ios_import surf %u FAILED (pages)\n", surf_id);
 		return EINVAL;
 	}
-	if (gpu_gpumem_map_phys(g_import_pa, npages, &gpuaddr) != 0) {
+	if (g_import_scratch_pa == 0) {
+		vm_offset_t scva = 0;
+		uint64_t spa = 0;
+		if (gmub_alloc_phys(&scva, &spa, PAGE_SIZE) != 0 || spa == 0) {
+			sweet_surface_gpu_unref(surf);
+			printf("SWEET DRM: ios_import surf %u FAILED (no scratch page)\n", surf_id);
+			return ENOMEM;
+		}
+		g_import_scratch_pa = spa;
+	}
+	for (i = 0; i < SWEET_IMPORT_PAD_PAGES; i++) {
+		g_import_pa[npages + i] = g_import_scratch_pa;
+	}
+	if (gpu_gpumem_map_phys(g_import_pa, npages + SWEET_IMPORT_PAD_PAGES, &gpuaddr) != 0) {
 		sweet_surface_gpu_unref(surf);
 		printf("SWEET DRM: ios_import surf %u FAILED (map %u pages)\n", surf_id, npages);
 		return ENOMEM;
diff --git a/iokit/Kernel/arm/SweetFramebuffer.cpp b/iokit/Kernel/arm/SweetFramebuffer.cpp
index 5b0e15d..2b12526 100644
--- a/iokit/Kernel/arm/SweetFramebuffer.cpp
+++ b/iokit/Kernel/arm/SweetFramebuffer.cpp
@@ -400,9 +400,13 @@ sweet_publish_accelerator(IOService *provider)
 		 * application's own EAGLContext runs on RedwoodMetal (the processes metal_allow names).
 		 * Without them EAGLContext found no renderer at all and gave applications no context.
 		 */
-		accelerator->setProperty("IOGLESBundleName", "AppleMetalGLRenderer");
+		/* SweetGLES (/System/Library/Extensions/SweetGLES.bundle) is this port's OpenGL ES: loaded
+		 * by GLEngine in every process that makes a GL context, it hands the application's gl*
+		 * straight to Mesa (freedreno) and keeps GLEngine out of every call. Apple's GLES-on-Metal
+		 * stays named as the Metal renderer, chosen with the com.apple.opengles UseMetal default. */
+		accelerator->setProperty("IOGLESBundleName", "SweetGLES");
 		accelerator->setProperty("IOGLESMetalBundleName", "AppleMetalGLRenderer");
-		accelerator->setProperty("IOGLESDefaultUseMetal", kOSBooleanTrue);
+		accelerator->setProperty("IOGLESDefaultUseMetal", kOSBooleanFalse);
 		accelerator->registerService();
 		IOLog("SWEET FB: IOAcceleratorES published (sweetmetal=%u): MetalPluginName RedwoodMetal\n", metal);
 	}
