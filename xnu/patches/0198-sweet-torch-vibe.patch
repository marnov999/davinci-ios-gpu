diff --git a/bsd/dev/sweet_outputs.c b/bsd/dev/sweet_outputs.c
new file mode 100644
index 0000000..5542a77
--- /dev/null
+++ b/bsd/dev/sweet_outputs.c
@@ -0,0 +1,448 @@
+/*
+ * SWEET outputs: the flashlight and the vibration motor, both PMIC peripherals written over SPMI (by
+ * sweet_spmi_write_out(), which takes only the registers below and reads every write back). After HakiOS's
+ * drivers/camera/hakios.torch.c and drivers/haptic/hakios.haptic.c (oosexgang, MIT): the staging and the limits;
+ * the hardware is the Mi 9T's own, from its live DT and MIUI's drivers (msm-4.14):
+ *
+ *   flashlight  PM6150L (SID 5) flash LED module v2 at 0xd300 (qcom,qpnp-flash-v2, leds-qpnp-flash-v2.c), its two
+ *               torch nodes torch_0 / torch_1 (LED 1 and 2, the dual-tone flash): MIUI's torch current 300 mA
+ *               each (max 500), IRES 12.5 mA (idx 0), software strobe, safety timer off (0x13). On, as
+ *               qpnp_flash_led_switch_set() does it: IRES 0x47, STROBE_CTRL 0x49+id bit 2 clear, TGR_CURRENT
+ *               0x43+id = round(mA / 12.5) - 1, SAFETY_TMR 0x40+id, MOD_CTRL 0x46 bit 7, EN_LED_CTRL 0x4c
+ *               bits 0-1. Off in the reverse order (qpnp_flash_led_switch_disable()). Faults: LED_STATUS1 0x08
+ *               (short / open), LED_STATUS2 0x09 bit 4 (VPH droop) and bits 2:0 (over-temperature).
+ *   vibration   PM6150 (SID 1) vibrator LDO at 0x5300 (qcom,qpnp-vibrator-ldo, leds-qpnp-vibrator-ldo.c), an
+ *               ERM motor: MIUI's 3000 mV (qcom,vib-ldo-volt-uv), no overdrive (qcom,disable-overdrive).
+ *               On: VSET_LB/UB 0x40/0x41 = mV, EN_CTL 0x46 bit 7, then STATUS1 0x08 bit 7 (VREG_READY).
+ *
+ * Nothing is done unless a boot-arg asks for it:
+ *   sweettorch=1   a look, reads only: the module's type and registers, in the log
+ *   sweettorch=2   ... and both torch LEDs on at sweettorch_ma (100) for 2 s, then off; every write read back
+ *   sweettorch=3   ... no light at the start; /dev/sweet-torch until the end of the run: write a level 0..1000 as
+ *                  text (thousandths of MIUI's 300 mA, 0 off), read gives the level lit now
+ *   sweetvibe=1    a look, reads only
+ *   sweetvibe=2    ... and one 300 ms buzz
+ *   sweetvibe=3    ... /dev/sweet-vibe: write a duration in ms as text (0 stops, at most 5000), read gives ms left
+ *
+ * Limits, whatever asks: never above MIUI's currents and voltage; the torch on for sweettorch_max_s (30, at most 120)
+ * at a time, then off until asked anew; while lit, every 100 ms, the module's fault flags and the SoC's temperature
+ * (sweet_thermal.c: 80 C): either, or a write that does not read back, and the torch goes off for the rest of the
+ * run. The motor runs 5 s at most at a stretch and then rests 1 s; a write that does not read back ends it too.
+ */
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/conf.h>
+#include <sys/errno.h>
+#include <sys/uio.h>
+#include <miscfs/devfs/devfs.h>
+#include <kern/clock.h>
+#include <kern/locks.h>
+#include <kern/thread.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+#include "sweet_spmi.h"
+
+extern void sweet_outputs_init(void);
+extern int sweet_thermal_max_mc(void);
+
+#define FL_SID                  5u
+#define FL_BASE                 0xd300u
+#define FL_STATUS1              0x08u
+#define FL_STATUS2              0x09u
+#define FL_SAFETY_TMR(id)       (0x40u + (id))
+#define FL_TGR_CURRENT(id)      (0x43u + (id))
+#define FL_MOD_CTRL             0x46u
+#define FL_IRES                 0x47u
+#define FL_STROBE_CTRL(id)      (0x49u + (id))
+#define FL_EN_LED_CTRL          0x4cu
+#define FL_SAFETY_TMR_OFF       0x13u
+#define FL_TORCH_MA             300u            /* MIUI's torch_0 / torch_1 qcom,current-ma */
+#define FL_IRES_UA              12500u
+
+#define VIB_SID                 1u
+#define VIB_BASE                0x5300u
+#define VIB_STATUS1             0x08u
+#define VIB_VSET_LB             0x40u
+#define VIB_VSET_UB             0x41u
+#define VIB_EN_CTL              0x46u
+#define VIB_MV                  3000u           /* qcom,vib-ldo-volt-uv */
+#define VIB_MAX_MS              5000u
+#define VIB_REST_MS             1000u
+
+static uint32_t torch_mode, vibe_mode, torch_test_ma = 100, torch_max_s = 30;
+static LCK_GRP_DECLARE(out_lck_grp, "sweet-outputs");
+static LCK_MTX_DECLARE(out_lock, &out_lck_grp);
+static int out_chan;
+
+/* asked for (under out_lock) */
+static uint32_t torch_want;                     /* 0..1000 */
+static uint32_t torch_generation, vibe_generation;
+static uint32_t vibe_want_ms;
+/* what is (the worker's) */
+static uint32_t torch_lit;
+static uint64_t torch_lit_since, vibe_until, vibe_since, vibe_rest_until;
+static bool torch_broken, vibe_broken, vibe_on;
+
+static uint64_t
+now_ms(void)
+{
+	uint64_t ns;
+	absolutetime_to_nanoseconds(mach_absolute_time(), &ns);
+	return ns / NSEC_PER_MSEC;
+}
+
+static bool
+rd(unsigned sid, unsigned addr, uint8_t *value)
+{
+	return sweet_spmi_read(sid, addr, value) == 0;
+}
+
+static bool
+wr(unsigned sid, unsigned addr, uint8_t value)
+{
+	int rc = sweet_spmi_write_out(sid, addr, value);
+	if (rc != 0) {
+		printf("SWEET OUT: SID %u %#x <- %#x failed (%d)\n", sid, addr, value, rc);
+	}
+	return rc == 0;
+}
+
+static void
+look(const char *what, unsigned sid, unsigned base, const uint8_t *regs, unsigned n)
+{
+	char line[256];
+	size_t len = 0;
+	line[0] = 0;
+	for (unsigned i = 0; i < n && len + 12 < sizeof(line); i++) {
+		uint8_t v = 0;
+		bool ok = rd(sid, base + regs[i], &v);
+		len += (size_t)snprintf(line + len, sizeof(line) - len, " %02x=%s%02x", regs[i], ok ? "" : "?", v);
+	}
+	printf("SWEET OUT: %s (SID %u %#x):%s\n", what, sid, base, line);
+}
+
+/* ---------------- the flashlight ---------------- */
+
+static bool
+torch_set(uint32_t level)
+{
+	uint8_t v = 0;
+	bool ok = true;
+
+	if (level == 0) {
+		ok = rd(FL_SID, FL_BASE + FL_EN_LED_CTRL, &v) && wr(FL_SID, FL_BASE + FL_EN_LED_CTRL, v & ~0x03u);
+		ok = rd(FL_SID, FL_BASE + FL_MOD_CTRL, &v) && wr(FL_SID, FL_BASE + FL_MOD_CTRL, v & ~0x80u) && ok;
+		for (unsigned id = 0; id < 2; id++) {
+			ok = wr(FL_SID, FL_BASE + FL_TGR_CURRENT(id), 0) && ok;
+		}
+		torch_lit = 0;
+		return ok;
+	}
+	uint32_t ma = FL_TORCH_MA * MIN(level, 1000u) / 1000u;
+	ma = MAX(ma, FL_IRES_UA / 1000u + 1u);
+	uint8_t code = (uint8_t)((ma * 1000u + FL_IRES_UA / 2u) / FL_IRES_UA - 1u);
+	if (torch_lit == 0) {
+		ok = rd(FL_SID, FL_BASE + FL_IRES, &v) && wr(FL_SID, FL_BASE + FL_IRES, v & ~0x0fu);   /* LED 1, 2: 12.5 mA */
+		for (unsigned id = 0; ok && id < 2; id++) {
+			ok = rd(FL_SID, FL_BASE + FL_STROBE_CTRL(id), &v) && wr(FL_SID, FL_BASE + FL_STROBE_CTRL(id), v & ~0x04u) &&
+			    wr(FL_SID, FL_BASE + FL_TGR_CURRENT(id), code) &&
+			    wr(FL_SID, FL_BASE + FL_SAFETY_TMR(id), FL_SAFETY_TMR_OFF);
+		}
+		ok = ok && rd(FL_SID, FL_BASE + FL_MOD_CTRL, &v) && wr(FL_SID, FL_BASE + FL_MOD_CTRL, v | 0x80u);
+		ok = ok && rd(FL_SID, FL_BASE + FL_EN_LED_CTRL, &v) && wr(FL_SID, FL_BASE + FL_EN_LED_CTRL, v | 0x03u);
+		torch_lit_since = now_ms();
+	} else {
+		for (unsigned id = 0; ok && id < 2; id++) {
+			ok = wr(FL_SID, FL_BASE + FL_TGR_CURRENT(id), code);
+		}
+	}
+	torch_lit = level;
+	if (ok) {
+		printf("SWEET OUT: torch %u/1000 = %u mA a LED (code %#x)\n", level, ma, code);
+	}
+	return ok;
+}
+
+static void
+torch_give_up(const char *why)
+{
+	printf("SWEET OUT: torch: %s: off, and no more torch in this boot\n", why);
+	torch_broken = true;
+	(void)torch_set(0);
+}
+
+/* while lit: the module's faults, the SoC's temperature, the time limit */
+static void
+torch_watch(uint64_t now)
+{
+	uint8_t s1 = 0, s2 = 0;
+	int mc = sweet_thermal_max_mc();
+
+	if (now - torch_lit_since < 200) {
+		return;
+	}
+	if (!rd(FL_SID, FL_BASE + FL_STATUS1, &s1) || !rd(FL_SID, FL_BASE + FL_STATUS2, &s2)) {
+		torch_give_up("status unreadable");
+	} else if (s1 != 0 || (s2 & 0x17u) != 0) {
+		printf("SWEET OUT: torch: LED_STATUS1 %#x LED_STATUS2 %#x\n", s1, s2);
+		torch_give_up(s1 ? "short / open circuit" : (s2 & 0x10u) ? "VPH droop" : "over-temperature");
+	} else if (mc >= 80000) {
+		torch_give_up("SoC at 80 C");
+	} else if (now - torch_lit_since >= (uint64_t)torch_max_s * 1000u) {
+		printf("SWEET OUT: torch on for sweettorch_max_s=%u: off until asked anew\n", torch_max_s);
+		(void)torch_set(0);
+		lck_mtx_lock(&out_lock);
+		torch_want = 0;
+		lck_mtx_unlock(&out_lock);
+	}
+}
+
+/* ---------------- the motor ---------------- */
+
+static bool
+vibe_set(bool on)
+{
+	uint8_t v = 0;
+	bool ok;
+
+	if (!on) {
+		ok = rd(VIB_SID, VIB_BASE + VIB_EN_CTL, &v) && wr(VIB_SID, VIB_BASE + VIB_EN_CTL, v & ~0x80u);
+		vibe_on = false;
+		return ok;
+	}
+	ok = wr(VIB_SID, VIB_BASE + VIB_VSET_LB, VIB_MV & 0xffu) && wr(VIB_SID, VIB_BASE + VIB_VSET_UB, VIB_MV >> 8) &&
+	    rd(VIB_SID, VIB_BASE + VIB_EN_CTL, &v) && wr(VIB_SID, VIB_BASE + VIB_EN_CTL, v | 0x80u);
+	vibe_on = true;
+	if (ok) {
+		for (unsigned i = 0; i < 20 && rd(VIB_SID, VIB_BASE + VIB_STATUS1, &v) && !(v & 0x80u); i++) {
+			delay(500);
+		}
+		if (!(v & 0x80u)) {
+			printf("SWEET OUT: vibe: VREG_READY not set (STATUS1 %#x)\n", v);
+		}
+	}
+	return ok;
+}
+
+static void
+vibe_give_up(const char *why)
+{
+	printf("SWEET OUT: vibe: %s: off, and no more vibration in this boot\n", why);
+	vibe_broken = true;
+	(void)vibe_set(false);
+}
+
+/* ---------------- the worker ---------------- */
+
+static void
+outputs_thread(__unused void *arg, __unused wait_result_t wr_result)
+{
+	static const uint8_t fl_regs[] = { 0x04, 0x05, 0x08, 0x09, 0x10, 0x40, 0x41, 0x43, 0x44, 0x46, 0x47, 0x49, 0x4a,
+		                           0x4c, 0x4d, 0x4e, 0x50, 0x51, 0x52 };
+	static const uint8_t vib_regs[] = { 0x04, 0x05, 0x08, 0x40, 0x41, 0x46 };
+	uint32_t torch_seen = 0, vibe_seen = 0;
+
+	if (sweet_spmi_init() != 0) {
+		printf("SWEET OUT: no SPMI: off\n");
+		return;
+	}
+	if (torch_mode) {
+		look("flash LED module", FL_SID, FL_BASE, fl_regs, sizeof(fl_regs));
+	}
+	if (vibe_mode) {
+		look("vibrator LDO", VIB_SID, VIB_BASE, vib_regs, sizeof(vib_regs));
+	}
+	if (torch_mode == 2) {
+		if (!torch_set(torch_test_ma * 1000u / FL_TORCH_MA)) {
+			torch_give_up("a write did not read back");
+		} else {
+			delay(200000);
+			look("flash LED module, lit", FL_SID, FL_BASE, fl_regs, sizeof(fl_regs));
+			delay(1800000);
+			if (!torch_set(0)) {
+				torch_give_up("a write did not read back");
+			}
+			printf("SWEET OUT: torch test done\n");
+		}
+	}
+	if (vibe_mode == 2) {
+		bool ok = vibe_set(true);
+		delay(300000);
+		if (!vibe_set(false) || !ok) {
+			vibe_give_up("a write did not read back");
+		}
+		printf("SWEET OUT: vibe test done\n");
+	}
+	if (torch_mode < 3 && vibe_mode < 3) {
+		return;
+	}
+	for (;;) {
+		uint32_t want_torch, want_vibe_ms, tg, vg;
+		uint64_t now;
+
+		lck_mtx_lock(&out_lock);
+		want_torch = torch_want;
+		want_vibe_ms = vibe_want_ms;
+		tg = torch_generation;
+		vg = vibe_generation;
+		lck_mtx_unlock(&out_lock);
+		now = now_ms();
+
+		if (torch_mode == 3 && !torch_broken) {
+			if (tg != torch_seen || (want_torch == 0 && torch_lit != 0)) {
+				torch_seen = tg;
+				if (want_torch != torch_lit && !torch_set(want_torch)) {
+					torch_give_up("a write did not read back");
+				}
+			}
+			if (torch_lit != 0) {
+				torch_watch(now);
+			}
+		}
+		if (vibe_mode == 3 && !vibe_broken) {
+			if (vg != vibe_seen) {
+				vibe_seen = vg;
+				vibe_until = want_vibe_ms ? now + MIN(want_vibe_ms, VIB_MAX_MS) : 0;
+			}
+			bool run = vibe_until > now && now >= vibe_rest_until;
+			if (run && vibe_on && now - vibe_since >= VIB_MAX_MS) {
+				vibe_rest_until = now + VIB_REST_MS;           /* 5 s at a stretch: a rest */
+				run = false;
+			}
+			if (run != vibe_on) {
+				if (run) {
+					vibe_since = now;
+				}
+				if (!vibe_set(run)) {
+					vibe_give_up("a write did not read back");
+				}
+			}
+		}
+
+		lck_mtx_lock(&out_lock);
+		if (tg == torch_generation && vg == vibe_generation) {
+			bool active = torch_lit != 0 || vibe_on || vibe_until > now;
+			struct timespec ts = { 0, 100 * NSEC_PER_MSEC };
+			(void)msleep(&out_chan, &out_lock, PZERO, "sweetout", active ? &ts : NULL);
+		}
+		lck_mtx_unlock(&out_lock);
+	}
+}
+
+/* ---------------- /dev/sweet-torch (minor 0), /dev/sweet-vibe (minor 1) ---------------- */
+
+static int
+out_open(dev_t dev, __unused int flags, __unused int devtype, __unused struct proc *p)
+{
+	return minor(dev) == 0 ? (torch_mode == 3 ? 0 : ENXIO) : minor(dev) == 1 ? (vibe_mode == 3 ? 0 : ENXIO) : ENXIO;
+}
+
+static int
+out_close(__unused dev_t dev, __unused int flags, __unused int devtype, __unused struct proc *p)
+{
+	return 0;
+}
+
+static int
+out_read(dev_t dev, struct uio *uio, __unused int ioflag)
+{
+	char text[16];
+	uint32_t value;
+	if (uio_offset(uio) != 0) {
+		return 0;
+	}
+	if (minor(dev) == 0) {
+		value = torch_broken ? 0 : torch_lit;
+	} else {
+		uint64_t now = now_ms();
+		value = vibe_until > now ? (uint32_t)(vibe_until - now) : 0;
+	}
+	int n = snprintf(text, sizeof(text), "%u\n", value);
+	return uiomove(text, n, uio);
+}
+
+static int
+out_write(dev_t dev, struct uio *uio, __unused int ioflag)
+{
+	char text[16];
+	uint32_t value = 0;
+	user_ssize_t n = MIN(uio_resid(uio), (user_ssize_t)sizeof(text) - 1);
+	int error = uiomove(text, (int)n, uio);
+	if (error) {
+		return error;
+	}
+	text[n] = 0;
+	for (char *c = text; *c >= '0' && *c <= '9'; c++) {
+		value = value * 10u + (uint32_t)(*c - '0');
+		if (value > 1000000u) {
+			return EINVAL;
+		}
+	}
+	lck_mtx_lock(&out_lock);
+	if (minor(dev) == 0) {
+		torch_want = MIN(value, 1000u);
+		torch_generation++;
+	} else {
+		vibe_want_ms = value;
+		vibe_generation++;
+	}
+	wakeup(&out_chan);
+	lck_mtx_unlock(&out_lock);
+	return 0;
+}
+
+static const struct cdevsw out_cdevsw = {
+	.d_open       = out_open,
+	.d_close      = out_close,
+	.d_read       = out_read,
+	.d_write      = out_write,
+	.d_ioctl      = eno_ioctl,
+	.d_stop       = eno_stop,
+	.d_reset      = eno_reset,
+	.d_ttys       = NULL,
+	.d_select     = eno_select,
+	.d_mmap       = eno_mmap,
+	.d_strategy   = eno_strat,
+	.d_reserved_1 = eno_getc,
+	.d_reserved_2 = eno_putc,
+	.d_type       = 0,
+};
+
+void
+sweet_outputs_init(void)
+{
+	thread_t thread;
+	uint32_t v;
+
+	(void)PE_parse_boot_argn("sweettorch", &torch_mode, sizeof(torch_mode));
+	(void)PE_parse_boot_argn("sweetvibe", &vibe_mode, sizeof(vibe_mode));
+	torch_mode = MIN(torch_mode, 3u);
+	vibe_mode = MIN(vibe_mode, 3u);
+	if (torch_mode == 0 && vibe_mode == 0) {
+		return;
+	}
+	if (PE_parse_boot_argn("sweettorch_ma", &v, sizeof(v)) && v >= 13 && v <= FL_TORCH_MA) {
+		torch_test_ma = v;
+	}
+	if (PE_parse_boot_argn("sweettorch_max_s", &v, sizeof(v)) && v >= 1 && v <= 120) {
+		torch_max_s = v;
+	}
+	if (torch_mode == 3 || vibe_mode == 3) {
+		int major = cdevsw_add(-1, &out_cdevsw);
+		if (major < 0) {
+			printf("SWEET OUT: no character device major\n");
+		} else {
+			if (torch_mode == 3) {
+				devfs_make_node(makedev(major, 0), DEVFS_CHAR, UID_ROOT, GID_WHEEL, 0666, "sweet-torch");
+			}
+			if (vibe_mode == 3) {
+				devfs_make_node(makedev(major, 1), DEVFS_CHAR, UID_ROOT, GID_WHEEL, 0666, "sweet-vibe");
+			}
+		}
+	}
+	printf("SWEET OUT: torch level %u (test %u mA, at most %u s), vibe level %u\n", torch_mode, torch_test_ma,
+	    torch_max_s, vibe_mode);
+	if (kernel_thread_start(outputs_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}
