+static void
+gpu_probe(void)
+{
+	gpu_gcc = ml_io_map(GPU_GCC_PA, GPU_GCC_SIZE);
+	if (!gpu_gcc) {
+		printf("SWEET GPU: GCC map failed\n");
+		return;
+	}
+	/* GCC is always-on; these reads are safe and show the GPU clock state. */
+	printf("SWEET GPU: GCC gpu clk status (pre): ahb=%#x memnoc=%#x snoc=%#x axi=%#x\n",
+	    gpu_rd(gpu_gcc, GCC_GPU_CFG_AHB_CLK), gpu_rd(gpu_gcc, GCC_GPU_MEMNOC_GFX_CLK),
+	    gpu_rd(gpu_gcc, GCC_GPU_SNOC_DVM_CLK), gpu_rd(gpu_gcc, GCC_DDRSS_GPU_AXI_CLK));
+	/* Enable the GPU config/AHB + NoC branches so the GPUCC window is clocked.
+	 * BIT(0) turns a branch on; we never clear bits (never disable a live clock). */
+	gpu_wr(gpu_gcc, GCC_GPU_CFG_AHB_CLK,
+	    gpu_rd(gpu_gcc, GCC_GPU_CFG_AHB_CLK) | GCC_BRANCH_ENABLE);
+	gpu_wr(gpu_gcc, GCC_DDRSS_GPU_AXI_CLK,
+	    gpu_rd(gpu_gcc, GCC_DDRSS_GPU_AXI_CLK) | GCC_BRANCH_ENABLE);
+	gpu_wr(gpu_gcc, GCC_GPU_MEMNOC_GFX_CLK,
+	    gpu_rd(gpu_gcc, GCC_GPU_MEMNOC_GFX_CLK) | GCC_BRANCH_ENABLE);
+	gpu_wr(gpu_gcc, GCC_GPU_SNOC_DVM_CLK,
+	    gpu_rd(gpu_gcc, GCC_GPU_SNOC_DVM_CLK) | GCC_BRANCH_ENABLE);
+	delay_for_interval(200, NSEC_PER_USEC); /* ~200us for branches to settle */
+	printf("SWEET GPU: GCC gpu clk status (post): ahb=%#x memnoc=%#x snoc=%#x axi=%#x\n",
+	    gpu_rd(gpu_gcc, GCC_GPU_CFG_AHB_CLK), gpu_rd(gpu_gcc, GCC_GPU_MEMNOC_GFX_CLK),
+	    gpu_rd(gpu_gcc, GCC_GPU_SNOC_DVM_CLK), gpu_rd(gpu_gcc, GCC_DDRSS_GPU_AXI_CLK));
+
+	/* Now GPUCC should be reachable. This read is the Phase-0 make-or-break. */
+	gpu_gpucc = ml_io_map(GPU_GPUCC_PA, GPU_GPUCC_SIZE);
+	if (!gpu_gpucc) {
+		printf("SWEET GPU: GPUCC map failed\n");
+		return;
+	}
+	uint32_t cc = gpu_rd(gpu_gpucc, 0);
+	printf("SWEET GPU: davinci a618 (DT chipid %#x); gpucc[0]=%#x\n", GPU_DT_CHIPID, cc);
+	if (cc == 0xffffffffu) {
+		printf("SWEET GPU: GPUCC reads 0xffffffff - still gated (need GPU CX GDSC vote).\n");
+	} else {
+		printf("SWEET GPU: Phase 0 OK - GPUCC reachable after enabling GCC gpu clocks.\n");
+	}
+	/* Map the GPU power/clock state (all reads inside the reachable GPUCC
+	 * window). GDSCR bit31 = PWR_ON. Tells us what is already powered before we
+	 * attempt the GMU boot. Offsets from gpucc-sdmmagpie.c / a6xx_regs.h. */
+	uint32_t gx = gpu_rd(gpu_gpucc, GPUCC_GX_GDSCR);
+	uint32_t cx = gpu_rd(gpu_gpucc, GPUCC_CX_GDSCR);
+	uint32_t gmuclk = gpu_rd(gpu_gpucc, GPUCC_CX_GMU_CLK);
+	uint32_t cxoclk = gpu_rd(gpu_gpucc, GPUCC_CXO_CLK);
+	printf("SWEET GPU: GPUCC gx_gdsc=%#x(pwr_on=%d) cx_gdsc=%#x(pwr_on=%d) cx_gmu_clk=%#x cxo_clk=%#x\n",
+	    gx, (gx >> 31) & 1u, cx, (cx >> 31) & 1u, gmuclk, cxoclk);
+
+	if (gpu_level >= 2) {
+		gpu_tz_probe();
+	}
+	if (gpu_level >= 4) {
+		gpu_gmu_step1();
+	}
+	if (gpu_level >= 5) {
+		gpu_gmu_step2();
+	}
+	if (gpu_level >= 6) {
+		(void)gpu_gmu_boot();
+	}
+	/* Register the /dev/kgsl-3d0 UAPI node (+ in-kernel devinfo self-test) so
+	 * userland freedreno can bind once the root carries a client. */
+	gpu_kgsl_init();
+	/* Register the MSM-DRM render node (/dev/dri/renderD128) for the gallium-
+	 * freedreno GLES path, over the same proven ring/iova/submit core. */
+	gpu_drm_init();
+}
+
+/* Block (not busy-wait) for `secs` so the probe prints after USB + the host
+ * capture are up; the early-boot prints were scrolling past otherwise. */
+static void
+gpu_sleep(uint32_t secs)
+{
+	uint64_t deadline;
+	clock_interval_to_deadline(secs, NSEC_PER_SEC, &deadline);
+	assert_wait_deadline(&gpu_started, THREAD_UNINT, deadline);
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+/* ---- SPMI PMIC-arbiter WRITE: set PON_SOFT_RB_SPARE = BOOTLOADER reason ----
+ * davinci's UEFI ABL reads the reboot target from the PMIC PON register (it
+ * persists across SoC reset), NOT the IMEM cookie (IMEM/PS_HOLD both went to
+ * MIUI). Mirror the proven observer-READ path (sweet_spmi.c) with an EXT_WRITEL
+ * on the chnls region. SPMI v5 regions (davinci DTB): core 0xc440000,
+ * chnls 0xc600000, obsrvr 0xe600000, cnfg 0xc40a000. Per-APID stride 0x80;
+ * CMD@+0 STATUS@+8 WDATA0@+0x10 RDATA0@+0x18. cmd=(opc<<27)|((addr&0xff)<<4);
+ * EXT_READL opc=1 (proven in the read path), EXT_WRITEL opc=0. Target =
+ * PON periph 0x08 reg SOFT_RB_SPARE 0x8f; BOOTLOADER reason 0x02 -> bits[7:1]. */
+#define SPMI_CORE_PA      0x0c440000u
+#define SPMI_CHNLS_PA     0x0c600000u
+#define SPMI_OBS_PA       0x0e600000u
+#define SPMI_CFG_PA       0x0c40a000u
+#define PON_PERIPH        0x08u
+#define PON_SOFT_RB_SPARE 0x8fu
+#define PON_REASON_BL     0x02u
+
+/* Read SOFT_RB_SPARE (periph 0x08 reg 0x8f) via the observer channel (direct
+ * reads work). Returns byte in *out; apid in *apid_out. -1 on failure. */
+static int
+spmi_pon_read(vm_offset_t core, vm_offset_t cfg, vm_offset_t obs,
+    unsigned count, unsigned *apid_out, uint8_t *out)
+{
+	unsigned i, apid = 0xffffu, ppid = (0u << 8) | PON_PERIPH;
+	for (i = 0; i < count; ++i) {               /* find APID; prefer owner EE 0 */
+		uint32_t map = *(volatile uint32_t *)(core + 0x900u + 4u * i);
+		if (!map || ((map >> 8) & 0xfffu) != ppid) {
+			continue;
+		}
+		if (apid == 0xffffu ||
+		    ((*(volatile uint32_t *)(cfg + 0x700u + 4u * i)) & 7u) == 0u) {
+			apid = i;
+		}
+	}
+	if (apid == 0xffffu) {
+		return -1;
+	}
+	*apid_out = apid;
+	unsigned off = 0x80u * apid;
+	*(volatile uint32_t *)(obs + off) = (1u << 27) | ((PON_SOFT_RB_SPARE & 0xffu) << 4);
+	__asm__ volatile("dsb osh" ::: "memory");
+	for (i = 0; i < 1000u; ++i) {
+		uint32_t st = *(volatile uint32_t *)(obs + off + 0x08u);
+		if (st & 1u) {
+			if (st & 0x0eu) {
+				return -1;
+			}
+			*out = (uint8_t)*(volatile uint32_t *)(obs + off + 0x18u);
+			return 0;
+		}
+		gmub_udelay(1);
+	}
+	return -1;
+}
+
+/* One byte of a PMIC register by the observer (EE 0) channel, as spmi_pon_read: reads only. */
+static vm_offset_t g_spmi_core, g_spmi_cfg, g_spmi_obs;
+static unsigned g_spmi_count;
+static int
+spmi_rd8(unsigned sid, unsigned addr, uint8_t *out)
+{
+	unsigned i, apid = 0xffffu, ppid = (sid << 8) | (addr >> 8);
+	if (!g_spmi_core) {
+		g_spmi_core = ml_io_map(SPMI_CORE_PA, 0x2000u);
+		g_spmi_cfg = ml_io_map(SPMI_CFG_PA, 0x1000u);
+		g_spmi_obs = ml_io_map(SPMI_OBS_PA, 0x10000u);
+		if (!g_spmi_core || !g_spmi_cfg || !g_spmi_obs) {
+			g_spmi_core = 0;
+			return -1;
+		}
+		g_spmi_count = (*(volatile uint32_t *)(g_spmi_core + 4)) & 0x7ffu;
+	}
+	for (i = 0; i < g_spmi_count && i < 512u; ++i) {
+		uint32_t map = *(volatile uint32_t *)(g_spmi_core + 0x900u + 4u * i);
+		if (!map || ((map >> 8) & 0xfffu) != ppid) {
+			continue;
+		}
+		if (apid == 0xffffu || ((*(volatile uint32_t *)(g_spmi_cfg + 0x700u + 4u * i)) & 7u) == 0u) {
+			apid = i;
+		}
+	}
+	if (apid == 0xffffu) {
+		return -2;
+	}
+	*(volatile uint32_t *)(g_spmi_obs + 0x80u * apid) = (1u << 27) | ((addr & 0xffu) << 4);
+	__asm__ volatile("dsb osh" ::: "memory");
+	for (i = 0; i < 1000u; ++i) {
+		uint32_t st = *(volatile uint32_t *)(g_spmi_obs + 0x80u * apid + 0x08u);
+		if (st & 1u) {
+			if (st & 0x0eu) {
+				return -3;
+			}
+			*out = (uint8_t)*(volatile uint32_t *)(g_spmi_obs + 0x80u * apid + 0x18u);
+			return 0;
+		}
+		gmub_udelay(1);
+	}
+	return -4;
+}
+
+/*
+ * What SweetBattery reads (patch 0062: PM6150 QG 0x48xx, charger 0x10xx/0x11xx, USB 0x13xx), raw,
+ * to see why it falls back to its static 100%: reads only.
+ */
+static void
+battery_report(void)
+{
+	static const uint16_t regs[] = { 0x4804, 0x4805, 0x4808, 0x48c0, 0x48c1, 0x48c2, 0x48c3, 0x1310, 0x110b,
+		0x1006, 0x1007, 0x100d, 0x1004, 0x1104, 0x1304 };
+	static bool listed;
+	char line[300];
+	int at = 0;
+	unsigned i;
+	for (i = 0; i < sizeof(regs) / sizeof(regs[0]); i++) {
+		uint8_t v = 0;
+		int e = spmi_rd8(0, regs[i], &v);
+		at += snprintf(line + at, sizeof(line) - (size_t)at, e ? " %04x:e%d" : " %04x:%02x", regs[i], e ? -e : v);
+	}
+	printf("SWEET BATT RAW:%s\n", line);
+	if (!listed && g_spmi_core) {
+		listed = true;
+		for (unsigned sid = 0; sid <= 2u; sid += 2u) {
+			at = 0;
+			for (i = 0; i < g_spmi_count && i < 512u && at < (int)sizeof(line) - 6; i++) {
+				uint32_t map = *(volatile uint32_t *)(g_spmi_core + 0x900u + 4u * i);
+				if (map && ((map >> 16) & 0xfu) == sid) {
+					at += snprintf(line + at, sizeof(line) - (size_t)at, " %02x", (map >> 8) & 0xffu);
+				}
+			}
+			printf("SWEET BATT SID%u peripherals:%s\n", sid, line);
+		}
+	}
+}
+
+static int
+spmi_set_pon_bootloader(void)
+{
+	vm_offset_t core = ml_io_map(SPMI_CORE_PA, 0x2000u);
+	vm_offset_t cfg  = ml_io_map(SPMI_CFG_PA, 0x1000u);
+	vm_offset_t obs  = ml_io_map(SPMI_OBS_PA, 0x10000u);
+	unsigned count, apid = 0xffffu;
+	uint32_t ver;
+	uint8_t old = 0, val, rb = 0xff;
+	uint64_t r[4];
+
+	if (!core || !cfg || !obs) {
+		printf("SWEET GPU: SPMI map failed\n");
+		return -1;
+	}
+	ver = *(volatile uint32_t *)core;
+	count = (*(volatile uint32_t *)(core + 4)) & 0x7ffu;
+	if (ver < 0x50000000u || ver >= 0x70000000u || !count || count > 512) {
+		printf("SWEET GPU: SPMI arb=%#x count=%u unsupported\n", ver, count);
+		return -1;
+	}
+	if (spmi_pon_read(core, cfg, obs, count, &apid, &old) != 0) {
+		printf("SWEET GPU: SPMI PON read failed (no APID / read err)\n");
+		return -1;
+	}
+	val = (uint8_t)((old & 0x01u) | (PON_REASON_BL << 1));  /* 0x04 in bits[7:1] */
+	/* WRITE via TZ SCM_IO_WRITE: EL3 stores to the XPU-blocked chnls region.
+	 * WDATA0 (chnls+off+0x10) = byte, then CMD (chnls+off) = EXT_WRITEL(opc0). */
+	unsigned off = 0x80u * apid;
+	gpu_smc(QCOM_SCM_IO_WRITE_FNID, 2, (uint64_t)SPMI_CHNLS_PA + off + 0x10u, val,
+	    0, 0, 0, r);
+	uint64_t w1 = r[0];
+	gpu_smc(QCOM_SCM_IO_WRITE_FNID, 2, (uint64_t)SPMI_CHNLS_PA + off,
+	    (0u << 27) | ((PON_SOFT_RB_SPARE & 0xffu) << 4), 0, 0, 0, r);
+	uint64_t w2 = r[0];
+	gmub_udelay(50);
+	(void)spmi_pon_read(core, cfg, obs, count, &apid, &rb);  /* confirm */
+	printf("SWEET GPU: PON via SCM apid=%u old=%#x new=%#x readback=%#x scm=%lld,%lld\n",
+	    apid, old, val, rb, (long long)w1, (long long)w2);
+	return (rb == val) ? 0 : -1;
+}
+
+/* Reboot to fastboot via the PMIC PON reason, then reset. Does not return on
+ * success. Lets the host drive the GPU dev loop hands-free. */
+static void
+gpu_reboot_fastboot(void)
+{
+	(void)spmi_set_pon_bootloader();   /* PON reason persists across the reset */
+	gmub_flush();                      /* flush the USB log before resetting */
+	uint64_t r[4];
+	gpu_smc(PSCI_SYSTEM_RESET, 0, 0, 0, 0, 0, 0, r);
+	vm_offset_t ph = ml_io_map(PSHOLD_PA, 0x1000u);   /* fallback if PSCI returns */
+	if (ph) {
+		*(volatile uint32_t *)ph = 0u;
+		__asm__ volatile("dsb sy" ::: "memory");
+	}
+	for (;;) {
+		__asm__ volatile("wfe");
+	}
+}
+
+/*
+ * The reboot reason, written as Linux writes it (what TWRP's "reboot bootloader" does: qcom-pon's
+ * reboot-mode sets PON SOFT_RB_SPARE bits[7:1] = 2 over SPMI, then the reset; ABL reads it back).
+ * Linux spmi-pmic-arb v5: an APID's read/write channel is at chnls + 0x10000 * apid -- the
+ * observer channel, which the reads use, is at obsrvr + 0x10000 * ee + 0x80 * apid. The write
+ * tried before used the observer's 0x80 stride on the write region, i.e. another channel than
+ * ours, which the XPU refused; and then it went through TrustZone, which refused it as well.
+ */
+static int
+spmi_pon_write_direct(unsigned apid, uint8_t val)
+{
+	vm_offset_t ch = ml_io_map(SPMI_CHNLS_PA + 0x10000u * apid, 0x1000u);
+	unsigned i;
+	if (!ch) {
+		return -1;
+	}
+	*(volatile uint32_t *)(ch + 0x10u) = val;                                   /* WDATA0 */
+	__asm__ volatile("dsb osh" ::: "memory");
+	*(volatile uint32_t *)(ch + 0x00u) = (0u << 27) | ((PON_SOFT_RB_SPARE & 0xffu) << 4) | 0u;   /* EXT_WRITEL, 1 byte */
+	__asm__ volatile("dsb osh" ::: "memory");
+	for (i = 0; i < 1000u; ++i) {
+		uint32_t st = *(volatile uint32_t *)(ch + 0x08u);                      /* STATUS */
+		if (st & 1u) {
+			return (st & 0x0eu) ? -2 : 0;
+		}
+		gmub_udelay(1);
+	}
+	return -3;
+}
+
+static int
+sweet_reboot_fastboot(uint32_t mode)
+{
+	vm_offset_t core = ml_io_map(SPMI_CORE_PA, 0x2000u);
+	vm_offset_t cfg  = ml_io_map(SPMI_CFG_PA, 0x1000u);
+	vm_offset_t obs  = ml_io_map(SPMI_OBS_PA, 0x10000u);
+	unsigned count, apid = 0xffffu, owner;
+	uint8_t old = 0, val, rb = 0xff;
+	int rc;
+
+	if (!core || !cfg || !obs) {
+		printf("SWEET REBOOT: SPMI map failed\n");
+		return -1;
+	}
+	count = (*(volatile uint32_t *)(core + 4)) & 0x7ffu;
+	if (!count || count > 512 || spmi_pon_read(core, cfg, obs, count, &apid, &old) != 0) {
+		printf("SWEET REBOOT: PON not found / not readable (count %u)\n", count);
+		return -1;
+	}
+	owner = (*(volatile uint32_t *)(cfg + 0x700u + 4u * apid)) & 7u;
+	val = (uint8_t)((old & 0x01u) | (PON_REASON_BL << 1));
+	rc = spmi_pon_write_direct(apid, val);
+	gmub_udelay(50);
+	(void)spmi_pon_read(core, cfg, obs, count, &apid, &rb);
+	printf("SWEET REBOOT: PON apid %u (owner ee %u) SOFT_RB_SPARE %#x -> %#x: write %d, reads back %#x%s\n",
+	    apid, owner, old, val, rc, rb, rb == val ? " (SET: a reset now goes to fastboot)" : " (NOT set)");
+	{       /* and the IMEM cookie the downstream kernel also leaves (harmless if ABL ignores it) */
+		vm_offset_t imem = ml_io_map(IMEM_PA, IMEM_SIZE);
+		if (imem) {
+			*(volatile uint32_t *)(imem + IMEM_RESTART_REASON_OFF) = RESTART_REASON_FASTBOOT;
+			__asm__ volatile("dsb sy" ::: "memory");
+		}
+	}
+	if (mode == 0) {
+		return rb == val ? 0 : -1;
+	}
+	printf("SWEET REBOOT: resetting\n");
+	gpu_sleep(1);                      /* the line out over the network first */
+	{
+		uint64_t r[4];
+		gpu_smc(PSCI_SYSTEM_RESET, 0, 0, 0, 0, 0, 0, r);
+	}
+	return -1;
+}
+
+/*
+ * The GPU's clock, as Linux's a6xx_gmu_set_freq() sets it on a legacy GMU (the a618; davinci's own
+ * kernel has qcom,gpu-quirk-hfi-use-reg, the same register path): the perf level into
+ * GMU_DCVS_PERF_SETTING, "any bandwidth" into GMU_DCVS_BW_SETTING, and the DCVS OOB raised and
+ * cleared; the GMU firmware moves the GX clock and says how it went in GMU_DCVS_RETURN. davinci's
+ * levels (qcom,gpu-pwrlevels): 0 825, 1 800, 2 650, 3 565, 4 430, 5 355, 6 267, 7 180 MHz.
+ * With the lock held, the GPU idle first.
+ */
+#define GMUB_DCVS_ACK_OPTION    0x1CBFCu
+#define GMUB_DCVS_PERF_SETTING  0x1CBFDu
+#define GMUB_DCVS_BW_SETTING    0x1CBFEu
+#define GMUB_DCVS_RETURN        0x1CBFFu
+#define GMUB_OOB_DCVS_SET       (1u << 23)
+#define GMUB_OOB_DCVS_ACK       (1u << 31)
+static int
+gpu_set_level(uint32_t level, uint64_t *out)
+{
+	unsigned polls;
+	uint32_t info = 0, ret;
+	if (!g_kgsl_ready || !gpu_gmu || g_gpu_nlevels == 0) {
+		return EINVAL;
+	}
+	if (level >= g_gpu_nlevels) {           /* past the bin's slowest (7 on an 825 bin): the slowest */
+		level = g_gpu_nlevels - 1u;
+	}
+	if (!g_hfi_up) {                        /* without the table of speeds the GMU faults on DCVS */
+		return ENODEV;
+	}
+	(void)gpu_wait(gpu_last(), 1000u);
+	gmub_wr(GMUB_DCVS_ACK_OPTION, 0);       /* DCVS_ACK_NONBLOCK */
+	/* the GMU's index into the table it was sent: ascending, 0 the 0 Hz level (vendor gmu_dcvs_set:
+	 * num_gpupwrlevels - pwrlevel - 1); CLKSET_OPTION_ATLEAST; the bus vote left as it is (0xFF) */
+	gmub_wr(GMUB_DCVS_PERF_SETTING, (3u << 28) | (g_gpu_nlevels - level));
+	{       /* vendor BW_VOTE(idx); 0xFF: leave the bus as it is (only "off" in the table) */
+		uint32_t bw = g_bw_levels > 1u ? bus_level(g_gpu_mhz[level]) : 0xFFu;
+		gmub_wr(GMUB_DCVS_BW_SETTING, (bw << 12) | bw);
+	}
+	__asm__ volatile("dsb osh" ::: "memory");
+	gmub_wr(GMUB_HOST2GMU_INTR_SET, GMUB_OOB_DCVS_SET);
+	for (polls = 0; polls < 10000u; polls++) {             /* 100 ms */
+		info = gmub_rd(GMUB_GMU2HOST_INTR_INFO);
+		if (info & GMUB_OOB_DCVS_ACK) {
+			break;
+		}
+		gmub_udelay(10);
+	}
+	gmub_wr(GMUB_GMU2HOST_INTR_CLR, GMUB_OOB_DCVS_ACK);
+	gmub_wr(GMUB_HOST2GMU_INTR_SET, GMUB_OOB_DCVS_ACK);     /* clear the OOB (legacy: bit 31) */
+	ret = gmub_rd(GMUB_DCVS_RETURN);
+	if (g_core) {           /* the clock it really runs at: the core's cycle counter over 2 ms */
+		uint64_t c0, c1, t0, t1, ns;
+		c0 = (uint64_t)gpu_rd(g_core, 0x401u << 2) << 32 | gpu_rd(g_core, 0x400u << 2);
+		t0 = mach_absolute_time();
+		gmub_udelay(2000);
+		c1 = (uint64_t)gpu_rd(g_core, 0x401u << 2) << 32 | gpu_rd(g_core, 0x400u << 2);
+		t1 = mach_absolute_time();
+		absolutetime_to_nanoseconds(t1 - t0, &ns);
+		printf("SWEET GPU: measured %llu MHz (%llu cycles in %llu us)\n", ns ? (c1 - c0) * 1000u / ns : 0,
+		    c1 - c0, ns / 1000u);
+	}
+	printf("SWEET GPU: level %u (%u MHz) asked: %s after %u polls (intr %#x), DCVS return %#x\n", level, g_gpu_mhz[level],
+	    (info & GMUB_OOB_DCVS_ACK) ? "acked" : "NOT acked", polls, info, ret);
+	if (info & GMUB_OOB_DCVS_ACK) {
+		g_gpu_level = level;
+	}
+	*out = (uint64_t)ret | ((uint64_t)((info & GMUB_OOB_DCVS_ACK) ? 1u : 0u) << 32);
+	return 0;
+}
+
+/*
+ * Wi-Fi, step 1 (boot-arg sweetwifi=1): the survey, reads only -- HackiOS redwood_wifi.c step_smem
+ * for davinci (WIFI-PLAN.md). The WCN3990's firmware runs in the modem, so the processor to look for is
+ * the modem (SMEM host 1): the shared memory area as the boot loader laid it out (dt: smem@86000000,
+ * 2 MB), the partition of us and the modem, and whether the modem has left its SMP2P item (428,
+ * qcom,smp2p-modem), its last words (421) or GLINK's descriptor (478) there: it has, if it ran since
+ * the phone was started. Nothing is written.
+ */
+#define WSMEM_PHYS      0x86000000u
+#define WSMEM_SIZE      0x00200000u
+#define WSMEM_US        0
+#define WSMEM_MODEM     1
+#define WSMEM_GLOBAL    0xfffe
+#define WSMEM_CANARY    0xa5a5
+struct wsmem_table_entry { uint32_t offset, size, flags; uint16_t host0, host1; uint32_t cacheline, reserved[7]; };
+struct wsmem_table { uint8_t magic[4]; uint32_t version, count, reserved[5]; };
+struct wsmem_partition { uint8_t magic[4]; uint16_t host0, host1; uint32_t size, free_uncached, free_cached, reserved[3]; };
+struct wsmem_entry { uint16_t canary, item; uint32_t size; uint16_t padding_data, padding_header; uint32_t reserved; };
+static volatile uint8_t *wsmem;
+
+/*
+ * Wi-Fi, step 2 (boot-arg sweetwifi=1, still reads only) -- HackiOS redwood_wifi.c step_mailbox and the
+ * doorbells, for davinci. Two always-on blocks, read as they are:
+ *   - the always-on processor's QMP mailbox (dt: qcom,qmp-aop@c300000, "msgram" 4 KB, 32-bit accesses):
+ *     it begins with a description of the two directions -- "their"/ucore = the AOP, "our"/mcore = us --
+ *     each with a link state, a channel state, the other side's acknowledgement, and where/how big its
+ *     mailbox is. The QMP protocol is SoC-independent, so the offsets are redwood's. We only read: the
+ *     magic tells whether this is the descriptor at all, and the link words whether a boot stage before
+ *     us has already brought the AOP channel up (UP 0x0000ffff / DOWN 0xffff0000 per direction).
+ *   - the one doorbell register that davinci rings every processor through (dt: syscon@17c0000c, the APCS
+ *     global IPC; 4 bytes). SM7150 is NOT redwood's IPCC@408000 (clients+signals): here each processor is
+ *     one bit of this single write-1-to-pulse register -- AOP = bit 0 (qcom,qmp-aop irq-reg-base+mask 1),
+ *     modem SMP2P = bit 14 (qcom,smp2p-modem ipc <..0 0xe>), modem GLINK = bit 12. Reading it only reports
+ *     the current latched word; nothing is written. This is the survey's last reads-only step before the
+ *     modem is ever loaded.
+ */
+#define WAOP_MSGRAM_PHYS   0x0c300000u            /* dt qcom,qmp-aop@c300000 reg[0] "msgram" */
+#define WAOP_MSGRAM_SIZE   0x00001000u            /* 4 KB (dt reg size); QMP descriptor + mailboxes */
+#define WAPCS_IPC_PHYS     0x17c0000cu            /* dt syscon@17c0000c: the APCS global IPC doorbell */
+/* QMP descriptor offsets (SoC-independent; redwood_wifi.c). "their" = AOP/ucore, "our" = us/mcore. */
+#define QMP_MAGIC          0x00
+#define QMP_MAGIC_VALUE    0x4d41494cu            /* "LIAM" / "MAIL" */
+#define QMP_VERSION        0x04
+#define QMP_FEATURES       0x08
+#define QMP_THEIR_LINK     0x0c
+#define QMP_THEIR_LINK_ACK 0x10
+#define QMP_THEIR_CHANNEL  0x14
+#define QMP_THEIR_CHAN_ACK 0x18
+#define QMP_THEIR_BOX_SIZE 0x1c
+#define QMP_THEIR_BOX      0x20
+#define QMP_OUR_LINK       0x24
+#define QMP_OUR_LINK_ACK   0x28
+#define QMP_OUR_CHANNEL    0x2c
+#define QMP_OUR_CHAN_ACK   0x30
+#define QMP_OUR_BOX_SIZE   0x34
+#define QMP_OUR_BOX        0x38
+#define QMP_UP             0x0000ffffu
+#define QMP_DOWN           0xffff0000u
+
+static uint32_t
+wmmio_rd32(vm_offset_t base, uint32_t off)
+{
+	uint32_t v = *(volatile uint32_t *)(base + off);
+	__asm__ volatile("dmb oshld" ::: "memory");
+	return v;
+}
+
+static const char *
+qmp_state(uint32_t v)
+{
+	return v == QMP_UP ? "UP" : v == QMP_DOWN ? "DOWN" : "?";
+}
+
+static vm_offset_t waop_base;    /* AOP QMP msgram (0xc300000), mapped once */
+static vm_offset_t wapcs_base;   /* APCS IPC doorbell page (0x17c00000), mapped once */
+static uint32_t    wifi_our_box; /* offset of our mailbox inside the msgram, set when the channel is open */
+
+static void
+wmmio_wr32(vm_offset_t base, uint32_t off, uint32_t val)
+{
+	*(volatile uint32_t *)(base + off) = val;
+	__asm__ volatile("dmb oshst" ::: "memory");
+}
+
+/* Map the two always-on blocks once; reused by the survey and the open. */
+static bool
+wifi_map_blocks(void)
+{
+	if (!waop_base) {
+		waop_base = ml_io_map(WAOP_MSGRAM_PHYS, WAOP_MSGRAM_SIZE);
+	}
+	if (!wapcs_base) {
+		wapcs_base = ml_io_map(WAPCS_IPC_PHYS & ~0xfffu, PAGE_SIZE);
+	}
+	return waop_base != 0;
+}
+
+/* Ring the always-on processor's doorbell: davinci sets bit 0 of the single APCS IPC register. */
+static void
+wifi_ring_aop(void)
+{
+	if (wapcs_base) {
+		wmmio_wr32(wapcs_base, WAPCS_IPC_PHYS & 0xfffu, 1u << 0);
+	}
+}
+
+/* Poll a QMP descriptor word until it reads `want`, up to `ms` ms (200 us steps). */
+static bool
+wifi_qmp_wait(uint32_t off, uint32_t want, unsigned ms)
+{
+	for (unsigned i = 0; i <= ms * 5u; i++) {
+		if (wmmio_rd32(waop_base, off) == want) {
+			return true;
+		}
+		delay_for_interval(200, NSEC_PER_USEC);
+	}
+	return false;
+}
+
+static void
+wifi_mailbox_survey(void)
+{
+	vm_offset_t aop, ipc;
+	uint32_t magic, ver, feat, boxsz, boxoff;
+
+	(void)wifi_map_blocks();
+	/* --- the always-on processor's QMP mailbox description (reads only) --- */
+	printf("SWEET WIFI: [2] the always-on processor's QMP mailbox at %#x, %#x bytes (reads only)\n",
+	    WAOP_MSGRAM_PHYS, WAOP_MSGRAM_SIZE);
+	aop = waop_base;
+	if (!aop) {
+		printf("SWEET WIFI: [2] cannot map the AOP mailbox\n");
+	} else {
+		magic  = wmmio_rd32(aop, QMP_MAGIC);
+		ver    = wmmio_rd32(aop, QMP_VERSION);
+		feat   = wmmio_rd32(aop, QMP_FEATURES);
+		printf("SWEET WIFI: [2] magic %#x (%s), version %#x, features %#x\n", magic,
+		    magic == QMP_MAGIC_VALUE ? "QMP descriptor" : "NOT a QMP descriptor", ver, feat);
+		if (magic != QMP_MAGIC_VALUE) {
+			printf("SWEET WIFI: [2] the mailbox has no description yet (AOP link not laid out from here)\n");
+		} else {
+			uint32_t tl = wmmio_rd32(aop, QMP_THEIR_LINK), tla = wmmio_rd32(aop, QMP_THEIR_LINK_ACK);
+			uint32_t tc = wmmio_rd32(aop, QMP_THEIR_CHANNEL), tca = wmmio_rd32(aop, QMP_THEIR_CHAN_ACK);
+			uint32_t ol = wmmio_rd32(aop, QMP_OUR_LINK), ola = wmmio_rd32(aop, QMP_OUR_LINK_ACK);
+			uint32_t oc = wmmio_rd32(aop, QMP_OUR_CHANNEL), oca = wmmio_rd32(aop, QMP_OUR_CHAN_ACK);
+			printf("SWEET WIFI: [2] their (AOP) link %#x (%s) ack %#x, channel %#x (%s) ack %#x\n",
+			    tl, qmp_state(tl), tla, tc, qmp_state(tc), tca);
+			printf("SWEET WIFI: [2] our link %#x (%s) ack %#x, channel %#x (%s) ack %#x\n",
+			    ol, qmp_state(ol), ola, oc, qmp_state(oc), oca);
+			boxsz  = wmmio_rd32(aop, QMP_OUR_BOX_SIZE);
+			boxoff = wmmio_rd32(aop, QMP_OUR_BOX);
+			printf("SWEET WIFI: [2] their box %#x/%#x bytes, our box %#x/%#x bytes\n",
+			    wmmio_rd32(aop, QMP_THEIR_BOX), wmmio_rd32(aop, QMP_THEIR_BOX_SIZE), boxoff, boxsz);
+			if (boxsz >= 68u && boxoff >= 0x3cu && (uint64_t)boxoff + boxsz <= WAOP_MSGRAM_SIZE) {
+				printf("SWEET WIFI: [2] length word in our box = %#x (0 = AOP has taken the last message)\n",
+				    wmmio_rd32(aop, boxoff));
+			}
+			if (tl == QMP_UP || ol == QMP_UP) {
+				printf("SWEET WIFI: [2] NOTE: a QMP link is already UP -- a stage before us opened the AOP\n");
+			}
+		}
+	}
+
+	/* --- the one APCS doorbell register davinci rings every processor through (reads only) --- */
+	printf("SWEET WIFI: [2] the APCS global IPC doorbell at %#x (reads only; bit 0 = AOP, 14 = modem SMP2P, 12 = modem GLINK)\n",
+	    WAPCS_IPC_PHYS);
+	ipc = wapcs_base;
+	if (!ipc) {
+		printf("SWEET WIFI: [2] cannot map the APCS IPC register\n");
+	} else {
+		uint32_t d = wmmio_rd32(ipc, WAPCS_IPC_PHYS & 0xfffu);
+		printf("SWEET WIFI: [2] doorbell register = %#x (pending bits: AOP=%u SMP2P=%u GLINK=%u)\n",
+		    d, (d >> 0) & 1u, (d >> 14) & 1u, (d >> 12) & 1u);
+	}
+	printf("SWEET WIFI: [2] survey done, reads only -- modem has not been touched\n");
+}
+
+/*
+ * Wi-Fi, step 3 (boot-arg sweetwifi=2): THE FIRST WRITE. Open the QMP channel to the always-on
+ * processor, Linux's qmp_open() a step at a time (HackiOS redwood_wifi.c step_mailbox_open): ack
+ * their link, raise ours and wait for their ack, raise our channel and wait for theirs, ack that
+ * and wait for their ack of ours. Each write is announced first; every write is to the AOP QMP
+ * descriptor or its doorbell only -- the modem is still NOT touched (that is a later step, gated
+ * higher). On any timeout we take our side back down so the AOP is left as we found it. The AOP
+ * is restarted only with the phone, so a channel a kernel before us opened is found open and left.
+ *
+ * Survey (2026-10-26) found: AOP link UP, our link/channel DOWN, doorbell clear -- the clean state
+ * to open from. our box = 0x128, size 0x2d8. Opening the AOP does not reset anything; it is the
+ * prerequisite for later telling the AOP "the modem image is loading" before the PAS auth+reset.
+ */
+static bool
+wifi_mailbox_open(void)
+{
+	uint32_t box, size, tl, ol, ola, tc, oca;
+
+	printf("SWEET WIFI: [3] OPEN the always-on processor's QMP channel (FIRST WRITE; AOP + its doorbell only)\n");
+	if (!wifi_map_blocks() || !wapcs_base) {
+		printf("SWEET WIFI: [3] cannot map the AOP mailbox / doorbell -- not opening\n");
+		return false;
+	}
+	if (wmmio_rd32(waop_base, QMP_MAGIC) != QMP_MAGIC_VALUE || wmmio_rd32(waop_base, QMP_VERSION) != 1u) {
+		printf("SWEET WIFI: [3] not a QMP descriptor this knows -- not opening\n");
+		return false;
+	}
+	box  = wmmio_rd32(waop_base, QMP_OUR_BOX);
+	size = wmmio_rd32(waop_base, QMP_OUR_BOX_SIZE);
+	if (size < 68u || box < 0x3cu || (uint64_t)box + size > WAOP_MSGRAM_SIZE || (box & 3u)) {
+		printf("SWEET WIFI: [3] our mailbox (%#x/%#x) is not where a message fits -- not opening\n", box, size);
+		return false;
+	}
+
+	/* Already fully open (a kernel before us)? Find it so, leave it. */
+	if (wmmio_rd32(waop_base, QMP_OUR_LINK) == QMP_UP && wmmio_rd32(waop_base, QMP_OUR_LINK_ACK) == QMP_UP &&
+	    wmmio_rd32(waop_base, QMP_OUR_CHANNEL) == QMP_UP && wmmio_rd32(waop_base, QMP_THEIR_CHANNEL) == QMP_UP &&
+	    wmmio_rd32(waop_base, QMP_OUR_CHAN_ACK) == QMP_UP) {
+		wifi_our_box = box;
+		printf("SWEET WIFI: [3] the channel is open already (opened before this kernel); our box %#x\n", box);
+		return true;
+	}
+
+	/* 1) acknowledge their link, then raise ours; ring; wait for their ack. */
+	tl = wmmio_rd32(waop_base, QMP_THEIR_LINK);
+	printf("SWEET WIFI: [3] write their-link-ack = %#x, our-link = UP, ring AOP doorbell\n", tl);
+	wmmio_wr32(waop_base, QMP_THEIR_LINK_ACK, tl);
+	wmmio_wr32(waop_base, QMP_OUR_LINK, QMP_UP);
+	wifi_ring_aop();
+	if (!wifi_qmp_wait(QMP_OUR_LINK_ACK, QMP_UP, 1000)) {
+		ola = wmmio_rd32(waop_base, QMP_OUR_LINK_ACK);
+		printf("SWEET WIFI: [3] AOP did NOT ack our link within 1 s (ack=%#x); taking our link down\n", ola);
+		wmmio_wr32(waop_base, QMP_OUR_LINK, QMP_DOWN);
+		wifi_ring_aop();
+		return false;
+	}
+	printf("SWEET WIFI: [3] AOP has seen our link\n");
+
+	/* 2) raise our channel; ring; wait for theirs. */
+	printf("SWEET WIFI: [3] write our-channel = UP, ring\n");
+	wmmio_wr32(waop_base, QMP_OUR_CHANNEL, QMP_UP);
+	wifi_ring_aop();
+	if (!wifi_qmp_wait(QMP_THEIR_CHANNEL, QMP_UP, 1000)) {
+		tc = wmmio_rd32(waop_base, QMP_THEIR_CHANNEL);
+		printf("SWEET WIFI: [3] AOP did NOT open its channel within 1 s (theirs=%#x); taking ours down\n", tc);
+		wmmio_wr32(waop_base, QMP_OUR_CHANNEL, QMP_DOWN);
+		wmmio_wr32(waop_base, QMP_OUR_LINK, QMP_DOWN);
+		wifi_ring_aop();
+		return false;
+	}
+	printf("SWEET WIFI: [3] AOP has opened its channel\n");
+
+	/* 3) acknowledge their channel; ring; wait for their ack of ours. */
+	printf("SWEET WIFI: [3] write their-channel-ack = UP, ring\n");
+	wmmio_wr32(waop_base, QMP_THEIR_CHAN_ACK, QMP_UP);
+	wifi_ring_aop();
+	if (!wifi_qmp_wait(QMP_OUR_CHAN_ACK, QMP_UP, 1000)) {
+		oca = wmmio_rd32(waop_base, QMP_OUR_CHAN_ACK);
+		printf("SWEET WIFI: [3] AOP did NOT ack our channel within 1 s (ack=%#x); taking ours down\n", oca);
+		wmmio_wr32(waop_base, QMP_OUR_CHANNEL, QMP_DOWN);
+		wmmio_wr32(waop_base, QMP_OUR_LINK, QMP_DOWN);
+		wifi_ring_aop();
+		return false;
+	}
+
+	ol  = wmmio_rd32(waop_base, QMP_OUR_LINK);
+	oca = wmmio_rd32(waop_base, QMP_OUR_CHAN_ACK);
+	wifi_our_box = box;
+	printf("SWEET WIFI: [3] THE QMP CHANNEL TO THE AOP IS OPEN (our link=%#x chan-ack=%#x box=%#x); modem still untouched\n",
+	    ol, oca, box);
+	return true;
+}
+
+#include <sys/uio.h>                    /* UIO_READ / UIO_SYSSPACE for vn_rdwr; here, not among the includes at the top, so later patches' context there still matches */
+/*
+ * Wi-Fi, step 4 (boot-arg sweetwifi=3): read the modem image from the iOS filesystem and check it
+ * against its own header (HackiOS redwood_wifi.c step_firmware, davinci). Reads only -- the files,
+ * and vnode stats of the segment files; NO hardware and NOT the modem. It only proves the image is
+ * whole and fits the reserved region, so the later PAS steps (header-to-TZ, segment copy, auth+reset)
+ * have something valid to work from.
+ *
+ * davinci reads from the iOS filesystem (vnode), not from the RAM disk as redwood does: the files are
+ * pushed to /usr/local/gltest/ by the dev loop (see sweet_push_exec_bit for the vnode idiom). So this
+ * runs on its OWN thread that waits for rootvnode -- never inline in the GPU bring-up, which is early.
+ *
+ * The image (Qualcomm mdt_loader): a 32-bit ELF whose header + program-header table + hash/cert blob
+ * are modem.mdt, and whose loadable segments are a file each, modem.bNN for header index NN (only the
+ * segments with file bytes get one). Device facts (2026-10-26): modem.mdt 9100 B, 31 program headers
+ * at 52 (32 B each); hash segment is index 1 (modem.b01, 8056 B); 52 + 32*31 + 8056 = 9100.
+ */
+#define WMODEM_REGION_PA   0x8b000000u          /* dt modem_region@8b000000 */
+#define WMODEM_REGION_SIZE 0x08400000u          /* 132 MiB */
+#define WMODEM_PAS_ID      4u                   /* dt qcom,mss@4080000 pas-id 4 (a later step uses it) */
+#define WMDT_DIR           "/usr/local/gltest/"
+#define WMDT_MAX_SEG       48u
+#define WMDT_HASH(f)       ((((f) >> 24) & 7u) == 2u)   /* the program header that is the hash/cert blob */
+
+struct wmdt_phdr { uint32_t type, offset, vaddr, paddr, filesz, memsz, flags, align; };
+static uint8_t wifi_mdt[0x4000];                /* modem.mdt (device's is 9100 B; cap 16 KiB) */
+static uint64_t wifi_mdt_size;                  /* set by step 4 when the image validates whole; 0 otherwise */
+static int wifi_level;                          /* sweetwifi=N, so the fw thread knows how far to go */
+
+/* Read up to `cap` bytes of a file into `buf`; *got = bytes read. 0 on success. (reads only) */
+static int
+wifi_read_file(const char *path, uint8_t *buf, uint32_t cap, uint64_t *got)
+{
+	vnode_t vp = NULLVP;
+	vfs_context_t ctx = vfs_context_kernel();
+	int e, resid = (int)cap;
+	if (vnode_lookup(path, 0, &vp, ctx) != 0) {
+		return -1;
+	}
+	e = vn_rdwr(UIO_READ, vp, (caddr_t)buf, (int)cap, 0, UIO_SYSSPACE, IO_NODELOCKED,
+	    vfs_context_ucred(ctx), &resid, vfs_context_proc(ctx));
+	vnode_put(vp);
+	if (e != 0) {
+		return -1;
+	}
+	*got = (uint64_t)cap - (uint64_t)resid;
+	return 0;
+}
+
+/* Read len bytes at file offset off into buf (cacheable). 0 on success; *got = bytes read. */
+static int
+wifi_read_file_at(const char *path, uint8_t *buf, uint32_t len, off_t off, uint64_t *got)
+{
+	vnode_t vp = NULLVP;
+	vfs_context_t ctx = vfs_context_kernel();
+	int e, resid = (int)len;
+	if (vnode_lookup(path, 0, &vp, ctx) != 0) {
+		return -1;
+	}
+	e = vn_rdwr(UIO_READ, vp, (caddr_t)buf, (int)len, off, UIO_SYSSPACE, IO_NODELOCKED,
+	    vfs_context_ucred(ctx), &resid, vfs_context_proc(ctx));
+	vnode_put(vp);
+	if (e != 0) {
+		return -1;
+	}
+	*got = (uint64_t)len - (uint64_t)resid;
+	return 0;
+}
+
+/* Stat a file's size without reading it. 0 on success. */
+static int
+wifi_file_size(const char *path, uint64_t *size)
+{
+	vnode_t vp = NULLVP;
+	vfs_context_t ctx = vfs_context_kernel();
+	struct vnode_attr va;
+	int e;
+	if (vnode_lookup(path, 0, &vp, ctx) != 0) {
+		return -1;
+	}
+	VATTR_INIT(&va);
+	VATTR_WANTED(&va, va_data_size);
+	e = vnode_getattr(vp, &va, ctx);
+	vnode_put(vp);
+	if (e != 0 || !VATTR_IS_SUPPORTED(&va, va_data_size)) {
+		return -1;
+	}
+	*size = va.va_data_size;
+	return 0;
+}
+
+static bool
+wifi_firmware_read_validate(void)
+{
+	char path[64];
+	uint64_t mdtsz = 0, total_file = 0;
+	uint32_t phnum, phoff, phentsize, hashsz = 0, lowest = ~0u, highest = 0, loadable = 0;
+
+	wifi_mdt_size = 0;
+	printf("SWEET WIFI: [4] read + validate the modem image at %smodem.{mdt,bNN} (reads only; modem untouched)\n", WMDT_DIR);
+	snprintf(path, sizeof(path), "%smodem.mdt", WMDT_DIR);
+	if (wifi_read_file(path, wifi_mdt, sizeof(wifi_mdt), &mdtsz) != 0) {
+		printf("SWEET WIFI: [4] cannot read %s -- push modem.mdt + modem.bNN into %s\n", path, WMDT_DIR);
+		return false;
+	}
+	phnum     = mdtsz >= 46u ? (uint32_t)(wifi_mdt[44] | wifi_mdt[45] << 8) : 0u;
+	phentsize = mdtsz >= 44u ? (uint32_t)(wifi_mdt[42] | wifi_mdt[43] << 8) : 0u;
+	phoff     = mdtsz >= 32u ? (uint32_t)(wifi_mdt[28] | wifi_mdt[29] << 8 | wifi_mdt[30] << 16 | wifi_mdt[31] << 24) : 0u;
+	if (memcmp(wifi_mdt, "\177ELF\1", 5) != 0 || phnum < 3u || phnum > WMDT_MAX_SEG || phentsize != 32u ||
+	    (uint64_t)phoff + 32ull * phnum > mdtsz) {
+		printf("SWEET WIFI: [4] %s is not a 32-bit MDT header (%02x %02x %02x %02x, phnum %u, phentsize %u, %llu bytes)\n",
+		    path, wifi_mdt[0], wifi_mdt[1], wifi_mdt[2], wifi_mdt[3], phnum, phentsize, mdtsz);
+		return false;
+	}
+	printf("SWEET WIFI: [4] %s: ELF32, %u program headers at %#x, %llu bytes\n", path, phnum, phoff, mdtsz);
+	for (uint32_t i = 0; i < phnum; i++) {
+		struct wmdt_phdr ph;
+		uint64_t fsz = 0;
+		memcpy(&ph, wifi_mdt + phoff + 32u * i, sizeof(ph));
+		if (WMDT_HASH(ph.flags)) {
+			hashsz = ph.filesz;
+		}
+		if (ph.type != 1u || WMDT_HASH(ph.flags) || ph.memsz == 0u) {
+			continue;               /* not a loaded segment */
+		}
+		if (ph.paddr < WMODEM_REGION_PA || ph.filesz > ph.memsz ||
+		    (uint64_t)ph.paddr + ph.memsz > (uint64_t)WMODEM_REGION_PA + WMODEM_REGION_SIZE) {
+			printf("SWEET WIFI: [4] segment %u (paddr %#x, %#x bytes) is NOT within the modem region %#x+%#x -- stop\n",
+			    i, ph.paddr, ph.memsz, WMODEM_REGION_PA, WMODEM_REGION_SIZE);
+			return false;
+		}
+		if (ph.filesz != 0u) {
+			snprintf(path, sizeof(path), "%smodem.b%02u", WMDT_DIR, i);
+			if (wifi_file_size(path, &fsz) != 0) {
+				printf("SWEET WIFI: [4] segment %u needs %s but it is not there -- stop\n", i, path);
+				return false;
+			}
+			if (fsz != ph.filesz) {
+				printf("SWEET WIFI: [4] %s is %llu bytes, the header says %u -- stop\n", path, fsz, ph.filesz);
+				return false;
+			}
+			total_file += fsz;
+		}
+		lowest  = ph.paddr < lowest ? ph.paddr : lowest;
+		highest = ph.paddr + ph.memsz > highest ? ph.paddr + ph.memsz : highest;
+		loadable++;
+	}
+	if (loadable == 0u || lowest != WMODEM_REGION_PA || (uint64_t)phoff + 32ull * phnum + hashsz != mdtsz) {
+		printf("SWEET WIFI: [4] not what PAS takes: %u loadable segments, lowest %#x (want %#x); %u + %u*32 + hashes %u vs %llu\n",
+		    loadable, lowest, WMODEM_REGION_PA, phoff, phnum, hashsz, mdtsz);
+		return false;
+	}
+	printf("SWEET WIFI: [4] THE MODEM IMAGE IS WHOLE: %u loadable segments, %llu bytes of segment files, header %llu B "
+	    "(hashes %u), spans %#x..%#x (%#x of the %#x-byte region). Ready for PAS (pas-id %u) -- NOT started.\n",
+	    loadable, total_file, mdtsz, hashsz, lowest, highest,
+	    ((highest + 0xfffu) & ~0xfffu) - WMODEM_REGION_PA, WMODEM_REGION_SIZE, WMODEM_PAS_ID);
+	wifi_mdt_size = mdtsz;
+	return true;
+}
+
+/*
+ * Wi-Fi, step 5 (boot-arg sweetwifi=4): ask TrustZone to AUTHENTICATE the modem image, WITHOUT
+ * releasing the modem. PAS is_supported(4) -> init_image(4, mdt) -> mem_setup(4, region). The modem
+ * Q6 stays in reset: there is NO segment copy and NO auth-and-reset here, so nothing on the modem
+ * runs. This proves one thing and only that: TrustZone accepts this device's signed modem image when
+ * it is handed over from our XNU. Mirrors sweet_gpu.c's GPU-zap PAS (gpu_scm_pas), with pas-id 4 and
+ * the modem's mdt/region. davinci's modem is qcom,pil-tz-generic/pas-id 4, so TZ does the whole load;
+ * init_image checks the signature of the metadata blob (modem.mdt: header + program table + hashes).
+ *
+ * THE segment copy into 0x8b000000 and auth-and-reset (SCM 0x42000205) -- which RELEASE the modem and
+ * are the reset-risk operations (a modem later shut down without a stop-ack has bricked restart until
+ * a reboot) -- are a separate, higher-gated step, to run deliberately with sweetgpu_armfb=1 armed.
+ */
+#define WMODEM_SCM_IS_SUPPORTED 0x42000207ull
+#define WMODEM_SCM_INIT_IMAGE   0x42000201ull
+#define WMODEM_SCM_MEM_SETUP    0x42000202ull
+
+/*
+ * Send ONE immediate RPMh ARC vote on the apps RSC (dt mailbox@18220000, "qcom,tcs-drv", drv-id 2),
+ * to power a rail the way the stock pil-tz driver's regulator_enable(vdd_cx)/regulator_enable(vdd_mss)
+ * does before pas_init_image. The AOP load_state message is only a notification; the real rail power
+ * is this RSC vote, which we were missing. Mirrors the downstream qcom-rpmh-mailbox.c (RSC v2.7):
+ *   reg_base = reg[1] = 0x18220d00; ACTIVE TCS (from qcom,tcs-config <2 2 ...>) is m=0; slot n=0.
+ * CMD_DATA is the ARC hardware-level INDEX into the resource's cmd-db VLVL list (NOT the vlvl value);
+ * we vote the top corner (nvals-1 = TURBO), matching the stock proxy vote. Reuses cmddb_find().
+ * Only touches the AP's own apps RSC active TCS, which nothing else on the AP drives here.
+ */
+#define WRSC_PAGE_PA     0x18220000u     /* page holding reg_base 0x18220d00 */
+#define WRSC_RB          0x00000d00u     /* reg_base offset within the page (reg[1]) */
+#define WRSC_IRQ_STATUS  0x04u
+#define WRSC_IRQ_CLEAR   0x08u
+#define WRSC_CMD_WAIT    0x10u
+#define WRSC_CONTROL     0x14u
+#define WRSC_STATUS      0x18u
+#define WRSC_CMD_ENABLE  0x1cu
+#define WRSC_CMD_MSGID   0x30u
+#define WRSC_CMD_ADDR    0x34u
+#define WRSC_CMD_DATA    0x38u
+#define WRSC_CMD_STATUS  0x3cu
+#define WRSC_MSGID_WR    0x10108u         /* LEN8 | RESP_REQ | WRITE (completing active write) */
+#define WRSC_AMC_ENABLE  0x10000u
+#define WRSC_AMC_TRIGGER 0x1000000u
+
+static vm_offset_t wrsc_page;             /* mapped 0x18220000; reg_base at +0xd00 */
+
+static int
+wifi_rpmh_vote(const char *res)
+{
+	uint16_t vals[16];
+	uint32_t addr = 0, nvals = 0, idx, s;
+	unsigned i;
+	vm_offset_t rb;
+
+	if (!wrsc_page && !(wrsc_page = ml_io_map(WRSC_PAGE_PA, 0x2000u))) {
+		printf("SWEET WIFI: [5] cannot map the apps RSC\n");
+		return -1;
+	}
+	rb = wrsc_page + WRSC_RB;              /* ACTIVE TCS m=0, slot n=0 */
+	if (cmddb_find(res, &addr, vals, &nvals) != 0 || nvals == 0u) {
+		printf("SWEET WIFI: [5] cmd-db lacks %s -- not voting\n", res);
+		return -1;
+	}
+	idx = nvals - 1u;                      /* top corner (TURBO), as the stock proxy vote */
+	printf("SWEET WIFI: [5] RPMh vote %s: cmd-db addr %#x, %u levels, hlvl idx %u (vlvl %u) [TURBO]\n",
+	    res, addr, nvals, idx, vals[idx]);
+	for (i = 0; i < 2000u && !(wmmio_rd32(rb, WRSC_STATUS) & 1u); i++) {
+		delay_for_interval(1, NSEC_PER_USEC);   /* wait TCS idle */
+	}
+	wmmio_wr32(rb, WRSC_CMD_ENABLE, 0);    /* clear any residue */
+	wmmio_wr32(rb, WRSC_CMD_WAIT, 0);
+	wmmio_wr32(rb, WRSC_CMD_MSGID, WRSC_MSGID_WR);
+	wmmio_wr32(rb, WRSC_CMD_ADDR, addr);
+	wmmio_wr32(rb, WRSC_CMD_DATA, idx);
+	wmmio_wr32(rb, WRSC_CMD_WAIT, 1u);     /* want completion on slot 0 */
+	wmmio_wr32(rb, WRSC_CMD_ENABLE, 1u);
+	wmmio_wr32(rb, WRSC_CONTROL, 0);                       /* trigger: 0 -> ENABLE -> ENABLE|TRIGGER */
+	for (i = 0; i < 1000u && wmmio_rd32(rb, WRSC_CONTROL) != 0u; i++) { }
+	wmmio_wr32(rb, WRSC_CONTROL, WRSC_AMC_ENABLE);
+	for (i = 0; i < 1000u && wmmio_rd32(rb, WRSC_CONTROL) != WRSC_AMC_ENABLE; i++) { }
+	wmmio_wr32(rb, WRSC_CONTROL, WRSC_AMC_ENABLE | WRSC_AMC_TRIGGER);
+	for (i = 0; i < 20000u && !(wmmio_rd32(rb, WRSC_IRQ_STATUS) & 1u); i++) {
+		delay_for_interval(1, NSEC_PER_USEC);
+	}
+	s = wmmio_rd32(rb, WRSC_CMD_STATUS);
+	wmmio_wr32(rb, WRSC_IRQ_CLEAR, 1u);
+	wmmio_wr32(rb, WRSC_CMD_ENABLE, 0);
+	wmmio_wr32(rb, WRSC_CMD_WAIT, 0);
+	printf("SWEET WIFI: [5] RPMh vote %s: cmd_status %#x (issued=%u compl=%u)%s\n", res, s, (s >> 8) & 1u,
+	    (s >> 16) & 1u, ((s & 0x100u) && (s & 0x10000u)) ? " OK" : " -- NOT confirmed");
+	return ((s & 0x100u) && (s & 0x10000u)) ? 0 : -1;
+}
+#define WMODEM_SCM_SHUTDOWN     0x42000206ull
+#define WGPU_PAS_ID             13u             /* known-good: the GPU zap PAS works for pas-id 13 */
+#define QMP_MSG_LEN             64u             /* Linux qmp_send always writes 64 bytes, text + zero pad */
+
+/*
+ * Send one QMP message to the always-on processor over the channel step 3 opened (Linux qmp_send):
+ * the text goes into our mailbox behind its length (a fixed 64), the AOP's doorbell is rung, and the
+ * AOP has taken it when the length reads back 0. davinci's modem is qcom,signal-aop: the modem's proxy
+ * power (cx, mss rails) is brought up by telling the AOP "{class: image, res: load_state, name: modem,
+ * val: on}" -- which is what the stock pil-tz driver does, and why step 5 could not authenticate with
+ * the modem rail off. Returns true if the AOP took the message.
+ */
+static bool
+wifi_mailbox_send(const char *text)
+{
+	uint32_t words[QMP_MSG_LEN / 4] = { 0 };
+	unsigned i;
+
+	if (!waop_base || wifi_our_box == 0u) {
+		printf("SWEET WIFI: [5] AOP channel not open -- cannot send \"%s\"\n", text);
+		return false;
+	}
+	strlcpy((char *)words, text, sizeof(words));
+	if (wmmio_rd32(waop_base, wifi_our_box) != 0u) {
+		printf("SWEET WIFI: [5] our AOP box still holds a message (%#x) -- not sending\n",
+		    wmmio_rd32(waop_base, wifi_our_box));
+		return false;
+	}
+	for (i = 0; i < QMP_MSG_LEN / 4u; i++) {
+		wmmio_wr32(waop_base, wifi_our_box + 4u + 4u * i, words[i]);
+	}
+	wmmio_wr32(waop_base, wifi_our_box, QMP_MSG_LEN);     /* the length, in front -> message is queued */
+	(void)wmmio_rd32(waop_base, wifi_our_box);
+	wifi_ring_aop();
+	if (!wifi_qmp_wait(wifi_our_box, 0, 1000)) {
+		printf("SWEET WIFI: [5] AOP did NOT take \"%s\" within 1 s -- taking it back\n", text);
+		wmmio_wr32(waop_base, wifi_our_box, 0);
+		return false;
+	}
+	printf("SWEET WIFI: [5] AOP took \"%s\"\n", text);
+	return true;
+}
+
+static void
+wifi_modem_pas_validate(void)
+{
+	vm_offset_t mdt_cva = 0, mdt_io = 0;
+	uint64_t mdt_pa = 0, x0, x1 = 0;
+	uint64_t i, mdtsz = wifi_mdt_size;
+
+	printf("SWEET WIFI: [5] ask TrustZone to AUTHENTICATE the modem image (pas-id %u); modem STAYS IN RESET -- not released\n",
+	    WMODEM_PAS_ID);
+	if (mdtsz == 0u || mdtsz > sizeof(wifi_mdt)) {
+		printf("SWEET WIFI: [5] no validated modem.mdt from step 4 -- not asking TZ\n");
+		return;
+	}
+	/* The metadata buffer MUST sit in a DDR bank XBL registered with TZ at boot. TZ RE (tz.bin) + the
+	 * sweetwifi=7 sweep (2026-10-29) proved the modem path (reader B) MAPS this buffer into TZ and rejects
+	 * with 0xffcffff6 = AC_ERR_NOT_DDR_MEMORY when its PA is not in that table. XNU's high RAM (gmub,
+	 * ~0xb7xxxxxx) is real DDR but NOT registered; the modem carveout IS (init_image accepted at both
+	 * 0x8b000000 and 0x93400000, rejected from gmub). Stage at the top of the carveout (0x93400000, in the
+	 * ~7 MiB spare above the image's 0x8b000000..0x92e00000) so it never collides with the loaded image. */
+	mdt_pa = 0x93400000ull;
+	(void)mdt_cva;
+	if (!(mdt_io = ml_io_map(mdt_pa, 0x4000))) {
+		printf("SWEET WIFI: [5] cannot map the modem-carveout mdt staging buffer at %#llx\n", (unsigned long long)mdt_pa);
+		return;
+	}
+	for (i = 0; i < mdtsz; i++) {
+		((volatile unsigned char *)mdt_io)[i] = wifi_mdt[i];
+	}
+	__asm__ volatile("dsb sy" ::: "memory");
+	gmub_flush();
+	printf("SWEET WIFI: [5] mdt copied to pa %#llx (%llu bytes), elf %02x%02x%02x%02x (want 7f454c46)\n",
+	    (unsigned long long)mdt_pa, mdtsz, ((volatile unsigned char *)mdt_io)[0], ((volatile unsigned char *)mdt_io)[1],
+	    ((volatile unsigned char *)mdt_io)[2], ((volatile unsigned char *)mdt_io)[3]);
+
+	/* is_supported sweep: compare the modem (4) against the KNOWN-GOOD GPU (13). If TZ answers x1=1
+	 * for 13 but x1=0 for 4, TZ gates modem PAS from us specifically; if it answers 0 for both, the
+	 * call's convention just differs and the answer is not a reliable "supported" flag. (read-only) */
+	x1 = 0;
+	x0 = gpu_scm_pas(WMODEM_SCM_IS_SUPPORTED, 0x01u, (uint64_t)WGPU_PAS_ID, 0, 0, &x1);
+	printf("SWEET WIFI: [5] PAS is_supported(%u=GPU, known-good) -> x0=%#llx x1=%#llx\n",
+	    WGPU_PAS_ID, (unsigned long long)x0, (unsigned long long)x1);
+	x1 = 0;
+	x0 = gpu_scm_pas(WMODEM_SCM_IS_SUPPORTED, 0x01u, (uint64_t)WMODEM_PAS_ID, 0, 0, &x1);
+	printf("SWEET WIFI: [5] PAS is_supported(%u=modem) -> x0=%#llx x1=%#llx (x0=0 & x1=1 => TZ can PAS this peripheral)\n",
+	    WMODEM_PAS_ID, (unsigned long long)x0, (unsigned long long)x1);
+
+	/* AUTHORITATIVE (MiCode davinci-p-oss subsys-pil-tz.c pil_boot, RE'd 2026-10-29): the modem and the
+	 * GPU zap (pas-id 13, which authenticates fine here) run byte-identical pil_init_image_trusted code.
+	 * The metadata buffer is ordinary coherent DMA (NOT in the modem region), the bus vote is the same
+	 * global scm_pas client both use, and there is NO hyp/scm_assign before init_image on this SoC. So
+	 * the mdt buffer / bus / region are all ruled out -- 0xffcffff6 is TZ's PAS AUTH of the modem
+	 * metadata failing. And our modem.mdt is byte-identical (md5) to the one THIS TZ accepts under MIUI,
+	 * so TZ *can* authenticate it: the reject is a TZ-STATE difference between the MIUI boot and ours.
+	 *
+	 * The one concrete deviation we had from stock pil_boot was an unconditional shutdown(4) BEFORE
+	 * init_image -- stock does init_image first, no shutdown. Two cases to tell apart in one boot:
+	 *   (A) our boot chain (ABL) left pas-id 4 already-inited -> re-init rejected; shutdown clears it.
+	 *   (B) our pre-shutdown itself wedged an otherwise-clean PAS state.
+	 * So: power on (cheap, proven-harmless insurance), then init_image FIRST with no shutdown (exactly
+	 * like stock). Only if rejected, shutdown(4) to clear stale PAS bookkeeping and retry. The pair of
+	 * return codes says which case we are in -- or, if both reject identically, that it is a genuine
+	 * TZ auth/secure-state reject beyond this code path. */
+	(void)wifi_mailbox_send("{class: image, res: load_state, name: modem, val: on}");
+	(void)wifi_rpmh_vote("cx.lvl");
+	(void)wifi_rpmh_vote("mss.lvl");
+	delay_for_interval(20, NSEC_PER_MSEC);          /* let the rails settle */
+
+	x1 = 0;
+	x0 = gpu_scm_pas(WMODEM_SCM_INIT_IMAGE, 0x82u, (uint64_t)WMODEM_PAS_ID, mdt_pa, 0, &x1);
+	printf("SWEET WIFI: [5] PAS init_image(%u, mdt) [attempt A, NO prior shutdown -- matches stock pil_boot] -> x0=%#llx x1=%#llx\n",
+	    WMODEM_PAS_ID, (unsigned long long)x0, (unsigned long long)x1);
+	if (x0 != 0u) {
+		uint64_t sx1 = 0, sx0;
+		printf("SWEET WIFI: [5] attempt A rejected (x0=%#llx); clearing PAS state with shutdown(%u) and retrying\n",
+		    (unsigned long long)x0, WMODEM_PAS_ID);
+		sx0 = gpu_scm_pas(WMODEM_SCM_SHUTDOWN, 0x01u, (uint64_t)WMODEM_PAS_ID, 0, 0, &sx1);
+		printf("SWEET WIFI: [5] PAS shutdown(%u) -> x0=%#llx x1=%#llx\n",
+		    WMODEM_PAS_ID, (unsigned long long)sx0, (unsigned long long)sx1);
+		gmub_flush();
+		x1 = 0;
+		x0 = gpu_scm_pas(WMODEM_SCM_INIT_IMAGE, 0x82u, (uint64_t)WMODEM_PAS_ID, mdt_pa, 0, &x1);
+		printf("SWEET WIFI: [5] PAS init_image(%u, mdt) [attempt B, AFTER shutdown] -> x0=%#llx x1=%#llx\n",
+		    WMODEM_PAS_ID, (unsigned long long)x0, (unsigned long long)x1);
+	}
+	if (x0 != 0u) {
+		printf("SWEET WIFI: [5] TZ REJECTED the modem image on BOTH attempts (x0=%#llx). The mdt is byte-identical to "
+		    "MIUI's, power/bus/buffer/region are ruled out -- this is a TZ-side PAS authentication/secure-state reject, "
+		    "not something this code path sets up wrong. Stop; modem untouched, in reset.\n", (unsigned long long)x0);
+		(void)wifi_mailbox_send("{class: image, res: load_state, name: modem, val: off}");
+		return;
+	}
+	printf("SWEET WIFI: [5] init_image ACCEPTED (x0=0) -- TZ authenticated the modem metadata.\n");
+
+	x0 = gpu_scm_pas(WMODEM_SCM_MEM_SETUP, 0x03u, (uint64_t)WMODEM_PAS_ID, (uint64_t)WMODEM_REGION_PA,
+	    (uint64_t)WMODEM_REGION_SIZE, &x1);
+	printf("SWEET WIFI: [5] PAS mem_setup(%u, %#x, %#x) -> x0=%#llx x1=%#llx\n", WMODEM_PAS_ID, WMODEM_REGION_PA,
+	    WMODEM_REGION_SIZE, (unsigned long long)x0, (unsigned long long)x1);
+	if (x0 != 0u) {
+		printf("SWEET WIFI: [5] mem_setup refused (x0=%#llx) -- stop; modem in reset\n", (unsigned long long)x0);
+		(void)wifi_mailbox_send("{class: image, res: load_state, name: modem, val: off}");
+		return;
+	}
+	printf("SWEET WIFI: [5] TRUSTZONE ACCEPTS THE MODEM IMAGE (signature ok, region set). Modem STILL IN RESET. "
+	    "Next (higher-gated, reset-risk): copy the 29 segments in, then auth-and-reset to RELEASE the modem.\n");
+	/* validate-only step: release the AOP proxy power again (we are not proceeding to auth here). */
+	(void)wifi_mailbox_send("{class: image, res: load_state, name: modem, val: off}");
+}
+
+/* sweetwifi=8: RELEASE THE MODEM -- the reset-risk step. mdt is staged in the carveout (registered DDR,
+ * fixes AC_ERR_NOT_DDR_MEMORY), init_image + mem_setup, then the loadable segments are copied from
+ * modem.bNN into 0x8b000000+(paddr-base) and auth_and_reset (0x42000205) brings the modem Q6 out of
+ * reset. cx/mss + AOP load_state are left ON (the modem needs them to run). armfb=1 turns any panic into
+ * a drop to fastboot; a modem that wedges just needs a reboot. After auth we watch the APCS doorbell for
+ * signs of life. Still no HLOS services yet (QRTR/rmtfs = M2/M3), so the modem may idle or crash after a
+ * few seconds -- that is expected; the milestone here is auth_and_reset(4)=0 = out of reset. */
+#define WMODEM_SCM_AUTH_RESET 0x42000205ull
+static void wifi_modem_liveness(void);   /* defined after the wsmem helpers */
+static void wifi_smp2p_up(void);         /* M2a: SMP2P bring-up, defined after the wsmem helpers */
+static void wifi_glink_attach(void);     /* M2b: GLINK FIFO attach */
+static void wifi_glink_link(void);       /* M2c: GLINK version + open IPCRTR */
+static void wrmtfs_load(void);           /* M3a: rmtfs (defined after wifi_glink_link) */
+static bool wrmtfs_setup(void);
+static void wrmtfs_start(void);
+static void wservreg_load(void);         /* M3b: service-registry locator (pd-mapper) */
+static void
+wifi_modem_release(void)
+{
+	char path[64];
+	uint64_t x0, x1 = 0, i, mdtsz = wifi_mdt_size;
+	uint32_t phnum, phoff, copied = 0;
+	vm_offset_t mio, region = 0, stage_cva = 0;
+	uint64_t stage_pa = 0;
+
+	printf("SWEET WIFI: [8] RELEASE THE MODEM (reset-risk): init_image + mem_setup + segment copy + auth_and_reset\n");
+	if (mdtsz == 0u || mdtsz > sizeof(wifi_mdt)) {
+		printf("SWEET WIFI: [8] no validated modem.mdt from step 4 -- cannot release\n"); return;
+	}
+	(void)wifi_mailbox_send("{class: image, res: load_state, name: modem, val: on}");
+	(void)wifi_rpmh_vote("cx.lvl");
+	(void)wifi_rpmh_vote("mss.lvl");
+	delay_for_interval(20, NSEC_PER_MSEC);
