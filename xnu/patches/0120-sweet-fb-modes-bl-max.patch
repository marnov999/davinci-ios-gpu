 {
-	if (level > 0x7FFu) {
-		level = 0x7FFu;
+	static uint32_t most = 0;       /* boot-arg sweetbl_max=N: no brighter than N (0..2047), whatever iOS asks */
+	if (most == 0) {
+		most = 0x7FFu;
+		(void)PE_parse_boot_argn("sweetbl_max", &most, sizeof(most));
+		if (most == 0 || most > 0x7FFu) {
+			most = 0x7FFu;
+		}
+	}
+	if (level > most) {
+		level = most;
 	}
 	g_panel_level = level;
 	return g_panel_off ? 0 : panel_dcs_brightness(level);
