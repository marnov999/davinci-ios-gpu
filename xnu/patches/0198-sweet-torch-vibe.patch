+/*
+ * The other writes this file allows: the vibrator and the flashlight, exactly the registers MIUI's drivers write
+ * (leds-qpnp-vibrator-ldo.c, leds-qpnp-flash-v2.c):
+ *   PM6150 (SID 1) vibrator LDO 0x5300: VSET_LB/UB 0x40/0x41, EN_CTL 0x46               (bsd/dev/sweet_outputs.c)
+ *   PM6150L (SID 5) flash LED 0xd300:   SAFETY_TMR 0x40/0x41, TGR_CURRENT 0x43/0x44 (LED 1, 2), MOD_CTRL 0x46,
+ *                                       IRES 0x47, STROBE_CTRL 0x49/0x4a, EN_LED_CTRL 0x4c   (bsd/dev/sweet_outputs.c)
+ * One byte by our own (EE 0) channel, only on an APID EE 0 owns, then read back: 0 when it reads back as written.
+ */
+int
+sweet_spmi_write_out(unsigned sid, unsigned addr, uint8_t value)
+{
+	static vm_offset_t ch[2];
+	static uint16_t ch_apid[2] = { SP_NO_APID, SP_NO_APID };
+	unsigned reg = addr & 0xffu, slot;
+	bool vib = sid == 1 && (addr >> 8) == 0x53u && (reg == 0x40u || reg == 0x41u || reg == 0x46u);
+	bool flash = sid == 5 && (addr >> 8) == 0xd3u && (reg == 0x40u || reg == 0x41u || reg == 0x43u ||
+	    reg == 0x44u || reg == 0x46u || reg == 0x47u || reg == 0x49u || reg == 0x4au || reg == 0x4cu);
+	uint8_t back = 0;
+
+	if (!sp_ready || !(vib || flash)) {
+		return -1;
+	}
+	slot = vib ? 0 : 1;
+	IOLockLock(sp_lock);
+	uint16_t apid = sp_find_apid((sid << 8) | (addr >> 8));
+	if (apid == SP_NO_APID || sp_poisoned[apid] || (sp_rd(sp_cfg, 0x700u + 4u * apid) & 7u) != 0) {
+		IOLockUnlock(sp_lock);
+		return -2;
+	}
+	if (ch[slot] == 0 || ch_apid[slot] != apid) {
+		ch[slot] = ml_io_map(SP_CHNLS_PA + 0x10000u * apid, 0x1000u);
+		ch_apid[slot] = apid;
+		if (ch[slot] == 0) {
+			IOLockUnlock(sp_lock);
+			return -1;
+		}
+	}
+	*(volatile uint32_t *)(ch[slot] + 0x10u) = value;                                    /* WDATA0 */
+	__asm__ volatile("dsb osh" ::: "memory");
+	*(volatile uint32_t *)(ch[slot] + 0x00u) = (0u << 27) | (reg << 4);                   /* EXT_WRITEL, 1 byte */
+	__asm__ volatile("dsb osh" ::: "memory");
+	int rc = -3;
+	for (unsigned i = 0; i < 1000u; ++i) {
+		uint32_t status = *(volatile uint32_t *)(ch[slot] + 0x08u);
+		if (status & 1u) {
+			rc = (status & 0x0eu) ? -4 : 0;
+			break;
+		}
+		delay(1);
+	}
+	IOLockUnlock(sp_lock);
+	if (rc == 0 && (sweet_spmi_read(sid, addr, &back) != 0 || back != value)) {
+		rc = -5;
+	}
+	return rc;
+}
