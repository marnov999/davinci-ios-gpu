diff --git a/bsd/kern/sweet_amfi.c b/bsd/kern/sweet_amfi.c
index 56ae718..56d78c3 100644
--- a/bsd/kern/sweet_amfi.c
+++ b/bsd/kern/sweet_amfi.c
@@ -509,15 +509,22 @@ sysctl_sweet_rtc SYSCTL_HANDLER_ARGS
 	int64_t v = -1;
 	uint8_t b[4], again = 0;
 	if (sweet_spmi_init() == 0) {
-		for (int tries = 0; tries < 3 && v < 0; tries++) {
+		/* all four bytes twice, equal (a carry between the passes just takes another try): a single
+		 * SPMI read now and then returns junk -- 16803239 for ~26000 once (2026-10-26) */
+		uint8_t c[4];
+		for (int tries = 0; tries < 5 && v < 0; tries++) {
 			bool ok = true;
 			for (unsigned i = 0; i < 4; i++) {
 				ok = ok && sweet_spmi_read(0, 0x6048 + i, &b[i]) == 0;
 			}
-			if (ok && sweet_spmi_read(0, 0x6048, &again) == 0 && again == b[0]) {
+			for (unsigned i = 0; i < 4; i++) {
+				ok = ok && sweet_spmi_read(0, 0x6048 + i, &c[i]) == 0;
+			}
+			if (ok && memcmp(b, c, 4) == 0) {
 				v = (int64_t)((uint32_t)b[0] | (uint32_t)b[1] << 8 | (uint32_t)b[2] << 16 | (uint32_t)b[3] << 24);
 			}
 		}
+		(void)again;
 	}
 	return SYSCTL_OUT(req, &v, sizeof(v));
 }
