+#define GPU_GCC_PA       0x00100000u
+#define GPU_GCC_SIZE     0x001f0000u   /* qcom_cc_map max_register ~0x1820b0 */
+#define GPU_GPUCC_PA     0x05090000u
+#define GPU_GPUCC_SIZE   0x9000u
+
+/* GCC GPU clock branch registers (offset within the GCC window). Enable = set
+ * BIT(0); the low bit of halt status (readback) reads 0 when the branch runs. */
+#define GCC_GPU_CFG_AHB_CLK    0x71004u
+#define GCC_GPU_MEMNOC_GFX_CLK 0x7100cu
+#define GCC_GPU_SNOC_DVM_CLK   0x71018u
+#define GCC_DDRSS_GPU_AXI_CLK  0x4452cu
+#define GCC_BRANCH_ENABLE      0x1u
+
+/* Registers WITHIN the GPUCC window (base 0x5090000), from gpucc-sdmmagpie.c:
+ * gpu_gx_gdsc 0x509100c, gpu_cx_gdsc 0x509106c, cx_gmu_clk 0x1098, cxo 0x109c.
+ * GDSCR bit 31 = PWR_ON. */
+#define GPUCC_GX_GDSCR   0x100cu
+#define GPUCC_CX_GDSCR   0x106cu
+#define GPUCC_CX_GMU_CLK 0x1098u
+#define GPUCC_CXO_CLK    0x109cu
+
+#define GPU_DT_CHIPID    0x06010800u
+
+/* Qualcomm SCM PAS: id = ARM_SMCCC_CALL_VAL(FAST,SMC64,SIP=2,fnid(svc2,cmd7)). */
+#define QCOM_SCM_PAS_IS_SUPPORTED_FNID  0xC2000207ull
+#define QCOM_GPU_PAS_ID                 13u
+/* TZ-mediated MMIO access (SVC_IO 0x05): EL3 performs the store, sitting above
+ * the XPU that blocks our EL1 write to the SPMI arbiter chnls region. Fast SMC64,
+ * SIP. io_writel(addr,val): x1=2,x2=addr,x3=val; io_readl(addr): x1=1,x2=addr,
+ * value in out[1]. (mainline qcom_scm_io_writel/readl.) */
+#define QCOM_SCM_IO_WRITE_FNID          0xC2000502ull
+#define QCOM_SCM_IO_READ_FNID           0xC2000501ull
+
+/* Dev-loop helper: reboot straight back to fastboot. davinci qcom,msm-imem is
+ * at 0x146aa000; restart_reason is at +0x65c; ABL enters fastboot when it reads
+ * FASTBOOT_MODE (0x77665500) there. Then PSCI SYSTEM_RESET (0x84000009). */
+#define IMEM_PA                 0x146aa000u
+#define IMEM_SIZE               0x1000u
+#define IMEM_RESTART_REASON_OFF 0x65cu
+#define RESTART_REASON_FASTBOOT 0x77665500u
+#define PSCI_SYSTEM_RESET       0x84000009ull
+/* qcom,pshold: writing 0 drops the PS_HOLD line -> HW reset that PRESERVES IMEM
+ * (PSCI SYSTEM_RESET cleared it, so the cookie was lost). From sdmmagpie.dtsi. */
+#define PSHOLD_PA               0x0c264000u
+
+/* GPUCC extras for the GMU power step: ahb branch + GDSC bits. */
+#define GPUCC_AHB_CLK      0x1078u
+#define GDSC_SW_COLLAPSE   0x1u          /* bit0: 1 = collapsed/off */
+#define GDSC_PWR_ON        0x80000000u   /* bit31: 1 = powered on */
+
+/* GMU register window (0x506a000). a6xx GMU regs are dword INDICES; byte offset
+ * within this window = (index<<2) - 0x6a000 (a6xx_regs.h / a6xx_gmu.h). The GMU
+ * is in the CX domain, so these are reachable once the CX GDSC + GMU clocks are
+ * on (gmu step 1). CM3_FW_INIT_RESULT == 0xBABEFACE only AFTER fw boots. */
+#define A6XX_GMU_PA            0x0506a000u
+#define A6XX_GMU_SIZE          0x31000u
+#define GMU_BOFF(idx)         ((uint32_t)(((idx) << 2) - 0x6a000u))
+#define GMU_CM3_SYSRESET       0x1F800u
+#define GMU_CX_GMU_WFI_CONFIG  0x1F802u
+#define GMU_CM3_FW_INIT_RESULT 0x1F81Cu
+#define GMU_HFI_CTRL_STATUS    0x1F980u
+#define GMU_GENERAL_0          0x1F9C5u
+
+static vm_offset_t gpu_gcc, gpu_gpucc;
+static bool gpu_started;
+static int gpu_level;
+
+static uint32_t
+gpu_rd(vm_offset_t base, uint32_t off)
+{
+	uint32_t v = *(volatile uint32_t *)(base + off);
+	__asm__ volatile("dmb oshld" ::: "memory");
+	return v;
+}
+
+static void
+gpu_wr(vm_offset_t base, uint32_t off, uint32_t val)
+{
+	*(volatile uint32_t *)(base + off) = val;
+	__asm__ volatile("dmb oshst" ::: "memory");
+}
+
+/* One SMC64 to the resident TZ; mirrors sweet_psci_cpu_on's conduit (0065). */
+static void
+gpu_smc(uint64_t a0, uint64_t a1, uint64_t a2, uint64_t a3,
+    uint64_t a4, uint64_t a5, uint64_t a6, uint64_t out[4])
+{
+	register uint64_t x0 __asm__("x0") = a0;
+	register uint64_t x1 __asm__("x1") = a1;
+	register uint64_t x2 __asm__("x2") = a2;
+	register uint64_t x3 __asm__("x3") = a3;
+	register uint64_t x4 __asm__("x4") = a4;
+	register uint64_t x5 __asm__("x5") = a5;
+	register uint64_t x6 __asm__("x6") = a6;
+	__asm__ volatile("smc #0"
+	    : "+r"(x0), "+r"(x1), "+r"(x2), "+r"(x3)
+	    : "r"(x4), "r"(x5), "r"(x6)
+	    : "memory", "x7", "x8", "x9", "x10", "x11", "x12",
+	      "x13", "x14", "x15", "x16", "x17");
+	out[0] = x0;
+	out[1] = x1;
+	out[2] = x2;
+	out[3] = x3;
+}
+
+static void
+gpu_tz_probe(void)
+{
+	uint64_t r[4] = {0, 0, 0, 0};
+	gpu_smc(QCOM_SCM_PAS_IS_SUPPORTED_FNID, 1u, QCOM_GPU_PAS_ID, 0, 0, 0, 0, r);
+	printf("SWEET GPU: PAS_IS_SUPPORTED(13) -> x0=%#llx x1=%#llx\n", r[0], r[1]);
+	if (r[0] == 0 && r[1] == 1) {
+		printf("SWEET GPU: TrustZone PAS ALIVE + GPU zap supported (blocker #2 tractable).\n");
+	} else if (r[0] == 0xffffffffull) {
+		printf("SWEET GPU: SMC not recognised; resident TZ exposes no SIP PAS to XNU.\n");
+	} else {
+		printf("SWEET GPU: PAS query status %#llx (check SCM arg convention).\n", r[0]);
+	}
+}
