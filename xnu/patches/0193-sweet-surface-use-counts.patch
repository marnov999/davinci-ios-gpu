 IOReturn
-IOSurfaceRootUserClient::trapUseCount(__unused void *id, __unused void *category,
-    void *, void *, void *, void *)
+IOSurfaceRootUserClient::useCount(uintptr_t id, uintptr_t category, int delta)
 {
+	if (category >= 2) {
+		return kIOReturnBadArgument;
+	}
+	IOLockLock(fLock);
+	SweetSurfaceRef *ref = findRef((uint32_t)id, false, NULL);
+	if (ref == NULL) {
+		ref = findRef((uint32_t)id, true, NULL);
+	}
+	if (ref == NULL) {
+		IOLockUnlock(fLock);
+		return kIOReturnNotFound;
+	}
+	if (delta > 0) {
+		ref->uses[category]++;
+		OSIncrementAtomic(sweet_surface_uses(ref->surface, (uint32_t)category));
+	} else if (ref->uses[category] != 0) {
+		ref->uses[category]--;
+		OSDecrementAtomic(sweet_surface_uses(ref->surface, (uint32_t)category));
+	}
+	IOLockUnlock(fLock);
 	return kIOReturnSuccess;
 }
 
+IOReturn
+IOSurfaceRootUserClient::trapIncrementUse(void *id, void *category, void *, void *, void *, void *)
+{
+	return useCount((uintptr_t)id, (uintptr_t)category, 1);
+}
+
+IOReturn
+IOSurfaceRootUserClient::trapDecrementUse(void *id, void *category, void *, void *, void *, void *)
+{
+	return useCount((uintptr_t)id, (uintptr_t)category, -1);
+}
