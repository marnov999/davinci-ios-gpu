+		CW(0x8C2u, 0x010000C0u); CW(0x8C1u, 0x8040362Cu); CW(0x8C3u, 128u);
+		CW(0x9E00u, 0x00180000u); CW(0x98Du, 0x1u); CW(0x500u, 0x1u);
+		__asm__ volatile("dsb osh" ::: "memory");
+		printf("SWEET GMU: [Ib] CP ROQ/pool+PC_DBG+AHB written\n"); gmub_flush();
+		/* group c: NC_MODE (RB/TPL1/SP) + UCHE_MODE + hang + client_pf */
