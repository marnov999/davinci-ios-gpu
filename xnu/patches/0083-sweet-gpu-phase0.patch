+/* Read the RPMH cmd-db and print the GX (gfx.lvl) + MX (mx.lvl) ARC VLVL arrays
+ * and the computed vote indices for the MIN_SVS (raw 48) corner. Confirms the
+ * GX_VOTE_IDX we hardcode. Locator at phys 0xc3f000c = {base,size} of the real
+ * DB in DDR. hdr{magic@4=0x0c0330db, rsc_hdr[8]@8, data@144}; rsc_hdr{slv_id@0,
+ * header_offset@2, data_offset@4, cnt@6}(16B); entry{id[8]@0, len@20, offset@22}
+ * (24B); aux=data+data_offset+offset, len bytes = u16 VLVL array. Read-only;
+ * called AFTER the GX stages so a fault here can't derail the BOOT_SLUMBER test. */
+#define CMDDB_LOCATOR_PA 0x0c3f000cu
+#define CMDDB_MAGIC      0x0c0330dbu
+
+static int
+gmub_cmddb_lvl(vm_offset_t data, vm_offset_t rscb, const char *name,
+    unsigned namelen, uint16_t *out, unsigned *num)
+{
+	unsigned s, e, b, k;
+	for (s = 0; s < 8u; ++s) {
+		vm_offset_t rsc = rscb + 16u * s;
+		uint16_t slv = *(volatile uint16_t *)(rsc + 0);
+		uint16_t hoff = *(volatile uint16_t *)(rsc + 2);
+		uint16_t doff = *(volatile uint16_t *)(rsc + 4);
+		uint16_t cnt = *(volatile uint16_t *)(rsc + 6);
+		if (slv == 0) {
+			continue;
+		}
+		for (e = 0; e < cnt; ++e) {
+			vm_offset_t ent = data + hoff + 24u * e;
+			int match = 1;
+			for (b = 0; b < namelen; ++b) {
+				if (*(volatile char *)(ent + b) != name[b]) { match = 0; break; }
+			}
+			if (!match || *(volatile char *)(ent + namelen) != 0) {
+				continue;
+			}
+			uint16_t len = *(volatile uint16_t *)(ent + 20);
+			uint16_t eoff = *(volatile uint16_t *)(ent + 22);
+			vm_offset_t aux = data + doff + eoff;
+			unsigned c16 = len >> 1;
+			if (c16 > 16u) { c16 = 16u; }
+			for (k = 0; k < c16; ++k) {
+				out[k] = *(volatile uint16_t *)(aux + 2u * k);
+			}
+			unsigned n = 1;
+			while (n < c16 && !(out[n-1] != 0 && out[n] == 0)) { ++n; }
+			*num = (c16 == 0) ? 0 : n;
+			return 0;
+		}
+	}
+	return -1;
+}
+
+static void
+gmub_cmddb_report(void)
+{
+	vm_offset_t loc = ml_io_map(CMDDB_LOCATOR_PA, 8);
+	if (!loc) { printf("SWEET GMU: [db] locator map failed\n"); return; }
+	uint32_t base = *(volatile uint32_t *)(loc);
+	uint32_t size = *(volatile uint32_t *)(loc + 4);
+	if (!base || size < 144u || size > 0x80000u) {
+		printf("SWEET GMU: [db] bad locator base=%#x size=%#x\n", base, size);
+		return;
+	}
+	vm_offset_t db = ml_io_map(base, size);
+	if (!db) { printf("SWEET GMU: [db] map base=%#x failed\n", base); return; }
+	uint32_t magic = *(volatile uint32_t *)(db + 4);
+	if (magic != CMDDB_MAGIC) {
+		printf("SWEET GMU: [db] magic=%#x want=%#x base=%#x\n", magic, CMDDB_MAGIC, base);
+		return;
+	}
+	vm_offset_t rscb = db + 8, data = db + 144;
+	uint16_t gfx[16], mx[16];
+	unsigned ng = 0, nm = 0;
+	int gr = gmub_cmddb_lvl(data, rscb, "gfx.lvl", 7, gfx, &ng);
+	int mr = gmub_cmddb_lvl(data, rscb, "mx.lvl", 6, mx, &nm);
+	if (gr != 0 || mr != 0) {
+		printf("SWEET GMU: [db] gfx=%d mx=%d not found\n", gr, mr);
+		return;
+	}
+	printf("SWEET GMU: [db] gfx.lvl n=%u: %u %u %u %u %u %u %u %u\n", ng,
+	    ng>0?gfx[0]:0, ng>1?gfx[1]:0, ng>2?gfx[2]:0, ng>3?gfx[3]:0,
+	    ng>4?gfx[4]:0, ng>5?gfx[5]:0, ng>6?gfx[6]:0, ng>7?gfx[7]:0);
+	gmub_flush();
+	printf("SWEET GMU: [db] mx.lvl n=%u: %u %u %u %u %u %u\n", nm,
+	    nm>0?mx[0]:0, nm>1?mx[1]:0, nm>2?mx[2]:0, nm>3?mx[3]:0,
+	    nm>4?mx[4]:0, nm>5?mx[5]:0);
+	unsigned k, j;
+	for (k = 0; k < ng; ++k) { if (gfx[k] >= 48u) break; }
+	uint16_t cur = (k < ng) ? gfx[k] : 0;
+	for (j = 0; j < nm; ++j) { if (mx[j] >= cur || j + 1 == nm) break; }
+	printf("SWEET GMU: [db] MIN_SVS(48) -> GX_VOTE_IDX=%u MX_VOTE_IDX=%u (used 2/2)\n",
+	    (k < ng) ? k : 99u, (j < nm) ? j : 99u);
+	gmub_flush();
+}
+
+/* Clean+invalidate a buffer to PoC so TrustZone (which reads DDR directly) sees
+ * our writes. XNU maps our kmem as Normal cacheable; TZ does not snoop it. */
+static void
+gpu_dcache_clean(vm_offset_t va, vm_size_t len)
+{
+	vm_offset_t p = va & ~((vm_offset_t)63);
+	vm_offset_t end = va + len;
+	for (; p < end; p += 64) {
+		__asm__ volatile("dc civac, %0" :: "r"(p) : "memory");
+	}
+	__asm__ volatile("dsb sy" ::: "memory");
+}
+
+/* Qualcomm STANDARD (yielding) SIP SCM call with the davinci-era A6-interrupted
+ * resume loop. QSEE yields a long PAS op with QCOM_SCM_INTERRUPTED (a0==1) to let
+ * EL1 run; HLOS must re-issue with x0=1 AND x6 = the session token TZ returned in
+ * x6 (captured here via "+r"(x6)). Keep x1..x5 across the resume. Also retries
+ * V2_EBUSY (-12). PAS calls MUST be STD (0x42...), not FAST. Returns x0 (0=ok);
+ * *res1 = x1 (must also be 0 for ok). */
+static uint64_t
+gpu_scm_pas(uint64_t fnid, uint64_t arginfo, uint64_t a2, uint64_t a3,
+    uint64_t a4, uint64_t *res1)
+{
+	uint64_t cmd = fnid, a6 = 0, x1ret = 0;
+	unsigned ebusy = 0, guard = 0;
+	for (;;) {
+		register uint64_t x0 __asm__("x0") = cmd;
+		register uint64_t x1 __asm__("x1") = arginfo;
+		register uint64_t x2 __asm__("x2") = a2;
+		register uint64_t x3 __asm__("x3") = a3;
+		register uint64_t x4 __asm__("x4") = a4;
+		register uint64_t x5 __asm__("x5") = 0;
+		register uint64_t x6 __asm__("x6") = a6;
+		__asm__ volatile("smc #0"
+		    : "+r"(x0), "+r"(x1), "+r"(x2), "+r"(x3), "+r"(x6)
+		    : "r"(x4), "r"(x5)
+		    : "memory", "x7", "x8", "x9", "x10", "x11", "x12",
+		      "x13", "x14", "x15", "x16", "x17");
+		x1ret = x1;
+		a6 = x6;                          /* capture resume/session token */
+		if (x0 == 1ull) {                 /* INTERRUPTED: resume x0=1, keep token */
+			cmd = 1ull;
+			if (++guard > 200000u) {
+				break;
+			}
+			continue;
+		}
+		if ((int64_t)x0 == -12) {         /* V2_EBUSY: wait + fresh re-issue */
+			if (++ebusy > 20u) {
+				break;
+			}
+			gmub_udelay(30000);
+			cmd = fnid;
+			a6 = 0;
+			continue;
+		}
+		if (res1) {
+			*res1 = x1ret;
+		}
+		return x0;
+	}
+	if (res1) {
+		*res1 = x1ret;
+	}
+	return cmd;
+}
+
+/* a6xx PM4 type-7 packet header. The parity bit of each field is the bit that
+ * makes the field's popcount odd. Verified: cp_type7(CP_ME_INIT=0x48, 11) =
+ * 0x70C8000B (matches a6xx-first-submission.md). */
+static uint32_t
+cp_parity(uint32_t v)
+{
+	v ^= v >> 16; v ^= v >> 8; v ^= v >> 4; v ^= v >> 2; v ^= v >> 1;
+	return (~v) & 1u;            /* 1 when popcount(v) is even -> makes total odd */
+}
+static uint32_t
+cp_type7(uint32_t op, uint32_t cnt)
+{
+	return 0x70000000u | (cnt & 0x3FFFu) | (cp_parity(cnt) << 15)
+	    | ((op & 0x7Fu) << 16) | (cp_parity(op) << 23);
+}
+/* a6xx PM4 type-4 register-write header (OUT_PKT4): write `cnt` dwords starting
+ * at register dword-index `reg`. Same odd-parity scheme as type7. */
+static uint32_t
+cp_type4(uint32_t reg, uint32_t cnt)
+{
+	return 0x40000000u | (cnt & 0x7Fu) | (cp_parity(cnt) << 7)
+	    | ((reg & 0x3FFFFu) << 8) | (cp_parity(reg) << 27);
+}
+
+/* ---- Stage Q: SMMU STAGE-1 PAGE TABLES. Flip GPU CB0 from passthrough
+ * (SCTLR.M=0, addr==phys) to stage-1 translation (ARM_64_LPAE_S1, ias=48, 4K).
+ * Build a pagetable that identity-maps [0,4GB) with 1GB blocks (so the ring/SQE/
+ * all current physical buffers keep working), plus maps a HIGH test VA
+ * 0x1_0000_0000 -> a fresh NC page. Enable M=1, then CP_MEM_WRITE to the VIRTUAL
+ * addr and confirm it lands at the physical page with CB0.FSR==0 -> proves the GPU
+ * now has its own virtual address space (the Phase-2 unlock for turnip/freedreno).
+ * Contained: only our CP's SID0 traffic is translated; iOS doesn't touch the GPU;
+ * a bad map faults (FSR) instead of corrupting - no flash/bootloader touched.
+ * smmu = ml_io_map(0x5040000): CB0 @ +0x8000, GR1 @ +0x1000. */
+#define Q_ADDRMASK 0x0000FFFFFFFFF000ull
+/* Persistent GPU address space left live by gpu_stage_q (stage-1 enabled). The KGSL
+ * backend (gpu_gpumem_alloc) hands out buffers mapped into this pagetable at kernel-
+ * assigned GPU VAs - exactly the IOCTL_KGSL_GPUMEM_ALLOC / MSM_INFO_GET_IOVA model.
+ *
+ * Ported from HackiOS redwood_adreno.c (space_map, redwood_gpu_address/_address_free,
+ * redwood_gpu_map/_unmap): buffers live at GPU VA 4..8 GB (L1[4..7]; L1[0..3] are the 1 GB
+ * identity blocks the ring, SQE and result page are reached through), with tables grown on
+ * demand. An address is the buffer's from when it is made until it is given back, and
+ * nothing moves a live buffer; addresses given back are unmapped (TLB invalidated) and
+ * handed out again. (The bump allocator this replaces never reused an address, so after
+ * 1 GB of buffers made in all -- a minute or two of compositing -- its L2 index wrapped
+ * and new buffers' PTEs overwrote live ones', with no TLB invalidate.) */
+static vm_offset_t g_l3_nc;        /* legacy: NC ptr to L3[0] (direct-VA stages) */
+static volatile uint64_t *g_l2_nc; /* NC ptr to L1[4]'s L2 table; non-NULL = pagetable up */
+static volatile uint64_t *g_l1_nc; /* NC ptr to the L1 table (to grow more L2s) */
+static uint64_t    g_gpuva_next;   /* first VA past what the bring-up stages used: the allocator starts here */
+#define GPU_VA_L1_FIRST     4u
+#define GPU_VA_L1_COUNT     4u
+#define GPU_VA_END          ((uint64_t)(GPU_VA_L1_FIRST + GPU_VA_L1_COUNT) << 30)
+#define GPU_ADDRESS_GRANULE 0x10000ull          /* what one allocation is rounded up to (redwood) */
+static volatile uint64_t *g_l2_tabs[GPU_VA_L1_COUNT];      /* NC ptr per L1 index (NULL = none yet) */
+static volatile uint64_t *g_l3_tabs[GPU_VA_L1_COUNT][512]; /* NC ptr per L1/L2 index (NULL = none yet) */
+static struct { uint64_t start, size; } gpu_free[1024];   /* the addresses not in use, in order */
+static unsigned gpu_free_count, gpu_va_holes;
+static bool     gpu_free_ready;
+static uint64_t gpu_va_used, gpu_va_lost;
+static uint32_t gpu_va_live, gpu_va_refused;
+
+/* Submit path published by the boot code once the ring + stage-1 pagetable are
+ * live, so the KGSL GPU_COMMAND ioctl (and the in-kernel self-test) can submit
+ * IBs on the same ring the bring-up stages used. */
+static vm_offset_t        g_core;        /* GPU core MMIO base */
+static volatile uint32_t *g_rb;          /* ring NC ptr */
+#define KGSL_RING_DWORDS  (0x8000u / 4u)  /* the ring: 32 KB (CP_RB_CNTL BUFSZ 12) */
+static unsigned           g_wptr;        /* current ring write index (dwords) */
+static uint64_t           g_res_pa;      /* TS completion result page (phys, identity-mapped) */
+static vm_offset_t        g_res_nc;      /* its NC CPU ptr */
+static int                g_kgsl_ready;  /* submit path live */
+static vm_offset_t        g_smmu_base;   /* GPU SMMU base (for CB0 FSR fault readback) */
+
+/* Drop the SMMU's cached translations and walks for CB0 (ASID 0) and wait for it. Needed
+ * after a PTE is cleared (redwood_gpu_unmap) and after a table entry is added to the live
+ * pagetable: the MMU-500 caches intermediate walks, so without it a stale "invalid" L1/L2
+ * entry translation-faults (fsr.TF) the new region. */
+static void
+gpu_tlb_flush(void)
+{
+	unsigned p;
+	if (!g_smmu_base) {
+		return;
+	}
+	__asm__ volatile("dsb sy" ::: "memory");
+	gpu_wr(g_smmu_base, 0x8000u + 0x610u, 0u);         /* CB0 S1_TLBIASID (ASID 0) */
+	gpu_wr(g_smmu_base, 0x8000u + 0x7F0u, 0u);         /* CB0 TLBSYNC */
+	for (p = 0; p < 2000u; p++) {
+		if (!(gpu_rd(g_smmu_base, 0x8000u + 0x7F4u) & 1u)) { break; }
+		gmub_udelay(1);
+	}
+}
+
+/* One zeroed 4K table, NC-mapped (redwood space_new_table: a 16K page gives four). */
+static volatile uint64_t *
+gpu_pt_table(uint64_t *out_pa)
+{
+	static vm_offset_t spare_nc;
+	static uint64_t    spare_pa;
+	static unsigned    spare_left;
+	volatile uint64_t *t;
+	vm_offset_t at;
+	unsigned j;
+	if (spare_left == 0) {
+		vm_offset_t cva = 0, nc;
+		uint64_t pa = 0;
+		if (gmub_alloc_phys(&cva, &pa, PAGE_SIZE) != 0) {
+			return NULL;
+		}
+		gpu_dcache_clean(cva, PAGE_SIZE);   /* flush the KMA_ZERO dirty cacheable lines to DRAM,
+		                                     * else they later evict and clobber the NC-written PTEs */
+		if (!(nc = ml_io_map(pa, PAGE_SIZE))) {
+			return NULL;
+		}
+		spare_nc = nc;
+		spare_pa = pa;
+		spare_left = (unsigned)(PAGE_SIZE / 0x1000u);
+	}
+	at = (vm_offset_t)(PAGE_SIZE - 0x1000u * spare_left);
+	spare_left--;
+	t = (volatile uint64_t *)(spare_nc + at);
+	for (j = 0; j < 512u; j++) {
+		t[j] = 0;
+	}
+	__asm__ volatile("dsb sy" ::: "memory");
+	*out_pa = spare_pa + at;
+	return t;
+}
+
+/* The NC-mapped L3 table for a buffer VA, its L2 and L3 made and linked on demand. */
+static volatile uint64_t *
+gpu_pt_l3_for(uint64_t va)
+{
+	unsigned l1i = (unsigned)((va >> 30) & 0x1FFu), l2i = (unsigned)((va >> 21) & 0x1FFu), k;
+	volatile uint64_t *t;
+	uint64_t pa = 0;
+	if (!g_l2_nc || !g_l1_nc || (va >> 39) != 0 ||
+	    l1i < GPU_VA_L1_FIRST || l1i >= GPU_VA_L1_FIRST + GPU_VA_L1_COUNT) {
+		return NULL;
+	}
+	k = l1i - GPU_VA_L1_FIRST;
+	if (!g_l2_tabs[k]) {
+		if (!(t = gpu_pt_table(&pa))) {
+			return NULL;
+		}
+		g_l1_nc[l1i] = (pa & Q_ADDRMASK) | 0x3ull;      /* L1[l1i] -> new L2 (table desc) */
+		g_l2_tabs[k] = t;
+		gpu_tlb_flush();
+	}
+	if (!g_l3_tabs[k][l2i]) {
+		if (!(t = gpu_pt_table(&pa))) {
+			return NULL;
+		}
+		g_l2_tabs[k][l2i] = (pa & Q_ADDRMASK) | 0x3ull; /* L2[l2i] -> new L3 (table desc) */
+		g_l3_tabs[k][l2i] = t;
+		gpu_tlb_flush();
+	}
+	return g_l3_tabs[k][l2i];
+}
+
+/* redwood gpu_address_span: an allocation's size in whole granules. */
+static uint64_t
+gpu_address_span(uint64_t size)
+{
+	return (size + (GPU_ADDRESS_GRANULE - 1)) & ~(GPU_ADDRESS_GRANULE - 1);
+}
+
+/* redwood_gpu_address: addresses for a buffer of so many bytes; 0: none left. */
+static uint64_t
+gpu_address(uint64_t size)
+{
+	unsigned i;
+	if (!gpu_free_ready) {
+		uint64_t start = gpu_address_span(g_gpuva_next);   /* past what the bring-up stages used */
+		gpu_free[0].start = start;
+		gpu_free[0].size = GPU_VA_END - start;
+		gpu_free_count = 1;
+		gpu_free_ready = true;
+	}
+	size = gpu_address_span(size);
+	for (i = 0; i < gpu_free_count; i++) {
+		if (gpu_free[i].size >= size) {
+			uint64_t address = gpu_free[i].start;
+			gpu_free[i].start += size;
+			gpu_free[i].size -= size;
+			if (gpu_free[i].size == 0) {
+				memmove(&gpu_free[i], &gpu_free[i + 1], (--gpu_free_count - i) * sizeof(gpu_free[0]));
+			}
+			gpu_va_used += size;
+			gpu_va_live++;
+			return address;
+		}
+	}
+	gpu_va_refused++;
+	return 0;
+}
+
+/* redwood_gpu_address_free: give addresses back (the free list coalesces). */
+static void
+gpu_address_free(uint64_t address, uint64_t size)
+{
+	unsigned at;
+	size = gpu_address_span(size);
+	gpu_va_used -= size;
+	gpu_va_live--;
+	for (at = 0; at < gpu_free_count && gpu_free[at].start < address; at++) {
+	}
+	if (at > 0 && gpu_free[at - 1].start + gpu_free[at - 1].size == address) {
+		gpu_free[at - 1].size += size;
+		if (at < gpu_free_count && address + size == gpu_free[at].start) {
+			gpu_free[at - 1].size += gpu_free[at].size;
+			memmove(&gpu_free[at], &gpu_free[at + 1], (--gpu_free_count - at) * sizeof(gpu_free[0]));
+		}
+	} else if (at < gpu_free_count && address + size == gpu_free[at].start) {
+		gpu_free[at].start = address;
+		gpu_free[at].size += size;
+	} else if (gpu_free_count < sizeof(gpu_free) / sizeof(gpu_free[0])) {
+		memmove(&gpu_free[at + 1], &gpu_free[at], (gpu_free_count++ - at) * sizeof(gpu_free[0]));
+		gpu_free[at].start = address;
+		gpu_free[at].size = size;
+	} else {
+		gpu_va_lost += size;        /* no room to remember the hole: lost, and counted, never reused blind */
+	}
+	if (gpu_free_count > gpu_va_holes) {
+		gpu_va_holes = gpu_free_count;
+	}
+}
+
+/* redwood_gpu_unmap: a buffer's pages out of the GPU's address space, and out of its TLB. */
+static void
+gpu_unmap(uint64_t address, uint64_t size)
+{
+	uint64_t off;
+	for (off = 0; off < size; off += 0x1000ull) {
+		volatile uint64_t *l3 = gpu_pt_l3_for(address + off);
+		if (l3) {
+			l3[((address + off) >> 12) & 0x1FFu] = 0;
+		}
+	}
+	gpu_tlb_flush();
+}
+
+/* KGSL GPUMEM_ALLOC / MSM GEM_NEW backend: allocate `size` bytes of FREEABLE, NON-contiguous,
+ * wired memory and map each 4 KB page's own phys into the GPU stage-1 pagetable at addresses
+ * of its own (non-cacheable: redwood PTE_CORE). Returns gpuaddr + the cacheable kernel VA
+ * (cva: the kernel CPU view AND the source for the write-combine user mmap) + the first page
+ * phys. In-kernel writers gpu_dcache_clean() before the GPU reads (the self-tests do);
+ * userland uses the WC mmap, which is already coherent. */
+#define GPU_PTE_CORE 0xE43ull   /* valid 4K page, AttrIndx=0 (uncached), AP unpriv, SH outer, AF, nG */
+static int
+gpu_gpumem_alloc(vm_size_t size, uint64_t *gpuaddr, vm_offset_t *cpu_nc, uint64_t *out_pa,
+    vm_offset_t *out_cva)
+{
+	vm_offset_t cva = 0;
+	uint64_t off, base;
+	vm_size_t asize = (size + (vm_size_t)PAGE_SIZE - 1) & ~((vm_size_t)PAGE_SIZE - 1);
+	if (!g_l2_nc || !g_gpuva_next) {
+		return -1;                 /* stage-1 pagetable not up */
+	}
+	if (kmem_alloc(kernel_map, &cva, asize, KMA_DATA | KMA_ZERO, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		return -1;                 /* non-contiguous, wired, freeable (no KMA_PERMANENT) */
+	}
+	if ((base = gpu_address(asize)) == 0) {
+		kmem_free(kernel_map, cva, asize);
+		return -1;
+	}
+	for (off = 0; off < asize; off += 0x1000ull) {
+		uint64_t va = base + off;
+		uint64_t pa = ptoa_64(pmap_find_phys(kernel_pmap, (addr64_t)(cva + off)))
+		            | (off & ((uint64_t)PAGE_SIZE - 1u));   /* 4K sub-page phys within the 16K page */
+		volatile uint64_t *l3 = gpu_pt_l3_for(va);
+		if (!l3) {
+			gpu_unmap(base, off);
+			gpu_address_free(base, asize);
+			kmem_free(kernel_map, cva, asize);
+			return -1;
+		}
+		l3[(va >> 12) & 0x1FFu] = (pa & Q_ADDRMASK) | GPU_PTE_CORE;
+	}
+	gpu_dcache_clean(cva, asize);     /* flush the zeroed state to DRAM before the GPU (NC) sees it */
+	__asm__ volatile("dsb sy" ::: "memory");
+	*gpuaddr = base;
+	*cpu_nc = cva;
+	if (out_pa) {
+		*out_pa = ptoa_64(pmap_find_phys(kernel_pmap, (addr64_t)cva));
+	}
+	if (out_cva) {
+		*out_cva = cva;    /* object-backed cacheable kernel VA for the WC BO CPU-map */
+	}
+	return 0;
+}
+
+/* Map EXISTING physically-backed pages (an IOSurface's wired backing) into the GPU at
+ * addresses of their own. Uncached like every other buffer (redwood surfaceBuffer() maps a
+ * surface with PTE_CORE too): what the CPU has written of the surface is pushed out of its
+ * cache before a submission names it (drm_do_gem_submit), as RedwoodGPU's submit() does. */
+static int
+gpu_gpumem_map_phys(const uint64_t *pa, unsigned npages, uint64_t *out_gpuaddr)
+{
+	unsigned i;
+	uint64_t base;
+	if (!g_l2_nc || !g_gpuva_next || npages == 0u) { return -1; }
+	if ((base = gpu_address((uint64_t)npages * 0x1000ull)) == 0) { return -1; }
+	for (i = 0; i < npages; i++) {
+		uint64_t va = base + (uint64_t)i * 0x1000ull;
+		volatile uint64_t *l3 = gpu_pt_l3_for(va);
+		if (!l3) {
+			gpu_unmap(base, (uint64_t)i * 0x1000ull);
+			gpu_address_free(base, (uint64_t)npages * 0x1000ull);
+			return -1;
+		}
+		l3[(va >> 12) & 0x1FFu] = (pa[i] & Q_ADDRMASK) | GPU_PTE_CORE;
+	}
+	__asm__ volatile("dsb sy" ::: "memory");
+	*out_gpuaddr = base;
+	return 0;
+}
+
+static unsigned
+gpu_stage_q(vm_offset_t smmu, vm_offset_t core, volatile uint32_t *rb, unsigned kk,
+    uint64_t res_pa, vm_offset_t res_nc)
+{
+	vm_offset_t pt_cva = 0, pt_nc, qp_cva = 0, qp_nc;
+	vm_offset_t ib_cva = 0, ib_nc, q2_cva = 0, q2_nc;   /* IB2 buffer + its result page */
+	uint64_t pt_pa = 0, qp_pa = 0, ib_pa = 0, q2_pa = 0, l0_pa, l1_pa, l2_pa, l3_pa;
+	unsigned j, polls;
+	uint32_t qr, ir, fsr;
+	if (gmub_alloc_phys(&pt_cva, &pt_pa, 0x8000u) != 0 ||
+	    gmub_alloc_phys(&qp_cva, &qp_pa, PAGE_SIZE) != 0 ||
+	    gmub_alloc_phys(&ib_cva, &ib_pa, PAGE_SIZE) != 0 ||
+	    gmub_alloc_phys(&q2_cva, &q2_pa, PAGE_SIZE) != 0) {
+		printf("SWEET GMU: [Q] pagetable alloc failed\n"); gmub_flush(); return kk;
+	}
+	if (!(pt_nc = ml_io_map(pt_pa, 0x8000u)) || !(qp_nc = ml_io_map(qp_pa, PAGE_SIZE)) ||
+	    !(ib_nc = ml_io_map(ib_pa, PAGE_SIZE)) || !(q2_nc = ml_io_map(q2_pa, PAGE_SIZE))) {
+		printf("SWEET GMU: [Q] pagetable NC map failed\n"); gmub_flush(); return kk;
+	}
+	gpu_dcache_clean(pt_cva, 0x8000u);   /* drop KMA_ZERO dirty lines before NC use */
+	gpu_dcache_clean(qp_cva, PAGE_SIZE);
+	gpu_dcache_clean(ib_cva, PAGE_SIZE);
+	gpu_dcache_clean(q2_cva, PAGE_SIZE);
+	for (j = 0; j < 0x8000u / 4u; ++j) {
+		((volatile uint32_t *)pt_nc)[j] = 0;         /* zero all table pages */
+	}
+	*(volatile uint32_t *)qp_nc = 0;
+	*(volatile uint32_t *)q2_nc = 0;
+	/* mini-IB2 (at GPU VA 0x100001000): CP_MEM_WRITE 0xF00DCAFE -> VA 0x100002000 (=q2) */
+	((volatile uint32_t *)ib_nc)[0] = cp_type7(0x3Du, 3u);
+	((volatile uint32_t *)ib_nc)[1] = 0x00002000u;   /* ADDR_LO of 0x1_0000_2000 */
+	((volatile uint32_t *)ib_nc)[2] = 0x00000001u;   /* ADDR_HI */
+	((volatile uint32_t *)ib_nc)[3] = 0xF00DCAFEu;
+	__asm__ volatile("dsb sy" ::: "memory");
+	/* 4 table pages bump-allocated from the pool: L0@+0, L1@+0x1000, L2@+0x2000, L3@+0x3000 */
+	l0_pa = pt_pa; l1_pa = pt_pa + 0x1000u; l2_pa = pt_pa + 0x2000u; l3_pa = pt_pa + 0x3000u;
+#define Q_D(off64, val) (*(volatile uint64_t *)(pt_nc + (vm_offset_t)(off64)) = (uint64_t)(val))
+	Q_D(0x0000 + 0 * 8, (l1_pa & Q_ADDRMASK) | 0x3ull);          /* L0[0] -> L1 (table) */
+	Q_D(0x1000 + 0 * 8, (0x00000000ull) | 0xF45ull);             /* L1[0] 1GB id block 0-1G */
+	Q_D(0x1000 + 1 * 8, (0x40000000ull) | 0xF45ull);             /* L1[1] 1-2G */
+	Q_D(0x1000 + 2 * 8, (0x80000000ull) | 0xF45ull);             /* L1[2] 2-3G */
+	Q_D(0x1000 + 3 * 8, (0xC0000000ull) | 0xF45ull);             /* L1[3] 3-4G */
+	Q_D(0x1000 + 4 * 8, (l2_pa & Q_ADDRMASK) | 0x3ull);          /* L1[4] (VA 4-5G) -> L2 */
+	Q_D(0x2000 + 0 * 8, (l3_pa & Q_ADDRMASK) | 0x3ull);          /* L2[0] -> L3 */
+	Q_D(0x3000 + 0 * 8, (qp_pa & Q_ADDRMASK) | 0xE43ull);        /* L3[0] VA 0x100000000 = qp (direct) */
+	Q_D(0x3000 + 1 * 8, (ib_pa & Q_ADDRMASK) | 0xE43ull);        /* L3[1] VA 0x100001000 = IB2 */
+	Q_D(0x3000 + 2 * 8, (q2_pa & Q_ADDRMASK) | 0xE43ull);        /* L3[2] VA 0x100002000 = IB2 result */
+#undef Q_D
+	__asm__ volatile("dsb sy" ::: "memory");
+	/* publish the live pagetable for the KGSL backend (gpu_gpumem_alloc): L3 is at
+	 * pool offset 0x3000; VAs 0,1,2 (0x100000000/1000/2000) are used by Q, so gpumem
+	 * starts at 0x100003000. */
+	g_l3_nc = pt_nc + 0x3000u;
+	g_l1_nc = (volatile uint64_t *)(pt_nc + 0x1000u);       /* L1 table (to grow more L2s) */
+	g_l2_tabs[0] = (volatile uint64_t *)(pt_nc + 0x2000u);  /* L1[4]'s L2 (to grow more L3s) */
+	g_l3_tabs[0][0] = (volatile uint64_t *)(pt_nc + 0x3000u); /* initial L3 = VA 0x1_0000_0000..+2MB */
+	g_l2_nc = g_l2_tabs[0];
+	g_gpuva_next = 0x100003000ull;
+	g_smmu_base = smmu;                                     /* for CB0 FSR fault readback on submit */
+	/* ---- flip CB0 passthrough -> stage-1 (keep S2CR0/SMR0 routing from Stage J) ---- */
+	gpu_wr(smmu, 0x8000u + 0x000u, 0u);                 /* CB0 SCTLR = 0 (disable) */
+	gpu_wr(smmu, 0x1000u + 0x800u, 0x1u);               /* GR1 CBA2R0 = VA64 */
+	gpu_wr(smmu, 0x1000u + 0x000u, 0x1F300u);           /* GR1 CBAR0 = S1_TRANS_S2_BYPASS|WB|NSH */
+	gpu_wr(smmu, 0x8000u + 0x010u, 0x38012u);           /* CB0 TCR2 (PASIZE40|AS|SEP_UPSTREAM) */
+	gpu_wr(smmu, 0x8000u + 0x030u, 0x2010u);            /* CB0 TCR (ias48 T0SZ0x10 NC-walk) */
+	gpu_wr(smmu, 0x8000u + 0x020u, (uint32_t)l0_pa);    /* CB0 TTBR0 lo (pgd=L0, ASID0) */
+	gpu_wr(smmu, 0x8000u + 0x024u, (uint32_t)(l0_pa >> 32)); /* TTBR0 hi */
+	gpu_wr(smmu, 0x8000u + 0x028u, 0u);                 /* TTBR1 lo */
+	gpu_wr(smmu, 0x8000u + 0x02Cu, 0u);                 /* TTBR1 hi */
+	gpu_wr(smmu, 0x8000u + 0x038u, 0xF404FF44u);        /* CB0 MAIR0 (NC@0,WB@1,dev@2) */
+	gpu_wr(smmu, 0x8000u + 0x03Cu, 0u);                 /* CB0 MAIR1 */
+	__asm__ volatile("dsb sy" ::: "memory");
+	gpu_wr(smmu, 0x8000u + 0x000u, 0x1067u);            /* CB0 SCTLR = M|TRE|AFE|CFRE|CFIE|ASIDPNE */
+	__asm__ volatile("dsb sy" ::: "memory");
+	gpu_wr(smmu, 0x8000u + 0x610u, 0u);                 /* CB0 S1_TLBIASID = 0 */
+	gpu_wr(smmu, 0x8000u + 0x7F0u, 0u);                 /* CB0 TLBSYNC */
+	for (polls = 0; polls < 2000u; ++polls) {
+		if (!(gpu_rd(smmu, 0x8000u + 0x7F4u) & 1u)) {
+			break;
+		}
+		gmub_udelay(1);
+	}
+	printf("SWEET GMU: [Q] stage-1 ENABLED: l0_pa=%#llx qp_pa=%#llx sctlr=%#x tlbsync_polls=%u\n",
+	    (unsigned long long)l0_pa, (unsigned long long)qp_pa,
+	    gpu_rd(smmu, 0x8000u + 0x000u), polls);
+	gmub_flush();
+	/* ---- CP_MEM_WRITE to the VIRTUAL addr 0x100000000; CP is 64-bit (ADDR_MODE=1) ---- */
+	rb[kk++] = cp_type7(0x3Du, 3u);        /* CP_MEM_WRITE 1 dword -> direct VA test */
+	rb[kk++] = 0x00000000u;                /* ADDR_LO (0x1_0000_0000) */
+	rb[kk++] = 0x00000001u;                /* ADDR_HI */
+	rb[kk++] = 0xDEADBEEFu;
+	/* CP_INDIRECT_BUFFER (IB1->IB2): jump to the mini-IB at GPU VA 0x1_0000_1000 (4 dwords).
+	 * Proves IB-list submit (what KGSL/freedreno use) + IB fetched from a translated VA. */
+	rb[kk++] = cp_type7(0x3Fu, 3u);        /* CP_INDIRECT_BUFFER */
+	rb[kk++] = 0x00001000u;                /* IB2 ADDR_LO (0x1_0000_1000) */
+	rb[kk++] = 0x00000001u;                /* IB2 ADDR_HI */
+	rb[kk++] = 4u;                         /* IB2 size in dwords */
+	rb[kk++] = cp_type7(0x46u, 4u);        /* CACHE_FLUSH_TS -> res+0xD0 seqno (phys, identity) */
+	rb[kk++] = 0x00000004u;
+	rb[kk++] = (uint32_t)(res_pa + 0xD0u);
+	rb[kk++] = (uint32_t)((res_pa + 0xD0u) >> 32);
+	rb[kk++] = 0x0000D00Du;
+	rb[kk++] = cp_type7(38u, 0u);          /* WFI */
+	*(volatile uint32_t *)(res_nc + 0xD0u) = 0;
+	__asm__ volatile("dsb sy" ::: "memory");
+	gmub_flush();
+	gpu_wr(core, 0x807u << 2, kk);         /* CP_RB_WPTR doorbell (resume CP under translation) */
+	__asm__ volatile("dsb sy" ::: "memory");
+	for (polls = 0; polls < 200000u; ++polls) {
+		if (*(volatile uint32_t *)(res_nc + 0xD0u) == 0x0000D00Du) {
+			break;
+		}
+		gmub_udelay(10);
+	}
+	qr = *(volatile uint32_t *)qp_nc;      /* direct VA write result */
+	ir = *(volatile uint32_t *)q2_nc;      /* IB2 (CP_INDIRECT_BUFFER) result */
+	fsr = gpu_rd(smmu, 0x8000u + 0x058u);  /* CB0 FSR; bits9-10=FORMAT (benign), real faults elsewhere */
+	printf("SWEET GMU: [Q] STAGE-1 XLATE: va0x100000000=%#x(exp deadbeef) IB2 va0x100002000=%#x"
+	    "(exp f00dcafe) fsr=%#x(fault=%#x) far=%#x_%#x rptr=%#x polls=%u -> %s\n",
+	    qr, ir, fsr, fsr & ~0x600u,   /* mask FORMAT[10:9] to show real-fault bits only */
+	    gpu_rd(smmu, 0x8000u + 0x064u), gpu_rd(smmu, 0x8000u + 0x060u),
+	    gpu_rd(core, 0x806u << 2), polls,
+	    (qr == 0xDEADBEEFu && ir == 0xF00DCAFEu && (fsr & ~0x600u) == 0u) ?
+	    "GPU VIRTUAL ADDRESSING + IB2 WORK = STAGE-1 + INDIRECT_BUFFER OK" :
+	    (qr == 0xDEADBEEFu && (fsr & ~0x600u) == 0u) ? "direct VA ok, IB2 FAILED (CP_INDIRECT_BUFFER)" :
+	    (fsr & 2u) ? "TRANSLATION FAULT (FSR.TF) - check pagetable" :
+	    (polls >= 200000u) ? "TIMEOUT (CP wedged - identity map wrong)" : "FAIL");
+	gmub_flush();
+	return kk;
+}
+
+/* ---- Stage S: KGSL BACKEND (in-kernel exercise of the UAPI core). Uses the live
+ * stage-1 pagetable from Stage Q. Allocates two gpumem buffers at kernel-assigned GPU
+ * VAs (the GPUMEM_ALLOC path), writes a mini command-IB into one that stores a magic to
+ * the other's GPU VA, submits it via CP_INDIRECT_BUFFER (the GPU_COMMAND path), and
+ * verifies the store landed (the WAITTIMESTAMP completion). This is the backend the
+ * /dev/kgsl-3d0 ioctls will call; proving it in-kernel defers the userland cdev/mmap +
+ * LaunchDaemon (operator step) while validating the GPU-facing logic. ---- */
+static unsigned
+gpu_stage_s(vm_offset_t core, volatile uint32_t *rb, unsigned kk, uint64_t res_pa,
+    vm_offset_t res_nc)
+{
+	uint64_t ib_va = 0, dst_va = 0;
+	vm_offset_t ib_nc, dst_nc;
+	unsigned polls;
+	uint32_t got;
+	if (gpu_gpumem_alloc(PAGE_SIZE, &ib_va, &ib_nc, NULL, NULL) != 0 ||
+	    gpu_gpumem_alloc(PAGE_SIZE, &dst_va, &dst_nc, NULL, NULL) != 0) {
+		printf("SWEET GMU: [S] gpumem_alloc failed (stage-1 up?)\n"); gmub_flush(); return kk;
+	}
+	*(volatile uint32_t *)dst_nc = 0;
+	/* command-IB in ib_va: CP_MEM_WRITE 0x5AFE600D -> dst_va (both kernel-assigned VAs) */
+	((volatile uint32_t *)ib_nc)[0] = cp_type7(0x3Du, 3u);
+	((volatile uint32_t *)ib_nc)[1] = (uint32_t)dst_va;
+	((volatile uint32_t *)ib_nc)[2] = (uint32_t)(dst_va >> 32);
+	((volatile uint32_t *)ib_nc)[3] = 0x5AFE600Du;
+	gpu_dcache_clean(ib_nc, PAGE_SIZE);    /* cva is cacheable: flush IB + cleared dst to DRAM */
+	gpu_dcache_clean(dst_nc, PAGE_SIZE);
+	__asm__ volatile("dsb sy" ::: "memory");
+	/* submit (GPU_COMMAND): ring CP_INDIRECT_BUFFER -> ib_va, then CACHE_FLUSH_TS */
+	rb[kk++] = cp_type7(0x3Fu, 3u);
+	rb[kk++] = (uint32_t)ib_va;
+	rb[kk++] = (uint32_t)(ib_va >> 32);
+	rb[kk++] = 4u;
+	rb[kk++] = cp_type7(0x46u, 4u);
+	rb[kk++] = 0x00000004u;
+	rb[kk++] = (uint32_t)(res_pa + 0xE0u);
+	rb[kk++] = (uint32_t)((res_pa + 0xE0u) >> 32);
+	rb[kk++] = 0x0000600Du;
+	rb[kk++] = cp_type7(38u, 0u);
+	*(volatile uint32_t *)(res_nc + 0xE0u) = 0;
+	__asm__ volatile("dsb sy" ::: "memory");
+	gmub_flush();
+	gpu_wr(core, 0x807u << 2, kk);              /* CP_RB_WPTR doorbell */
+	__asm__ volatile("dsb sy" ::: "memory");
+	for (polls = 0; polls < 200000u; ++polls) {
+		if (*(volatile uint32_t *)(res_nc + 0xE0u) == 0x0000600Du) {
+			break;
+		}
+		gmub_udelay(10);
+	}
+	gpu_dcache_clean(dst_nc, PAGE_SIZE);    /* invalidate so the CPU re-reads the GPU-written DRAM */
+	got = *(volatile uint32_t *)dst_nc;
+	printf("SWEET GMU: [S] KGSL BACKEND: gpumem ib_va=%#llx dst_va=%#llx submit-IB readback=%#x"
+	    "(exp 5afe600d) polls=%u -> %s\n", (unsigned long long)ib_va,
+	    (unsigned long long)dst_va, got, polls,
+	    (got == 0x5AFE600Du) ? "GPUMEM ALLOC + IB SUBMIT BACKEND OK" : "FAIL");
+	gmub_flush();
+	return kk;
+}
+
+/* ===================== the GMU's memory and its messages (HFI) ===================== */
+/*
+ * Ported from HackiOS redwood_adreno.c steps 13-17 (step_gmu_space, the queue table of
+ * step_gmu_start, hfi_send/hfi_receive, the tables of step_core_power), with what the a618 takes
+ * from davinci's own kernel (kgsl_gmu.c, kgsl_hfi.c, adreno_a6xx_gmu.c; davinci's dt has
+ * qcom,gpu-quirk-hfi-use-reg) and Linux's legacy path (a6xx_hfi_start_v1).
+ *
+ * The GMU reaches the memory it shares with us as stream 5 (dt: gmu_kernel, iommus = <&kgsl_smmu 5>).
+ * No stream-match entry existed for it, so with sCR0.USFCFG set its first request for memory -- the
+ * queue table, at HFI_CTRL_INIT -- was an unidentified-stream fault, and HFI was skipped; without
+ * HFI the GMU has no table of speeds, and the DCVS request faulted its processor. Here the stream
+ * gets an entry of the stream table, routed to a context bank of its own with tables of ours, as
+ * HackiOS gives its GMU context 1 (space_on); what lies outside the map is a context fault there.
+ * The GMU's addresses are the vendor's (allocate_gmu_kmem): the page the firmware wants at
+ * 0x60000000 first, then the crash-dump buffer of H2F_MSG_INIT, the log and the queues.
+ */
+#define GMUS_VA          0x60000000u
+#define GMUS_DEBUG_OFF   0x1000u         /* 16K */
+#define GMUS_DEBUG_SIZE  0x4000u
+#define GMUS_LOG_OFF     0x5000u         /* 4K, vendor LOGMEM_SIZE */
+#define GMUS_LOG_SIZE    0x1000u
+#define GMUS_HFI_OFF     0x6000u         /* the table and four queues of 4K (vendor HFIMEM_SIZE) */
+#define GMUS_SIZE        0xC000u         /* three 16K pages */
+#define GMUS_SID         GMUB_GMU_SID_KERNEL
+#define GMUB_HFI_VERSION_INFO 0x1F981u
+
+static vm_offset_t g_gmus_nc;            /* uncached view of the GMU's memory */
+static uint64_t    g_gmus_pa;
+static vm_offset_t g_gmus_smmu;
+static int         g_gmus_cb = -1, g_gmus_smr = -1;
+static int         g_hfi_up;             /* the tables are the GMU's: DCVS by register can be asked */
+static uint32_t    g_hfi_seq, g_hfi_version;
+
+/* What the context bank of the GMU has recorded of a request it refused; cleared after. */
+static bool
+gmu_space_faulted(const char *when)
+{
+	uint32_t cbo, fsr;
+	if (g_gmus_cb < 0) {
+		return false;
+	}
+	cbo = 0x8000u + 0x1000u * (uint32_t)g_gmus_cb;
+	fsr = gpu_rd(g_gmus_smmu, cbo + 0x58u);
+	if ((fsr & ~(3u << 9)) == 0) {               /* bits 10:9 only say the format of the syndrome */
+		return false;
+	}
+	printf("SWEET GMU: THE SMMU REFUSED THE GMU (%s): fsr %#x far %#x%08x fsynr0 %#x\n", when, fsr,
+	    gpu_rd(g_gmus_smmu, cbo + 0x64u), gpu_rd(g_gmus_smmu, cbo + 0x60u), gpu_rd(g_gmus_smmu, cbo + 0x68u));
+	gpu_wr(g_gmus_smmu, cbo + 0x58u, fsr);
+	return true;
+}
+
+/*
+ * The GMU's memory, mapped at its addresses in tables of ours, given to a context bank that
+ * translates nothing yet, and stream 5 sent through it by a stream-match entry not in use. Every
+ * global register written is read back (the hypervisor decides what of them is taken): anything
+ * not as written undoes the entry, and the GMU is left as before (no HFI).
+ */
+static int
+gmu_space_on(vm_offset_t smmu)
+{
+	volatile uint64_t *t0, *t1, *t2, *t3;
+	uint64_t l0 = 0, l1 = 0, l2 = 0, l3 = 0;
+	vm_offset_t cva = 0;
+	uint32_t cbo, i;
+	unsigned polls;
+	int cb = -1, smr = -1;
+
+	for (i = 0; i < 5u; i++) {
+		printf("SWEET GMU: [M] smr%u=%#x s2cr%u=%#x cbar%u=%#x cba2r%u=%#x cb%u sctlr=%#x\n", i,
+		    gpu_rd(smmu, 0x800u + 4u * i), i, gpu_rd(smmu, 0xC00u + 4u * i), i, gpu_rd(smmu, 0x1000u + 4u * i),
+		    i, gpu_rd(smmu, 0x1800u + 4u * i), i, gpu_rd(smmu, 0x8000u + 0x1000u * i));
+	}
+	gmub_flush();
+	for (i = 1; i < 5u && smr < 0; i++) {        /* 0 is the 3D core's */
+		if (!(gpu_rd(smmu, 0x800u + 4u * i) & 0x80000000u)) {
+			smr = (int)i;
+		}
+	}
+	for (i = 4; i >= 1u && cb < 0; i--) {        /* a bank no valid entry sends to, that translates nothing */
+		uint32_t j;
+		bool used = gpu_rd(smmu, 0x1000u + 4u * i) != 0 || (gpu_rd(smmu, 0x8000u + 0x1000u * i) & 1u);
+		for (j = 0; j < 5u && !used; j++) {
+			uint32_t s2cr = gpu_rd(smmu, 0xC00u + 4u * j);
+			used = (gpu_rd(smmu, 0x800u + 4u * j) & 0x80000000u) && ((s2cr >> 16) & 3u) == 0 && (s2cr & 0xFFu) == i;
+		}
+		if (!used) {
+			cb = (int)i;
+		}
+	}
+	if (smr < 0 || cb < 0) {
+		printf("SWEET GMU: [M] no stream entry (%d) or context bank (%d) free for the GMU\n", smr, cb);
+		return -1;
+	}
+	if (gmub_alloc_phys(&cva, &g_gmus_pa, GMUS_SIZE) != 0) {
+		printf("SWEET GMU: [M] no memory for the GMU\n");
+		return -1;
+	}
+	gpu_dcache_clean(cva, GMUS_SIZE);            /* the zeroed cacheable lines, before the uncached view */
+	if (!(g_gmus_nc = ml_io_map(g_gmus_pa, GMUS_SIZE))) {
+		return -1;
+	}
+	for (i = 0; i < GMUS_SIZE / 4u; i++) {
+		((volatile uint32_t *)g_gmus_nc)[i] = 0;
+	}
+	if (!(t0 = gpu_pt_table(&l0)) || !(t1 = gpu_pt_table(&l1)) || !(t2 = gpu_pt_table(&l2)) ||
+	    !(t3 = gpu_pt_table(&l3))) {
+		return -1;
+	}
+	t0[0] = (l1 & Q_ADDRMASK) | 0x3ull;
+	t1[(GMUS_VA >> 30) & 0x1FFu] = (l2 & Q_ADDRMASK) | 0x3ull;
+	t2[(GMUS_VA >> 21) & 0x1FFu] = (l3 & Q_ADDRMASK) | 0x3ull;
+	for (i = 0; i < GMUS_SIZE / 0x1000u; i++) {
+		t3[((GMUS_VA >> 12) & 0x1FFu) + i] = ((g_gmus_pa + 0x1000ull * i) & Q_ADDRMASK) | GPU_PTE_CORE;
+	}
+	__asm__ volatile("dsb sy" ::: "memory");
+
+	/* the bank, as CB0 is (gpu_stage_q) */
+	cbo = 0x8000u + 0x1000u * (uint32_t)cb;
+	gpu_wr(smmu, cbo + 0x000u, 0u);
+	gpu_wr(smmu, 0x1800u + 4u * (uint32_t)cb, 0x1u);         /* CBA2R: VA64 */
+	gpu_wr(smmu, 0x1000u + 4u * (uint32_t)cb, 0x1F300u);     /* CBAR: S1 translate, S2 bypass */
+	gpu_wr(smmu, cbo + 0x010u, 0x38012u);                    /* TCR2 */
+	gpu_wr(smmu, cbo + 0x030u, 0x2010u);                     /* TCR */
+	gpu_wr(smmu, cbo + 0x020u, (uint32_t)l0);
+	gpu_wr(smmu, cbo + 0x024u, (uint32_t)(l0 >> 32));        /* ASID 0, private to the bank (ASIDPNE) */
+	gpu_wr(smmu, cbo + 0x028u, 0u);
+	gpu_wr(smmu, cbo + 0x02Cu, 0u);
+	gpu_wr(smmu, cbo + 0x038u, 0xF404FF44u);                 /* MAIR0 */
+	gpu_wr(smmu, cbo + 0x03Cu, 0u);
+	gpu_wr(smmu, cbo + 0x058u, 0xFFFFFFFFu);                 /* FSR: nothing recorded */
+	__asm__ volatile("dsb sy" ::: "memory");
+	gpu_wr(smmu, cbo + 0x000u, 0x1067u);                     /* SCTLR: M|TRE|AFE|CFRE|CFIE|ASIDPNE; faults terminate */
+	gpu_wr(smmu, cbo + 0x610u, 0u);
+	gpu_wr(smmu, cbo + 0x7F0u, 0u);
+	for (polls = 0; polls < 2000u && (gpu_rd(smmu, cbo + 0x7F4u) & 1u); polls++) {
+		gmub_udelay(1);
+	}
+	/* then the stream: where it goes first, then the entry that matches it (space_on's order) */
+	gpu_wr(smmu, 0xC00u + 4u * (uint32_t)smr, (uint32_t)cb); /* S2CR: TYPE translate, CBNDX */
+	gpu_wr(smmu, 0x800u + 4u * (uint32_t)smr, 0x80000000u | GMUS_SID);
+	__asm__ volatile("dsb sy" ::: "memory");
+	if (gpu_rd(smmu, 0x800u + 4u * (uint32_t)smr) != (0x80000000u | GMUS_SID) ||
+	    (gpu_rd(smmu, 0xC00u + 4u * (uint32_t)smr) & 0x300FFu) != (uint32_t)cb ||
+	    (gpu_rd(smmu, 0x1000u + 4u * (uint32_t)cb) & 0x30000u) != 0x10000u ||
+	    !(gpu_rd(smmu, cbo) & 1u) || gpu_rd(smmu, cbo + 0x020u) != (uint32_t)l0) {
+		printf("SWEET GMU: [M] the SMMU did not take it: smr%d=%#x s2cr=%#x cbar%d=%#x sctlr=%#x ttbr0=%#x; undone\n",
+		    smr, gpu_rd(smmu, 0x800u + 4u * (uint32_t)smr), gpu_rd(smmu, 0xC00u + 4u * (uint32_t)smr), cb,
+		    gpu_rd(smmu, 0x1000u + 4u * (uint32_t)cb), gpu_rd(smmu, cbo), gpu_rd(smmu, cbo + 0x020u));
+		gpu_wr(smmu, 0x800u + 4u * (uint32_t)smr, 0u);
+		gpu_wr(smmu, cbo, 0u);
+		return -1;
+	}
+	g_gmus_smmu = smmu;
+	g_gmus_cb = cb;
+	g_gmus_smr = smr;
+	printf("SWEET GMU: [M] the GMU's stream %u goes through context bank %d (stream entry %d): %#x bytes at its %#x "
+	    "(pa %#llx), tables at %#llx\n", GMUS_SID, cb, smr, GMUS_SIZE, GMUS_VA, (unsigned long long)g_gmus_pa,
+	    (unsigned long long)l0);
+	gmub_flush();
+	return 0;
+}
+
+/* The queue table at the head of the HFI memory, as the vendor's hfi_init lays it out for a legacy GMU. */
+struct gmus_qhdr {
+	uint32_t status, start_addr, type, queue_size, msg_size, drop_cnt, rx_wm, tx_wm, rx_req, tx_req, read_index, write_index;
+};
+#define HFI_QUEUES       4u
+#define HFI_TABLE_BYTES  (24u + 48u * HFI_QUEUES)
+#define HFI_QUEUE_AT(i)  (((HFI_TABLE_BYTES + 15u) & ~15u) + 0x1000u * (i))
+#define HFI_QUEUE_WORDS  1024u
+#define HFI_CMD_Q        0u
+#define HFI_MSG_Q        1u
+#define HFI_DBG_Q        2u
+
+static volatile uint32_t *
+hfi_mem(uint32_t off)
+{
+	return (volatile uint32_t *)(g_gmus_nc + GMUS_HFI_OFF + off);
+}
+static volatile struct gmus_qhdr *
+hfi_q(uint32_t q)
+{
+	return (volatile struct gmus_qhdr *)hfi_mem(24u + 48u * q);
+}
+
+static void
+hfi_table_init(void)
+{
+	/* queue ids of the legacy firmware (a630, a615 family): message 4, debug 5, dispatch 1 */
+	static const uint8_t idx[HFI_QUEUES] = { 0, 4, 5, 1 }, pri[HFI_QUEUES] = { 10, 10, 40, 20 }, on[HFI_QUEUES] = { 1, 1, 1, 0 };
+	volatile uint32_t *t = hfi_mem(0);
+	uint32_t i;
+	t[0] = 0;                                    /* version */
+	t[1] = HFI_TABLE_BYTES / 4u;
+	t[2] = 24u / 4u;                             /* first queue header */
+	t[3] = 48u / 4u;                             /* a header's words */
+	t[4] = HFI_QUEUES;
+	t[5] = HFI_QUEUES;
+	for (i = 0; i < HFI_QUEUES; i++) {
+		volatile struct gmus_qhdr *h = hfi_q(i);
+		h->status = on[i];
+		h->start_addr = GMUS_VA + GMUS_HFI_OFF + HFI_QUEUE_AT(i);
+		h->type = (uint32_t)idx[i] | (uint32_t)pri[i] << 8;
+		h->queue_size = HFI_QUEUE_WORDS;
+		h->msg_size = 0;
+		h->drop_cnt = 0;
+		h->rx_wm = 1;
+		h->tx_wm = 1;
+		h->rx_req = 1;
+		h->tx_req = 0;
+		h->read_index = 0;
+		h->write_index = 0;
+	}
+	__asm__ volatile("dsb sy" ::: "memory");
+}
+
+/* One message out of a queue of the GMU's into `out` (words); 0 if there is none. */
+static uint32_t
+hfi_read(uint32_t q, uint32_t *out, uint32_t max)
+{
+	volatile struct gmus_qhdr *h = hfi_q(q);
+	volatile uint32_t *data = hfi_mem(HFI_QUEUE_AT(q));
+	uint32_t r = h->read_index, words, i;
+	if (r == h->write_index) {
+		h->rx_req = 1;
+		return 0;
+	}
+	words = r < HFI_QUEUE_WORDS ? (data[r] >> 8) & 0xFFu : 0;
+	if (words == 0 || words > max) {             /* not a message we can take: drop what is there */
+		printf("SWEET GMU: HFI queue %u: bad message %#x at %u; dropped\n", q, r < HFI_QUEUE_WORDS ? data[r] : 0, r);
+		h->read_index = h->write_index;
+		return 0;
+	}
+	for (i = 0; i < words; i++) {
+		out[i] = data[r];
+		r = (r + 1u) % HFI_QUEUE_WORDS;
+	}
+	if ((g_hfi_version >> 28) >= 2u) {
+		r = ((r + 3u) & ~3u) % HFI_QUEUE_WORDS;
+	}
+	h->read_index = r;
+	return words;
+}
+
+/* Send a message (its first word made here) and wait for the GMU's answer to it: 0 if it accepts. */
+static int
+hfi_send(const char *what, uint32_t id, uint32_t *msg, uint32_t words, uint32_t *answer)
+{
+	volatile struct gmus_qhdr *h = hfi_q(HFI_CMD_Q);
+	volatile uint32_t *data = hfi_mem(HFI_QUEUE_AT(HFI_CMD_Q));
+	uint32_t seq = ++g_hfi_seq & 0xFFFu, w = h->write_index, i, got[24], n, err = 0;
+	unsigned rounds, polls;
+	bool answered = false;
+
+	msg[0] = seq << 20 | words << 8 | id;        /* type 0: a command */
+	for (i = 0; i < words; i++) {
+		data[w] = msg[i];
+		w = (w + 1u) % HFI_QUEUE_WORDS;
+	}
+	if ((g_hfi_version >> 28) >= 2u) {
+		for (; w % 4u; w = (w + 1u) % HFI_QUEUE_WORDS) {
+			data[w] = 0xFAFAFAFAu;
+		}
+	}
+	__asm__ volatile("dsb sy" ::: "memory");
+	h->write_index = w;
+	__asm__ volatile("dsb sy" ::: "memory");
+	gmub_wr(GMUB_HOST2GMU_INTR_SET, 1u);
+	for (rounds = 0; rounds < 3u && !answered; rounds++) {
+		for (polls = 0; polls < 100000u && !(gmub_rd(GMUB_GMU2HOST_INTR_INFO) & 1u); polls++) {
+			gmub_udelay(1);
+		}
+		if (!(gmub_rd(GMUB_GMU2HOST_INTR_INFO) & 1u)) {
+			break;
+		}
+		gmub_wr(GMUB_GMU2HOST_INTR_CLR, 1u);
+		while ((n = hfi_read(HFI_MSG_Q, got, 24u)) != 0) {
+			uint32_t type = (got[0] >> 16) & 0xFu;
+			if ((type == 2u || type == 1u) && n >= 3u && ((got[1] >> 20) & 0xFFFu) == seq) {
+				answered = true;
+				err = got[2];
+				if (answer) {
+					for (i = 0; i < n && i < 8u; i++) {
+						answer[i] = got[i];
+					}
+				}
+			} else if ((got[0] & 0xFFu) == 100u) {   /* F2H_MSG_ERR */
+				got[n < 24u ? n : 23u] = 0;
+				printf("SWEET GMU: THE GMU REPORTS AN ERROR: %u %u \"%s\"\n", got[1] >> 16, got[1] & 0xFFFFu,
+				    n > 2u ? (const char *)&got[2] : "");
+			} else {
+				printf("SWEET GMU: the GMU says %#x %#x %#x %#x (%u words)\n", got[0], n > 1u ? got[1] : 0,
+				    n > 2u ? got[2] : 0, n > 3u ? got[3] : 0, n);
+			}
+		}
+	}
+	for (i = 0; i < 32u && hfi_read(HFI_DBG_Q, got, 24u) != 0; i++) {
+	}
+	if (!answered || err != 0) {
+		printf("SWEET GMU: [HFI] the GMU %s %s (%#x); fw_init %#x intr_info %#x\n", answered ? "refuses" : "does not answer",
+		    what, err, gmub_rd(GMUB_CM3_FW_INIT_RESULT), gmub_rd(GMUB_GMU2HOST_INTR_INFO));
+		(void)gmu_space_faulted(what);
+		gmub_flush();
+		return -1;
+	}
+	printf("SWEET GMU: [HFI] the GMU accepts %s\n", what);
+	return 0;
+}
+
+/*
+ * The speeds: davinci's dt has one table per speed bin (qcom,gpu-pwrlevel-bins), the bin read from
+ * the fuse at qfprom 0x780000 + 0x41a0, bits 28:21 (qcom,gpu-speed-bin). The supply level of each
+ * speed is the lowest corner of gpucc-sdmmagpie.c's gfx3d rate_max that allows it.
+ */
+static const struct {
+	uint32_t bin, n;
+	uint16_t mhz[8];
+} gpu_bins[] = {
+	{ 0x00u, 8, { 825, 800, 650, 565, 430, 355, 267, 180 } },
+	{ 0xACu, 8, { 825, 800, 650, 565, 430, 355, 267, 180 } },
+	{ 0xA7u, 7, { 800, 650, 565, 430, 355, 267, 180 } },
+	{ 0x92u, 7, { 700, 650, 565, 430, 355, 267, 180 } },
+	{ 0x80u, 6, { 610, 565, 430, 355, 267, 180 } },
+};
+static uint32_t g_gpu_nlevels;               /* the bin's levels: 0 the fastest */
+static uint32_t g_bw_levels = 1;             /* levels of the bus table sent (1: "off" only) */
+/* dt qcom,gpu-pwrlevel qcom,bus-freq, the same for every bin by speed; the index into grp3d's
+ * qcom,msm-bus,vectors-KBps, whose ib values (KB/s) are g_bus_kbps */
+static uint32_t
+bus_level(uint32_t mhz)
+{
+	return mhz >= 700 ? 11 : mhz >= 650 ? 10 : mhz >= 565 ? 9 : mhz >= 430 ? 8 : mhz >= 355 ? 7 : mhz >= 267 ? 6 : 4;
+}
+static const uint32_t g_bus_kbps[12] = { 0, 400000, 800000, 1200000, 1804000, 2188000, 2724000, 3296000, 4068000,
+	5412000, 6220000, 7216000 };
+static uint16_t g_gpu_mhz[8];
+
+static uint32_t
+gx_corner(uint32_t mhz)
+{
+	static const uint16_t top[8] = { 180, 267, 355, 430, 565, 650, 800, 825 };
+	static const uint16_t corner[8] = { 48, 64, 128, 192, 256, 320, 384, 416 };
+	unsigned i;
+	for (i = 0; i < 8u; i++) {
+		if (mhz <= top[i]) {
+			return corner[i];
+		}
+	}
+	return 416;
+}
+
+/* The vendor's setup_volt_dependency_tbl: a level, its place in the rail's list, the memories' rail's place. */
+static int
+arc_vote(uint32_t vlvl, const uint16_t *pri, unsigned npri, const uint16_t *sec, unsigned nsec, uint32_t *vote)
+{
+	unsigned k, j;
+	for (k = 0; k < npri && pri[k] < vlvl; k++) {
+	}
+	if (k == npri || nsec == 0) {
+		return -1;
+	}
+	for (j = 0; j < nsec; j++) {
+		if (sec[j] >= pri[k] || j + 1u == nsec) {
+			break;
+		}
+	}
+	*vote = (uint32_t)pri[k] << 16 | j << 8 | k;
+	return 0;
+}
+
+/* An entry of cmd-db by name: its RPMh address and (if asked) its list of levels. */
+static unsigned g_cmddb_auxwords;            /* the last entry's aux data, in 16-bit words */
+static int
+cmddb_find(const char *name, uint32_t *addr, uint16_t *vals, unsigned *nvals)
+{
+	static vm_offset_t db;
+	unsigned s, e, b, k, len = 0;
+	while (len < 8u && name[len]) {
+		len++;
+	}
+	if (!db) {
+		vm_offset_t loc = ml_io_map(CMDDB_LOCATOR_PA, 8);
+		uint32_t base, size;
+		if (!loc) {
+			return -1;
+		}
+		base = *(volatile uint32_t *)loc;
+		size = *(volatile uint32_t *)(loc + 4);
+		if (!base || size < 144u || size > 0x80000u || !(db = ml_io_map(base, size)) ||
+		    *(volatile uint32_t *)(db + 4) != CMDDB_MAGIC) {
+			db = 0;
+			return -1;
+		}
+	}
+	for (s = 0; s < 8u; s++) {
+		vm_offset_t rsc = db + 8u + 16u * s, data = db + 144u;
+		uint16_t hoff = *(volatile uint16_t *)(rsc + 2), doff = *(volatile uint16_t *)(rsc + 4);
+		uint16_t cnt = *(volatile uint16_t *)(rsc + 6);
+		if (*(volatile uint16_t *)rsc == 0) {
+			continue;
+		}
+		for (e = 0; e < cnt; e++) {
+			vm_offset_t ent = data + hoff + 24u * e;
+			bool match = true;
+			for (b = 0; b < len && match; b++) {
+				match = *(volatile char *)(ent + b) == name[b];
+			}
+			if (!match || (len < 8u && *(volatile char *)(ent + len) != 0)) {
+				continue;
+			}
+			*addr = *(volatile uint32_t *)(ent + 16);
+			if (vals) {
+				uint16_t l = *(volatile uint16_t *)(ent + 20), off = *(volatile uint16_t *)(ent + 22);
+				unsigned c = l >> 1, n = 1;
+				g_cmddb_auxwords = c;
+				if (c > 16u) {
+					c = 16u;
+				}
+				for (k = 0; k < c; k++) {
+					vals[k] = *(volatile uint16_t *)(data + doff + off + 2u * k);
+				}
+				while (n < c && !(vals[n - 1] != 0 && vals[n] == 0)) {
+					n++;
+				}
+				*nvals = c == 0 ? 0 : n;
+			}
+			return 0;
+		}
+	}
+	return -1;
+}
+
+/* The tables, made before the GMU starts (its boot vote comes from them too). */
+static uint32_t g_perf[3 + 32 + 8];          /* H2F_MSG_PERF_TBL, v1: header, levels, gx {vote, kHz}[16], cx {vote, kHz}[4] */
+static uint32_t g_bw[1 + 5 + 6 + 12 + 8 + 128];  /* H2F_MSG_BW_VOTE_TBL */
+static uint32_t g_boot_gx = 2, g_boot_mx = 2;
+static bool     g_tables;
+
+static void
+hfi_tables(void)
+{
+	uint16_t gfx[16], cx[16], mx[16];
+	unsigned ngfx = 0, ncx = 0, nmx = 0, i, b;
+	uint32_t a, bin = 0xFFFFFFFFu, sh0 = 0, mc0 = 0, acv = 0, cn0 = 0, n;
+	vm_offset_t q = ml_io_map(0x00784000u, 0x1000u);
+
+	if (q) {
+		bin = (*(volatile uint32_t *)(q + 0x1A0u) & 0x1FE00000u) >> 21;
+	}
+	for (b = 0; b < sizeof(gpu_bins) / sizeof(gpu_bins[0]) && gpu_bins[b].bin != bin; b++) {
+	}
+	if (b == sizeof(gpu_bins) / sizeof(gpu_bins[0])) {
+		printf("SWEET GMU: [T] speed bin %#x is not in davinci's dt: the slowest bin's table\n", bin);
+		b = sizeof(gpu_bins) / sizeof(gpu_bins[0]) - 1u;
+	}
+	g_gpu_nlevels = gpu_bins[b].n;
+	for (i = 0; i < g_gpu_nlevels; i++) {
+		g_gpu_mhz[i] = gpu_bins[b].mhz[i];
+	}
+	if (cmddb_find("gfx.lvl", &a, gfx, &ngfx) || cmddb_find("cx.lvl", &a, cx, &ncx) ||
+	    cmddb_find("mx.lvl", &a, mx, &nmx) || cmddb_find("SH0", &sh0, NULL, NULL) ||
+	    cmddb_find("MC0", &mc0, NULL, NULL) || cmddb_find("ACV", &acv, NULL, NULL) ||
+	    cmddb_find("CN0", &cn0, NULL, NULL)) {
+		printf("SWEET GMU: [T] cmd-db lacks a rail or a bus resource (SH0 %#x MC0 %#x ACV %#x CN0 %#x)\n", sh0, mc0, acv, cn0);
+		return;
+	}
+	/* speeds ascending, 0 first (the vendor's gpu_freqs: the dt's levels backwards, its last the 0 Hz one) */
+	n = g_gpu_nlevels + 1u;
+	g_perf[1] = n;
+	g_perf[2] = 2;
+	for (i = 0; i < n; i++) {
+		uint32_t mhz = i == 0 ? 0 : g_gpu_mhz[g_gpu_nlevels - i];
+		if (arc_vote(mhz ? gx_corner(mhz) : 0, gfx, ngfx, mx, nmx, &g_perf[3 + 2 * i])) {
+			printf("SWEET GMU: [T] no gfx level for %u MHz\n", mhz);
+			return;
+		}
+		g_perf[4 + 2 * i] = mhz * 1000u;
+	}
+	if (arc_vote(0, cx, ncx, mx, nmx, &g_perf[35]) || arc_vote(48, cx, ncx, mx, nmx, &g_perf[37])) {
+		return;
+	}
+	g_perf[36] = 0;
+	g_perf[38] = 200000;                         /* the GMU at 200 MHz, MIN_SVS (dt qcom,gmu-pwrlevels) */
+	/* the boot vote: the dt's initial level, the slowest (vendor a6xx_gmu_gfx_rail_on) */
+	g_boot_gx = g_perf[3 + 2] & 0xFFu;
+	g_boot_mx = (g_perf[3 + 2] >> 8) & 0xFFu;
+	/* buses: one level, "off" -- the GPU's own votes for DDR left at nothing (Linux a618_build_bw_table),
+	 * with the addresses of this SoC's resources from cmd-db */
+	g_bw[1] = 1;                                 /* levels */
+	g_bw[2] = 1;                                 /* cnoc commands */
+	g_bw[3] = 3;                                 /* ddr commands */
+	g_bw[4] = 1;                                 /* cnoc wait mask */
+	g_bw[5] = 1;                                 /* ddr wait mask */
+	g_bw[6] = cn0;                               /* cnoc_cmd_addrs[6] */
+	g_bw[12] = 0x40000000u;                      /* cnoc_cmd_data[0][0]: off */
+	g_bw[18] = 0x60000001u;                      /* cnoc_cmd_data[1][0]: on */
+	g_bw[24] = sh0;                              /* ddr_cmd_addrs[8] */
+	g_bw[25] = mc0;
+	g_bw[26] = acv;
+	g_bw[32] = g_bw[33] = g_bw[34] = 0x40000000u;  /* ddr_cmd_data[0][0..2] */
+	/* boot-arg sweetgpu_bw=1: the GPU's own votes for DDR, one level per entry of grp3d's bus table, as
+	 * the vendor sends them (build_bwtable_cmd_cache); the votes computed as Linux does from cmd-db
+	 * (a6xx_gmu_rpmh_bw_votes_init: SH0 over a 16-byte bus, MC0 over 4, ACV fixed with perfmode bit 3) */
+	{
+		uint32_t want = 0;
+		(void)PE_parse_boot_argn("sweetgpu_bw", &want, sizeof(want));
+		if (want) {
+			static const char *const bcm[3] = { "SH0", "MC0", "ACV" };
+			static const uint32_t buswidth[3] = { 16, 4, 0 };
+			uint16_t aux[16];
+			uint32_t unit[3], width[3], vcd[3], lv, j;
+			unsigned na = 0;
+			bool ok = true;
+			for (j = 0; j < 3u && ok; j++) {
+				ok = cmddb_find(bcm[j], &a, aux, &na) == 0 && g_cmddb_auxwords >= 4u;
+				if (ok) {
+					unit[j] = (uint32_t)aux[0] | (uint32_t)aux[1] << 16;
+					width[j] = aux[2];
+					vcd[j] = aux[3] & 0xFFu;
+					ok = unit[j] != 0;
+				}
+			}
+			if (!ok) {
+				printf("SWEET GMU: [T] no BCM data for %s: the bus table stays \"off\" only\n", bcm[j - 1u]);
+			} else {
+				for (lv = 0; lv < 12u; lv++) {
+					for (j = 0; j < 3u; j++) {
+						uint32_t commit = (j == 2u || vcd[j] != vcd[j + 1u]) ? 1u : 0u, vote;
+						uint64_t peak;
+						if (g_bus_kbps[lv] == 0) {
+							g_bw[32 + 8 * lv + j] = commit << 30;
+						} else if (j == 2u) {
+							g_bw[32 + 8 * lv + j] = commit << 30 | 1u << 29 | (1u << 3);
+						} else {
+							peak = (uint64_t)g_bus_kbps[lv] * width[j] / buswidth[j] * 1000u / unit[j];
+							vote = peak < 1u ? 1u : peak > 0x3FFFu ? 0x3FFFu : (uint32_t)peak;
+							g_bw[32 + 8 * lv + j] = commit << 30 | 1u << 29 | vote;
+						}
+					}
+				}
+				g_bw[1] = 12;
+				g_bw[5] = 0;
+				for (j = 0; j < 3u; j++) {
+					g_bw[5] |= (g_bw[32 + j] >> 30 & 1u) << j;
+				}
+				g_bw_levels = 12;
+				printf("SWEET GMU: [T] bus table: 12 levels; SH0 unit %u width %u vcd %u, MC0 unit %u width %u vcd %u, "
+				    "ACV vcd %u; top votes %#x %#x %#x\n", unit[0], width[0], vcd[0], unit[1], width[1], vcd[1], vcd[2],
+				    g_bw[32 + 88], g_bw[33 + 88], g_bw[34 + 88]);
+			}
+		}
+	}
+	g_tables = true;
+	printf("SWEET GMU: [T] speed bin %#x: %u levels, %u..%u MHz; votes 0:%#x 1:%#x top:%#x; gmu %#x; boot gx %u mx %u; "
+	    "SH0 %#x MC0 %#x ACV %#x CN0 %#x\n", bin, g_gpu_nlevels, g_gpu_mhz[g_gpu_nlevels - 1u], g_gpu_mhz[0], g_perf[3],
+	    g_perf[5], g_perf[3 + 2 * (n - 1u)], g_perf[37], g_boot_gx, g_boot_mx, sh0, mc0, acv, cn0);
+	gmub_flush();
+}
+
+/*
+ * After the GMU's processor runs, its rail is up and SPTPRAC on (vendor a6xx_gmu_fw_start with the
+ * quirk): start the queues, then hfi_start -- INIT, the version, the speeds (v1), the bus votes,
+ * and TEST ("no more messages until the next boot"; DCVS goes by register from here).
+ */
+static void
+hfi_start(void)
+{
+	uint32_t init[5] = { 0, 0, GMUS_VA + GMUS_DEBUG_OFF, GMUS_DEBUG_SIZE, 1u /* GMU_COLD_BOOT */ };
+	uint32_t ver[2] = { 0, 0x10070000u /* GMU_VERSION(1, 7): the a618's */ }, test[1] = { 0 }, answer[8] = { 0 };
+	unsigned polls;
+	uint32_t i, logged = 0;
+
+	if (g_gmus_cb < 0 || !g_tables) {
+		return;
+	}
+	for (i = 0; i < GMUS_LOG_SIZE / 4u; i++) {
+		logged += ((volatile uint32_t *)(g_gmus_nc + GMUS_LOG_OFF))[i] != 0;
+	}
+	printf("SWEET GMU: [HFI] the GMU wrote %u words of its log; faults so far: %s\n", logged,
+	    gmu_space_faulted("before HFI") ? "yes" : "none");
+	gmub_wr(GMUB_HFI_CTRL_INIT, 1u);
+	for (polls = 0; polls < 100000u && !(gmub_rd(GMUB_HFI_CTRL_STATUS) & 1u); polls++) {
+		gmub_udelay(1);
+	}
+	g_hfi_version = gmub_rd(GMUB_HFI_VERSION_INFO);
+	printf("SWEET GMU: [HFI] queues: ctrl_status %#x after %u us, HFI version %#x\n", gmub_rd(GMUB_HFI_CTRL_STATUS),
+	    polls, g_hfi_version);
+	gmub_flush();
+	if (!(gmub_rd(GMUB_HFI_CTRL_STATUS) & 1u) || gmu_space_faulted("HFI_CTRL_INIT")) {
+		return;
+	}
+	if (hfi_send("INIT", 0u, init, 5u, NULL) || hfi_send("the version", 1u, ver, 2u, answer) ||
+	    hfi_send("the speeds", 4u, g_perf, sizeof(g_perf) / 4u, NULL) ||
+	    hfi_send("the bus votes", 3u, g_bw, sizeof(g_bw) / 4u, NULL) || hfi_send("TEST", 5u, test, 1u, NULL)) {
+		return;
+	}
+	g_hfi_up = 1;
+	printf("SWEET GMU: [HFI] UP: GMU firmware %#x; the speeds are the GMU's\n", answer[3]);
+	gmub_flush();
+}
+
+/* ============================ the boot code ============================ */
+/*
+ * gpu_gmu_boot() - cold-boot the a618 GMU. Returns 0 on full success (GMU alive
+ * AND OOB BOOT_SLUMBER acked), negative on the first stage that fails. Safe to
+ * call once, after gmu_step1 + gmu_step2.
+ */
+static int
+gpu_gmu_boot(void)
+{
+	static const uint32_t rscc_seq[5] = {
+		0xA7A506A0u, 0xA1E6A6E7u, 0xA2E081E1u, 0xE9A982E2u, 0x0020E8A8u };
+	static const uint32_t pdc_seq[5] = {
+		0xFEBEA1E1u, 0xA5A4A3A2u, 0x8382A6E0u, 0xBCE3E284u, 0x002081FCu };
+	vm_offset_t pdc_cfg, pdc_sq, smmu;
+	vm_offset_t hfi_va, log_va;
+	uint64_t hfi_pa, log_pa;
+	uint32_t scr0, fw_init;
+	unsigned i, polls;
+
+	printf("SWEET GMU: boot start; pre-boot cm3_sysreset=%#x fw_init=%#x\n",
+	    gmub_rd(GMUB_CM3_SYSRESET), gmub_rd(GMUB_CM3_FW_INIT_RESULT));
+	gmub_flush();
+
+	/* Q4b: clear + unmask GMU interrupts (davinci-p-oss adreno_gmu_clear_and_
+	 * unmask_irqs, run before fw_start). Clears the stale GMU2HOST status - the
+	 * phantom INTR_INFO bit23 we kept misreading - and arms the CM3's HFI/AO
+	 * services. OOB acks are polled from RAW INTR_INFO so the mask doesn't gate
+	 * them; this is correctness + a clean slate for the ack poll. */
+	gmub_wr(GMUB_GMU2HOST_INTR_CLR, 0xFFFFFFFFu);
+	gmub_wr(GMUB_AO_HOST_INTR_CLR, 0xFFFFFFFFu);
+	gmub_wr(GMUB_GMU2HOST_INTR_MASK, ~GMUB_HFI_IRQ_MASK);
+	gmub_wr(GMUB_AO_HOST_INTR_MASK, ~GMUB_AO_IRQ_MASK);
+	__asm__ volatile("dsb osh" ::: "memory");
+
+	/* ---- map PDC + SMMU windows (GMU window already in gpu_gmu) ---- */
+	pdc_cfg = ml_io_map(GMUB_PDC_CFG_PA, GMUB_PDC_WIN_SIZE);
+	pdc_sq  = ml_io_map(GMUB_PDC_SEQ_PA, GMUB_PDC_WIN_SIZE);
+	smmu    = ml_io_map(GMUB_SMMU_PA, GMUB_SMMU_SIZE);
+	if (!pdc_cfg || !pdc_sq || !smmu) {
+		printf("SWEET GMU: window map failed pdc_cfg=%d pdc_seq=%d smmu=%d\n",
+		    pdc_cfg != 0, pdc_sq != 0, smmu != 0);
+	gmub_flush();
+		return -1;
+	}
+
+	/* ---- Stage 0a: SMMU bypass for the GMU streams (SID 4,5) ---- */
+	scr0 = gpu_rd(smmu, GMUB_SMMU_sCR0);
+	if (scr0 & GMUB_SMMU_CLIENTPD) {
+		printf("SWEET GMU: SMMU sCR0=%#x CLIENTPD already global-bypass\n", scr0);
+	} else {
+		/* GLOBAL bypass: set sCR0 CLIENTPD so ALL GPU streams (incl. GMU SIDs
+		 * 4/5) skip translation. The per-stream S2CR writes did not take
+		 * (readback TYPE != bypass) and the GMU faulted on HFI memory access. */
+		gpu_wr(smmu, GMUB_SMMU_sCR0, scr0 | GMUB_SMMU_CLIENTPD);
+		__asm__ volatile("dsb osh" ::: "memory");
+		printf("SWEET GMU: SMMU global bypass: sCR0 %#x -> %#x\n",
+		    scr0, gpu_rd(smmu, GMUB_SMMU_sCR0));
+	}
+	gmub_flush();
+
+	/* ---- Stage 0b: physically-contiguous HFI + log buffers (< 4 GiB) ---- */
+	if (gmub_alloc_phys(&hfi_va, &hfi_pa, PAGE_SIZE) != 0) {
+		printf("SWEET GMU: HFI buffer alloc failed (need contiguous low-4GB page)\n");
+	gmub_flush();
+		return -2;
+	}
+	if (gmub_alloc_phys(&log_va, &log_pa, PAGE_SIZE) != 0) {
+		printf("SWEET GMU: log buffer alloc failed\n");
+	gmub_flush();
+		return -2;
+	}
+	printf("SWEET GMU: buffers hfi_pa=%#llx log_pa=%#llx (bypass: iova==phys)\n",
+	    (unsigned long long)hfi_pa, (unsigned long long)log_pa);
+	gmub_flush();
+	/* boot-arg sweetgpu_hfi=1: the GMU's memory through an SMMU context of its own, and HFI */
+	{
+		uint32_t want = 0;
+		(void)PE_parse_boot_argn("sweetgpu_hfi", &want, sizeof(want));
+		if (want) {
+			hfi_tables();
+			if (g_tables && gmu_space_on(smmu) == 0) {
+				hfi_table_init();
+				hfi_pa = GMUS_VA + GMUS_HFI_OFF;    /* from here, the GMU's addresses */
+				log_pa = GMUS_VA + GMUS_LOG_OFF;
+			}
+		}
+	}
+
+	/* ---- Stage A: RSCC + PDC micro-sequence program ---- */
+	gmub_wr(GMUB_RSCC_RSC_STATUS0, (1u << 24));
+	gmub_wr(GMUB_RSCC_PDC_SLAVE_ID, 1);
+	gmub_wr(GMUB_RSCC_HIDDEN_TCS_DATA, 0);
+	gmub_wr(GMUB_RSCC_HIDDEN_TCS_ADDR, 0);
+	gmub_wr(GMUB_RSCC_HIDDEN_TCS_DATA + GMUB_RSC_CMD_OFFSET, 0);
+	gmub_wr(GMUB_RSCC_HIDDEN_TCS_ADDR + GMUB_RSC_CMD_OFFSET, 0);
+	gmub_wr(GMUB_RSCC_HIDDEN_TCS_DATA + GMUB_RSC_CMD_OFFSET * 2, 0x80000000u);
+	gmub_wr(GMUB_RSCC_HIDDEN_TCS_ADDR + GMUB_RSC_CMD_OFFSET * 2, 0);
+	gmub_wr(GMUB_RSCC_OVERRIDE_START, 0);
+	gmub_wr(GMUB_RSCC_PDC_SEQ_START, 0x4520u);
+	gmub_wr(GMUB_RSCC_PDC_MATCH_LO, 0x4510u);
+	gmub_wr(GMUB_RSCC_PDC_MATCH_HI, 0x4514u);
+	for (i = 0; i < 5; ++i) {
+		gmub_wr(GMUB_RSCC_SEQ_MEM_0_DRV0 + i, rscc_seq[i]);
+	}
+	for (i = 0; i < 5; ++i) {
+		gpu_wr(pdc_sq, (GMUB_PDC_SEQ_MEM_0 + i) << 2, pdc_seq[i]);
+	}
+	/* PDC TCS1 bank */
+	gpu_wr(pdc_cfg, GMUB_PDC_TCS1_ENABLE_BANK << 2, 7);
+	gpu_wr(pdc_cfg, GMUB_PDC_TCS1_WAIT_CMPL << 2, 0);
+	gpu_wr(pdc_cfg, GMUB_PDC_TCS1_CONTROL << 2, 0);
+	gpu_wr(pdc_cfg, GMUB_PDC_TCS1_CMD0_MSGID << 2, 0x10108);
+	gpu_wr(pdc_cfg, GMUB_PDC_TCS1_CMD0_ADDR << 2, 0x30010);
+	gpu_wr(pdc_cfg, GMUB_PDC_TCS1_CMD0_DATA << 2, 1);
+	gpu_wr(pdc_cfg, (GMUB_PDC_TCS1_CMD0_MSGID + GMUB_PDC_CMD_OFFSET) << 2, 0x10108);
+	gpu_wr(pdc_cfg, (GMUB_PDC_TCS1_CMD0_ADDR + GMUB_PDC_CMD_OFFSET) << 2, 0x30000);
+	gpu_wr(pdc_cfg, (GMUB_PDC_TCS1_CMD0_DATA + GMUB_PDC_CMD_OFFSET) << 2, 0x0);
+	gpu_wr(pdc_cfg, (GMUB_PDC_TCS1_CMD0_MSGID + GMUB_PDC_CMD_OFFSET * 2) << 2, 0x10108);
+	gpu_wr(pdc_cfg, (GMUB_PDC_TCS1_CMD0_ADDR + GMUB_PDC_CMD_OFFSET * 2) << 2, GMUB_A618_PDC_ADDR_OFF);
+	gpu_wr(pdc_cfg, (GMUB_PDC_TCS1_CMD0_DATA + GMUB_PDC_CMD_OFFSET * 2) << 2, 0x0);
+	/* PDC TCS3 bank */
+	gpu_wr(pdc_cfg, GMUB_PDC_TCS3_ENABLE_BANK << 2, 7);
+	gpu_wr(pdc_cfg, GMUB_PDC_TCS3_WAIT_CMPL << 2, 0);
+	gpu_wr(pdc_cfg, GMUB_PDC_TCS3_CONTROL << 2, 0);
+	gpu_wr(pdc_cfg, GMUB_PDC_TCS3_CMD0_MSGID << 2, 0x10108);
+	gpu_wr(pdc_cfg, GMUB_PDC_TCS3_CMD0_ADDR << 2, 0x30010);
+	gpu_wr(pdc_cfg, GMUB_PDC_TCS3_CMD0_DATA << 2, 2);
+	gpu_wr(pdc_cfg, (GMUB_PDC_TCS3_CMD0_MSGID + GMUB_PDC_CMD_OFFSET) << 2, 0x10108);
+	gpu_wr(pdc_cfg, (GMUB_PDC_TCS3_CMD0_ADDR + GMUB_PDC_CMD_OFFSET) << 2, 0x30000);
+	gpu_wr(pdc_cfg, (GMUB_PDC_TCS3_CMD0_DATA + GMUB_PDC_CMD_OFFSET) << 2, 0x2); /* a618 */
+	gpu_wr(pdc_cfg, (GMUB_PDC_TCS3_CMD0_MSGID + GMUB_PDC_CMD_OFFSET * 2) << 2, 0x10108);
+	gpu_wr(pdc_cfg, (GMUB_PDC_TCS3_CMD0_ADDR + GMUB_PDC_CMD_OFFSET * 2) << 2, GMUB_A618_PDC_ADDR_OFF);
+	gpu_wr(pdc_cfg, (GMUB_PDC_TCS3_CMD0_DATA + GMUB_PDC_CMD_OFFSET * 2) << 2, 0x3);
+	/* enable PDC */
+	gpu_wr(pdc_cfg, GMUB_PDC_SEQ_START_ADDR << 2, 0);
+	gpu_wr(pdc_cfg, GMUB_PDC_ENABLE_PDC << 2, 0x80000001u);
+	__asm__ volatile("dsb osh" ::: "memory");
+	printf("SWEET GMU: [A] RSCC/PDC programmed; rscc_seq_busy=%#x enable_pdc_rb=%#x\n",
+	    gmub_rd(GMUB_RSCC_SEQ_BUSY_DRV0), gpu_rd(pdc_cfg, GMUB_PDC_ENABLE_PDC << 2));
+	gmub_flush();
+
+	/* ---- RSC/PDC uCode verify (NO wake): v16's RSCC_CONTROL_REQ=BIT(1) was the
+	 * WRONG op on cold boot - that is the wake-from-sleep handshake, gated on
+	 * SLEEP_SEQ_DONE, and times out by design on a true cold boot (confirmed vs
+	 * davinci-p-oss _load_gmu_rpmh_ucode / a6xx_rpmh_power_on_gpu). On cold boot
+	 * the GMU runs the RSC->PDC->RPMH sequence ITSELF in response to BOOT_SLUMBER.
+	 * So here we only CONFIRM the Stage-A uCode writes actually took (TZ-lock
+	 * check): RSCC_SEQ_MEM_0 should read back 0xA7A506A0, PDC enable 0x80000001. */
+	printf("SWEET GMU: [RSC] cold (no wake); seq_mem0=%#x(want 0xa7a506a0) "
+	    "enable_pdc=%#x rpmh_pwr=%#x\n", gmub_rd(GMUB_RSCC_SEQ_MEM_0_DRV0),
+	    gpu_rd(pdc_cfg, GMUB_PDC_ENABLE_PDC << 2),
+	    gmub_rd(GMUB_CX_GMU_RPMH_PWR_STATE));
+	gmub_flush();
+
+	/* ---- Stage B: load a618_gmu.bin into ITCM (legacy bulk, 0x8000 B) ---- */
+	if (A618_GMU_FW_LEN == 0 || (A618_GMU_FW_LEN & 3u) || A618_GMU_FW_LEN > 0x8000u) {
+		printf("SWEET GMU: [B] bad fw len %#x\n", (unsigned)A618_GMU_FW_LEN);
+	gmub_flush();
+		return -3;
+	}
+	for (i = 0; i < (A618_GMU_FW_LEN >> 2); ++i) {
+		uint32_t w = ((const uint32_t *)a618_gmu_fw)[i];
+		gmub_wr(GMUB_CM3_ITCM_START + i, w);
+	}
+	__asm__ volatile("dsb osh" ::: "memory");
+	printf("SWEET GMU: [B] fw -> ITCM (%u bytes); itcm[0]=%#x\n",
+	    (unsigned)A618_GMU_FW_LEN, gmub_rd(GMUB_CM3_ITCM_START));
+	gmub_flush();
+
+	/* ---- Stage C: configure the GMU for boot (mainline a6xx_gmu_fw_start +
+	 * a6xx_gmu_power_config order). The v14 CM3 fault was this stage missing the
+	 * GMU RPMh vote-enables: RPMH_CTRL must be 0xF11 (incl GFX_VOTE_ENABLE), and
+	 * PWR_COL_INTER_FRAME must be the plain ACTIVE value, not OR'd collapse bits.
+	 * Also allow the AO AHB fence (else CPU writes to the GMU silently drop). ---- */
+	gmub_wr(GMUB_AO_AHB_FENCE_CTRL, 0);         /* allow CPU<->GMU reg writes */
+	gmub_wr(GMUB_GENERAL_7, 1);                 /* TCM retention + cold/warm marker */
+	gmub_wr(GMUB_SYS_BUS_CONFIG, 0x1);
+	gmub_wr(GMUB_ICACHE_CONFIG, 0x1);
+	gmub_wr(GMUB_DCACHE_CONFIG, 0x1);
+	gmub_wr(GMUB_CM3_FW_INIT_RESULT, 0);        /* clear for fresh value */
+	gmub_wr(GMUB_CM3_BOOT_CONFIG, GMUB_LOAD_MODE_TCM);
+	gmub_wr(GMUB_HFI_QTBL_ADDR, (uint32_t)hfi_pa);
+	gmub_wr(GMUB_HFI_QTBL_INFO, 1);
+	gmub_wr(GMUB_AHB_FENCE_RANGE_0, GMUB_FENCE_RANGE_MASK);
+	gmub_wr(GMUB_CM3_CFG, 0x4052);              /* fault routing, no NMI jump */
+	gmub_wr(GMUB_HFI_SFR_ADDR, GMUB_CHIPID);
+	gmub_wr(GMUB_PWR_COL_CP_MSG, ((uint32_t)log_pa & 0xFFFFF000u) |
+	    (((g_gmus_cb >= 0 ? GMUS_LOG_SIZE : PAGE_SIZE) / 0x1000u - 1u) & 0xFFu));
+	/* power_config (idle_level=ACTIVE): plain INTER_FRAME value + RPMh vote path. */
+	gmub_wr(GMUB_PWR_COL_INTER_FRAME, GMUB_PWR_COL_INTER_FRAME_VAL);
+	gmub_wr(GMUB_RPMH_CTRL, gmub_rd(GMUB_RPMH_CTRL) | GMUB_RPMH_ENABLE_MASK);
+	gmub_wr(GMUB_CX_GMU_WFI_CONFIG, 0x0);
+	__asm__ volatile("dsb osh" ::: "memory");
+	printf("SWEET GMU: [C] configured; boot_cfg=%#x fence=%#x rpmh_ctrl=%#x "
+	    "pwr_col=%#x fence_ctl=%#x\n", gmub_rd(GMUB_CM3_BOOT_CONFIG),
+	    gmub_rd(GMUB_AHB_FENCE_RANGE_0), gmub_rd(GMUB_RPMH_CTRL),
+	    gmub_rd(GMUB_PWR_COL_INTER_FRAME), gmub_rd(GMUB_AO_AHB_FENCE_CTRL));
