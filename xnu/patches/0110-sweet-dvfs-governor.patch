+/*
+ * The clocks as a phone keeps them (on with sweetcpufreq=1; boot-arg sweetdvfs=0 keeps everything at
+ * the top as before): all at the top while something is being drawn, low after 1.5 s of nothing,
+ * and capped while the battery is low -- every cluster at its top row and the GPU at 610 MHz took
+ * more than the charger gives and ran the battery flat while plugged in, slowing to 8 frames a
+ * second at the end (the hardware's own limits) before the power went. "Something drawn": a swap
+ * (SweetFramebuffer.cpp) or a GPU submission, which also wake this at once from low clocks.
+ * The battery: the voltage SweetBattery.cpp measures (its percentage is only an estimate).
+ */
+volatile uint32_t sweet_battery_mv;             /* SweetBattery.cpp, as last measured; 0 not yet */
+static volatile uint64_t g_dvfs_active;         /* mach time of the last swap or submission */
+static int g_dvfs_mode = -1;                    /* 0 fast, 1 idle, 2 low battery */
+static int g_dvfs_on;
+static int g_dvfs_chan;
+
+void sweet_dvfs_kick(void);
+void
+sweet_dvfs_kick(void)
+{
+	g_dvfs_active = mach_absolute_time();
+	if (g_dvfs_on && g_dvfs_mode == 1) {
+		thread_wakeup((event_t)&g_dvfs_chan);
+	}
+}
+
+static void
+osm_set(unsigned c, uint32_t row)
+{
+	vm_offset_t base = g_osm_base[c];
+	if (base == 0) {
+		return;
+	}
+	if (row > g_osm_top[c]) {
+		row = g_osm_top[c];
+	}
+	for (unsigned n = 0; n < (g_osm_per_core[c] ? osm_clusters[c].cores : 1u); n++) {
+		gpu_wr(base, OSM_PERF_STATE(n), row);
+	}
+	__asm__ volatile("dsb sy" ::: "memory");
+}
+
+static void
+dvfs_apply(int mode)
+{
+	/* rows: L3 768/1132/top, little 768/1324/top, big 652/1209/top (tables in the CPUFREQ lines) */
+	static const uint32_t rows[3][3] = { { 99, 99, 99 }, { 3, 2, 1 }, { 6, 5, 5 } };
+	uint32_t level = mode == 0 ? 0u : mode == 1 ? (g_gpu_nlevels ? g_gpu_nlevels - 1u : 7u) : g_gpu_nlevels / 2u;
+	uint64_t o = 0;
+	for (unsigned c = 0; c < 3u; c++) {
+		osm_set(c, rows[mode][c]);
+	}
+	if (g_hfi_up && g_kgsl_ready && level != g_gpu_level) {
+		gpu_lock();
+		g_level_quiet = 1;
+		(void)gpu_set_level(level, &o);
+		g_level_quiet = 0;
+		gpu_unlock();
+	}
+	{
+		static uint32_t told;
+		if (told++ < 12 || mode == 2) {
+			printf("SWEET DVFS: %s (GPU level %u, battery %u mV)\n", mode == 0 ? "fast" : mode == 1 ? "idle" : "LOW BATTERY: capped",
+			    g_gpu_level, sweet_battery_mv);
+		}
+	}
+	g_dvfs_mode = mode;
+}
+
+static void
+dvfs_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	uint64_t idle_after, now;
+	bool low = false;
+	nanoseconds_to_absolutetime(1500ull * NSEC_PER_MSEC, &idle_after);
+	for (;;) {
+		int mode;
+		assert_wait_timeout((event_t)&g_dvfs_chan, THREAD_UNINT, 100, NSEC_PER_MSEC);
+		(void)thread_block(THREAD_CONTINUE_NULL);
+		now = mach_absolute_time();
+		if (sweet_battery_mv != 0) {    /* (hysteresis: capped below 3.5 V, freed above 3.65 V) */
+			low = low ? sweet_battery_mv < 3650u : sweet_battery_mv < 3500u;
+		}
+		mode = low ? 2 : (now - g_dvfs_active > idle_after ? 1 : 0);
+		if (mode != g_dvfs_mode) {
+			dvfs_apply(mode);
+		}
+	}
+}
