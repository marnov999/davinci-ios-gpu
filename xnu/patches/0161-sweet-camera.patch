+/* ---- I2C by hand on the CCI pins (HackiOS redwood_camera.c:276-454, unchanged in substance) ---------- */
+
+struct bus {
+	const char *    name;
+	unsigned        sda, scl;
+	uint32_t        cfg[2], io[2];
+};
+static struct bus cci_bus;
+
+static void
+half_bit(void)
+{
+	spin_us(5);                     /* <= 100 kHz */
+}
+
+static void
+line(unsigned n, bool high)
+{
+	wr(GPIO_IO(n), 0);
+	wr(GPIO_CFG(n), CFG_PULL_UP | (high ? 0 : CFG_OUTPUT));        /* open drain: high = released, pulled up */
+}
+
+static bool
+level_of(unsigned n)
+{
+	return rd(GPIO_IO(n)) & 1;
+}
+
+static void
+i2c_start(struct bus *b)
+{
+	line(b->sda, true);
+	line(b->scl, true);
+	half_bit();
+	line(b->sda, false);
+	half_bit();
+	line(b->scl, false);
+	half_bit();
+}
+
+static void
+i2c_stop(struct bus *b)
+{
+	line(b->sda, false);
+	half_bit();
+	line(b->scl, true);
+	half_bit();
+	line(b->sda, true);
+	half_bit();
+}
+
+static bool
+i2c_bit(struct bus *b, bool out)
+{
+	bool in;
+
+	line(b->sda, out);
+	half_bit();
+	line(b->scl, true);
+	for (unsigned stretched = 0; !level_of(b->scl) && stretched < 100; stretched++) {
+		half_bit();
+	}
+	half_bit();
+	in = level_of(b->sda);
+	line(b->scl, false);
+	return in;
+}
+
+static bool
+i2c_write(struct bus *b, uint8_t byte)
+{
+	for (int bit = 7; bit >= 0; bit--) {
+		i2c_bit(b, (byte >> bit) & 1);
+	}
+	return !i2c_bit(b, true);
+}
+
+static uint8_t
+i2c_read(struct bus *b, bool more)
+{
+	uint8_t byte = 0;
+
+	for (int bit = 7; bit >= 0; bit--) {
+		byte = (uint8_t)(byte << 1 | i2c_bit(b, true));
+	}
+	i2c_bit(b, !more);
+	return byte;
+}
+
+static void
+bus_give_back(struct bus *b)
+{
+	wr(GPIO_IO(b->sda), b->io[0] & 2);
+	wr(GPIO_IO(b->scl), b->io[1] & 2);
+	wr(GPIO_CFG(b->sda), b->cfg[0]);
+	wr(GPIO_CFG(b->scl), b->cfg[1]);
+}
+
+/* A slave stopped mid-byte holds SDA low: clock it out (i2c_generic_scl_recovery), as HackiOS learned. */
+static bool
+bus_unwedge(struct bus *b)
+{
+	for (unsigned clocks = 1; clocks <= 9; clocks++) {
+		line(b->scl, false);
+		half_bit();
+		line(b->scl, true);
+		half_bit();
+		if (level_of(b->sda)) {
+			i2c_stop(b);
+			say("%s: SDA was held low, free after %u clock(s)\n", b->name, clocks);
+			return true;
+		}
+	}
+	return false;
+}
+
+static bool
+bus_take(struct bus *b)
+{
+	b->cfg[0] = rd(GPIO_CFG(b->sda));
+	b->cfg[1] = rd(GPIO_CFG(b->scl));
+	b->io[0] = rd(GPIO_IO(b->sda));
+	b->io[1] = rd(GPIO_IO(b->scl));
+	line(b->sda, true);
+	line(b->scl, true);
+	half_bit();
+	if (level_of(b->sda) && level_of(b->scl)) {
+		return true;
+	}
+	if (level_of(b->scl) && !level_of(b->sda) && bus_unwedge(b) && level_of(b->scl)) {
+		return true;
+	}
+	{
+		bool sda = level_of(b->sda), scl = level_of(b->scl);
+
+		bus_give_back(b);
+		/* both low: usually VIO (L16A, the bus pull-ups' supply) is off */
+		say("%s not at rest (gpio%u=%u gpio%u=%u): not touched\n", b->name, b->sda, sda, b->scl, scl);
+	}
+	return false;
+}
+
+static bool
+i2c_transfer(struct bus *b, uint8_t address, const uint8_t *out, unsigned out_count, uint8_t *in, unsigned in_count)
+{
+	bool answered;
+
+	if (broken || !bus_take(b)) {
+		return false;
+	}
+	i2c_start(b);
+	answered = i2c_write(b, (uint8_t)(address << 1));
+	for (unsigned i = 0; answered && i < out_count; i++) {
+		answered = i2c_write(b, out[i]);
+	}
+	if (answered && in_count != 0) {
+		i2c_start(b);
+		answered = i2c_write(b, (uint8_t)(address << 1 | 1));
+		for (unsigned i = 0; answered && i < in_count; i++) {
+			in[i] = i2c_read(b, i + 1 < in_count);
+		}
+	}
+	i2c_stop(b);
+	bus_give_back(b);
+	return answered;
+}
+
+/* ---- SPMI: observer reads (look), channel writes (PM6150L GPIO 3/8 for wide/tele only) -------------- */
+
+#define SPMI_CORE_PHYS          0x0c440000UL
+#define SPMI_CHNLS_PHYS         0x0c600000UL
+#define SPMI_OBS_PHYS           0x0e600000UL
+#define SPMI_CNFG_PHYS          0x0c40a000UL
+#define SID_PM6150              0
+#define SID_PM6150L             4
+#define PGPIO_PERIPH(n)         (0xc0u + (n) - 1)       /* PM6150L GPIO n at 0xc000 + 0x100 (n - 1) */
+#define PGPIO_MODE_CTL          0x40
+#define PGPIO_DIG_VIN_CTL       0x41
+#define PGPIO_DIG_PULL_CTL      0x42
+#define PGPIO_OUT_SOURCE_CTL    0x44
+#define PGPIO_EN_CTL            0x46
+
+static vm_offset_t spmi_core, spmi_obs, spmi_cnfg;
+static unsigned spmi_count;
+static LCK_GRP_DECLARE(cam_lck_grp, "sweet-camera");
+static LCK_MTX_DECLARE(spmi_lock, &cam_lck_grp);
+
+static bool
+spmi_up(void)
+{
+	if (spmi_core == 0) {
+		spmi_core = cam_map(SPMI_CORE_PHYS, 0x2000);
+		spmi_cnfg = cam_map(SPMI_CNFG_PHYS, 0x1000);
+		spmi_obs = cam_map(SPMI_OBS_PHYS, 0x10000);
+		if (spmi_core == 0 || spmi_cnfg == 0 || spmi_obs == 0) {
+			return false;
+		}
+		uint32_t version = rd(spmi_core);
+
+		spmi_count = rd(spmi_core + 4) & 0x7ff;
+		if (version < 0x50000000u || version >= 0x70000000u || spmi_count == 0 || spmi_count > 512) {
+			say("SPMI arbiter %#x (%u APIDs) not the v5 known here\n", version, spmi_count);
+			spmi_count = 0;
+		}
+	}
+	return spmi_count != 0;
+}
+
+/* APID of a peripheral; *owner_ee its owner (cnfg 0x700). 0xffff: none. */
+static unsigned
+spmi_apid(unsigned sid, unsigned periph, unsigned *owner_ee)
+{
+	unsigned found = 0xffff;
+
+	for (unsigned i = 0; i < spmi_count; i++) {
+		uint32_t map = rd(spmi_core + 0x900 + 4 * i);
+
+		if (map != 0 && ((map >> 8) & 0xfff) == ((sid << 8) | periph)) {
+			unsigned owner = rd(spmi_cnfg + 0x700 + 4 * i) & 7;
+
+			if (found == 0xffff || owner == 0) {
+				found = i;
+				*owner_ee = owner;
+			}
+		}
+	}
+	return found;
+}
+
+static bool
+spmi_read(unsigned sid, uint16_t address, uint8_t *value)
+{
+	unsigned owner = 7, apid;
+	bool ok = false;
+
+	if (!spmi_up()) {
+		return false;
+	}
+	lck_mtx_lock(&spmi_lock);
+	apid = spmi_apid(sid, address >> 8, &owner);
+	if (apid != 0xffff) {
+		vm_offset_t ch = spmi_obs + 0x80 * apid;
+
+		wr(ch + 0x00, (1u << 27) | ((address & 0xffu) << 4));        /* EXT_READL, 1 byte */
+		for (unsigned i = 0; i < 1000; i++) {
+			uint32_t status = rd(ch + 0x08);
+
+			if (status & 1) {
+				ok = (status & 0x0e) == 0;
+				*value = (uint8_t)rd(ch + 0x18);
+				break;
+			}
+			spin_us(1);
+		}
+	}
+	lck_mtx_unlock(&spmi_lock);
+	return ok;
+}
+
+/* A PM6150L GPIO register written through our own channel (chnls + 0x10000 * apid) and read back. */
+static bool
+pgpio_put(unsigned gpio, uint8_t reg, uint8_t value)
+{
+	unsigned owner = 7, apid;
+	bool ok = false;
+	uint8_t back = 0;
+
+	if (gpio != 3 && gpio != 8) {                   /* the wide's and the tele's VDIG enables only */
+		give_up("a PMIC GPIO this driver does not own");
+		return false;
+	}
+	if (!spmi_up()) {
+		return false;
+	}
+	lck_mtx_lock(&spmi_lock);
+	apid = spmi_apid(SID_PM6150L, PGPIO_PERIPH(gpio), &owner);
+	if (apid != 0xffff && owner == 0) {
+		vm_offset_t ch = cam_map(SPMI_CHNLS_PHYS + 0x10000UL * apid, 0x1000);
+
+		if (ch != 0) {
+			wr(ch + 0x10, value);
+			__asm__ volatile ("dsb osh" ::: "memory");
+			wr(ch + 0x00, (0u << 27) | ((uint32_t)reg << 4));      /* EXT_WRITEL, 1 byte */
+			for (unsigned i = 0; i < 1000; i++) {
+				uint32_t status = rd(ch + 0x08);
+
+				if (status & 1) {
+					ok = (status & 0x0e) == 0;
+					break;
+				}
+				spin_us(1);
+			}
+		}
+	}
+	lck_mtx_unlock(&spmi_lock);
+	if (apid == 0xffff || owner != 0) {
+		say("PM6150L GPIO%u: APID %#x owner EE %u: not ours to write\n", gpio, apid, owner);
+		give_up("a PMIC GPIO owned by another EE");
+		return false;
+	}
+	if (!ok || !spmi_read(SID_PM6150L, (uint16_t)(PGPIO_PERIPH(gpio) << 8 | reg), &back) || back != value) {
+		say("PM6150L GPIO%u reg %#x <- %#x reads %#x\n", gpio, reg, value, back);
+		give_up("a PMIC GPIO write that did not take");
+		return false;
+	}
+	return true;
+}
+
+static uint8_t pgpio_found[5];
+static bool pgpio_changed;
+static const uint8_t pgpio_regs[5] = { PGPIO_DIG_VIN_CTL, PGPIO_DIG_PULL_CTL, PGPIO_MODE_CTL, PGPIO_OUT_SOURCE_CTL, PGPIO_EN_CTL };
+
+/* "normal" function, output, VIN0, no pull, enabled, level high/low (pinctrl-spmi-gpio LV/MV layout) */
+static bool
+pgpio_drive(unsigned gpio, bool high)
+{
+	uint8_t want[5] = { 0x00, 0x05, 0x01, (uint8_t)(high ? 0x80 : 0x00), 0x80 };
+
+	if (!pgpio_changed) {
+		for (int i = 0; i < 5; i++) {
+			if (!spmi_read(SID_PM6150L, (uint16_t)(PGPIO_PERIPH(gpio) << 8 | pgpio_regs[i]), &pgpio_found[i])) {
+				give_up("a PMIC GPIO that cannot be read");
+				return false;
+			}
+		}
+		pgpio_changed = true;
+	}
+	for (int i = 0; i < 5; i++) {
+		if (!pgpio_put(gpio, pgpio_regs[i], want[i])) {
+			return false;
+		}
+	}
+	return true;
+}
+
+static void
+pgpio_restore(unsigned gpio)
+{
+	if (!pgpio_changed) {
+		return;
+	}
+	for (int i = 4; i >= 0; i--) {
+		(void)pgpio_put(gpio, pgpio_regs[i], pgpio_found[i]);
+	}
+	pgpio_changed = false;
+}
+
+/* ---- rails (RPMh, through sweet_rpmh.c) ----------------------------------------------------------- */
+
+/*
+ * The DT's values for every camera rail (davinci-sdmmagpie-camera-sensor.dtsi rgltr-min-voltage,
+ * clamped to the regulator's own range in davinci_0.dts):
+ *   ldoa16 1800 mV (VIO), bobc1 3296 mV (VANA: BOB's init voltage, the camera asks >= 3008),
+ *   smpc8 1352 mV (VDIG input), ldoc9 2952 mV (CUSTOM: "BIAS VREG_L9C_3P1").
+ * CX at SVS (camcc's clocks at 400 MHz: vdd_cx LOW), MX at SVS_L1 (PLL0 at 1.2 GHz: vdd_mx LOW_L1).
+ */
+enum { RAIL_VIO, RAIL_VANA, RAIL_VDIG, RAIL_CUSTOM, RAILS };
+static const struct { const char *res; unsigned mv; } rail_res[RAILS] = {
+	{ "ldoa16", 1800 }, { "bobc1", 3296 }, { "smpc8", 1352 }, { "ldoc9", 2952 },
+};
+static bool rail_on[RAILS], arcs_voted;
+#define CX_LEVEL                128             /* RPMh vlvl: SVS */
+#define MX_LEVEL                192             /* SVS_L1 */
+
+static bool
+rail(unsigned r, bool on)
+{
+	if (!use_rails || rail_on[r] == on) {
+		return true;
+	}
+	if (sweet_rpmh_vreg_vote(rail_res[r].res, rail_res[r].mv, on) != 0) {
+		say("RPMh did not take %s %s\n", rail_res[r].res, on ? "on" : "off");
+		if (on) {
+			give_up("a rail that RPMh did not take");
+			return false;
+		}
+	}
+	rail_on[r] = on;
+	return true;
+}
+
+/*
+ * CX >= SVS and MX >= SVS_L1 are what camcc wants (CX_LEVEL/MX_LEVEL). sweet_rpmh.c has no ARC (cx.lvl /
+ * mx.lvl) path yet, so nothing is voted: the panel and CPUs keep CX up; whether MX is high enough for
+ * PLL0's 1.2 GHz is learned at sweetcam=3 (PLL0 lock). An ARC vote is a separate, later patch.
+ */
+static bool
+arcs(bool on)
+{
+	if (on && !arcs_voted) {
+		say("CX/MX not voted (no ARC path in sweet_rpmh.c yet): relying on the levels others hold\n");
+	}
+	arcs_voted = on;
+	return true;
+}
+
+/* ---- clocks: GCC and camcc (camcc-sdmmagpie.c, gcc-sdmmagpie.c) ------------------------------------- */
+
+#define GCC_PHYS                0x00100000UL
+#define GCC_CAMERA_AHB_CBCR     0xb008          /* camcc's register access; NOT always on: gate -> external abort */
+#define GCC_CAMERA_HF_AXI_CBCR  0xb020
+#define GCC_CAMERA_XO_CBCR      0xb02c
+#define GCC_CAMERA_SF_AXI_CBCR  0xb06c
+#define CAMCC_PHYS              0x0ad00000UL
+#define CAMCC_SIZE              0x10000UL       /* regmap max 0xd024 */
+#define TITAN_TOP_GDSCR         0xc1c4          /* [0] SW collapse, [31] PWR_ON */
+#define CAMCC_GDSC_CBCR         0xc1a0          /* cam_cc_gdsc_clk, CLK_IS_CRITICAL in Linux */
+#define CBCR_OFF                (1u << 31)
+#define CMD_UPDATE              1u
+#define GDSC_COLLAPSE           1u
+#define GDSC_ON                 (1u << 31)
+
+static vm_offset_t gcc, camcc;
+static bool gcc_ahb_switched, gdsc_switched, mclk_switched;
+static uint32_t found_gdscr, found_mclk_cfg_rcgr, found_mclk_cbcr;
+
+static bool
+wait_bits(vm_offset_t base, uint32_t offset, uint32_t mask, uint32_t want, uint32_t us)
+{
+	for (uint32_t waited = 0; waited <= us; waited += 10) {
+		if ((rd(base + offset) & mask) == want) {
+			return true;
+		}
+		spin_us(10);
+	}
+	return false;
+}
+
+/* GCC's camera AHB first: with it gated, a read of camcc aborts (sweet_gpu.c's GPUCC lesson). */
+static bool
+gcc_camera_ahb(void)
+{
+	uint32_t cbcr = rd(gcc + GCC_CAMERA_AHB_CBCR);
+
+	if (!(cbcr & CBCR_OFF)) {
+		return true;
+	}
+	wr(gcc + GCC_CAMERA_AHB_CBCR, cbcr | 1);
+	gcc_ahb_switched = true;
+	if (!wait_bits(gcc, GCC_CAMERA_AHB_CBCR, CBCR_OFF, 0, 500)) {
+		say("GCC camera AHB does not come on (%#x)\n", rd(gcc + GCC_CAMERA_AHB_CBCR));
+		give_up("the camera AHB clock");
+		return false;
+	}
+	say("GCC camera AHB on (was %#x)\n", cbcr);
+	return true;
+}
+
+static bool
+camcc_put(uint32_t offset, uint32_t value, uint32_t check)
+{
+	wr(camcc + offset, value);
+	if ((rd(camcc + offset) & check) != (value & check)) {
+		say("camcc %#x <- %#x, reads %#x\n", offset, value, rd(camcc + offset));
+		give_up("a camcc register that did not read back");
+		return false;
+	}
+	return true;
+}
+
+static bool
+gdsc_on(void)
+{
+	uint32_t g = rd(camcc + CAMCC_GDSC_CBCR);
+
+	if (g & CBCR_OFF) {
+		wr(camcc + CAMCC_GDSC_CBCR, g | 1);    /* (critical in Linux: never switched back off) */
+		(void)wait_bits(camcc, CAMCC_GDSC_CBCR, CBCR_OFF, 0, 500);
+	}
+	found_gdscr = rd(camcc + TITAN_TOP_GDSCR);
+	if (!(found_gdscr & GDSC_COLLAPSE) && (found_gdscr & GDSC_ON)) {
+		return true;
+	}
+	if (!camcc_put(TITAN_TOP_GDSCR, found_gdscr & ~GDSC_COLLAPSE, GDSC_COLLAPSE)) {
+		return false;
+	}
+	gdsc_switched = true;
+	if (!wait_bits(camcc, TITAN_TOP_GDSCR, GDSC_ON, GDSC_ON, 200)) {
+		say("titan top GDSC does not come on (%#x)\n", rd(camcc + TITAN_TOP_GDSCR));
+		give_up("a power domain that does not come on");
+		return false;
+	}
+	say("titan top GDSC on (%#x)\n", rd(camcc + TITAN_TOP_GDSCR));
+	return true;
+}
+
+static void
+gdsc_off(void)
+{
+	if (!gdsc_switched) {
+		return;
+	}
+	wr(camcc + TITAN_TOP_GDSCR, rd(camcc + TITAN_TOP_GDSCR) | GDSC_COLLAPSE);
+	gdsc_switched = false;
+	say("titan top GDSC %s\n", wait_bits(camcc, TITAN_TOP_GDSCR, GDSC_ON, 0, 200) ? "off" : "NOT OFF");
+}
+
+/* MCLK at 19.2 MHz: the RCG from BI_TCXO_MX (source 0), divider 1, no M/N; the branch; the pin. */
+static bool
+mclk_on(uint32_t khz)
+{
+	if (khz != 19200) {
+		give_up("an MCLK rate not known here (davinci's modules all ask 19.2 MHz)");
+		return false;
+	}
+	found_mclk_cfg_rcgr = rd(camcc + hw->mclk_cmd + 4);
+	found_mclk_cbcr = rd(camcc + hw->mclk_cbcr);
+	if (found_mclk_cbcr & 1) {
+		give_up("MCLK is on already (somebody else's)");
+		return false;
+	}
+	mclk_switched = true;
+	if (!camcc_put(hw->mclk_cmd + 4, (found_mclk_cfg_rcgr & ~0x371fu) | 0u << 8 | 1u, 0x371f)) {
+		return false;
+	}
+	wr(camcc + hw->mclk_cmd, rd(camcc + hw->mclk_cmd) | CMD_UPDATE);
+	if (!wait_bits(camcc, hw->mclk_cmd, CMD_UPDATE, 0, 500)) {
+		give_up("MCLK's RCG does not update");
+		return false;
+	}
+	if (!camcc_put(hw->mclk_cbcr, found_mclk_cbcr | 1, 1) || !wait_bits(camcc, hw->mclk_cbcr, CBCR_OFF, 0, 500)) {
+		give_up("MCLK's branch does not come on");
+		return false;
+	}
+	wr(GPIO_CFG(hw->mclk_pin), CFG_FUNCTION(FUNC_CAM_MCLK) | CFG_DRIVE_MA(2));      /* cam_mclk, no pull, 2 mA (DT) */
+	say("MCLK%u on at 19.2 MHz (gpio%u)\n", (hw->mclk_cmd - 0x5004) / 0x20, hw->mclk_pin);
+	return true;
+}
+
+static void
+mclk_off(void)
+{
+	if (!mclk_switched) {
+		return;
+	}
+	if (pins_found) {
+		wr(GPIO_CFG(hw->mclk_pin), found_mclk_cfg);
+	}
+	wr(camcc + hw->mclk_cbcr, rd(camcc + hw->mclk_cbcr) & ~1u);
+	(void)wait_bits(camcc, hw->mclk_cbcr, CBCR_OFF, CBCR_OFF, 500);
+	wr(camcc + hw->mclk_cmd + 4, found_mclk_cfg_rcgr);
+	wr(camcc + hw->mclk_cmd, rd(camcc + hw->mclk_cmd) | CMD_UPDATE);
+	(void)wait_bits(camcc, hw->mclk_cmd, CMD_UPDATE, 0, 500);
+	mclk_switched = false;
+}
+
+/*
+ * camcc PLL0, Fabia (clk-alpha-pll.c): cam_cc_pll0_config "1200MHz": L 0x3e, FRAC 0x8000 (19.2 MHz x 62.5),
+ * post dividers 0x31 << 8 (even /2 = 600 MHz, odd /3 = 400 MHz), TEST_CTL 0x40000000; CAL_L 0x3f.
+ * clk_fabia_pll_configure() then clk_fabia_pll_enable().
+ */
+#define PLL_MODE                0x00            /* [0] OUTCTRL, [2] RESET_N, [20] VOTE_FSM_ENA, [23] HW update bypass, [31] LOCK_DET */
+#define PLL_L_VAL               0x04
+#define PLL_CAL_L_VAL           0x08
+#define PLL_USER_CTL            0x0c            /* [2:0] outputs main/even/odd, [15:8] post dividers */
+#define PLL_TEST_CTL            0x1c
+#define PLL_OPMODE              0x2c            /* 0 standby, 1 run */
+#define PLL_FRAC                0x38
+
+static bool pll_switched;
+
+static bool
+pll0_up(void)
+{
+	uint32_t mode = rd(camcc + PLL_MODE);
+
+	if ((mode & (1u | 1u << 20)) != 0) {
+		say("camcc PLL0 is running or FSM-voted (mode %#x): somebody else's\n", mode);
+		give_up("PLL0 in use");
+		return false;
+	}
+	pll_switched = true;
+	if (!camcc_put(PLL_L_VAL, 0x3e, ~0u) || !camcc_put(PLL_CAL_L_VAL, 0x3f, ~0u) || !camcc_put(PLL_FRAC, 0x8000, 0xffff) ||
+	    !camcc_put(PLL_USER_CTL, (rd(camcc + PLL_USER_CTL) & ~0xff00u) | 0x3100u, 0xff00) ||
+	    !camcc_put(PLL_TEST_CTL, 0x40000000, ~0u) ||
+	    !camcc_put(PLL_MODE, rd(camcc + PLL_MODE) | 1u << 23, 1u << 23) ||
+	    !camcc_put(PLL_MODE, rd(camcc + PLL_MODE) & ~1u, 1) ||          /* outputs off */
+	    !camcc_put(PLL_OPMODE, 0, 1) ||                                 /* standby */
+	    !camcc_put(PLL_MODE, rd(camcc + PLL_MODE) | 1u << 2, 1u << 2) || /* out of reset */
+	    !camcc_put(PLL_OPMODE, 1, 1)) {                                 /* run */
+		return false;
+	}
+	if (!wait_bits(camcc, PLL_MODE, 1u << 31, 1u << 31, 1000)) {
+		say("camcc PLL0 does not lock (mode %#x): MX too low?\n", rd(camcc + PLL_MODE));
+		give_up("a PLL that does not lock");
+		return false;
+	}
+	if (!camcc_put(PLL_USER_CTL, rd(camcc + PLL_USER_CTL) | 7, 7) || !camcc_put(PLL_MODE, rd(camcc + PLL_MODE) | 1, 1)) {
+		return false;
+	}
+	say("camcc PLL0 locked at 1200 MHz (mode %#x user %#x)\n", rd(camcc + PLL_MODE), rd(camcc + PLL_USER_CTL));
+	return true;
+}
+
+static void
+pll0_down(void)
+{
+	if (!pll_switched) {
+		return;
+	}
+	wr(camcc + PLL_MODE, rd(camcc + PLL_MODE) & ~1u);
+	wr(camcc + PLL_USER_CTL, rd(camcc + PLL_USER_CTL) & ~7u);
+	wr(camcc + PLL_OPMODE, 0);
+	wr(camcc + PLL_MODE, rd(camcc + PLL_MODE) & ~(1u << 2));
+	pll_switched = false;
+}
+
+/* RCGs (source index per camcc-sdmmagpie.c parent maps; divider field 2n - 1) and branches. */
+struct rcg {
+	const char *    name;
+	uint32_t        cmd, source, divider, found_cfg;
+	bool            set;
+};
+static struct rcg rcgs[] = {
+	{ "slow_ahb 80 MHz", 0x7058, 3, 9 },            /* map_8: PLL0 odd (400) / 5 */
+	{ "camnoc_axi 150 MHz", 0xc12c, 2, 7 },         /* map_0: PLL0 even (600) / 4 */
+	{ "cphy_rx 400 MHz", 0xa064, 1, 5 },            /* map_1: PLL0 main (1200) / 3 */
+	{ "csiNphytimer 300 MHz", 0, 2, 3 },            /* map_0: PLL0 even / 2 (hw->timer_cmd) */
+	{ "ife_lite_csid 400 MHz", 0xc020, 1, 5 },      /* map_1: PLL0 main / 3 */
+	{ "ife_lite 400 MHz", 0xc004, 3, 1 },           /* map_0: PLL0 odd / 1 */
+};
+struct branch {
+	const char *    name;
+	bool            in_gcc;
+	uint32_t        cbcr;
+	bool            set;
+};
+static struct branch branches[] = {
+	{ "gcc camera_xo", true, GCC_CAMERA_XO_CBCR }, { "gcc camera_hf_axi", true, GCC_CAMERA_HF_AXI_CBCR },
+	{ "gcc camera_sf_axi", true, GCC_CAMERA_SF_AXI_CBCR },
+	{ "cpas_ahb", false, 0xc124 }, { "camnoc_axi", false, 0xc148 },
+	{ "csiphy0", false, 0x6020 },                   /* every csiphy node in the DT lists csiphy0_clk too */
+	{ "csiphyN", false, 0 }, { "csiNphytimer", false, 0 },
+	{ "ife_lite_csid", false, 0xc038 }, { "ife_lite_cphy_rx", false, 0xc040 }, { "ife_lite", false, 0xc01c },
+};
+#define NRCG                    (sizeof(rcgs) / sizeof(rcgs[0]))
+#define NBRANCH                 (sizeof(branches) / sizeof(branches[0]))
+
+static bool
+clocks_up(void)
+{
+	rcgs[3].cmd = hw->timer_cmd;
+	branches[6].cbcr = hw->phy_cbcr;
+	branches[7].cbcr = hw->timer_cbcr;
+	for (unsigned i = 0; i < NRCG; i++) {
+		struct rcg *r = &rcgs[i];
+
+		r->found_cfg = rd(camcc + r->cmd + 4);
+		if (!camcc_put(r->cmd + 4, (r->found_cfg & ~0x371fu) | r->source << 8 | r->divider, 0x371f)) {
+			return false;
+		}
+		r->set = true;
+		wr(camcc + r->cmd, rd(camcc + r->cmd) | CMD_UPDATE);
+		if (!wait_bits(camcc, r->cmd, CMD_UPDATE, 0, 500)) {
+			say("RCG %s does not update (cmd %#x)\n", r->name, rd(camcc + r->cmd));
+			give_up("an RCG that does not update");
+			return false;
+		}
+	}
+	for (unsigned i = 0; i < NBRANCH; i++) {
+		struct branch *b = &branches[i];
+		vm_offset_t base = b->in_gcc ? gcc : camcc;
+
+		if (b->cbcr == 0 || (rd(base + b->cbcr) & 1)) {
+			continue;                       /* on already (or csiphyN == csiphy0): left as found */
+		}
+		wr(base + b->cbcr, rd(base + b->cbcr) | 1);
+		b->set = true;
+		if (!wait_bits(base, b->cbcr, CBCR_OFF, 0, 500)) {
+			say("branch %s does not come on (%#x)\n", b->name, rd(base + b->cbcr));
+			give_up("a clock that does not come on");
+			return false;
+		}
+	}
+	say("camera clocks on (%u RCGs, CSIPHY %u)\n", (unsigned)NRCG, hw->csiphy);
+	return true;
+}
+
+static void
+clocks_down(void)
+{
+	for (int i = (int)NBRANCH - 1; i >= 0; i--) {
+		struct branch *b = &branches[i];
+
+		if (b->set) {
+			vm_offset_t base = b->in_gcc ? gcc : camcc;
+
+			wr(base + b->cbcr, rd(base + b->cbcr) & ~1u);
+			b->set = false;
+		}
+	}
+	for (int i = (int)NRCG - 1; i >= 0; i--) {
+		struct rcg *r = &rcgs[i];
+
+		if (r->set) {
+			wr(camcc + r->cmd + 4, r->found_cfg);
+			wr(camcc + r->cmd, rd(camcc + r->cmd) | CMD_UPDATE);
+			(void)wait_bits(camcc, r->cmd, CMD_UPDATE, 0, 500);
+			r->set = false;
+		}
+	}
+}
+
+/* ---- the sensor's tables (RWCTAB02, as HackiOS's ctab_load: redwood_camera.c:1068-1167) ---------------- */
+
+struct ctab_head {
+	char            magic[8];       /* "RWCTAB02" */
+	uint32_t        slave, address_bytes, data_bytes, id_address, id, id_mask, lane_assign, modes;
+};
+struct ctab_mode {
+	uint32_t        width, height, x, y, lanes, cphy, settle, pixel_clock, line_length, frame_length, fps_milli, data_type;
+};
+struct ctab_entry {
+	uint16_t        address, data;  /* power steps: kind, value (MCLK in kHz) */
+	uint8_t         address_bytes, data_bytes, operation, zero;
+	uint32_t        delay_us;
+};
+
+static const struct ctab_head *ctab;
+static const struct ctab_mode *ctab_modes;
+static const uint8_t *ctab_power, *ctab_tables;
+static uint64_t ctab_size;
+static void *ctab_file;
+static vm_size_t ctab_file_size;
+
+static void
+ctab_free(void)
+{
+	if (ctab_file != NULL) {
+		kfree_data(ctab_file, ctab_file_size);
+		ctab_file = NULL;
+	}
+	ctab = NULL;
+}
+
+/* /usr/local/camera/<name> into memory (sweet_gpu.c clocks_file()'s way). */
+static bool
+file_read(const char *name)
+{
+	char path[96];
+	vnode_t vp = NULLVP;
+	vfs_context_t ctx;
+	off_t size = 0;
+	int resid = 0, error;
+
+	ctab_free();
+	if (rootvnode == NULLVP) {
+		return false;
+	}
+	snprintf(path, sizeof(path), "/usr/local/camera/%s", name);
+	ctx = vfs_context_kernel();
+	if (vnode_lookup(path, 0, &vp, ctx) != 0) {
+		say("no %s\n", path);
+		return false;
+	}
+	if (vnode_size(vp, &size, ctx) != 0 || size < (off_t)sizeof(struct ctab_head) || size > (1 << 20)) {
+		vnode_put(vp);
+		return false;
+	}
+	ctab_file_size = (vm_size_t)size;
+	ctab_file = kalloc_data(ctab_file_size, Z_WAITOK | Z_ZERO);
+	if (ctab_file == NULL) {
+		vnode_put(vp);
+		return false;
+	}
+	error = vn_rdwr(UIO_READ, vp, (caddr_t)ctab_file, (int)size, 0, UIO_SYSSPACE, 0, vfs_context_ucred(ctx), &resid,
+	    vfs_context_proc(ctx));
+	vnode_put(vp);
+	if (error != 0 || resid != 0) {
+		ctab_free();
+		return false;
+	}
+	ctab_size = (uint64_t)size;
+	return true;
+}
+
+static bool
+ctab_load(const char *name)
+{
+	const uint8_t *at, *end;
+
+	if (!file_read(name)) {
+		return false;
+	}
+	ctab = (const struct ctab_head *)ctab_file;
+	if (memcmp(ctab->magic, "RWCTAB02", 8) != 0 || ctab->modes == 0 || ctab->modes > 16 ||
+	    sizeof(*ctab) + ctab->modes * sizeof(struct ctab_mode) > ctab_size) {
+		say("%s is not an RWCTAB02 table\n", name);
+		ctab_free();
+		return false;
+	}
+	end = (const uint8_t *)ctab + ctab_size;
+	ctab_modes = (const struct ctab_mode *)(ctab + 1);
+	ctab_power = (const uint8_t *)(ctab_modes + ctab->modes);
+	at = ctab_power;
+	for (int p = 0; p < 2; p++) {
+		if (at + 12 > end) {
+			ctab_free();
+			return false;
+		}
+		at += 12 + *(const uint32_t *)(at + 8) * sizeof(struct ctab_entry);
+	}
+	ctab_tables = at;
+	if (ctab_tables + 4 > end) {
+		ctab_free();
+		return false;
+	}
+	say("%s: slave %#x, chip ID %#x at %#x, lanes %#x, %u modes\n", name, ctab->slave, ctab->id, ctab->id_address,
+	    ctab->lane_assign, ctab->modes);
+	for (uint32_t m = 0; m < ctab->modes; m++) {
+		const struct ctab_mode *o = &ctab_modes[m];
+
+		say("  mode %u: %ux%u, %u lane(s), settle %u, pclk %u, line %u, frame %u, %u.%03u fps\n", m, o->width, o->height,
+		    o->lanes, o->settle, o->pixel_clock, o->line_length, o->frame_length, o->fps_milli / 1000, o->fps_milli % 1000);
+	}
+	return true;
+}
+
+static const struct ctab_entry *
+ctab_block(const uint8_t *at, uint32_t blocks, const char *name, uint32_t *count)
+{
+	const uint8_t *end = (const uint8_t *)ctab + ctab_size;
+
+	for (uint32_t t = 0; t < blocks && at + 12 <= end; t++) {
+		uint32_t n = *(const uint32_t *)(at + 8);
+
+		if (strncmp((const char *)at, name, 8) == 0 && at + 12 + n * sizeof(struct ctab_entry) <= end) {
+			*count = n;
+			return (const struct ctab_entry *)(at + 12);
+		}
+		at += 12 + n * sizeof(struct ctab_entry);
+	}
+	*count = 0;
+	return NULL;
+}
+
+static const struct ctab_entry *
+ctab_find(const char *name, uint32_t *count)
+{
+	return ctab == NULL ? NULL : ctab_block(ctab_tables + 4, *(const uint32_t *)ctab_tables, name, count);
+}
+
+static uint8_t
+sensor_address(void)
+{
+	return (uint8_t)(ctab->slave >> 1);    /* the module's is the 8-bit one */
+}
+
+static void
+select_sensor(unsigned i)
+{
+	hw_index = i;
+	hw = &sensors[i];
+	cci_bus.name = i == SWEET_CAMERA_ULTRA ? "CCI1 master 0" : i == SWEET_CAMERA_TELE ? "CCI0 master 1" : "CCI0 master 0";
+	cci_bus.sda = swap_i2c ? hw->scl : hw->sda;
+	cci_bus.scl = swap_i2c ? hw->sda : hw->scl;
+	ctab_free();
+}
+
+/* ---- power ------------------------------------------------------------------------------------------ */
+
+static bool powered, reset_driven, vdig_switched;
+
+static bool
+vdig_enable(bool on)
+{
+	if (hw->vdig_kind == VDIG_TLMM) {
+		if (on) {
+			found_vdig_cfg = rd(GPIO_CFG(hw->vdig_gpio));
+			found_vdig_io = rd(GPIO_IO(hw->vdig_gpio));
+			vdig_switched = true;
+			wr(GPIO_IO(hw->vdig_gpio), 2);
+			wr(GPIO_CFG(hw->vdig_gpio), CFG_OUTPUT | CFG_DRIVE_MA(2));
+			if ((rd(GPIO_CFG(hw->vdig_gpio)) & 0x3ff) != (CFG_OUTPUT | CFG_DRIVE_MA(2)) || !(rd(GPIO_IO(hw->vdig_gpio)) & 2)) {
+				give_up("the VDIG enable pin does not read back");
+				return false;
+			}
+		} else if (vdig_switched) {
+			wr(GPIO_IO(hw->vdig_gpio), 0);
+			spin_us(10);
+			wr(GPIO_IO(hw->vdig_gpio), found_vdig_io & 2);
+			wr(GPIO_CFG(hw->vdig_gpio), found_vdig_cfg);
+			vdig_switched = false;
+		}
+		return true;
+	}
+	if (hw->vdig_kind == VDIG_PMIC) {
+		if (on) {
+			vdig_switched = true;
+			return pgpio_drive(hw->vdig_gpio, true);
+		}
+		if (vdig_switched) {
+			(void)pgpio_drive(hw->vdig_gpio, false);
+			pgpio_restore(hw->vdig_gpio);
+			vdig_switched = false;
+		}
+		return true;
+	}
+	return true;
+}
+
+static void
+sensor_delay(uint32_t us)
+{
+	if (us >= 1000) {
+		wait_ms(us / 1000);
+		us %= 1000;
+	}
+	spin_us(us);
+}
+
+/* One power step (cam_sensor kinds: 0 MCLK, 1 VANA, 2 VDIG, 3 VIO, 6/7 CUSTOM_REG1/2, 8 RESET). */
+static bool
+power_step(const struct ctab_entry *e, bool up)
+{
+	bool on = e->data != 0;
+
+	switch (e->address) {
+	case 8:
+		reset_driven = true;
+		reset_pin(on);
+		break;
+	case 0:
+		if (on) {
+			if (!up || !gdsc_on() || !mclk_on(e->data)) {
+				return false;
+			}
+		} else {
+			mclk_off();
+		}
+		break;
+	case 1:
+		if (!rail(RAIL_VANA, on) && on) {
+			return false;
+		}
+		break;
+	case 2:
+		if (on) {
+			if (!up || !rail(RAIL_VDIG, true) || !vdig_enable(true)) {
+				return false;
+			}
+		} else {
+			(void)vdig_enable(false);
+			(void)rail(RAIL_VDIG, false);
+		}
+		break;
+	case 3:
+		if (!rail(RAIL_VIO, on) && on) {
+			return false;
+		}
+		break;
+	case 6: case 7:
+		if (!rail(RAIL_CUSTOM, on) && on) {
+			return false;
+		}
+		break;
+	default:
+		say("a power step of kind %u, not known here\n", e->address);
+		give_up("a power sequence not understood");
+		return false;
+	}
+	sensor_delay(e->delay_us);
+	return true;
+}
+
+static void
+power_down(void)
+{
+	uint32_t count = 0;
+	const struct ctab_entry *e = ctab != NULL ? ctab_block(ctab_power, 2, "pwrdn", &count) : NULL;
+	bool any = powered || mclk_switched || gdsc_switched || reset_driven || vdig_switched;
+
+	for (unsigned r = 0; r < RAILS; r++) {
+		any |= rail_on[r];
+	}
+	if (!any) {
+		return;
+	}
+	for (uint32_t i = 0; e != NULL && i < count; i++) {
+		(void)power_step(&e[i], false);
+	}
+	mclk_off();
+	if (reset_driven) {
+		reset_pin(false);
+	}
+	(void)vdig_enable(false);
+	for (int r = RAILS - 1; r >= 0; r--) {
+		(void)rail((unsigned)r, false);
+	}
+	gdsc_off();
+	if (reset_driven && pins_found) {
+		wr(GPIO_IO(hw->reset), found_reset_io & 2);
+		wr(GPIO_CFG(hw->reset), found_reset_cfg);
+		reset_driven = false;
+	}
+	powered = false;
+	say("the %s sensor powered down\n", hw->name);
+}
+
+static bool
+power_up(void)
+{
+	uint32_t count = 0;
+	const struct ctab_entry *e = ctab != NULL ? ctab_block(ctab_power, 2, "pwrup", &count) : NULL;
+
+	if (e == NULL) {
+		give_up("no power sequence");
+		return false;
+	}
+	if (hw->popup) {
+		say("the front camera is behind the pop-up: its frames are dark until the motor raises it\n");
+	}
+	powered = true;
+	for (uint32_t i = 0; i < count; i++) {
+		if (!power_step(&e[i], true)) {
+			return false;
+		}
+	}
+	say("the %s sensor powered up (%u steps)\n", hw->name, count);
+	return true;
+}
+
+static bool
+read_id(uint32_t *chip)
+{
+	uint8_t where[2] = { (uint8_t)(ctab->id_address >> 8), (uint8_t)ctab->id_address }, id[4] = { 0 };
+	unsigned out = ctab->address_bytes == 2 ? 2 : 1, in = ctab->data_bytes >= 1 && ctab->data_bytes <= 4 ? ctab->data_bytes : 2;
+	unsigned go;
+
+	for (go = 0; go < 20; go++) {
+		if (i2c_transfer(&cci_bus, sensor_address(), out == 2 ? where : where + 1, out, id, in)) {
+			break;
+		}
+		wait_ms(2);
+	}
+	if (go == 20) {
+		say("the %s sensor does not answer at %#04x\n", hw->name, sensor_address());
+		return false;
+	}
+	*chip = 0;
+	for (unsigned i = 0; i < in; i++) {
+		*chip = *chip << 8 | id[i];
+	}
+	return true;
+}
+
+/* The chip ID; for the wide footprint, IMX586 or IMX582 (same pins, same power sequence: tables differ). */
+static bool
+read_chip_id(void)
+{
+	uint32_t chip = 0;
+
+	if (!read_id(&chip)) {
+		return false;
+	}
+	if ((chip & ctab->id_mask) != (ctab->id & ctab->id_mask) && hw->tab_alt != NULL) {
+		say("chip ID %#x is not %s's: trying %s\n", chip, hw->tab, hw->tab_alt);
+		if (!ctab_load(hw->tab_alt)) {
+			return false;
+		}
+	}
+	say("the %s sensor's chip ID: %#06x (%s)\n", hw->name, chip,
+	    (chip & ctab->id_mask) == (ctab->id & ctab->id_mask) ? "as Android expects" : "NOT what Android expects");
+	return (chip & ctab->id_mask) == (ctab->id & ctab->id_mask);
+}
+
+/*
+ * A table written in order. Samsung setfiles carry writes to 0x0000 (the read-only model ID register:
+ * "0x0000 0x30c6") as markers; they are written as Android writes them. After a soft reset (0x6010 = 1
+ * Samsung, 0x0103 = 1 Sony/OV) the modules give a delay of a few "us"; at least 3 ms is waited (the
+ * data sheets' value) in case the CamX field is milliseconds after all.
+ */
+static bool
+sensor_table(const char *name)
+{
+	uint32_t count;
+	const struct ctab_entry *e = ctab_find(name, &count);
+
+	if (e == NULL) {
+		say("the tables have no \"%s\"\n", name);
+		return false;
+	}
+	for (uint32_t i = 0; i < count; i++) {
+		uint8_t out[4];
+		unsigned n = 0;
+		uint32_t delay = e[i].delay_us;
+
+		if (e[i].operation != 0 || e[i].address_bytes < 1 || e[i].address_bytes > 2 || e[i].data_bytes < 1 || e[i].data_bytes > 2) {
+			say("\"%s\" %u: operation %u, %u/%u bytes: not known here\n", name, i, e[i].operation, e[i].address_bytes,
+			    e[i].data_bytes);
+			give_up("a sensor table not understood");
+			return false;
+		}
+		if (e[i].address_bytes == 2) {
+			out[n++] = (uint8_t)(e[i].address >> 8);
+		}
+		out[n++] = (uint8_t)e[i].address;
+		if (e[i].data_bytes == 2) {
+			out[n++] = (uint8_t)(e[i].data >> 8);
+		}
+		out[n++] = (uint8_t)e[i].data;
+		if (!i2c_transfer(&cci_bus, sensor_address(), out, n, NULL, 0)) {
+			say("\"%s\" %u: %#x <- %#x not acknowledged\n", name, i, e[i].address, e[i].data);
+			give_up("a sensor write nobody acknowledged");
+			return false;
+		}
+		if ((e[i].address == 0x6010 || e[i].address == 0x0103) && (e[i].data & 1) && delay < 3000) {
+			delay = 3000;
+		}
+		if (delay != 0) {
+			sensor_delay(delay > 100000 ? 100000 : delay);
+		}
+	}
+	say("\"%s\": %u writes\n", name, count);
+	return true;
+}
+
+static bool
+sensor_write(uint16_t address, uint16_t value, bool sixteen)
+{
+	uint8_t out[4] = { (uint8_t)(address >> 8), (uint8_t)address, (uint8_t)(value >> 8), (uint8_t)value };
+
+	if (sixteen) {
+		return i2c_transfer(&cci_bus, sensor_address(), out, 4, NULL, 0);
+	}
+	out[2] = (uint8_t)value;
+	return i2c_transfer(&cci_bus, sensor_address(), out, 3, NULL, 0);
+}
+
+/* ---- the apps SMMU: a context of ours for the IFEs' streams (HackiOS redwood_camera.c:2025-2288) -------- */
+
+/*
+ * davinci_0.dts msm_cam_smmu_ife: iommus 0x900/0x460, 0x880/0x460, 0x820/0x440 (+0x400 twins, mnoc_hf_1).
+ * NOT 0x800/0x440: that is the display's (mdss_mdp, line 9077), which the bootloader set up.
+ * Three match registers, one context. Which of them IFE-lite 0 uses is learned from the first fault
+ * (FSYNR / CBFRSYNRA) or from which SMR is hit, then the others can go.
+ */
+#define SMMU_PHYS               0x15000000UL
+#define SMMU_SGFSR              0x048
+#define SMMU_SGFSYNR1           0x054
+#define SMMU_IDR0               0x020
+#define SMMU_IDR1               0x024
+#define SMMU_SMR(n)             (0x800 + 4 * (n))
+#define SMMU_S2CR(n)            (0xc00 + 4 * (n))
+#define SMMU_CBAR(n)            (4 * (n))               /* GR1 */
+#define SMMU_CBFRSYNRA(n)       (0x400 + 4 * (n))       /* GR1: the faulting stream of context n */
+#define SMMU_CBA2R(n)           (0x800 + 4 * (n))       /* GR1 */
+#define SMMU_CBAR_STAGE_1       (1u << 16 | 3u << 8 | 0xfu << 12)
+#define SMMU_CB_SCTLR           0x00
+#define SMMU_CB_TCR2            0x10
+#define SMMU_CB_TTBR0           0x20
+#define SMMU_CB_TTBR1           0x28
+#define SMMU_CB_TCR             0x30
+#define SMMU_CB_MAIR0           0x38
+#define SMMU_CB_MAIR1           0x3c
+#define SMMU_CB_FSR             0x58
+#define SMMU_CB_FAR             0x60
+#define SMMU_CB_FSYNR0          0x68
+#define SMMU_CB_TLBIASID        0x610
+#define SMMU_CB_TLBSYNC         0x7f0
+#define SMMU_CB_TLBSTATUS       0x7f4
+#define SMMU_SCTLR_ON           (1u << 0 | 1u << 1 | 1u << 2 | 1u << 5 | 1u << 8 | 1u << 12)
+#define SMMU_TCR_39_BITS        (25u | 1u << 8 | 1u << 10 | 3u << 12 | 1u << 23)
+#define SMMU_TCR2               (1u | 1u << 4 | 7u << 15)       /* 36-bit PA: davinci's DRAM ends below 0x150000000 */
+#define SMMU_MAIR0              0xf404ff44
+#define SMMU_FSR_ALL            0xc00001fe
+#define CAM_PTE                 (3ull | 1ull << 6 | 2ull << 8 | 1ull << 10 | 1ull << 11)
+#define FRAME_ADDRESSES         0x40000000ull           /* in the DT's iova pool (0x7400000 + 0xd8c00000) */
+#define IFE_SMRS                3
+
+static const struct { uint16_t stream, mask; } ife_streams[IFE_SMRS] = {
+	{ 0x900, 0x460 }, { 0x880, 0x460 }, { 0x820, 0x440 },
+};
+static vm_offset_t smmu, smmu_gr1, smmu_context, page_tables;
+static uint64_t page_tables_bytes;
+static uint32_t smmu_match[IFE_SMRS], smmu_old_smr[IFE_SMRS], smmu_old_s2cr[IFE_SMRS], smmu_context_n, smmu_pages_size, smmu_pages;
+static unsigned smmu_matches;
+static bool smmu_on;
+static LCK_MTX_DECLARE(smmu_lock, &cam_lck_grp);
+static vm_offset_t frames;
+static uint64_t frames_bytes;
+
+static bool
+smmu_find(void)
+{
+	bool used[256] = { false };
+	uint32_t idr0 = rd(smmu + SMMU_IDR0), idr1 = rd(smmu + SMMU_IDR1);
+
+	smmu_pages_size = idr1 >> 31 ? 0x10000 : 0x1000;
+	smmu_pages = 2u << (idr1 >> 28 & 7);
+	if (2 * smmu_pages * smmu_pages_size != 0x100000) {
+		say("the SMMU's layout (IDR1 %#x) is not the one known here\n", idr1);
+		return false;
+	}
+	smmu_matches = 0;
+	for (uint32_t n = 0; n < (idr0 & 0xff) && SMMU_SMR(n) < 0xc00; n++) {
+		uint32_t smr = rd(smmu + SMMU_SMR(n)), s2cr = rd(smmu + SMMU_S2CR(n));
+
+		if (smr >> 31) {
+			used[s2cr & 0xff] = true;
+			for (int s = 0; s < IFE_SMRS; s++) {
+				if ((((smr & 0x7fff) ^ ife_streams[s].stream) & ~((smr >> 16 & 0x7fff) | ife_streams[s].mask)) == 0) {
+					say("SMMU SMR %u (%#x) already matches the IFE streams: left alone\n", n, smr);
+					return false;
+				}
+			}
+		} else if (smmu_matches < IFE_SMRS) {
+			smmu_match[smmu_matches] = n;
+			smmu_old_smr[smmu_matches] = smr;
+			smmu_old_s2cr[smmu_matches] = s2cr;
+			smmu_matches++;
+		}
+	}
+	for (smmu_context_n = 0; smmu_context_n < (idr1 & 0xff) && used[smmu_context_n]; smmu_context_n++) {
+	}
+	if (smmu_matches < IFE_SMRS || smmu_context_n >= (idr1 & 0xff)) {
+		say("the SMMU has no %u free SMRs or no free context\n", IFE_SMRS);
+		return false;
+	}
+	smmu_gr1 = cam_map(SMMU_PHYS + smmu_pages_size, 0x1000);
+	smmu_context = cam_map(SMMU_PHYS + (uint64_t)(smmu_pages + smmu_context_n) * smmu_pages_size, 0x1000);
+	if (rd(smmu_context + SMMU_CB_SCTLR) & 1) {
+		say("SMMU context %u is on although no stream uses it: somebody's\n", smmu_context_n);
+		return false;
+	}
+	return true;
+}
+
+static bool
+smmu_put(vm_offset_t base, uint32_t offset, uint32_t value, uint32_t check)
+{
+	wr(base + offset, value);
+	if ((rd(base + offset) & check) != (value & check)) {
+		say("SMMU %#x <- %#x reads %#x (hypervisor-owned?)\n", offset, value, rd(base + offset));
+		give_up("an SMMU register that did not read back");
+		return false;
+	}
+	return true;
+}
+
+static bool
+smmu_up(void)
+{
+	uint64_t *root, *second, table_root;
+	uint32_t thirds = (uint32_t)((frames_bytes + 0x1fffff) >> 21), pages = (uint32_t)(frames_bytes >> 12);
+	bool ok = false;
+
+	if (smmu == 0) {
+		smmu = cam_map(SMMU_PHYS, 0x1000);
+	}
+	lck_mtx_lock(&smmu_lock);
+	if (!smmu_find()) {
+		give_up("no place in the SMMU");
+		goto out;
+	}
+	page_tables_bytes = (2 + thirds) * 4096;
+	if (kmem_alloc(kernel_map, &page_tables, round_page(page_tables_bytes), KMA_KOBJECT | KMA_ZERO | KMA_DATA,
+	    VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		page_tables = 0;
+		give_up("no memory for page tables");
+		goto out;
+	}
+	root = (uint64_t *)page_tables;
+	second = (uint64_t *)(page_tables + 4096);
+	root[FRAME_ADDRESSES >> 30 & 0x1ff] = cam_pa((vm_offset_t)second) | 3;
+	for (uint32_t t = 0; t < thirds; t++) {
+		uint64_t *third = (uint64_t *)(page_tables + (2 + t) * 4096);
+
+		second[(FRAME_ADDRESSES >> 21 & 0x1ff) + t] = cam_pa((vm_offset_t)third) | 3;
+		for (uint32_t p = 0; p < 512 && t * 512 + p < pages; p++) {
+			third[p] = cam_pa(frames + 4096ull * (t * 512 + p)) | CAM_PTE;
+		}
+	}
+	for (vm_offset_t l = page_tables; l < page_tables + page_tables_bytes; l += 64) {
+		__asm__ volatile ("dc civac, %0" : : "r" (l));
+	}
+	__asm__ volatile ("dsb sy");
+	table_root = cam_pa(page_tables) | (uint64_t)smmu_context_n << 48;
+	if (!smmu_put(smmu_context, SMMU_CB_SCTLR, 0, ~0u) || !smmu_put(smmu_gr1, SMMU_CBA2R(smmu_context_n), 1, 1) ||
+	    !smmu_put(smmu_gr1, SMMU_CBAR(smmu_context_n), SMMU_CBAR_STAGE_1, 0x30000) ||
+	    !smmu_put(smmu_context, SMMU_CB_TCR2, SMMU_TCR2, 0) || !smmu_put(smmu_context, SMMU_CB_TCR, SMMU_TCR_39_BITS, ~0u) ||
+	    !smmu_put(smmu_context, SMMU_CB_TTBR0, (uint32_t)table_root, ~0u) ||
+	    !smmu_put(smmu_context, SMMU_CB_TTBR0 + 4, (uint32_t)(table_root >> 32), ~0u) ||
+	    !smmu_put(smmu_context, SMMU_CB_TTBR1, 0, ~0u) || !smmu_put(smmu_context, SMMU_CB_TTBR1 + 4, 0, ~0u) ||
+	    !smmu_put(smmu_context, SMMU_CB_MAIR0, SMMU_MAIR0, ~0u) || !smmu_put(smmu_context, SMMU_CB_MAIR1, 0, ~0u)) {
+		goto out;
+	}
+	wr(smmu_context + SMMU_CB_FSR, SMMU_FSR_ALL);
+	wr(smmu_context + SMMU_CB_TLBIASID, smmu_context_n);
+	wr(smmu_context + SMMU_CB_TLBSYNC, 1);
+	if (!wait_bits(smmu_context, SMMU_CB_TLBSTATUS, 1, 0, 10000)) {
+		give_up("the SMMU does not finish its TLB sync");
+		goto out;
+	}
+	if (!smmu_put(smmu_context, SMMU_CB_SCTLR, SMMU_SCTLR_ON, 1)) {
+		goto out;
+	}
+	smmu_on = true;
+	for (int s = 0; s < IFE_SMRS; s++) {
+		if (!smmu_put(smmu, SMMU_S2CR(smmu_match[s]), smmu_context_n, 0x300ff) ||
+		    !smmu_put(smmu, SMMU_SMR(smmu_match[s]), 1u << 31 | (uint32_t)ife_streams[s].mask << 16 | ife_streams[s].stream, ~0u)) {
+			goto out;
+		}
+	}
+	say("SMMU: context %u maps %llu KB at %#llx; SMRs %u/%u/%u send the IFE streams to it\n", smmu_context_n, frames_bytes >> 10,
+	    FRAME_ADDRESSES, smmu_match[0], smmu_match[1], smmu_match[2]);
+	ok = true;
+out:
+	lck_mtx_unlock(&smmu_lock);
+	return ok;
+}
+
+static void
+smmu_faults(void)
+{
+	uint32_t status, global;
+
+	if (!smmu_on) {
+		return;
+	}
+	status = rd(smmu_context + SMMU_CB_FSR);
+	global = rd(smmu + SMMU_SGFSR);
+	if ((status & SMMU_FSR_ALL) == 0 && global == 0) {
+		return;
+	}
+	say("SMMU FAULT: context %u FSR %#x FAR %#llx FSYNR0 %#x, stream %#x; global %#x/%#x\n", smmu_context_n, status,
+	    (uint64_t)rd(smmu_context + SMMU_CB_FAR + 4) << 32 | rd(smmu_context + SMMU_CB_FAR), rd(smmu_context + SMMU_CB_FSYNR0),
+	    rd(smmu_gr1 + SMMU_CBFRSYNRA(smmu_context_n)) & 0xffff, global, rd(smmu + SMMU_SGFSYNR1));
+}
+
+static void
+smmu_down(void)
+{
+	if (!smmu_on && smmu_matches == 0) {
+		return;
+	}
+	smmu_faults();
+	if (!leaving) {
+		lck_mtx_lock(&smmu_lock);
+	}
+	for (unsigned s = 0; s < smmu_matches; s++) {
+		wr(smmu + SMMU_SMR(smmu_match[s]), smmu_old_smr[s]);
+		wr(smmu + SMMU_S2CR(smmu_match[s]), smmu_old_s2cr[s]);
+	}
+	if (smmu_on) {
+		wr(smmu_context + SMMU_CB_SCTLR, 0);
+		wr(smmu_context + SMMU_CB_TLBIASID, smmu_context_n);
+		wr(smmu_context + SMMU_CB_TLBSYNC, 1);
+	}
+	if (!leaving) {
+		lck_mtx_unlock(&smmu_lock);
+	}
+	smmu_on = false;
+	smmu_matches = 0;
+	if (page_tables != 0 && !leaving) {
+		kmem_free(kernel_map, page_tables, round_page(page_tables_bytes));
+		page_tables = 0;
+	}
+}
+
+/* ---- CSID-lite 0 (csid-lite175: cam_ife_csid_lite17x.h) and IFE-lite 0 (vfe-lite175: cam_vfe_lite17x.h) ---- */
+/* Same register layout as HackiOS's redwood (lite17x): HackiOS redwood_camera.c:2290-2608, unchanged. */
+
+#define CSID_PHYS               0x0acc8000UL
+#define IFE_PHYS                0x0acc4000UL
+#define CSIPHY_PHYS(n)          (0x0ace0000UL + 0x2000UL * (n))
+
+#define CSID_HW_VERSION         0x000
+#define CSID_RST_STROBES        0x010
+#define CSID_CSI2_RX_IRQ_STATUS 0x020
+#define CSID_CSI2_RX_IRQ_MASK   0x024
+#define CSID_CSI2_RX_IRQ_CLEAR  0x028
+#define CSID_RDI0_IRQ_STATUS    0x030
+#define CSID_RDI0_IRQ_MASK      0x034
+#define CSID_RDI0_IRQ_CLEAR     0x038
+#define CSID_TOP_IRQ_STATUS     0x070
+#define CSID_TOP_IRQ_MASK       0x074
+#define CSID_TOP_IRQ_CLEAR      0x078
+#define CSID_IRQ_CMD            0x080
+#define CSID_CSI2_RX_CFG0       0x100
+#define CSID_CSI2_RX_CFG1       0x104
+#define CSID_CSI2_RX_PKTS       0x160
+#define CSID_CSI2_RX_ECC        0x164
+#define CSID_CSI2_RX_CRC        0x168
+#define CSID_RDI0_CFG0          0x200
+#define CSID_RDI0_CFG1          0x204
+#define CSID_RDI0_CTRL          0x208
+#define CSID_RDI0_FRM_DROP_PATTERN 0x20c
+#define CSID_RDI0_FRM_DROP_PERIOD  0x210
+#define CSID_RDI0_IRQ_SUB_PATTERN  0x214
+#define CSID_RDI0_IRQ_SUB_PERIOD   0x218
+#define CSID_RDI0_PIX_DROP_PATTERN 0x224
+#define CSID_RDI0_PIX_DROP_PERIOD  0x228
+#define CSID_RDI0_LINE_DROP_PATTERN 0x22c
+#define CSID_RDI0_LINE_DROP_PERIOD  0x230
+#define CSID_RDI0_STATUS        0x250
+#define CSID_RDI0_BYTES_PING    0x2e0
+#define CSID_RDI0_BYTES_PONG    0x2e4
+#define CSID_TPG_CTRL           0x600
+#define CSID_TPG_VC_CFG0        0x604
+#define CSID_TPG_VC_CFG1        0x608
+#define CSID_TPG_LFSR_SEED      0x60c
+#define CSID_TPG_DT0_CFG0       0x610
+#define CSID_TPG_DT0_CFG1       0x614
+#define CSID_TPG_DT0_CFG2       0x618
+#define CSID_TPG_COLOR_BARS_CFG 0x640
+#define CSID_TPG_COMMON_GEN_CFG 0x648
+#define TPG_VC                  0xa
+#define RAW10_DT                0x2b
+#define RAW10_STRIDE(width)     (((width) * 10 / 8 + 15) & ~15u)        /* the write master's line: 16-byte multiple */
+
+#define IFE_HW_VERSION          0x0000
+#define IFE_GLOBAL_RESET        0x0018
+#define IFE_IRQ_MASK0           0x005c
+#define IFE_IRQ_CLEAR0          0x0064
+#define IFE_IRQ_CLEAR1          0x0068
+#define IFE_IRQ_STATUS0         0x006c
+#define IFE_IRQ_STATUS1         0x0070
+#define IFE_IRQ_GLOBAL_CLEAR    0x0058
+#define IFE_VIOLATION_STATUS    0x007c
+#define IFE_REG_UPDATE          0x04ac
+#define BUS_HW_VERSION          0x2000
+#define BUS_CGC_OVD             0x200c
+#define BUS_IRQ_MASK1           0x2048
+#define BUS_IRQ_CLEAR1          0x2054
+#define BUS_IRQ_STATUS0         0x205c
+#define BUS_IRQ_STATUS1         0x2060
+#define BUS_IRQ_STATUS2         0x2064
+#define BUS_IRQ_GLOBAL_CLEAR    0x2068
+#define BUS_COMP_ERROR          0x206c
+#define BUS_ADDR_SYNC_FRAME_HDR 0x2080
+#define BUS_ADDR_SYNC_NO_SYNC   0x2084
+#define BUS_TEST_CTRL           0x211c
+#define WM0_STATUS0             0x2200
+#define WM0_STATUS1             0x2204
+#define WM0_CFG                 0x2208
+#define WM0_IMAGE_ADDR          0x2214
+#define WM0_WIDTH               0x221c
+#define WM0_HEIGHT              0x2220
+#define WM0_PACKER              0x2224
+#define WM0_STRIDE              0x2228
+#define WM0_IRQ_SUB_PERIOD      0x2248
+#define WM0_IRQ_SUB_PATTERN     0x224c
+#define WM0_FRAMEDROP_PERIOD    0x2250
+#define WM0_FRAMEDROP_PATTERN   0x2254
+#define WM0_FRAME_INC           0x2258
+#define WM0_BURST_LIMIT         0x225c
+#define RDI0_SOF                (1u << 27)      /* IFE_IRQ_STATUS0: vfe17x_rdi_0_data.sof_irq_mask */
+#define WM0_DONE                1u              /* BUS_IRQ_STATUS1 */
+
+static vm_offset_t csid, ife, csiphy, csiphys[4];
+static bool csid_running, ife_running, tpg_running, csiphy_running;
+
+static bool
+blk_put(vm_offset_t base, const char *what, uint32_t offset, uint32_t value, bool check)
+{
+	wr(base + offset, value);
+	__asm__ volatile ("dsb sy");
+	if (check && rd(base + offset) != value) {
+		say("%s %#x <- %#x reads %#x\n", what, offset, value, rd(base + offset));
+		give_up("a camera register that did not read back");
+		return false;
+	}
+	return true;
+}
+
+static bool
+csid_reset(void)
+{
+	blk_put(csid, "CSID", CSID_CSI2_RX_IRQ_MASK, 0, false);
+	for (unsigned r = 0; r < 4; r++) {
+		blk_put(csid, "CSID", CSID_RDI0_IRQ_MASK + 0x10 * r, 0, false);
+	}
+	blk_put(csid, "CSID", CSID_TOP_IRQ_CLEAR, 1, false);
+	blk_put(csid, "CSID", CSID_CSI2_RX_IRQ_CLEAR, 0xfffffff, false);
+	for (unsigned r = 0; r < 4; r++) {
+		blk_put(csid, "CSID", CSID_RDI0_IRQ_CLEAR + 0x10 * r, 0x7fff, false);
+	}
+	blk_put(csid, "CSID", CSID_IRQ_CMD, 1, false);
+	blk_put(csid, "CSID", CSID_CSI2_RX_CFG1, 0x80, false);
+	for (unsigned r = 0; r < 4; r++) {
+		blk_put(csid, "CSID", CSID_RDI0_CFG0 + 0x100 * r, 2, false);
+	}
+	for (unsigned stage = 0; stage < 2; stage++) {      /* registers (strobe 1), then the hardware (0x1e) */
+		blk_put(csid, "CSID", CSID_TOP_IRQ_CLEAR, 1, false);
+		blk_put(csid, "CSID", CSID_IRQ_CMD, 1, false);
+		blk_put(csid, "CSID", CSID_TOP_IRQ_MASK, 1, false);
+		blk_put(csid, "CSID", CSID_IRQ_CMD, 1, false);
+		blk_put(csid, "CSID", CSID_RST_STROBES, stage ? 0x1e : 0x1, false);
+		if (!wait_bits(csid, CSID_TOP_IRQ_STATUS, 1, 1, 100000)) {
+			say("CSID-lite %s reset does not finish (top irq %#x)\n", stage ? "hardware" : "register", rd(csid + CSID_TOP_IRQ_STATUS));
+			give_up("a CSID that does not reset");
+			return false;
+		}
+		blk_put(csid, "CSID", CSID_TOP_IRQ_CLEAR, 1, false);
+		blk_put(csid, "CSID", CSID_IRQ_CMD, 1, false);
+	}
+	say("CSID-lite 0 reset (version %#x)\n", rd(csid + CSID_HW_VERSION));
+	return true;
+}
+
+/* RX from CSIPHY `phy' (or the TPG: -1), RDI 0 for RAW10 of vc, written packed as it comes. D-PHY only here. */
+static bool
+csid_config(int phy, unsigned lanes, uint32_t lane_cfg, uint32_t vc, uint32_t width, uint32_t height)
+{
+	uint32_t cfg0 = vc << 22 | RAW10_DT << 16 | 0xfu << 12 | 1u << 2 | 3u;
+
+	if (!blk_put(csid, "CSID", CSID_CSI2_RX_CFG0, (lanes - 1) | lane_cfg << 4 | (uint32_t)(phy < 0 ? 0 : phy & 3) << 20, true) ||
+	    !blk_put(csid, "CSID", CSID_CSI2_RX_CFG1, 1u << 6 | 1u, true)) {
+		return false;
+	}
+	if (phy < 0) {
+		if (!blk_put(csid, "CSID", CSID_TPG_VC_CFG0, 0u << 16 | 1u << 10 | vc, true) ||
+		    !blk_put(csid, "CSID", CSID_TPG_VC_CFG1, 0x3ffu << 12 | 0x740, true) ||
+		    !blk_put(csid, "CSID", CSID_TPG_LFSR_SEED, 0x12345678, true) ||
+		    !blk_put(csid, "CSID", CSID_TPG_DT0_CFG0, width << 16 | height, true) ||
+		    !blk_put(csid, "CSID", CSID_TPG_DT0_CFG1, RAW10_DT, true) ||
+		    !blk_put(csid, "CSID", CSID_TPG_DT0_CFG2, (3u - 1) << 16 | 0x8, true) ||
+		    !blk_put(csid, "CSID", CSID_TPG_COLOR_BARS_CFG, 1u << 5, true) ||
+		    !blk_put(csid, "CSID", CSID_TPG_COMMON_GEN_CFG, 0, true)) {
+			return false;
+		}
+	}
+	if (!blk_put(csid, "CSID", CSID_RDI0_CFG0, cfg0, true) || !blk_put(csid, "CSID", CSID_RDI0_CFG1, 2, true) ||
+	    !blk_put(csid, "CSID", CSID_RDI0_FRM_DROP_PERIOD, 1, true) || !blk_put(csid, "CSID", CSID_RDI0_FRM_DROP_PATTERN, 0, true) ||
+	    !blk_put(csid, "CSID", CSID_RDI0_IRQ_SUB_PERIOD, 1, true) || !blk_put(csid, "CSID", CSID_RDI0_IRQ_SUB_PATTERN, 0, true) ||
+	    !blk_put(csid, "CSID", CSID_RDI0_PIX_DROP_PATTERN, 0, true) || !blk_put(csid, "CSID", CSID_RDI0_PIX_DROP_PERIOD, 1, true) ||
+	    !blk_put(csid, "CSID", CSID_RDI0_LINE_DROP_PATTERN, 0, true) ||
+	    !blk_put(csid, "CSID", CSID_RDI0_LINE_DROP_PERIOD, 1, true) || !blk_put(csid, "CSID", CSID_RDI0_CTRL, 0, true) ||
+	    !blk_put(csid, "CSID", CSID_RDI0_CFG0, cfg0 | 1u << 31, true)) {
+		return false;
+	}
+	csid_running = true;
+	return blk_put(csid, "CSID", CSID_RDI0_CTRL, 1, true) &&
+	       blk_put(csid, "CSID", CSID_RDI0_IRQ_MASK, 1u << 1 | 1u << 2 | 1u << 3 | 1u << 4 | 1u << 5 | 1u << 6, true);
+}
+
+static bool
+tpg_start(void)
+{
+	if (!blk_put(csid, "CSID", CSID_TPG_CTRL, 4u << 20 | 0x80u << 8 | 3u << 4 | 7u, true)) {
+		return false;
+	}
+	tpg_running = true;
+	return true;
+}
+
+/* cam_vfe_top_reset, cam_vfe_bus_init_hw, start_wm/update_wm for RDI 0 -> WM0 in frame mode. */
+static bool
+ife_config(uint64_t address, uint32_t frame_inc)
+{
+	blk_put(ife, "IFE", IFE_IRQ_MASK0, 1u << 31, false);
+	blk_put(ife, "IFE", IFE_GLOBAL_RESET, 0x3f9f, false);
+	if (!wait_bits(ife, IFE_IRQ_STATUS0, 1u << 31, 1u << 31, 100000)) {
+		say("IFE-lite does not reset (irq %#x)\n", rd(ife + IFE_IRQ_STATUS0));
+		give_up("an IFE that does not reset");
+		return false;
+	}
+	blk_put(ife, "IFE", IFE_IRQ_CLEAR0, 0xffffffff, false);
+	blk_put(ife, "IFE", IFE_IRQ_CLEAR1, 0xffffffff, false);
+	blk_put(ife, "IFE", IFE_IRQ_GLOBAL_CLEAR, 1, false);
+	say("IFE-lite 0 reset (version %#x, bus %#x)\n", rd(ife + IFE_HW_VERSION), rd(ife + BUS_HW_VERSION));
+	if (!blk_put(ife, "IFE", BUS_ADDR_SYNC_FRAME_HDR, 0, true) || !blk_put(ife, "IFE", BUS_CGC_OVD, 0xfffff, false) ||
+	    !blk_put(ife, "IFE", BUS_TEST_CTRL, 0, false) || !blk_put(ife, "IFE", BUS_ADDR_SYNC_NO_SYNC, 0xffffff, false) ||
+	    !blk_put(ife, "IFE", WM0_BURST_LIMIT, 0xf, true) || !blk_put(ife, "IFE", WM0_WIDTH, 0xff01, true) ||
+	    !blk_put(ife, "IFE", WM0_HEIGHT, 0, true) || !blk_put(ife, "IFE", WM0_PACKER, 0, true) ||
+	    !blk_put(ife, "IFE", WM0_STRIDE, 0xff01, true) || !blk_put(ife, "IFE", WM0_FRAMEDROP_PERIOD, 0, true) ||
+	    !blk_put(ife, "IFE", WM0_FRAMEDROP_PATTERN, 1, true) || !blk_put(ife, "IFE", WM0_IRQ_SUB_PERIOD, 0, true) ||
+	    !blk_put(ife, "IFE", WM0_IRQ_SUB_PATTERN, 1, true) || !blk_put(ife, "IFE", BUS_IRQ_MASK1, 1, false) ||
+	    !blk_put(ife, "IFE", WM0_IMAGE_ADDR, (uint32_t)address, false) || !blk_put(ife, "IFE", WM0_FRAME_INC, frame_inc, true) ||
+	    !blk_put(ife, "IFE", WM0_CFG, 3, true)) {
+		return false;
+	}
+	ife_running = true;
+	return blk_put(ife, "IFE", IFE_REG_UPDATE, 0x2, false);
+}
+
+static void
+show_paths(const char *when)
+{
+	say("%s: CSID rx irq %#x pkts %u ecc %#x crc %u; RDI0 irq %#x status %#x bytes %u/%u; IFE irq %#x %#x viol %#x; "
+	    "bus irq %#x %#x %#x comp %#x; WM0 %#x %#x\n", when, rd(csid + CSID_CSI2_RX_IRQ_STATUS), rd(csid + CSID_CSI2_RX_PKTS),
+	    rd(csid + CSID_CSI2_RX_ECC), rd(csid + CSID_CSI2_RX_CRC), rd(csid + CSID_RDI0_IRQ_STATUS), rd(csid + CSID_RDI0_STATUS),
+	    rd(csid + CSID_RDI0_BYTES_PING), rd(csid + CSID_RDI0_BYTES_PONG), rd(ife + IFE_IRQ_STATUS0), rd(ife + IFE_IRQ_STATUS1),
+	    rd(ife + IFE_VIOLATION_STATUS), rd(ife + BUS_IRQ_STATUS0), rd(ife + BUS_IRQ_STATUS1), rd(ife + BUS_IRQ_STATUS2),
+	    rd(ife + BUS_COMP_ERROR), rd(ife + WM0_STATUS0), rd(ife + WM0_STATUS1));
+}
+
+static void
+paths_down(void)
+{
+	if (tpg_running) {
+		wr(csid + CSID_TPG_CTRL, 0);
+		tpg_running = false;
+	}
+	if (csid_running) {
+		wr(csid + CSID_RDI0_IRQ_MASK, 0);
+		wr(csid + CSID_RDI0_CTRL, (rd(csid + CSID_RDI0_CTRL) & ~3u) | 2);      /* halt now */
+		wr(csid + CSID_RDI0_CFG0, rd(csid + CSID_RDI0_CFG0) & ~(1u << 31));
+		wr(csid + CSID_CSI2_RX_CFG0, 0);
+		csid_running = false;
+	}
+	if (ife_running) {
+		wr(ife + WM0_CFG, 0);
+		wr(ife + IFE_REG_UPDATE, 0x2);
+		spin_us(1000);
+		ife_running = false;
+	}
+}
