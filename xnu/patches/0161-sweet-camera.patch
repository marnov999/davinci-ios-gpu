+/* ---- the sensors ---------------------------------------------------------------------------------- */
+
+enum { VDIG_NONE, VDIG_TLMM, VDIG_PMIC };
+enum {
+	REGS_SMIA,              /* Samsung: 0x0340 frame length, 0x0202 coarse, 0x0204 gain (16-bit), hold 0x0104 */
+	REGS_SONY,              /* Sony: same addresses, 8-bit data each, gain code 1024 - 1024/gain */
+	REGS_OV8856,            /* OmniVision: VTS 0x380e/f, exposure 0x3500..2 (lines << 4), gain 0x3508/9, hold 0x3208 */
+};
+struct sensor_hw {
+	const char *    name;
+	const char *    chip;
+	const char *    tab;            /* /usr/local/camera/<tab> (davinci_camsensor.py) */
+	const char *    tab_alt;        /* another chip on the same footprint (IMX582), picked by chip ID */
+	unsigned        sda, scl, reset;
+	uint32_t        mclk_cmd, mclk_cbcr;
+	unsigned        mclk_pin;
+	uint8_t         vdig_kind;
+	uint16_t        vdig_gpio;      /* TLMM pin, or PM6150L GPIO number */
+	unsigned        csiphy;
+	uint32_t        phy_cbcr, timer_cmd, timer_cbcr;
+	uint8_t         regs;
+	uint8_t         bayer;          /* 0 RGGB, 1 GRBG, 2 GBRG, 3 BGGR (CamX CFA from the module, converted) */
+	uint16_t        gain_unity, gain_max;
+	bool            popup;          /* behind the pop-up: dark until the motor raises it (not done here) */
+};
