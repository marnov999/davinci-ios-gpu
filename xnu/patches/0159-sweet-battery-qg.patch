+		if ((int)abstop - 0x3c9 < 0)
+			return f64_add(x, F64_1);                    /* tiny: 1 + x */
+		if (abstop >= 0x409) {
+			if (x == 0xfff0000000000000ull) return 0;    /* -inf */
+			if (abstop >= 0x7ff) return f64_add(x, F64_1);
+			if (x >> 63)                                 /* __math_uflow(0) */
+				return f64_mul(0x1000000000000000ull, 0x1000000000000000ull);
+			return f64_mul(0x7000000000000000ull, 0x7000000000000000ull);
+		}
+		special = 1;
+	}
+	z = f64_mul(EXP_INVLN2N, x);
+	kd = f64_rinta(z);
+	ki = f64_to_i64_rna(z);
+	r = f64_fma(EXP_NEGLN2HI, kd, x);
+	r = f64_fma(kd, EXP_NEGLN2LO, r);
+	idx = ((uint64_t)ki << 1) & 0xfe;
+	tail = exp_tab[idx];
+	sbits = exp_tab[idx + 1] + ((uint64_t)ki << 45);
+	p1 = f64_fma(EXP_C3, r, EXP_C2);
+	r2 = f64_mul(r, r);
+	t1 = f64_add(tail, r);
+	t1 = f64_fma(r2, p1, t1);
+	p2 = f64_mul(r2, r2);
+	tmp = f64_fma(r, EXP_C5, EXP_C4);
+	tmp = f64_fma(p2, tmp, t1);
+	if (!special) {
+		scale = sbits;
+		return f64_fma(tmp, scale, scale);
+	}
+	/* specialcase */
+	if (!((uint32_t)ki & 0x80000000u)) {
+		f64 y;
+		sbits -= 1009ull << 52;
+		scale = sbits;
+		y = f64_fma(tmp, scale, scale);
+		return f64_mul(y, 0x7f00000000000000ull);
+	} else {
+		f64 y, hi, lo, one = F64_1, t;
+		sbits += 1022ull << 52;
+		scale = sbits;
+		lo = f64_mul(tmp, scale);
+		y = f64_add(lo, scale);
+		if (sf_mi(f64_cmp(y, one))) {
+			t = f64_sub(scale, y);
+			lo = f64_add(lo, t);
+			hi = f64_add(y, one);
+			t = f64_sub(one, hi);
+			t = f64_add(y, t);
+			lo = f64_add(lo, t);
+			y = f64_add(hi, lo);
+			y = f64_add(y, 0xbff0000000000000ull);
+			if (sf_eq(f64_cmp(y, 0))) y = 0;
+		}
+		return f64_mul(y, 0x0010000000000000ull);
+	}
+}
