+
+/*
+ * One DCS short write without parameter (display off/on, sleep in/out), the way panel_dcs_brightness()
+ * sends its long write: refresh paused, the frame in flight finished, the packet through the test
+ * pattern FIFO. refresh_stays_off: the INTF1 autorefresh is left off (kept in g_panel_refresh) -- the
+ * panel sleeps; otherwise the one kept before is put back.
+ */
+static int
+panel_dcs_cmd(uint8_t cmd, bool refresh_stays_off)
+{
+	static vm_offset_t dsi, intf;
+	uint32_t reg, i, done = 0, ar;
+	if (!dsi && !(dsi = ml_io_map(DSI0_PA, 0x400u))) {
+		return -1;
+	}
+	if (!intf && !(intf = ml_io_map(0x0ae6b000u, 0x1000u))) {
+		return -1;
+	}
+	if (!(gpu_rd(dsi, DSI_CTRL_R) & 1u)) {
+		return -2;                              /* the controller is off */
+	}
+	ar = gpu_rd(intf, 0x800u + 0x2B4u);             /* INTF1 INTF_TEAR_AUTOREFRESH_CONFIG */
+	if (ar & (1u << 31)) {
+		if (g_panel_refresh == ~0u) {
+			g_panel_refresh = ar;
+		}
+		gpu_wr(intf, 0x800u + 0x2B4u, 0u);
+		__asm__ volatile("dsb sy" ::: "memory");
+	}
+	for (i = 0; i < 40000u && (gpu_rd(dsi, DSI_STATUS_R) & (1u << 2)); i++) {   /* CMD_MODE_MDP_BUSY */
+		gmub_udelay(1);
+	}
+	gpu_wr(dsi, DSI_TPG_CTRL_R, (1u << 1) | (1u << 2) | (3u << 16));
+	/* header {data 0 = the command, data 1 = 0, type 0x05 DCS short write, flags: last command} */
+	gpu_wr(dsi, DSI_TPG_DMA_INIT_R, (uint32_t)cmd | 0x05u << 16 | 0x80u << 24);
+	reg = gpu_rd(dsi, DSI_CMD_DMA_CTRL_R);
+	reg &= ~((1u << 31) | (1u << 30));
+	reg |= 1u << 28;
+	gpu_wr(dsi, DSI_CMD_DMA_CTRL_R, reg);
+	gpu_wr(dsi, DSI_DMA_CMD_LENGTH_R, 4u);
+	__asm__ volatile("dsb sy" ::: "memory");
+	gpu_wr(dsi, DSI_DMA_SW_TRIGGER_R, 1u);
+	for (i = 0; i < 20000u; i++) {
+		if ((done = gpu_rd(dsi, DSI_INT_CTRL_R)) & 1u) {
+			break;
+		}
+		gmub_udelay(1);
+	}
+	if (done & 1u) {
+		gpu_wr(dsi, DSI_INT_CTRL_R, done);
+	}
+	gpu_wr(dsi, DSI_TPG_CTRL_R, 0u);
+	gpu_wr(dsi, DSI_TPG_FIFO_RESET_R, 1u);
+	gmub_udelay(1);
+	gpu_wr(dsi, DSI_TPG_FIFO_RESET_R, 0u);
+	if (!refresh_stays_off && g_panel_refresh != ~0u) {
+		__asm__ volatile("dsb sy" ::: "memory");
+		gpu_wr(intf, 0x800u + 0x2B4u, g_panel_refresh);
+		g_panel_refresh = ~0u;
+	}
+	return (done & 1u) ? 0 : -3;
+}
