+	gmub_wr(GMUB_GX_SPTPRAC_PWR_CTL, GMUB_SPTPRAC_ENABLE);
+	__asm__ volatile("dsb osh" ::: "memory");
+	polls = 0;
+	(void)gmub_poll(GMUB_SPTPRAC_PWR_CLK_STS, GMUB_SPTPRAC_ON_MASK,
+	    GMUB_SPTPRAC_ON_VAL, &polls);
+	{
+		uint32_t s = gmub_rd(GMUB_SPTPRAC_PWR_CLK_STS);
+		printf("SWEET GMU: [F2] SPTPRAC: status=%#x on=%d polls=%u\n", s,
+		    ((s & GMUB_SPTPRAC_ON_MASK) == GMUB_SPTPRAC_ON_VAL), polls);
+		gmub_flush();
+	}
+	/* ---- Stage E (now in the vendor's place: after rail and SPTPRAC): HFI ---- */
+	hfi_start();
+
+	/* ---- Stage F3: GPU_SET OOB (required before any CP/RBBM access) + the
+	 * authoritative gx_is_on() test (SPTPRAC_PWR_CLK_STATUS bits 6,7 == 0). ---- */
+	gmub_wr(GMUB_HOST2GMU_INTR_SET, GMUB_OOB_GPU_SET_SET);
+	__asm__ volatile("dsb osh" ::: "memory");
+	polls = 0;
+	(void)gmub_poll(GMUB_GMU2HOST_INTR_INFO, GMUB_OOB_GPU_SET_ACK,
+	    GMUB_OOB_GPU_SET_ACK, &polls);
+	{
+		uint32_t info = gmub_rd(GMUB_GMU2HOST_INTR_INFO);
+		uint32_t s = gmub_rd(GMUB_SPTPRAC_PWR_CLK_STS);
+		printf("SWEET GMU: [F3] GPU_SET: intr_info=%#x ack(b24)=%d polls=%u; "
+		    "gx_is_on=%d (sptprac_sts=%#x)\n", info, (info >> 24) & 1u, polls,
+		    ((s & GMUB_GX_HM_OFF_MASK) == 0), s);
+		gmub_flush();
+		if (info & GMUB_OOB_GPU_SET_ACK) {
+			gmub_wr(GMUB_GMU2HOST_INTR_CLR, GMUB_OOB_GPU_SET_ACK);
+		}
+	}
+	/* ---- Stage G: GX is powered. Before concluding the core is "dead" from a
+	 * status=0 read, separate three facts: (G1) is the core CLOCKED - the CP
+	 * always-on counter runs off the CX always-on domain and must advance
+	 * between two reads; (G2) lift the RBBM soft reset (the classic "clock +
+	 * lift reset", which the GMU is nominally supposed to have done); (G3)
+	 * re-test. The write-read is on CP_SQE_INSTR_BASE_LO (CP block) - if the
+	 * counter ticks and RBBM_STATUS reads sane but this write never latches,
+	 * the core is up and only the CP is secure-gated => the zap is the unlock.
+	 * Each sub-stage flushes the USB log so a hang can't swallow the reading
+	 * that came before it. ---- */
+	{
+		vm_offset_t core = ml_io_map(A6XX_GPU_CORE_PA_, A6XX_GPU_CORE_SIZE_);
+		if (!core) {
+			printf("SWEET GMU: [G] GPU core map failed\n");
+			gmub_flush();
+			return 0;
+		}
