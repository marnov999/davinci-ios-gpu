+	gmub_wr(GMUB_GX_SPTPRAC_PWR_CTL, GMUB_SPTPRAC_ENABLE);
+	__asm__ volatile("dsb osh" ::: "memory");
+	polls = 0;
+	(void)gmub_poll(GMUB_SPTPRAC_PWR_CLK_STS, GMUB_SPTPRAC_ON_MASK,
+	    GMUB_SPTPRAC_ON_VAL, &polls);
+	{
+		uint32_t s = gmub_rd(GMUB_SPTPRAC_PWR_CLK_STS);
+		printf("SWEET GMU: [F2] SPTPRAC: status=%#x on=%d polls=%u\n", s,
+		    ((s & GMUB_SPTPRAC_ON_MASK) == GMUB_SPTPRAC_ON_VAL), polls);
+		gmub_flush();
+	}
