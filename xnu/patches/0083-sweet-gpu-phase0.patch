+/* ============================ small helpers ============================ */
+static uint32_t gmub_rd(uint32_t idx)            { return gpu_rd(gpu_gmu, GMU_BOFF(idx)); }
+static void     gmub_wr(uint32_t idx, uint32_t v){ gpu_wr(gpu_gmu, GMU_BOFF(idx), v); }
+
+static void gmub_udelay(unsigned us)
+{
+	delay_for_interval(us, NSEC_PER_USEC);
+}
+
+/* Give the 100ms USB-log streamer (on another core) time to flush the last
+ * printf before the next stage, so a reset can't swallow the stage we died at.
+ * 250ms busy-wait; harmless between the GMU boot's logical phases. */
+static int gmub_fast = -1;   /* boot-arg sweetgpu_fast=1: no log-flush pauses (the window server waits for the bring-up) */
+static void gmub_flush(void)
+{
+	if (gmub_fast < 0) {
+		int v = 0;
+		gmub_fast = PE_parse_boot_argn("sweetgpu_fast", &v, sizeof(v)) && v != 0;
+	}
+	if (gmub_fast) {
+		return;
+	}
+	delay_for_interval(250000u, NSEC_PER_USEC);
+}
