+		/* G1b: v12 proved the core is DEAD (aon=0, no advance) despite the
+		 * BOOT_SLUMBER ack - the GX rail powered but the core clock never spun.
+		 * Find which power/clock domain is actually off. ALL READS, no writes.
+		 * GPUCC shows the GX/CX GDSC rails + the gfx3d clock branch; the GMU
+		 * shows SPTPRAC (SP/TP retention+clock). GDSCR bit31=PWR_ON; a clock
+		 * CBCR bit31=CLK_OFF (1 => the branch is NOT running). gpu_gpucc is the
+		 * GPUCC window mapped back in gpu_probe. ---- */
+		uint32_t gxg     = gpu_rd(gpu_gpucc, 0x100cu); /* GX GDSCR */
+		uint32_t cxg     = gpu_rd(gpu_gpucc, 0x106cu); /* CX GDSCR */
+		uint32_t gfx3d   = gpu_rd(gpu_gpucc, 0x1054u); /* gpu_cc_gx_gfx3d_clk CBCR */
+		uint32_t sptp_st = gmub_rd(0x1F8D0u);          /* GMU SPTPRAC_PWR_CLK_STATUS */
+		uint32_t sptp_ct = gmub_rd(0x1A881u);          /* GMU GX_SPTPRAC_POWER_CONTROL */
+		printf("SWEET GMU: [G1b] GPUCC gx_gdsc=%#x(on=%d) cx_gdsc=%#x(on=%d) "
+		    "gfx3d_cbcr=%#x(clk_off=%d)\n", gxg, (gxg >> 31) & 1u, cxg,
+		    (cxg >> 31) & 1u, gfx3d, (gfx3d >> 31) & 1u);
+		gmub_flush();
+		printf("SWEET GMU: [G1b] GMU sptprac_status=%#x sptprac_ctl=%#x\n",
+		    sptp_st, sptp_ct);
+		gmub_flush();
+	}
+	/* ---- Stage H: probe the SMMU identity/config to learn why the bypass
+	 * write was ignored (GR0 regs at the smmu window, plain byte offsets). ---- */
+	printf("SWEET GMU: [H] SMMU idr0=%#x idr1=%#x idr2=%#x scr0=%#x\n",
+	    gpu_rd(smmu, 0x20u), gpu_rd(smmu, 0x24u), gpu_rd(smmu, 0x28u),
+	    gpu_rd(smmu, 0x0u));
+	gmub_flush();
+	printf("SWEET GMU: [H] SMR[0]=%#x S2CR[0]=%#x S2CR[4]=%#x S2CR[5]=%#x\n",
+	    gpu_rd(smmu, 0x800u), gpu_rd(smmu, 0xC00u),
+	    gpu_rd(smmu, 0xC00u + 4u * 4u), gpu_rd(smmu, 0xC00u + 4u * 5u));
+	gmub_flush();
+
+	/* ---- Stage J (runs FIRST now): GPU rendering SMMU routing diagnostic. v20a
+	 * showed the probe dies in Stage I (a6xx_start) - so run the SMMU routing test
+	 * BEFORE Stage I to get that answer regardless. Our old sCR0/S2CR writes looked
+	 * "ignored" = the Qualcomm quirk (TYPE_FAULT writes dropped, TYPE_BYPASS->FAULT)
+	 * +/- unclocked SMMU; TYPE_TRANS(0) writes SHOULD stick. Test: (1) CB0 space
+	 * (smmu+0x8000) writable (KGSL writes it non-secure); (2) route SID0->CB0 via
+	 * S2CR TYPE_TRANS persists on readback. Nothing runs through SID0 yet; S2CR
+	 * restored after. ---- */
+	{
+		uint32_t scr0 = gpu_rd(smmu, 0x0u);
+		uint32_t smr0 = gpu_rd(smmu, 0x800u);
+		uint32_t s2cr0 = gpu_rd(smmu, 0xC00u);
+		gpu_wr(smmu, 0x8000u + 0x20u, 0xA5A50000u);  /* CB0 TTBR0_LO as scratch */
+		__asm__ volatile("dsb osh" ::: "memory");
+		uint32_t cb0 = gpu_rd(smmu, 0x8000u + 0x20u);
+		gpu_wr(smmu, 0x8000u + 0x20u, 0u);
+		printf("SWEET GMU: [J] SMMU scr0=%#x smr0=%#x s2cr0=%#x(0x200ff=fault) "
+		    "cb0_write=%#x(want 0xa5a50000)\n", scr0, smr0, s2cr0, cb0);
+		gmub_flush();
+		gpu_wr(smmu, 0x800u, 0x80000000u);           /* SMR0 = VALID | ID(0) */
+		gpu_wr(smmu, 0xC00u, 0x00000000u);           /* S2CR0 = TYPE_TRANS(0)|CBNDX(0) */
+		__asm__ volatile("dsb osh" ::: "memory");
+		uint32_t smr0b = gpu_rd(smmu, 0x800u);
+		uint32_t s2cr0b = gpu_rd(smmu, 0xC00u);
+		printf("SWEET GMU: [J] TYPE_TRANS route: smr0=%#x(want 0x80000000) "
+		    "s2cr0=%#x(want 0x0 => ROUTED; 0x200ff => still ignored)\n", smr0b, s2cr0b);
+		gmub_flush();
+		(void)s2cr0; (void)smr0;
+		/* Routing works -> FINALIZE CB0 as identity/pass-through and LEAVE SID0
+		 * routed (GPU idle, no transactions yet; this is the CB the CP will use).
+		 * CBAR(0) type S1_TRANS_S2_BYPASS(1) + CB0 SCTLR=0 (stage-1 off = physical
+		 * addresses pass through). GR1 CBAR base = smmu + 0x1000 (pgshift 12). */
+		gpu_wr(smmu, 0x1000u + 0x0u, 0x00010000u);   /* GR1 CBAR(0)=S1_TRANS_S2_BYPASS<<16 */
+		gpu_wr(smmu, 0x8000u + 0x0u, 0x0u);          /* CB0 SCTLR=0 (translation off) */
+		__asm__ volatile("dsb osh" ::: "memory");
+		printf("SWEET GMU: [J] CB0 identity: cbar=%#x(want 0x10000) sctlr=%#x; SID0 "
+		    "left routed to CB0 for the CP\n",
+		    gpu_rd(smmu, 0x1000u), gpu_rd(smmu, 0x8000u));
+		gmub_flush();
+	}
+
+	/* ---- Stage I: a6xx_start core init, INSTRUMENTED. v20a died somewhere in
