+f32 f64_to_f32(f64 a);                 /* FCVT s, d (RNE) */
+
+/* FCMP result as AArch64 NZCV, and the condition codes the daemon uses */
+#define SF_N 8
+#define SF_Z 4
+#define SF_C 2
+#define SF_V 1
+unsigned f32_cmp(f32 a, f32 b);        /* FCMP s, s  (or s, #0.0 with b = 0) */
+unsigned f64_cmp(f64 a, f64 b);        /* FCMP d, d */
+static inline int sf_mi(unsigned f) { return (f & SF_N) != 0; }
+static inline int sf_pl(unsigned f) { return (f & SF_N) == 0; }
+static inline int sf_gt(unsigned f) { return !(f & SF_Z) && (!!(f & SF_N) == !!(f & SF_V)); }
+static inline int sf_le(unsigned f) { return (f & SF_Z) || (!!(f & SF_N) != !!(f & SF_V)); }
+static inline int sf_ge(unsigned f) { return !!(f & SF_N) == !!(f & SF_V); }
+static inline int sf_lt(unsigned f) { return !!(f & SF_N) != !!(f & SF_V); }
+static inline int sf_eq(unsigned f) { return (f & SF_Z) != 0; }
+
+/* bionic libm exp() (arm64, Android 11), bit exact */
+f64 sf_exp(f64 x);
+
+/* constants used by the daemon (bit patterns) */
+#define F32_0      0x00000000u
+#define F32_1      0x3f800000u
+#define F32_2      0x40000000u
+#define F32_M10    0xc1200000u
+#define F32_100    0x42c80000u
+#define F32_200    0x43480000u
+#define F32_1000   0x447a0000u
+#define F32_M1000  0xc47a0000u
+#define F32_3600   0x45610000u
+#define F32_10000  0x461c4000u
+#define F32_M10000 0xc61c4000u
+#define F32_20000  0x469c4000u
+#define F32_1E6    0x49742400u
+#define F32_0_35   0x3eb33333u
+#define F32_10     0x41200000u
+#define F64_1      0x3ff0000000000000ull
+#define F64_M0_005 0xbf747ae147ae147bull
+#define F64_0_005  0x3f747ae147ae147bull
+
+#endif
