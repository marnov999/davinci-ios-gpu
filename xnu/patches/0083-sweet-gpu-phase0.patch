+	gmub_wr(GMUB_AO_AHB_FENCE_CTRL, 0);         /* allow CPU<->GMU reg writes */
+	gmub_wr(GMUB_GENERAL_7, 1);                 /* TCM retention + cold/warm marker */
+	gmub_wr(GMUB_SYS_BUS_CONFIG, 0x1);
+	gmub_wr(GMUB_ICACHE_CONFIG, 0x1);
+	gmub_wr(GMUB_DCACHE_CONFIG, 0x1);
+	gmub_wr(GMUB_CM3_FW_INIT_RESULT, 0);        /* clear for fresh value */
