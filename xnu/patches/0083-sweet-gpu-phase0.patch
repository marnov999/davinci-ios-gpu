+	 * fault via the failed per-stream bypass). HFI isn't needed for the OOB
+	 * BOOT_SLUMBER handshake (interrupt-register based), which is what powers
+	 * GX. Skip straight to OOB; HFI comes back once bypass + queue-headers are
+	 * proven. ---- */
+	printf("SWEET GMU: [E] HFI %s\n", g_gmus_cb >= 0 ? "after the rail and SPTPRAC (vendor order)" : "skipped (sweetgpu_hfi=1 enables it)");
+	gmub_flush();
+
+	/* ---- Stage F: gfx_rail_on + OOB BOOT_SLUMBER (LEGACY GMU path). The GMU
+	 * powers the GX GDSC in response to BOOT_SLUMBER, but only after the GX/MX
+	 * voltage-vote indices are set; a bare request makes the CM3 FAULT - that is
+	 * the BIT23 (=CM3_FAULT) we mistook for an "ack" through v13, which is why GX
+	 * never powered (v13: gx_gdsc on=0, sptprac 0xd4 => GX_HM off). davinci's
+	 * gx_arc_votes are unknown, so try the minimal vote (0) + OPTION=0 and report
+	 * the real bits: ack=BIT30, fault=BIT23. ---- */
+	/* GX/MX_VOTE_IDX are cmd-db gfx.lvl/mx.lvl INDICES, not voltages. Index 0=OFF,
+	 * 1=RETENTION on every ARC .lvl array (that is why vote=0 left rpmh_pwr=0xf and
+	 * never acked). Index 2 = MIN_SVS = davinci's default pwrlevel (initial-pwrlevel
+	 * 7 = 180 MHz = MIN_SVS) = the lowest real ON GX corner. cmd-db is read+printed
+	 * after Stage H to confirm the exact index for next time. */
+	gmub_wr(GMUB_BOOT_SLUMBER_OPTION, 0);
+	gmub_wr(GMUB_GX_VOTE_IDX, g_boot_gx);       /* 2/2 unless the tables say (the same, for 180 MHz) */
+	gmub_wr(GMUB_MX_VOTE_IDX, g_boot_mx);
+	__asm__ volatile("dsb osh" ::: "memory");
+	gmub_wr(GMUB_HOST2GMU_INTR_SET, GMUB_OOB_BOOT_SLUMBER_SET);
+	__asm__ volatile("dsb osh" ::: "memory");
+	polls = 0;
+	(void)gmub_poll(GMUB_GMU2HOST_INTR_INFO, GMUB_OOB_BOOT_SLUMBER_ACK,
+	    GMUB_OOB_BOOT_SLUMBER_ACK, &polls);
+	{
+		uint32_t info = gmub_rd(GMUB_GMU2HOST_INTR_INFO);
+		printf("SWEET GMU: [F] BOOT_SLUMBER: intr_info=%#x ack(b30)=%d "
+		    "fault(b23)=%d polls=%u\n", info, (info >> 30) & 1u,
+		    (info >> 23) & 1u, polls);
+		gmub_flush();
+		/* If it faulted, read WHY: a dropped AHB fence looks exactly like a CM3
+		 * fault, so check fence first, then NMI/AO status + RPMh power state. */
+		printf("SWEET GMU: [F] fault-dbg: nmi=%#x ao_intr=%#x fence_sts=%#x "
+		    "fence_ctl=%#x rpmh_pwr=%#x fw_init=%#x\n",
+		    gmub_rd(GMUB_NMI_CONTROL_STATUS), gmub_rd(GMUB_AO_HOST_INTR_STATUS),
+		    gmub_rd(GMUB_AHB_FENCE_STATUS), gmub_rd(GMUB_AO_AHB_FENCE_CTRL),
+		    gmub_rd(GMUB_CX_GMU_RPMH_PWR_STATE), gmub_rd(GMUB_CM3_FW_INIT_RESULT));
+		gmub_flush();
+		if (info & GMUB_OOB_BOOT_SLUMBER_ACK) {
+			gmub_wr(GMUB_GMU2HOST_INTR_CLR, GMUB_OOB_BOOT_SLUMBER_ACK);
+		}
+	}
