+/* As sweet_gpu.c: kernel_map, not io_submap (8 MB, permanent). */
+#ifndef VM_WIMG_IO
+#define VM_WIMG_IO              0x7u
+#endif
+#define cam_map(pa, size)       ml_io_map_unmappable((vm_offset_t)(pa), (vm_size_t)(size), VM_WIMG_IO)
+
+static uint32_t level;
+static bool broken, leaving, fake, use_rails = true, swap_i2c, pmic_reads;
+
+static void say(const char *format, ...) __printflike(1, 2);
+
+static void
+say(const char *format, ...)
+{
+	char line[300];
+	va_list list;
+
+	va_start(list, format);
+	vsnprintf(line, sizeof(line), format, list);
+	va_end(list);
+	if (!leaving && ml_get_interrupts_enabled()) {
+		printf("SWEET CAM: %s", line);
+	}
+}
+
+static inline uint32_t
+rd(vm_offset_t address)
+{
+	uint32_t v = *(volatile uint32_t *)address;
+	__asm__ volatile ("dmb oshld" ::: "memory");
+	return v;
+}
+
+static inline void
+wr(vm_offset_t address, uint32_t value)
+{
+	__asm__ volatile ("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)address = value;
+}
+
+static void
+spin_us(uint32_t us)
+{
+	uint64_t until;
+
+	nanoseconds_to_absolutetime((uint64_t)us * NSEC_PER_USEC, &until);
+	until += mach_absolute_time();
+	while (mach_absolute_time() < until) {
+	}
+}
+
+static void
+wait_ms(uint32_t ms)
+{
+	if (leaving) {
+		spin_us(ms * 1000);
+	} else {
+		delay_for_interval(ms, NSEC_PER_MSEC);
+	}
+}
+
+static void
+give_up(const char *why)
+{
+	if (!broken) {
+		broken = true;
+		say("%s: nothing more is written in this boot\n", why);
+	}
+}
+
+static uint64_t
+cam_pa(vm_offset_t va)
+{
+	ppnum_t pn = pmap_find_phys(kernel_pmap, (addr64_t)va);
+
+	return pn == 0 ? 0 : ((uint64_t)ptoa_64(pn) | (va & PAGE_MASK));
+}
+
+/* ---- pins: TLMM in three tiles (pinctrl-sdmmagpie.c: WEST 0x100000, NORTH 0x500000, SOUTH 0x900000) ---- */
+
+#define TLMM_PHYS               0x03400000UL
+#define TILE_WEST               0x00100000UL
+#define TILE_NORTH              0x00500000UL
+#define TILE_SOUTH              0x00900000UL
+#define CFG_PULL_UP             3u
+#define CFG_OUTPUT              (1u << 9)
+#define CFG_FUNCTION(f)         ((uint32_t)(f) << 2)
+#define CFG_DRIVE_MA(ma)        ((uint32_t)((ma) / 2 - 1) << 6)
+#define FUNC_CAM_MCLK           1               /* gpio13..16 function 1 */
+#define MAX_PIN                 64
+
+static vm_offset_t pin_va[MAX_PIN];
+
+/* The tile of each pin this file may touch; 0: not ours to touch. */
+static vm_offset_t
+pin_tile(unsigned pin)
+{
+	if (pin >= 13 && pin <= 28) {
+		return TILE_SOUTH;              /* MCLK0..3, CCI0/1, resets, CCI2 */
+	}
+	if (pin == 29) {
+		return TILE_NORTH;              /* ultra VDIG enable */
+	}
+	if (pin == 57) {
+		return TILE_WEST;               /* front VDIG enable */
+	}
+	return 0;
+}
+
+static vm_offset_t
+pin(unsigned n)
+{
+	vm_offset_t tile = n < MAX_PIN ? pin_tile(n) : 0;
+
+	if (tile == 0) {
+		give_up("a pin this driver does not own");
+		return 0;
+	}
+	if (pin_va[n] == 0) {
+		pin_va[n] = cam_map(TLMM_PHYS + tile + 0x1000UL * n, 0x1000);
+	}
+	return pin_va[n];
+}
+
+#define GPIO_CFG(n)             (pin(n))
+#define GPIO_IO(n)              (pin(n) + 4)
+
+static void
+show_pin(unsigned n, const char *what)
+{
+	uint32_t cfg = rd(GPIO_CFG(n)), io = rd(GPIO_IO(n));
+
+	say("gpio%u (%s): function %u, pull %u, %u mA, %s, reads %u\n", n, what, (cfg >> 2) & 15, cfg & 3,
+	    (((cfg >> 6) & 7) + 1) * 2, (cfg & CFG_OUTPUT) ? (io & 2 ? "drives high" : "drives low") : "input", io & 1);
+}
