+extern vnode_t rootvnode;       /* also declared near sweet_push_exec_bit; a second extern is harmless */
+static void
+wifi_fw_thread(void *arg, wait_result_t wr)
+{
+	unsigned tries;
+	(void)arg; (void)wr;
+	for (tries = 0; tries < 600u; tries++) {        /* up to ~60 s for the iOS root volume */
+		if (rootvnode != NULLVP) {
+			if (wifi_firmware_read_validate() && wifi_level >= 4) {
+				if (wifi_level >= 8) {
+					wifi_modem_release();   /* sweetwifi=8: segment copy + auth_and_reset -- RELEASE the modem (reset-risk) */
+					if (wifi_level >= 9) {
+						wifi_smp2p_up();        /* sweetwifi=9: M2a -- SMP2P handshake to DSP_READY */
+					}
+					if (wifi_level >= 10) {
+						wifi_glink_attach();    /* sweetwifi=10: M2b -- attach GLINK FIFOs, peek modem VERSION */
+					}
+					if (wifi_level >= 11) {
+						wifi_glink_link();      /* sweetwifi=11: M2c -- send VERSION, pump, open IPCRTR */
+					}
+				} else if (wifi_level == 7) {
+					wifi_ddr_sweep();       /* sweetwifi=7: DDR-location sweep -- find a PA TZ accepts (AC_ERR_NOT_DDR_MEMORY) */
+				} else {
+					wifi_modem_pas_validate();      /* sweetwifi=4: TZ signature check, modem NOT released */
+				}
+			}
+			if (wifi_level == 6) {
+				wifi_pas_crossprobe();          /* sweetwifi=6: embedded ipa_fws (pas-id 15) PAS cross-probe */
+			}
+			break;
+		}
+		delay_for_interval(100, NSEC_PER_MSEC);
+	}
+	if (tries >= 600u) {
+		printf("SWEET WIFI: [4] the iOS root volume did not appear within 60 s -- firmware not read\n");
+	}
+	(void)thread_terminate(current_thread());
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+static bool
+wsmem_peek(uint32_t off, void *to, uint32_t size)
+{
+	uint32_t i;
+	if (!wsmem) {
+		wsmem = (volatile uint8_t *)ml_io_map_wcomb(WSMEM_PHYS, WSMEM_SIZE);
+	}
+	if (!wsmem || (uint64_t)off + size > WSMEM_SIZE) {
+		return false;
+	}
+	for (i = 0; i < size; i++) {
+		((uint8_t *)to)[i] = wsmem[off + i];
+	}
+	return true;
+}
+
+static uint32_t
+wsmem_partition(uint16_t one, uint16_t other, uint32_t *cacheline, uint32_t *size)
+{
+	struct wsmem_table t;
+	struct wsmem_table_entry e;
+	struct wsmem_partition h;
+	uint32_t i;
+	if (!wsmem_peek(WSMEM_SIZE - 0x1000u, &t, sizeof(t)) || memcmp(t.magic, "$TOC", 4) || t.version != 1 || t.count > 64) {
+		return 0;
+	}
+	for (i = 0; i < t.count; i++) {
+		if (!wsmem_peek(WSMEM_SIZE - 0x1000u + (uint32_t)sizeof(t) + i * (uint32_t)sizeof(e), &e, sizeof(e)) || !e.offset ||
+		    !e.size || !((e.host0 == one && e.host1 == other) || (e.host0 == other && e.host1 == one))) {
+			continue;
+		}
+		if ((uint64_t)e.offset + e.size > WSMEM_SIZE - 0x1000u || !wsmem_peek(e.offset, &h, sizeof(h)) ||
+		    memcmp(h.magic, "$PRT", 4) || h.size != e.size) {
+			return 0;
+		}
+		*cacheline = e.cacheline;
+		*size = e.size;
+		return e.offset;
+	}
+	return 0;
+}
+
+/* The items of a partition into item/offset/size triples; how many. */
+static unsigned
+wsmem_items(uint32_t part, uint32_t cacheline, uint32_t (*found)[3], unsigned max)
+{
+	struct wsmem_partition h;
+	struct wsmem_entry e;
+	uint32_t at, back;
+	unsigned n = 0;
+	if (!part || !wsmem_peek(part, &h, sizeof(h)) || h.free_uncached > h.size || h.free_cached > h.size) {
+		return 0;
+	}
+	for (at = sizeof(h); at + sizeof(e) <= h.free_uncached;) {
+		if (!wsmem_peek(part + at, &e, sizeof(e)) || e.canary != WSMEM_CANARY || e.size > h.size) {
+			break;
+		}
+		if (n < max) {
+			found[n][0] = e.item;
+			found[n][1] = part + at + (uint32_t)sizeof(e) + e.padding_header;
+			found[n][2] = e.size - e.padding_data;
+		}
+		n++;
+		at += (uint32_t)sizeof(e) + e.padding_header + e.size;
+	}
+	if (cacheline == 0 || (cacheline & (cacheline - 1))) {
+		return n;
+	}
+	back = ((uint32_t)sizeof(e) + cacheline - 1) & ~(cacheline - 1);
+	for (at = h.size - back; at > h.free_cached && at < h.size;) {
+		if (!wsmem_peek(part + at, &e, sizeof(e)) || e.canary != WSMEM_CANARY || e.size > at) {
+			break;
+		}
+		if (n < max) {
+			found[n][0] = e.item;
+			found[n][1] = part + at - e.size;
+			found[n][2] = e.size - e.padding_data;
+		}
+		n++;
+		if (e.size + back > at) {
+			break;
+		}
+		at -= e.size + back;
+	}
+	return n;
+}
+
+static void
+wifi_survey(void)
+{
+	static uint32_t found[256][3];
+	static const struct { uint16_t one, other; const char *name; } parts[2] = {
+		{ WSMEM_US, WSMEM_MODEM, "us and the modem (0, 1)" }, { WSMEM_GLOBAL, WSMEM_GLOBAL, "the global one" } };
+	struct wsmem_table t;
+	struct wsmem_table_entry e;
+	uint32_t version = 0, i, p;
+	char line[320];
+
+	printf("SWEET WIFI: [1] the shared memory area at %#x, %#x bytes (reads only)\n", WSMEM_PHYS, WSMEM_SIZE);
+	if (!wsmem_peek(0x40u + 4u * 7u, &version, sizeof(version)) || !wsmem_peek(WSMEM_SIZE - 0x1000u, &t, sizeof(t))) {
+		printf("SWEET WIFI: [1] cannot map it\n");
+		return;
+	}
+	printf("SWEET WIFI: [1] boot loader's version word %#x; table %c%c%c%c version %u, %u partitions\n", version,
+	    t.magic[0], t.magic[1], t.magic[2], t.magic[3], t.version, t.count);
+	if (memcmp(t.magic, "$TOC", 4) || t.version != 1 || t.count > 64) {
+		return;
+	}
+	for (i = 0; i < t.count; i++) {
+		if (wsmem_peek(WSMEM_SIZE - 0x1000u + (uint32_t)sizeof(t) + i * (uint32_t)sizeof(e), &e, sizeof(e))) {
+			printf("SWEET WIFI: [1] partition %u: hosts %#x %#x at %#x, %#x bytes, flags %#x, cacheline %u\n", i, e.host0,
+			    e.host1, WSMEM_PHYS + e.offset, e.size, e.flags, e.cacheline);
+		}
+	}
+	for (p = 0; p < 2u; p++) {
+		uint32_t cl = 0, size = 0, part = wsmem_partition(parts[p].one, parts[p].other, &cl, &size);
+		unsigned n = wsmem_items(part, cl, found, 256), k = 0;
+		printf("SWEET WIFI: [1] partition of %s: %s, %u items\n", parts[p].name, part ? "there" : "NOT THERE", n);
+		while (k < n && k < 256u) {
+			int at = 0;
+			for (unsigned c = 0; c < 14u && k < n && k < 256u; c++, k++) {
+				at += snprintf(line + at, sizeof(line) - (size_t)at, " %u(%u)", found[k][0], found[k][2]);
+			}
+			printf("SWEET WIFI: [1]   items(bytes):%s\n", line);
+		}
+		for (k = 0; k < n && k < 256u; k++) {
+			if (found[k][0] == 428u) {         /* the modem's SMP2P: "$SMP", version, local/remote, counts, flags, entries */
+				uint32_t w[5] = { 0 };
+				char names[96];
+				int at = 0;
+				(void)wsmem_peek(found[k][1], w, sizeof(w));
+				for (unsigned x = 0; x < (w[3] >> 16) && x < 4u && at < (int)sizeof(names) - 24; x++) {
+					char nm[17] = { 0 };
+					uint32_t v = 0;
+					(void)wsmem_peek(found[k][1] + 20u + 20u * x, nm, 16);
+					(void)wsmem_peek(found[k][1] + 36u + 20u * x, &v, 4);
+					at += snprintf(names + at, sizeof(names) - (size_t)at, " %s=%#x", nm, v);
+				}
+				printf("SWEET WIFI: [1] THE MODEM'S SMP2P (428) is there: magic %#x version %#x hosts %#x counts %#x "
+				    "flags %#x:%s\n", w[0], w[1], w[2], w[3], w[4], at ? names : "");
+			} else if (found[k][0] == 421u && found[k][2]) {   /* its last words */
+				char text[81] = { 0 };
+				(void)wsmem_peek(found[k][1], text, found[k][2] < 80u ? found[k][2] : 80u);
+				printf("SWEET WIFI: [1] the modem's last words (421): \"%s\"\n", text);
+			}
+		}
+	}
+
+	wifi_mailbox_survey();
+}
+
+/* Did the modem actually run after auth_and_reset? A modem that boots writes its SMP2P item (428) and,
+ * if it crashes, its last words (421) into the (0,1) SMEM partition -- which the step-1 survey saw EMPTY
+ * (0 items) before release. Re-read it so we know "released and ran briefly" vs "released and dead". */
+static void
+wifi_modem_liveness(void)
+{
+	uint32_t cl = 0, size = 0, part, found[64][3];
+	unsigned n, k;
+	delay_for_interval(200, NSEC_PER_MSEC);
+	part = wsmem_partition(WSMEM_US, WSMEM_MODEM, &cl, &size);
+	n = wsmem_items(part, cl, found, 64);
+	printf("SWEET WIFI: [8] post-release SMEM re-survey: (0,1) modem/APSS partition %s, %u items (was 0 before release)\n",
+	    part ? "there" : "NOT THERE", n);
+	/* dump every item the modem created -- these ARE davinci's GLINK/SMP2P SMEM structures (for M2) */
+	for (k = 0; k < n; k++) {
+		uint32_t w[8] = { 0 };
+		uint32_t got = found[k][2] < 32u ? found[k][2] : 32u;
+		(void)wsmem_peek(found[k][1], w, got);
+		printf("SWEET WIFI: [8]   item %u: id=%u off=%#x size=%u  first=%08x %08x %08x %08x %08x %08x %08x %08x\n",
+		    k, found[k][0], found[k][1], found[k][2], w[0], w[1], w[2], w[3], w[4], w[5], w[6], w[7]);
+		if (found[k][0] == 421u) {
+			char text[84];
+			uint32_t len = found[k][2] < 80u ? found[k][2] : 80u;
+			(void)wsmem_peek(found[k][1], text, len);
+			text[len] = 0;
+			printf("SWEET WIFI: [8]     (item 421 modem last words: \"%s\")\n", text);
+		}
+	}
+	if (n == 0u) {
+		printf("SWEET WIFI: [8] modem wrote nothing to SMEM -- did not reach SMP2P (needs GLINK/QRTR + rmtfs, M2/M3)\n");
+	}
+}
+
+/* ---- M2a: SMP2P bring-up (sweetwifi=9) ------------------------------------------------------------
+ * Port of HackiOS hakios.mpss.c our_item_make/step_our_item/dsp_listen for davinci. The modem, out of
+ * reset, creates item 435 (its SMP2P, magic $SMP) + the GLINK descriptor/ring. We allocate OUR item 428
+ * under the SMEM hardware mutex, fill the smp2p struct (entry "master-kernel"), ring the modem (APCS
+ * 0x17c0000c bit 14), then poll 435 and run the Linux handshake until its "slave-kernel" entry reads
+ * DSP_READY (0x2). davinci TCSR mutex (dt: hwlock syscon@1f40000, SMEM hwlock index 3) = 0x1f43000. */
+#define WSMEM_LOCK_PHYS       0x01f43000u
+#define WSMEM_LOCK_US         1u
+#define WSMP2P_MAGIC          0x504d5324u
+#define WSMP2P_VERSION        1u
+#define WSMP2P_RESTART_ACKS   1u
+#define WSMP2P_RESTART_DONE   (1u << 0)
+#define WSMP2P_RESTART_ACK    (1u << 1)
+#define WSMP2P_AT_VERSION     4u
+#define WSMP2P_AT_PROCESSORS  8u
+#define WSMP2P_AT_COUNTS      12u
+#define WSMP2P_AT_FLAGS       16u
+#define WSMP2P_AT_NAME(i)     (20u + 20u * (i))
+#define WSMP2P_AT_VALUE(i)    (36u + 20u * (i))
+#define WDSP_FATAL            (1u << 0)
+#define WDSP_READY            (1u << 1)
+#define WITEM_SMP2P_OURS      428u
+#define WITEM_SMP2P_THEIRS    435u
+struct wsmp2p { uint32_t magic, version; uint16_t local, remote, total, valid; uint32_t flags;
+	struct { char name[16]; uint32_t value; } entry[16]; };
+static vm_offset_t wsmem_lock_base;
+static uint32_t    wour_item;
+
+static void
+wsmem_poke(uint32_t off, uint32_t val)
+{
+	if (!wsmem) { wsmem = (volatile uint8_t *)ml_io_map_wcomb(WSMEM_PHYS, WSMEM_SIZE); }
+	if (wsmem && (uint64_t)off + 4u <= WSMEM_SIZE) {
+		*(volatile uint32_t *)(wsmem + off) = val;
+		__asm__ volatile("dsb sy" ::: "memory");
+	}
+}
+
+static uint32_t
+wsmem_item_off(uint32_t item, uint32_t *size)
+{
+	uint32_t cl = 0, psz = 0, part, found[64][3];
+	unsigned n, i;
+	part = wsmem_partition(WSMEM_US, WSMEM_MODEM, &cl, &psz);
+	n = wsmem_items(part, cl, found, 64);
+	for (i = 0; i < n; i++) {
+		if (found[i][0] == item) { *size = found[i][2]; return found[i][1]; }
+	}
+	return 0;
+}
+
+static void
+wifi_ring_modem(uint32_t bit)
+{
+	if (!wapcs_base) { (void)wifi_map_blocks(); }
+	if (wapcs_base) { wmmio_wr32(wapcs_base, WAPCS_IPC_PHYS & 0xfffu, 1u << bit); }
+}
+
+/* Allocate a private SMEM item in the (US,MPSS) partition under the hardware mutex (Linux qcom_smem_alloc_private). */
+static bool
+wour_item_make(uint32_t partition, uint32_t item, uint32_t bytes)
+{
+	struct wsmem_partition header;
+	struct wsmem_entry entry;
+	uint32_t item_size = (bytes + 7u) & ~7u, need_bytes = (uint32_t)sizeof(entry) + item_size;
+	uint32_t owner = ~0u, at, ms, z;
+	bool made = false;
+	if (!wsmem_lock_base) { wsmem_lock_base = ml_io_map(WSMEM_LOCK_PHYS, 0x1000u); }
+	if (!wsmem_lock_base) { printf("SWEET WIFI: [9] cannot map the SMEM mutex\n"); return false; }
+	for (ms = 0; ms <= 1000u; ms++) {
+		*(volatile uint32_t *)wsmem_lock_base = WSMEM_LOCK_US;
+		__asm__ volatile("dsb sy" ::: "memory");
+		owner = *(volatile uint32_t *)wsmem_lock_base;
+		if (owner == WSMEM_LOCK_US) { break; }
+		delay_for_interval(1, NSEC_PER_MSEC);
+	}
+	if (owner != WSMEM_LOCK_US) { printf("SWEET WIFI: [9] SMEM mutex held by %u for 1s -- not writing\n", owner); return false; }
+	if (!wsmem_peek(partition, &header, sizeof(header)) || header.free_uncached > header.free_cached ||
+	    header.free_cached > header.size) {
+		printf("SWEET WIFI: [9] partition marks make no sense -- not writing\n"); goto out;
+	}
+	for (at = (uint32_t)sizeof(header); at < header.free_uncached;) {
+		if (!wsmem_peek(partition + at, &entry, sizeof(entry)) || entry.canary != WSMEM_CANARY || entry.item == item ||
+		    entry.size > header.size) { break; }
+		at += (uint32_t)sizeof(entry) + entry.padding_header + entry.size;
+	}
+	if (at != header.free_uncached) {
+		printf("SWEET WIFI: [9] entries don't end at the mark (at %#x, mark %#x) -- not writing\n", at, header.free_uncached); goto out;
+	}
+	if (at + need_bytes > header.free_cached) {
+		printf("SWEET WIFI: [9] no room (%u wanted, %u free) -- not writing\n", need_bytes, header.free_cached - at); goto out;
+	}
+	wsmem_poke(partition + at, (uint32_t)WSMEM_CANARY | item << 16);
+	wsmem_poke(partition + at + 4u, item_size);
+	wsmem_poke(partition + at + 8u, item_size - bytes);
+	for (z = 0; z < item_size; z += 4u) { wsmem_poke(partition + at + (uint32_t)sizeof(entry) + z, 0); }
+	wsmem_poke(partition + at + 12u, 0);
+	__asm__ volatile("dsb sy" ::: "memory");
+	wsmem_poke(partition + (uint32_t)__builtin_offsetof(struct wsmem_partition, free_uncached), at + need_bytes);
+	__asm__ volatile("dsb sy" ::: "memory");
+	made = true;
+out:
+	*(volatile uint32_t *)wsmem_lock_base = 0;
+	__asm__ volatile("dsb sy" ::: "memory");
+	return made;
+}
+
+static uint32_t
+wsmp2p_state(const struct wsmp2p *w)
+{
+	unsigned i;
+	for (i = 0; i < w->valid && i < 16u; i++) {
+		if (strncmp(w->entry[i].name, "slave-kernel", 16) == 0) { return w->entry[i].value; }
+	}
+	return 0;
+}
+
+static void
+wifi_smp2p_up(void)
+{
+	uint32_t cl = 0, psz = 0, part, osz = 0, name[4] = { 0 }, a, w;
+	struct wsmp2p ours, theirs;
+	bool agreed = false, acked = false;
+	int t;
+
+	printf("SWEET WIFI: [9] M2a SMP2P: allocate item 428, fill it, ring modem (bit 14), handshake item 435 -> DSP_READY\n");
+	part = wsmem_partition(WSMEM_US, WSMEM_MODEM, &cl, &psz);
+	if (part == 0u) { printf("SWEET WIFI: [9] no (0,1) partition\n"); return; }
+	wour_item = wsmem_item_off(WITEM_SMP2P_OURS, &osz);
+	if (wour_item != 0u) {
+		printf("SWEET WIFI: [9] item 428 already present at off %#x (reused)\n", wour_item);
+	} else {
+		if (!wour_item_make(part, WITEM_SMP2P_OURS, (uint32_t)sizeof(struct wsmp2p))) { return; }
+		wour_item = wsmem_item_off(WITEM_SMP2P_OURS, &osz);
+		if (wour_item == 0u) { printf("SWEET WIFI: [9] item 428 not found after make\n"); return; }
+		printf("SWEET WIFI: [9] item 428 MADE at off %#x (%u bytes)\n", wour_item, osz);
+	}
+	for (a = 0; a < sizeof(struct wsmp2p); a += 4u) { wsmem_poke(wour_item + a, 0); }
+	__asm__ volatile("dsb sy" ::: "memory");
+	wsmem_poke(wour_item, WSMP2P_MAGIC);
+	wsmem_poke(wour_item + WSMP2P_AT_PROCESSORS, (uint32_t)WSMEM_US | (uint32_t)WSMEM_MODEM << 16);
+	strlcpy((char *)name, "master-kernel", sizeof(name));
+	for (w = 0; w < 4u; w++) { wsmem_poke(wour_item + WSMP2P_AT_NAME(0) + 4u * w, name[w]); }
+	wsmem_poke(wour_item + WSMP2P_AT_COUNTS, 16u | 1u << 16);
+	wsmem_poke(wour_item + WSMP2P_AT_VERSION, WSMP2P_RESTART_ACKS << 8);
+	__asm__ volatile("dsb sy" ::: "memory");
+	wsmem_poke(wour_item + WSMP2P_AT_VERSION, WSMP2P_RESTART_ACKS << 8 | WSMP2P_VERSION);
+	__asm__ volatile("dsb sy" ::: "memory");
+	wifi_ring_modem(14);
+	if (!wsmem_peek(wour_item, &ours, sizeof(ours)) || ours.magic != WSMP2P_MAGIC) {
+		printf("SWEET WIFI: [9] our item 428 does not read back as written\n"); return;
+	}
+	printf("SWEET WIFI: [9] item 428 written (version %#x procs %#x valid %u) + rang bit 14; polling modem 435...\n",
+	    ours.version, ((uint32_t)WSMEM_US | (uint32_t)WSMEM_MODEM << 16), ours.valid);
+
+	for (t = 0; t < 50; t++) {
+		uint32_t toff = wsmem_item_off(WITEM_SMP2P_THEIRS, &psz), st;
+		if (toff != 0u && wsmem_peek(toff, &theirs, sizeof(theirs)) && theirs.magic == WSMP2P_MAGIC) {
+			st = wsmp2p_state(&theirs);
+			if (!agreed && (theirs.version & 0xffu) == (ours.version & 0xffu)) {
+				uint32_t feat = (ours.version >> 8) & (theirs.version >> 8);
+				if (feat != (ours.version >> 8)) { wsmem_poke(wour_item + WSMP2P_AT_VERSION, feat << 8 | (ours.version & 0xffu)); }
+				agreed = true;
+				printf("SWEET WIFI: [9] SMP2P agreed: version %u, features %#x\n", ours.version & 0xffu, feat);
+			}
+			if (agreed && (((theirs.flags & WSMP2P_RESTART_DONE) != 0u) != acked)) {
+				acked = !acked;
+				(void)wsmem_peek(wour_item, &ours, sizeof(ours));
+				wsmem_poke(wour_item + WSMP2P_AT_FLAGS, (ours.flags & ~WSMP2P_RESTART_ACK) | (acked ? WSMP2P_RESTART_ACK : 0u));
+				__asm__ volatile("dsb sy" ::: "memory");
+				wifi_ring_modem(14);
+			}
+			if (st & WDSP_READY) { printf("SWEET WIFI: [9]   >>>>> DSP_READY -- the modem SMP2P says UP (state %#x, valid %u) <<<<<\n", st, theirs.valid); break; }
+			if (st & WDSP_FATAL) { printf("SWEET WIFI: [9]   modem SMP2P says FATAL (state %#x)\n", st); break; }
+			if ((t % 10) == 0) { printf("SWEET WIFI: [9]   +%dms: modem 435 valid=%u slave-kernel=%#x flags=%#x\n", t * 100, theirs.valid, st, theirs.flags); }
+		} else if ((t % 10) == 0) {
+			printf("SWEET WIFI: [9]   +%dms: modem item 435 not readable yet\n", t * 100);
+		}
+		delay_for_interval(100, NSEC_PER_MSEC);
+	}
+	printf("SWEET WIFI: [9] M2a SMP2P step done\n");
+}
+
+/* ---- M2b: GLINK FIFO attach (sweetwifi=10) --------------------------------------------------------
+ * Port of hakios.mpss.c glink_find/glink_reset/glink_waiting/glink_peek. The modem created the GLINK
+ * descriptor (478, 4 FIFO indices) + its TX ring (480, modem->us). We allocate OUR TX ring (479,
+ * us->modem, 16 KiB) the same way as item 428, attach, reset our indices, then peek the modem's RX
+ * ring for its first GLINK message -- expected GLINK_VERSION (cmd 0). Read-only on the modem's ring;
+ * no send yet (that is M2c). Descriptor: OUR_TAIL@0 OUR_HEAD@4 THEIR_TAIL@8 THEIR_HEAD@12. */
+#define WITEM_GLINK_DESC      478u
+#define WITEM_GLINK_OURS      479u
+#define WITEM_GLINK_THEIRS    480u
+#define WGLINK_OUR_TAIL       0u
+#define WGLINK_OUR_HEAD       4u
+#define WGLINK_THEIR_TAIL     8u
+#define WGLINK_THEIR_HEAD     12u
+static uint32_t wglink_desc, wglink_ours, wglink_ours_size, wglink_theirs, wglink_theirs_size;
+
+static uint32_t
+wsmem_word(uint32_t off)
+{
+	uint32_t v = 0;
+	(void)wsmem_peek(off, &v, 4);
+	return v;
+}
+
+static bool
+wglink_find(void)
+{
+	uint32_t sz = 0;
+	wglink_desc = wsmem_item_off(WITEM_GLINK_DESC, &sz);
+	if (wglink_desc == 0u || sz != 32u) { return false; }
+	wglink_ours = wsmem_item_off(WITEM_GLINK_OURS, &wglink_ours_size);
+	wglink_theirs = wsmem_item_off(WITEM_GLINK_THEIRS, &wglink_theirs_size);
+	return wglink_ours != 0u && wglink_theirs != 0u && wglink_ours_size >= 1024u && wglink_theirs_size >= 1024u &&
+	       !(wglink_ours_size & 7u) && !(wglink_theirs_size & 7u);
+}
+
+static uint32_t
+wglink_waiting(void)
+{
+	uint32_t head = wsmem_word(wglink_desc + WGLINK_THEIR_HEAD), tail = wsmem_word(wglink_desc + WGLINK_THEIR_TAIL);
+	if (head >= wglink_theirs_size || tail >= wglink_theirs_size) { return 0; }
+	return head >= tail ? head - tail : wglink_theirs_size - tail + head;
+}
+
+static void
+wglink_peek(void *to, uint32_t offset, uint32_t count)
+{
+	uint32_t at = (wsmem_word(wglink_desc + WGLINK_THEIR_TAIL) + offset) % wglink_theirs_size, i;
+	for (i = 0; i < count; i++) {
+		((uint8_t *)to)[i] = wsmem[wglink_theirs + (at + i) % wglink_theirs_size];
+	}
+}
+
+static const char *
+wglink_cmd_name(uint32_t c)
+{
+	static const char *const n[] = { "version", "version-ack", "open", "close", "open-ack", "intent", "done",
+		"intent-request", "intent-request-ack", "data", "10", "close-ack", "data-more", "read-notify", "done-reuse", "signals" };
+	return c < sizeof(n) / sizeof(n[0]) ? n[c] : "?";
+}
+
+static void
+wifi_glink_attach(void)
+{
+	uint32_t cl = 0, psz = 0, part, sz = 0;
+	struct { uint16_t cmd, param1; uint32_t param2; } msg;
+	int t;
+
+	printf("SWEET WIFI: [10] M2b GLINK: allocate our TX ring (479), attach 478/479/480, peek the modem's VERSION\n");
+	part = wsmem_partition(WSMEM_US, WSMEM_MODEM, &cl, &psz);
+	if (part == 0u) { printf("SWEET WIFI: [10] no (0,1) partition\n"); return; }
+	if (wsmem_item_off(WITEM_GLINK_OURS, &sz) == 0u) {
+		if (!wour_item_make(part, WITEM_GLINK_OURS, 0x4000u)) { printf("SWEET WIFI: [10] could not make item 479\n"); return; }
+		printf("SWEET WIFI: [10] item 479 (our 16 KiB TX ring) MADE\n");
+	} else {
+		printf("SWEET WIFI: [10] item 479 already present (%u bytes)\n", sz);
+	}
+	if (!wglink_find()) {
+		printf("SWEET WIFI: [10] glink_find FAILED (desc@%#x ours@%#x/%u theirs@%#x/%u)\n",
+		    wglink_desc, wglink_ours, wglink_ours_size, wglink_theirs, wglink_theirs_size);
+		return;
+	}
+	printf("SWEET WIFI: [10] GLINK attached: desc@%#x ours@%#x(%uB) theirs@%#x(%uB); OUR_T=%#x OUR_H=%#x THEIR_T=%#x THEIR_H=%#x\n",
+	    wglink_desc, wglink_ours, wglink_ours_size, wglink_theirs, wglink_theirs_size,
+	    wsmem_word(wglink_desc + 0u), wsmem_word(wglink_desc + 4u), wsmem_word(wglink_desc + 8u), wsmem_word(wglink_desc + 12u));
+	if (wsmem_word(wglink_desc + WGLINK_OUR_HEAD) != 0u || wsmem_word(wglink_desc + WGLINK_THEIR_TAIL) != 0u) {
+		wsmem_poke(wglink_desc + WGLINK_OUR_HEAD, 0);
+		wsmem_poke(wglink_desc + WGLINK_THEIR_TAIL, 0);
+		__asm__ volatile("dsb sy" ::: "memory");
+		printf("SWEET WIFI: [10] reset our marks (OUR_HEAD, THEIR_TAIL) to 0 for a fresh link\n");
+	}
+	for (t = 0; t < 50; t++) {
+		uint32_t avail = wglink_waiting();
+		if (avail >= 8u) {
+			wglink_peek(&msg, 0, 8);
+			printf("SWEET WIFI: [10]   modem GLINK msg: cmd=%u (%s) param1=%#x param2=%#x (avail %u) %s\n",
+			    msg.cmd, wglink_cmd_name(msg.cmd), msg.param1, msg.param2, avail,
+			    msg.cmd == 0u ? "<<<<< GLINK_VERSION from the modem!" : "");
+			break;
+		}
+		if ((t % 10) == 0) {
+			printf("SWEET WIFI: [10]   +%dms: modem ring avail=%u (THEIR_HEAD=%#x THEIR_TAIL=%#x)\n",
+			    t * 100, avail, wsmem_word(wglink_desc + WGLINK_THEIR_HEAD), wsmem_word(wglink_desc + WGLINK_THEIR_TAIL));
+		}
+		delay_for_interval(100, NSEC_PER_MSEC);
+	}
+	printf("SWEET WIFI: [10] M2b GLINK attach done\n");
+}
+
+/* ---- M2c: GLINK link -- version + open the IPCRTR channel (sweetwifi=11) --------------------------
+ * Port of hakios.mpss.c glink_room/put/say/offer/advance/pump + step_link. GLINK is host-initiated: we
+ * send our VERSION (ring APCS bit 12), then pump the modem's RX ring and answer VERSION/OPEN/OPEN_ACK/
+ * INTENT. The channel opens when the modem has opened its side (theirs!=0) AND acked ours; then we push
+ * our receive intents. A completed inbound datagram is handed to wifi_qrtr_input (a stub for M2c; M2d
+ * parses QRTR). GLINK cmds enum per the spec. Intent buffers come from a static pool (no kalloc_data). */
+enum { WGL_VERSION = 0, WGL_VERSION_ACK = 1, WGL_OPEN = 2, WGL_CLOSE = 3, WGL_OPEN_ACK = 4, WGL_INTENT = 5,
+	WGL_DONE = 6, WGL_INTENT_REQUEST = 7, WGL_INTENT_REQUEST_ACK = 8, WGL_DATA = 9, WGL_CLOSE_ACK = 11,
+	WGL_DATA_MORE = 12, WGL_READ_NOTIFY = 13, WGL_DONE_REUSE = 14, WGL_SIGNALS = 15 };
+#define WGL_VERSION_1    1u
+#define WGL_INTENT_REUSE 1u
+#define WGL_RESERVE      16u
+
+struct wglink_channel {
+	const char *name;
+	uint32_t ours, theirs;
+	bool asked, acknowledged, open;
+	struct { uint32_t size, count; } intents[3];
+	struct { uint32_t id, size; bool there, in_use; } their_intents[64];
+	struct { uint32_t size, fill; uint8_t *data; } our_intents[24];
+	uint32_t our_intent_count;
+};
+static struct {
+	bool up, broken, agreed;
+	uint32_t features, said, heard;
+	struct wglink_channel ch;
+} wgl = { .ch = { .name = "IPCRTR", .ours = 1u, .intents = { { 0x800u, 5u }, { 0x2000u, 3u }, { 0x4400u, 2u } } } };
+static uint8_t  wglink_pool[0x12000];
+static uint32_t wglink_pool_used;
+
+static void wifi_qrtr_input(const uint8_t *data, uint32_t len);   /* M2d; a stub for now */
+
+static uint32_t
+wglink_room(void)
+{
+	uint32_t head = wsmem_word(wglink_desc + WGLINK_OUR_HEAD), tail = wsmem_word(wglink_desc + WGLINK_OUR_TAIL), room;
+	if (head >= wglink_ours_size || tail >= wglink_ours_size) { return 0; }
+	room = tail <= head ? wglink_ours_size - head + tail : tail - head;
+	return room < WGL_RESERVE ? 0 : room - WGL_RESERVE;
+}
+
+static void
+wglink_advance(uint32_t count)
+{
+	wsmem_poke(wglink_desc + WGLINK_THEIR_TAIL, (wsmem_word(wglink_desc + WGLINK_THEIR_TAIL) + count) % wglink_theirs_size);
+}
+
+static bool
+wglink_put(const void *a, uint32_t alen, const void *b, uint32_t blen)
+{
+	volatile uint8_t *q = wsmem + wglink_ours;
+	uint32_t head = wsmem_word(wglink_desc + WGLINK_OUR_HEAD), length = alen + blen, padded = (length + 7u) & ~7u, i;
+	if (!wgl.up || wglink_room() < padded) { return false; }
+	for (i = 0; i < padded; i++) {
+		q[(head + i) % wglink_ours_size] = i < alen ? ((const uint8_t *)a)[i] : i < length ? ((const uint8_t *)b)[i - alen] : 0;
+	}
+	__asm__ volatile("dsb sy" ::: "memory");
+	wsmem_poke(wglink_desc + WGLINK_OUR_HEAD, (head + padded) % wglink_ours_size);
+	__asm__ volatile("dsb sy" ::: "memory");
+	wifi_ring_modem(12);
+	wgl.said++;
+	return true;
+}
+
+static void
+wglink_say(uint32_t cmd, uint32_t p1, uint32_t p2, const void *more, uint32_t more_len)
+{
+	struct { uint16_t cmd, p1; uint32_t p2; } m = { (uint16_t)cmd, (uint16_t)p1, p2 };
+	(void)wglink_put(&m, (uint32_t)sizeof(m), more, more_len);
+}
+
+static bool
+wglink_offer(uint32_t size)
+{
+	uint32_t words[2], i = wgl.ch.our_intent_count;
+	if (i >= 24u || size == 0u || size > 0x10000u || wglink_pool_used + size > sizeof(wglink_pool)) { return false; }
+	wgl.ch.our_intents[i].data = wglink_pool + wglink_pool_used;
+	wglink_pool_used += size;
+	wgl.ch.our_intents[i].size = size;
+	wgl.ch.our_intents[i].fill = 0;
+	wgl.ch.our_intent_count++;
+	words[0] = size; words[1] = i + 1u;
+	wglink_say(WGL_INTENT, wgl.ch.ours, 1u, words, (uint32_t)sizeof(words));
+	return true;
+}
+
+/* Everything the modem put in its ring, taken out and acted on (Linux qcom_glink_native_rx). */
+static void
+wglink_pump(void)
+{
+	struct { uint16_t command, param1; uint32_t param2; } message;
+	struct wglink_channel *channel = &wgl.ch;
+	uint32_t words[4];
+	char name[33];
+
+	while (wgl.up && !wgl.broken) {
+		uint32_t waiting = wglink_waiting(), length = (uint32_t)sizeof(message);
+		if (waiting < sizeof(message)) { return; }
+		wglink_peek(&message, 0, (uint32_t)sizeof(message));
+		if (message.command == WGL_OPEN) {
+			length += message.param2;
+		} else if (message.command == WGL_INTENT) {
+			length += 8u * message.param2;
+		} else if (message.command == WGL_DATA || message.command == WGL_DATA_MORE) {
+			if (waiting < 16u) { return; }
+			wglink_peek(words, 8, 8);
+			length = 16u + words[0];
+		}
+		length = (length + 7u) & ~7u;
+		if (length > wglink_theirs_size - 8u) {
+			printf("SWEET WIFI: [11] glink: message of %u bytes (cmd %u) not believed -- broken\n", length, message.command);
+			wgl.broken = true; return;
+		}
+		if (waiting < length) { return; }
+		wgl.heard++;
+		switch (message.command) {
+		case WGL_VERSION:
+			if (message.param1 == WGL_VERSION_1) { wgl.features &= message.param2; }
+			wglink_advance(length);
+			wglink_say(WGL_VERSION_ACK, WGL_VERSION_1, wgl.features, NULL, 0);
+			break;
+		case WGL_VERSION_ACK:
+			wglink_advance(length);
+			if (message.param1 == WGL_VERSION_1 && message.param2 == wgl.features) {
+				wgl.agreed = true;
+			} else if (message.param1 != 0) {
+				wgl.features &= message.param2;
+				wglink_say(WGL_VERSION, WGL_VERSION_1, wgl.features, NULL, 0);
+			}
+			break;
+		case WGL_OPEN:
+			bzero(name, sizeof(name));
+			wglink_peek(name, (uint32_t)sizeof(message), message.param2 < sizeof(name) - 1 ? message.param2 : (uint32_t)sizeof(name) - 1);
+			wglink_advance(length);
+			if (strcmp(name, channel->name) != 0) {
+				printf("SWEET WIFI: [11] glink: modem opens \"%s\" (its ch %u): unanswered, we don't speak it\n", name, message.param1);
+				break;
+			}
+			printf("SWEET WIFI: [11] glink: modem opens \"%s\" (its ch %u): acked, opening ours (ch %u)\n", name, message.param1, channel->ours);
+			channel->theirs = message.param1;
+			wglink_say(WGL_OPEN_ACK, channel->theirs, 0, NULL, 0);
+			if (!channel->asked) {
+				uint32_t sz = (uint32_t)strlen(channel->name) + 1u;
+				bzero(name, sizeof(name));
+				strlcpy(name, channel->name, sizeof(name));
+				wglink_say(WGL_OPEN, channel->ours, sz, name, (sz + 7u) & ~7u);
+				channel->asked = true;
+			}
+			break;
+		case WGL_OPEN_ACK:
+			wglink_advance(length);
+			if (message.param1 == channel->ours) { channel->acknowledged = true; }
+			break;
+		case WGL_INTENT:
+			for (uint32_t i = 0; (message.param1 == channel->theirs || message.param1 == channel->ours) && i < message.param2; i++) {
+				wglink_peek(words, 8u + 8u * i, 8);
+				for (unsigned n = 0; n < 64u; n++) {
+					if (!channel->their_intents[n].there || channel->their_intents[n].id == words[1]) {
+						channel->their_intents[n].there = true;
+						channel->their_intents[n].in_use = false;
+						channel->their_intents[n].size = words[0];
+						channel->their_intents[n].id = words[1];
+						break;
+					}
+				}
+			}
+			wglink_advance(length);
+			break;
+		case WGL_DONE:
+		case WGL_DONE_REUSE:
+			for (unsigned n = 0; (message.param1 == channel->theirs || message.param1 == channel->ours) && n < 64u; n++) {
+				if (channel->their_intents[n].there && channel->their_intents[n].id == message.param2) {
+					channel->their_intents[n].in_use = false;
+					channel->their_intents[n].there = message.command == WGL_DONE_REUSE;
+				}
+			}
+			wglink_advance(length);
+			break;
+		case WGL_INTENT_REQUEST:
+			wglink_advance(length);
+			{
+				bool granted = wglink_offer(message.param2);
+				wglink_say(WGL_INTENT_REQUEST_ACK, channel->ours, granted, NULL, 0);
+			}
+			break;
+		case WGL_INTENT_REQUEST_ACK:
+			wglink_advance(length);
+			break;
+		case WGL_DATA:
+		case WGL_DATA_MORE: {
+			uint32_t intent = message.param2 - 1u;
+			if (intent >= channel->our_intent_count ||
+			    words[0] > channel->our_intents[intent].size - channel->our_intents[intent].fill) {
+				printf("SWEET WIFI: [11] glink: data %u bytes on ch %u intent %u NOT OURS/too much -- dropped\n",
+				    words[0], message.param1, message.param2);
+				wglink_advance(length);
+				break;
+			}
+			wglink_peek(channel->our_intents[intent].data + channel->our_intents[intent].fill, 16, words[0]);
+			channel->our_intents[intent].fill += words[0];
+			wglink_advance(length);
+			if (words[1] == 0u) {
+				wifi_qrtr_input(channel->our_intents[intent].data, channel->our_intents[intent].fill);
+				channel->our_intents[intent].fill = 0;
+				wglink_say(WGL_DONE_REUSE, channel->ours, message.param2, NULL, 0);
+			}
+			break;
+		}
+		case WGL_READ_NOTIFY:
+			wglink_advance(length);
+			wifi_ring_modem(12);
+			break;
+		case WGL_CLOSE:
+			wglink_advance(length);
+			wglink_say(WGL_CLOSE_ACK, message.param1, 0, NULL, 0);
+			if (message.param1 == channel->theirs) { channel->open = false; channel->theirs = 0; }
+			break;
+		case WGL_CLOSE_ACK:
+		case WGL_SIGNALS:
+			wglink_advance(length);
+			break;
+		default:
+			printf("SWEET WIFI: [11] glink: unknown message (%u %u %#x) -- broken\n", message.command, message.param1, message.param2);
+			wgl.broken = true;
+			return;
+		}
+		if (channel->theirs != 0u && channel->acknowledged && !channel->open) {
+			channel->open = true;
+			printf("SWEET WIFI: [11]   >>>>> THE CHANNEL \"IPCRTR\" IS OPEN both ways (ours %u, modem %u) -- telling the modem our intents <<<<<\n",
+			    channel->ours, channel->theirs);
+			for (unsigned i = 0; i < 3u; i++) {
+				for (unsigned n = 0; n < channel->intents[i].count; n++) { (void)wglink_offer(channel->intents[i].size); }
+			}
+		}
+	}
+}
+
+/* ---- M2d: QRTR -- hello both ways + the modem's service list (sweetwifi=12) -----------------------
+ * Port of hakios.mpss.c glink_send + the QRTR control handling. QRTR datagrams ride the IPCRTR channel
+ * as GLINK DATA. We only ever SEND in reply to something the modem sent (from inside the pump), so the
+ * send is a single shot into a modem intent (no inner pump -> no reentrancy). On the modem's HELLO we
+ * reply HELLO; each NEW_SERVER is logged as the service list (WLFW/wlan ~svc 0x27/39 = Wi-Fi). */
+#define QRTR_US_NODE      1u
+#define QRTR_CONTROL      0xfffffffeu
+enum { QRTR_DATA = 1, QRTR_HELLO = 2, QRTR_BYE = 3, QRTR_NEW_SERVER = 4, QRTR_DEL_SERVER = 5, QRTR_RESUME_TX = 7, QRTR_NEW_LOOKUP = 10 };
+struct wqrtr_header { uint32_t version, type, from_node, from_port, confirm, size, to_node, to_port; };
+struct wqrtr_control { uint32_t command, words[4]; };
+static uint32_t wqrtr_peer, wqrtr_hellos, wqrtr_in;
+static struct { uint32_t service, instance, node, port; bool there; } wqrtr_servers[64];
+
+/* One GLINK DATA message into the smallest fitting modem intent; single-shot (safe to call from the pump). */
+static int
+wglink_send(const void *data, uint32_t length)
+{
+	struct { uint16_t cmd, p1; uint32_t p2, size, left; } header = { (uint16_t)WGL_DATA, (uint16_t)wgl.ch.ours, 0, length, 0 };
+	int found = -1;
+	unsigned n;
+	if (!wgl.up || !wgl.ch.open || wgl.broken) { return -1; }
+	for (n = 0; n < 64u; n++) {
+		if (!wgl.ch.their_intents[n].there || wgl.ch.their_intents[n].in_use || wgl.ch.their_intents[n].size < length) { continue; }
+		if (found < 0 || wgl.ch.their_intents[n].size < wgl.ch.their_intents[found].size) { found = (int)n; }
+	}
+	if (found < 0) { return -2; }
+	if (wglink_room() < ((length + (uint32_t)sizeof(header) + 7u) & ~7u)) { return -3; }
+	wgl.ch.their_intents[found].in_use = true;
+	header.p2 = wgl.ch.their_intents[found].id;
+	(void)wglink_put(&header, (uint32_t)sizeof(header), data, length);
+	return 0;
+}
+
+static int
+wqrtr_out_packet(uint32_t type, uint32_t from_port, uint32_t to_node, uint32_t to_port, const void *data, uint32_t length)
+{
+	static uint8_t buf[sizeof(struct wqrtr_header) + 64];
+	struct wqrtr_header *h = (struct wqrtr_header *)buf;
+	uint32_t padded = (length + 3u) & ~3u;
+	if (length == 0u || sizeof(struct wqrtr_header) + padded > sizeof(buf)) { return -1; }
+	h->version = 1; h->type = type; h->from_node = QRTR_US_NODE; h->from_port = from_port; h->confirm = 0;
+	h->size = length; h->to_node = to_node; h->to_port = to_port;
+	memcpy(buf + sizeof(*h), data, length);
+	return wglink_send(buf, (uint32_t)sizeof(*h) + padded);
+}
+
+
+/* ---- M3: QRTR server side -- local ports + announced servers (port of hakios qrtr_open/announce) --- */
+typedef void (*wqrtr_recv_t)(void *ctx, uint32_t node, uint32_t from_port, const void *data, uint32_t len);
+struct wqrtr_port { uint32_t number; wqrtr_recv_t receive; void *context; };
+static struct wqrtr_port wqrtr_ports[16];
+static struct { uint32_t service, instance, port; } wour_servers[4];
+static uint32_t wqrtr_next_port = 0x4000u;
+
+/* M4 trigger (defined with the PDR client below wrmtfs_start, used from the listen loop above it). */
+#define WPDR_SERVICE 66u
+static bool wpdr_registered, wpdr_wlan_up;
+static void wpdr_register_wlan(uint32_t node, uint32_t port);
+
+static struct wqrtr_port *
+wqrtr_open(wqrtr_recv_t receive, void *context)
+{
+	unsigned p;
+	for (p = 0; p < 16u; p++) {
+		if (wqrtr_ports[p].number == 0u) {
+			wqrtr_ports[p].number = wqrtr_next_port++;
+			wqrtr_ports[p].receive = receive;
+			wqrtr_ports[p].context = context;
+			return &wqrtr_ports[p];
+		}
+	}
+	return NULL;
+}
+
+static int
+wqrtr_send(uint32_t from_port, uint32_t node, uint32_t to, const void *data, uint32_t length)
+{
+	return wqrtr_out_packet(QRTR_DATA, from_port, node, to, data, length);
+}
+
+static void
+wqrtr_announce(uint32_t node, unsigned server, bool end)
+{
+	struct wqrtr_control p = { QRTR_NEW_SERVER, { 0, 0, 0, 0 } };
+	if (!end) {
+		p.words[0] = wour_servers[server].service;
+		p.words[1] = wour_servers[server].instance;
+		p.words[2] = QRTR_US_NODE;
+		p.words[3] = wour_servers[server].port;
+	}
+	(void)wqrtr_out_packet(QRTR_NEW_SERVER, QRTR_CONTROL, node, QRTR_CONTROL, &p, (uint32_t)sizeof(p));
+}
+
+static void
+wqrtr_announce_all(uint32_t node)
+{
+	unsigned i;
+	for (i = 0; i < 4u; i++) {
+		if (wour_servers[i].port != 0u) { wqrtr_announce(node, i, false); }
+	}
+}
+
+static void
+wifi_qrtr_input(const uint8_t *data, uint32_t length)
+{
+	struct wqrtr_header h;
+	struct wqrtr_control c;
+	uint32_t at;
+
+	if (length >= sizeof(h) && data[0] == 1) {
+		memcpy(&h, data, sizeof(h));
+		at = (uint32_t)sizeof(h);
+	} else if (length >= 16u && data[0] == 3) {
+		bzero(&h, sizeof(h));
+		h.type = data[1];
+		h.confirm = data[2] & 1u;
+		memcpy(&h.size, data + 4, 4);
+		h.from_node = (uint32_t)(data[8] | data[9] << 8);
+		h.from_port = (uint32_t)(data[10] | data[11] << 8);
+		h.to_node = (uint32_t)(data[12] | data[13] << 8);
+		h.to_port = (uint32_t)(data[14] | data[15] << 8);
+		h.from_port = h.from_port == 0xfffeu ? QRTR_CONTROL : h.from_port;
+		h.to_port = h.to_port == 0xfffeu ? QRTR_CONTROL : h.to_port;
+		at = 16u + data[3];
+	} else {
+		printf("SWEET WIFI: [11] qrtr: %u bytes, not a datagram (begins %#x)\n", length, length ? data[0] : 0);
+		return;
+	}
+	if (h.size == 0u || at + h.size > length) {
+		printf("SWEET WIFI: [11] qrtr: datagram size %u in a %u-byte message -- dropped\n", h.size, length);
+		return;
+	}
+	wqrtr_in++;
+	if (wqrtr_peer == 0u) { wqrtr_peer = h.from_node; }
+	if (h.type == QRTR_RESUME_TX) { return; }
+	if (h.confirm) {
+		struct wqrtr_control resume = { QRTR_RESUME_TX, { h.to_node, h.to_port, 0, 0 } };
+		(void)wqrtr_out_packet(QRTR_RESUME_TX, h.to_port, h.from_node, h.from_port, &resume, (uint32_t)sizeof(resume));
+	}
+	if (!(h.to_port == QRTR_CONTROL || h.type == QRTR_HELLO || h.type == QRTR_NEW_SERVER || h.type == QRTR_DEL_SERVER ||
+	    h.type == QRTR_BYE || h.type == QRTR_NEW_LOOKUP)) {
+		unsigned p;
+		for (p = 0; p < 16u; p++) {   /* data to one of our ports (rmtfs/servreg/tftp) -> its callback */
+			if (wqrtr_ports[p].number == h.to_port && h.type == QRTR_DATA && wqrtr_ports[p].receive != NULL) {
+				wqrtr_ports[p].receive(wqrtr_ports[p].context, h.from_node, h.from_port, data + at, h.size);
+				return;
+			}
+		}
+		return;
+	}
+	bzero(&c, sizeof(c));
+	memcpy(&c, data + at, h.size < sizeof(c) ? h.size : sizeof(c));
+	switch (c.command) {
+	case QRTR_HELLO: {
+		struct wqrtr_control hello = { QRTR_HELLO, { 0, 0, 0, 0 } };
+		if (wqrtr_hellos++ == 0u) {
+			int e = wqrtr_out_packet(QRTR_HELLO, QRTR_CONTROL, h.from_node, QRTR_CONTROL, &hello, (uint32_t)sizeof(hello));
+			printf("SWEET WIFI: [11] qrtr: HELLO from node %u; our reply %s\n", h.from_node, e == 0 ? "SENT" : "NOT sent");
+			wqrtr_announce_all(h.from_node);      /* M3: tell the modem our servers (rmtfs etc.) */
+		}
+		break;
+	}
+	case QRTR_NEW_SERVER: {
+		unsigned i, slot = 64u;
+		for (i = 0; i < 64u; i++) {
+			if (wqrtr_servers[i].there && wqrtr_servers[i].node == c.words[2] && wqrtr_servers[i].port == c.words[3]) { slot = i; break; }
+			if (!wqrtr_servers[i].there && slot == 64u) { slot = i; }
+		}
+		if (slot < 64u) {
+			wqrtr_servers[slot].there = true; wqrtr_servers[slot].service = c.words[0];
+			wqrtr_servers[slot].instance = c.words[1]; wqrtr_servers[slot].node = c.words[2]; wqrtr_servers[slot].port = c.words[3];
+		}
+		printf("SWEET WIFI: [11] qrtr: >>> SERVICE %u (%#x) version %u instance %u at node %u port %u%s\n",
+		    c.words[0], c.words[0], c.words[1] & 0xffu, c.words[1] >> 8, c.words[2], c.words[3],
+		    c.words[0] == 0x27u || c.words[0] == 39u ? "   <<< WLFW = Wi-Fi!" : "");
+		break;
+	}
+	case QRTR_NEW_LOOKUP: {
+		unsigned i, matches = 0;
+		for (i = 0; i < 4u; i++) {
+			if (wour_servers[i].port != 0u && (c.words[0] == 0u || wour_servers[i].service == c.words[0])) {
+				wqrtr_announce(h.from_node, i, false); matches++;
+			}
+		}
+		wqrtr_announce(h.from_node, 0, true);   /* the empty NEW_SERVER that ends the answer */
+		printf("SWEET WIFI: [11] qrtr: modem looks for service %u (%#x) inst %u: %u of ours\n", c.words[0], c.words[0], c.words[1], matches);
+		break;
+	}
+	case QRTR_DEL_SERVER:
+	case QRTR_BYE:
+		printf("SWEET WIFI: [11] qrtr: a service is gone (cmd %u, node %u port %u)\n", c.command, c.words[2], c.words[3]);
+		break;
+	default:
+		break;
+	}
+}
+
+static void
+wifi_glink_link(void)
+{
+	int t;
+	printf("SWEET WIFI: [11] M2c GLINK link: send VERSION (ring bit 12), pump, open IPCRTR\n");
+	if (!wglink_find()) { printf("SWEET WIFI: [11] GLINK not attached (run after M2b)\n"); return; }
+	wsmem_poke(wglink_desc + WGLINK_OUR_HEAD, 0);
+	wsmem_poke(wglink_desc + WGLINK_THEIR_TAIL, 0);
+	__asm__ volatile("dsb sy" ::: "memory");
+	wgl.up = true; wgl.broken = false; wgl.agreed = false; wgl.features = WGL_INTENT_REUSE;
+	wgl.said = wgl.heard = 0; wglink_pool_used = 0;
+	wgl.ch.theirs = 0; wgl.ch.asked = wgl.ch.acknowledged = wgl.ch.open = false; wgl.ch.our_intent_count = 0;
+	bzero(wgl.ch.their_intents, sizeof(wgl.ch.their_intents));
+	if (wifi_level >= 13) { wrmtfs_start(); }   /* M3a: register the rmtfs server before HELLO/announce */
+	wglink_say(WGL_VERSION, WGL_VERSION_1, wgl.features, NULL, 0);
+	for (t = 0; t < 500 && !wgl.broken && !wgl.ch.open; t++) {
+		wglink_pump();
+		if ((t % 50) == 0) {
+			printf("SWEET WIFI: [11]   +%dms: agreed=%d theirs=%u ack=%d open=%d said=%u heard=%u\n",
+			    t * 10, wgl.agreed, wgl.ch.theirs, wgl.ch.acknowledged, wgl.ch.open, wgl.said, wgl.heard);
+		}
+		delay_for_interval(10, NSEC_PER_MSEC);
+	}
+	wglink_pump();
+	if (wgl.ch.open) {
+		printf("SWEET WIFI: [11] M2c DONE: IPCRTR OPEN (ours %u, modem %u, said %u, heard %u) -- QRTR next (M2d)\n",
+		    wgl.ch.ours, wgl.ch.theirs, wgl.said, wgl.heard);
+	} else {
+		printf("SWEET WIFI: [11] M2c: IPCRTR NOT open (agreed=%d theirs=%u ack=%d broken=%d said=%u heard=%u)\n",
+		    wgl.agreed, wgl.ch.theirs, wgl.ch.acknowledged, wgl.broken, wgl.said, wgl.heard);
+	}
+	if (wgl.ch.open && wifi_level >= 12) {
+		/* level 14 keeps the link pumping long enough for the modem to load wlan_pd from wlanmdsp.mbn over
+		 * TFTP (3.8 MB, read in ELF pieces) and register WLFW (service 39) -- that is M3 complete. */
+		int listen_iters = wifi_level >= 14 ? 18000 : (wifi_level >= 13 ? 3000 : 800);
+		int wlfw_at = -1;
+		printf("SWEET WIFI: [11] M2d/M3: listening %d ms for QRTR services + rmtfs/wlan activity...\n", listen_iters * 10);
+		for (t = 0; t < listen_iters && !wgl.broken; t++) {
+			wglink_pump();
+			delay_for_interval(10, NSEC_PER_MSEC);
+			if (wifi_level >= 15 && !wpdr_registered && t >= 300) {
+				/* once the modem's notifier (svc 66) is up, register for wlan_pd ONCE so the modem spawns it. */
+				unsigned i;
+				for (i = 0; i < 64u; i++) {
+					if (wqrtr_servers[i].there && wqrtr_servers[i].service == WPDR_SERVICE) {
+						wpdr_register_wlan(wqrtr_servers[i].node, wqrtr_servers[i].port);
+						break;
+					}
+				}
+			}
+			if (wifi_level >= 14) {
+				if (wlfw_at < 0) {
+					unsigned i;
+					for (i = 0; i < 64u; i++) {
+						if (wqrtr_servers[i].there && (wqrtr_servers[i].service == 0x27u || wqrtr_servers[i].service == 39u)) {
+							wlfw_at = t;
+							printf("SWEET WIFI: [14] >>>>> WLFW (service 39, Wi-Fi firmware) IS UP after %d ms -- wlan_pd started! node %u port %u <<<<<\n",
+							    t * 10, wqrtr_servers[i].node, wqrtr_servers[i].port);
+							break;
+						}
+					}
+				}
+				if ((t % 1000) == 999) {
+					printf("SWEET WIFI: [14]   +%ds: datagrams in=%u, wlfw=%s\n", (t + 1) / 100, wqrtr_in, wlfw_at >= 0 ? "UP" : "waiting");
+				}
+			}
+		}
+		printf("SWEET WIFI: [11] M2d DONE: qrtr hellos=%u, datagrams in=%u, modem node=%u (said=%u heard=%u); WLFW %s\n",
+		    wqrtr_hellos, wqrtr_in, wqrtr_peer, wgl.said, wgl.heard, wlfw_at >= 0 ? "UP" : "not seen");
+	}
+}
+
+/* ---- M3a: rmtfs (QMI service 14) -- serve the modem's EFS so it progresses past SSCTL/servreg ------
+ * Port of hakios.mpss.c rmtfs. A <4GB no-map buffer is TZ-assigned to the modem (SCM 0x42000C16), the
+ * modem opens /boot/modem_fs{1,2,g,c}, asks for the buffer PA, then reads/writes sectors via iovec; we
+ * serve from the partition images (pushed to /usr/local/gltest/). Writes are kept in RAM for the run. */
+#define WRMTFS_SECTOR        512u
+#define WRMTFS_BUFFER_SIZE   0x200000u          /* davinci dt qcom,rmtfs_sharedmem@0 = 2 MiB */
+#define WRMTFS_BUFFER_PA_DEF 0x95700000ull      /* pil_adsp_region (no-map, ADSP not started here); modem_buffer= overrides */
+#define WQMI_REQUEST         0u
+#define WQMI_RESPONSE        2u
+#define WQMI_RESULT_FAILURE  1u
+#define WQMI_ERR_INTERNAL    1u
+#define WQMI_ERR_MALFORMED   2u
+#define WVMID_HLOS           3u
+#define WVMID_MSS_MSA        15u
+#define WVMID_NAV            0x2bu
+#define WVM_PERM_RW          6u
+
+static struct { const char *path, *partition, *file; uint8_t *data; uint64_t size; bool open; } wrmtfs_files[4] = {
+	{ "/boot/modem_fs1", "modemst1", "/usr/local/gltest/modemst1.img", NULL, 0, false },
+	{ "/boot/modem_fs2", "modemst2", "/usr/local/gltest/modemst2.img", NULL, 0, false },
+	{ "/boot/modem_fsc", "fsc",      "/usr/local/gltest/fsc.img",      NULL, 0, false },
+	{ "/boot/modem_fsg", "fsg",      "/usr/local/gltest/fsg.img",      NULL, 0, false },
+};
+static vm_offset_t      wrmtfs_buffer;
+static volatile uint8_t *wrmtfs_window;
+static uint64_t         wrmtfs_buffer_pa;
+static bool             wrmtfs_shared;
+static struct wqrtr_port *wrmtfs_port;
+static uint32_t wrmtfs_requests, wrmtfs_reads, wrmtfs_writes, wrmtfs_refused;
+
+/* SMC with four register args (x2..x5); our gpu_scm_pas only drives x2..x4. SCM_INTERRUPTED=1. */
+static int32_t
+wifi_scm4(uint64_t fn, uint64_t args, uint64_t a2, uint64_t a3, uint64_t a4, uint64_t a5, uint64_t *answer)
+{
+	uint64_t session = 0;
+	int i;
+	fn |= (1ull << 30) | (2ull << 24);   /* SCM_64 | SCM_SIP */
+	for (i = 0; i < 100; i++) {
+		register uint64_t x0 __asm__("x0") = i == 0 ? fn : 1ull;
+		register uint64_t x1 __asm__("x1") = args;
+		register uint64_t x2 __asm__("x2") = a2;
+		register uint64_t x3 __asm__("x3") = a3;
+		register uint64_t x4 __asm__("x4") = a4;
+		register uint64_t x5 __asm__("x5") = a5;
+		register uint64_t x6 __asm__("x6") = session;
+		register uint64_t x7 __asm__("x7") = 0;
+		__asm__ volatile("smc #0" : "+r"(x0), "+r"(x1), "+r"(x2), "+r"(x3), "+r"(x4), "+r"(x5), "+r"(x6), "+r"(x7)
+		    : : "x8", "x9", "x10", "x11", "x12", "x13", "x14", "x15", "x16", "x17", "memory");
+		session = x6;
+		if (x0 != 1ull) { *answer = x1; return (int32_t)x0; }
+	}
+	return -1;
+}
+
+static const uint8_t *
+wqmi_tlv(const uint8_t *m, uint32_t length, uint8_t type, uint16_t *size)
+{
+	uint32_t at;
+	for (at = 7; at + 3u <= length;) {
+		uint16_t n = (uint16_t)(m[at + 1] | m[at + 2] << 8);
+		if (at + 3u + n > length) { return NULL; }
+		if (m[at] == type) { *size = n; return m + at + 3u; }
+		at += 3u + n;
+	}
+	return NULL;
+}
+
+static uint32_t
+wle32(const uint8_t *p)
+{
+	return (uint32_t)(p[0] | p[1] << 8 | p[2] << 16 | p[3] << 24);
+}
+
+/* Candidate rmtfs buffers: no-map carveouts for subsystems NOT started under iOS (so still HLOS-owned and
+ * assignable). hakios assigns the CDSP region on redwood; we sweep because wifi20's EINVAL(-2) can mean
+ * either a non-HLOS region OR the NAV(0x2b) destination vmid being unsupported on davinci. First wins. */
+static const struct { uint64_t pa; const char *name; } wrmtfs_candidates[] = {
+	{ 0x93900000ull, "cdsp_region" },       /* compute DSP not started here -- hakios's choice on redwood */
+	{ 0x9f800000ull, "cdsp_sec_region" },
+	{ 0x95700000ull, "pil_adsp_region" },   /* what wifi20 tried (with NAV) -> EINVAL */
+	{ 0x93400000ull, "pil_video_region" },
+};
+
+/* Map a 2 MiB window at pa as the rmtfs buffer and zero it (HLOS keeps RW after the assign, so this is
+ * fine before or after sharing). */
+static bool
+wrmtfs_map(uint64_t pa)
+{
+	uint32_t i;
+	wrmtfs_window = (volatile uint8_t *)ml_io_map_wcomb(pa, WRMTFS_BUFFER_SIZE);
+	if (wrmtfs_window == NULL) { return false; }
+	wrmtfs_buffer = (vm_offset_t)wrmtfs_window;
+	wrmtfs_buffer_pa = pa;
+	for (i = 0; i < WRMTFS_BUFFER_SIZE; i += 8u) { *(volatile uint64_t *)(wrmtfs_window + i) = 0; }
+	__asm__ volatile("dsb sy" ::: "memory");
+	return true;
+}
+
+/* One TZ mem-assign (Linux qcom_scm_assign_mem) of [buf_pa, 2 MiB): HLOS -> {HLOS,MSS[,NAV]} rw. Returns
+ * the SCM result (0 = ok) and fills *answer. Builds a fresh descriptor; keeps no state on failure. */
+static int32_t
+wrmtfs_assign(uint64_t buf_pa, bool with_nav, uint64_t *answer)
+{
+	vm_offset_t cva = 0;
+	uint64_t pa = 0;
+	uint8_t *page;
+	unsigned destinations, i;
+	*answer = ~0ull;
+	if (gmub_alloc_phys(&cva, &pa, PAGE_SIZE) != 0) { return -1; }
+	page = (uint8_t *)cva;
+	for (i = 0; i < PAGE_SIZE; i += 8u) { *(volatile uint64_t *)(page + i) = 0; }
+	*(volatile uint64_t *)(page + 0) = buf_pa;                      /* the memory */
+	*(volatile uint64_t *)(page + 8) = WRMTFS_BUFFER_SIZE;
+	*(volatile uint32_t *)(page + 64) = WVMID_HLOS;                 /* sources: HLOS alone */
+	*(volatile uint32_t *)(page + 128 + 0)  = WVMID_HLOS;    *(volatile uint32_t *)(page + 128 + 4)  = WVM_PERM_RW;
+	*(volatile uint32_t *)(page + 128 + 24) = WVMID_MSS_MSA; *(volatile uint32_t *)(page + 128 + 28) = WVM_PERM_RW;
+	destinations = 2;
+	if (with_nav) {
+		*(volatile uint32_t *)(page + 128 + 48) = WVMID_NAV; *(volatile uint32_t *)(page + 128 + 52) = WVM_PERM_RW;
+		destinations = 3;
+	}
+	*(volatile uint64_t *)(page + 240 + 0)  = 1u * 4u;                        /* arg3: sources size */
+	*(volatile uint64_t *)(page + 240 + 8)  = pa + 128u;                      /* arg4: destinations */
+	*(volatile uint64_t *)(page + 240 + 16) = (uint64_t)destinations * 24u;   /* arg5: their size */
+	*(volatile uint64_t *)(page + 240 + 24) = 0;
+	gpu_dcache_clean(cva, PAGE_SIZE);
+	__asm__ volatile("dsb sy" ::: "memory");
+	return wifi_scm4(0xc16ull, 0x1117ull, pa, 16, pa + 64u, pa + 240u, answer);
+}
+
+/* Find a carveout TZ will assign to the modem, map it, keep it. Sets wrmtfs_shared on success. NAV-off is
+ * tried first (NAV is the likelier cause of EINVAL). modem_buffer=PA pins one region. */
+static bool
+wrmtfs_setup(void)
+{
+	uint64_t bp = 0, answer;
+	int32_t result;
+	unsigned c, pass, n = sizeof(wrmtfs_candidates) / sizeof(wrmtfs_candidates[0]);
+	bool pinned = PE_parse_boot_argn("modem_buffer", &bp, sizeof(bp)) && bp != 0;
+	for (c = 0; c < (pinned ? 1u : n); c++) {
+		uint64_t pa = pinned ? bp : wrmtfs_candidates[c].pa;
+		const char *nm = pinned ? "modem_buffer" : wrmtfs_candidates[c].name;
+		for (pass = 0; pass < 2u; pass++) {
+			bool nav = pass == 1;
+			result = wrmtfs_assign(pa, nav, &answer);
+			printf("SWEET WIFI: [13] rmtfs: assign %s %#llx %s -> ret=%d answer=%#llx\n",
+			    nm, (unsigned long long)pa, nav ? "+NAV" : "no-NAV", result, (unsigned long long)answer);
+			if (result == 0 && answer == 0 && wrmtfs_map(pa)) {
+				wrmtfs_shared = true;
+				printf("SWEET WIFI: [13] rmtfs: >>> THE MODEM MAY USE THE BUFFER at %s %#llx (%s) <<<\n",
+				    nm, (unsigned long long)pa, nav ? "with NAV" : "no NAV");
+				return true;
+			}
+		}
+	}
+	printf("SWEET WIFI: [13] rmtfs: no region accepted by TZ -- buffer NOT shared\n");
+	return false;
+}
+
+static void
+wrmtfs_load(void)
+{
+	unsigned f;
+	for (f = 0; f < 4u; f++) {
+		uint64_t size = 0, got = 0;
+		vm_offset_t buf = 0;
+		if (wrmtfs_files[f].data != NULL) { continue; }
+		if (wifi_file_size(wrmtfs_files[f].file, &size) != 0 || size == 0 || size > (64u << 20)) {
+			printf("SWEET WIFI: [13] rmtfs: %s NOT on device (push it to %s)\n", wrmtfs_files[f].partition, wrmtfs_files[f].file);
+			continue;
+		}
+		if (kmem_alloc(kernel_map, &buf, (vm_size_t)size, KMA_DATA | KMA_ZERO, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+			printf("SWEET WIFI: [13] rmtfs: no memory for %s (%llu bytes)\n", wrmtfs_files[f].partition, size);
+			continue;
+		}
+		if (wifi_read_file(wrmtfs_files[f].file, (uint8_t *)buf, (uint32_t)size, &got) != 0 || got != size) {
+			printf("SWEET WIFI: [13] rmtfs: read %s failed (%llu/%llu)\n", wrmtfs_files[f].file, got, size);
+			kmem_free(kernel_map, buf, (vm_size_t)size);
+			continue;
+		}
+		wrmtfs_files[f].data = (uint8_t *)buf;
+		wrmtfs_files[f].size = size;
+		printf("SWEET WIFI: [13] rmtfs: loaded %s (%s): %llu bytes\n", wrmtfs_files[f].partition, wrmtfs_files[f].file, size);
+	}
+}
+
+static void
+wrmtfs_receive(void *context, uint32_t node, uint32_t port, const void *data, uint32_t length)
+{
+	const uint8_t *m = data, *value;
+	uint8_t answer[64], *tlv;
+	uint16_t message, size = 0, result = 0, error = 0, extra = 0;
+	unsigned file = 4;
+	(void)context;
+	if (length < 7u || m[0] != WQMI_REQUEST) { return; }
+	message = (uint16_t)(m[3] | m[4] << 8);
+	wrmtfs_requests++;
+	bzero(answer, sizeof(answer));
+	answer[0] = WQMI_RESPONSE;
+	answer[1] = m[1]; answer[2] = m[2]; answer[3] = m[3]; answer[4] = m[4];
+	tlv = answer + 14;
+	switch (message) {
+	case 1:   /* OPEN */
+		value = wqmi_tlv(m, length, 1, &size);
+		for (unsigned fi = 0; value != NULL && fi < 4u; fi++) {
+			if (size == strlen(wrmtfs_files[fi].path) && memcmp(value, wrmtfs_files[fi].path, size) == 0) { file = fi; }
+		}
+		if (file == 4u || wrmtfs_files[file].data == NULL) {
+			printf("SWEET WIFI: [13] rmtfs: modem opens \"%.*s\": NOT HERE\n", value ? (int)(size < 48u ? size : 48u) : 0, value ? (const char *)value : "");
+			result = WQMI_RESULT_FAILURE; error = WQMI_ERR_INTERNAL; wrmtfs_refused++; break;
+		}
+		wrmtfs_files[file].open = true;
+		printf("SWEET WIFI: [13] rmtfs: modem opens %s (%llu bytes): caller %u\n", wrmtfs_files[file].path, wrmtfs_files[file].size, file + 1);
+		tlv[0] = 0x10; tlv[1] = 4; tlv[2] = 0; tlv[3] = (uint8_t)(file + 1); extra = 7;
+		break;
+	case 2:   /* CLOSE */
+		value = wqmi_tlv(m, length, 1, &size);
+		file = value != NULL && size == 4u && wle32(value) >= 1u && wle32(value) <= 4u ? wle32(value) - 1u : 4u;
+		if (file < 4u) { wrmtfs_files[file].open = false; }
+		break;
+	case 4:   /* ALLOC_BUFF */
+		value = wqmi_tlv(m, length, 2, &size);
+		if (value == NULL || size != 4u || wle32(value) > WRMTFS_BUFFER_SIZE || wrmtfs_buffer == 0 || !wrmtfs_shared) {
+			printf("SWEET WIFI: [13] rmtfs: modem asks buffer %u: NOT GIVEN (%s)\n", value && size == 4u ? wle32(value) : 0, wrmtfs_shared ? "shared" : "NOT shared");
+			result = WQMI_RESULT_FAILURE; error = WQMI_ERR_INTERNAL; wrmtfs_refused++; break;
+		}
+		printf("SWEET WIFI: [13] rmtfs: modem asks buffer %u: given ours at %#llx\n", wle32(value), wrmtfs_buffer_pa);
+		tlv[0] = 0x10; tlv[1] = 8; tlv[2] = 0;
+		for (unsigned b = 0; b < 8u; b++) { tlv[3 + b] = (uint8_t)(wrmtfs_buffer_pa >> (8 * b)); }
+		extra = 11;
+		break;
+	case 3: {   /* RW_IOVEC */
+		const uint8_t *direction = wqmi_tlv(m, length, 2, &size), *entries;
+		uint16_t direction_size = size, entries_size = 0;
+		bool write;
+		unsigned count, e;
+		value = wqmi_tlv(m, length, 1, &size);
+		entries = wqmi_tlv(m, length, 3, &entries_size);
+		file = value != NULL && size == 4u && wle32(value) >= 1u && wle32(value) <= 4u ? wle32(value) - 1u : 4u;
+		if (file == 4u || !wrmtfs_files[file].open || direction == NULL || direction_size != 1u || entries == NULL ||
+		    entries_size < 1u || entries_size != 1u + 12u * entries[0] || wrmtfs_window == NULL) {
+			result = WQMI_RESULT_FAILURE; error = WQMI_ERR_MALFORMED; wrmtfs_refused++; break;
+		}
+		write = direction[0] != 0;
+		count = entries[0];
+		for (e = 0; e < count && result == 0; e++) {
+			uint64_t sector = wle32(entries + 1 + 12 * e), physical = wle32(entries + 5 + 12 * e), sectors = wle32(entries + 9 + 12 * e);
+			uint64_t bytes = sectors * WRMTFS_SECTOR, i;
+			if (physical < wrmtfs_buffer_pa || physical - wrmtfs_buffer_pa + bytes > WRMTFS_BUFFER_SIZE ||
+			    sector * WRMTFS_SECTOR + bytes > wrmtfs_files[file].size) {
+				printf("SWEET WIFI: [13] rmtfs: %s %llu sectors from %llu of %s: OUT OF RANGE\n", write ? "write" : "read", sectors, sector, wrmtfs_files[file].partition);
+				result = WQMI_RESULT_FAILURE; error = WQMI_ERR_MALFORMED; wrmtfs_refused++; break;
+			}
+			if (write) {
+				for (i = 0; i < bytes; i++) { wrmtfs_files[file].data[sector * WRMTFS_SECTOR + i] = wrmtfs_window[physical - wrmtfs_buffer_pa + i]; }
+				wrmtfs_writes++;
+			} else {
+				for (i = 0; i < bytes; i++) { wrmtfs_window[physical - wrmtfs_buffer_pa + i] = wrmtfs_files[file].data[sector * WRMTFS_SECTOR + i]; }
+				wrmtfs_reads++;
+			}
+		}
+		__asm__ volatile("dsb sy" ::: "memory");
+		if (result == 0 && (wrmtfs_reads + wrmtfs_writes) <= 16u) {
+			printf("SWEET WIFI: [13] rmtfs: modem %s %u pieces of %s: served\n", write ? "writes" : "reads", count, wrmtfs_files[file].partition);
+		}
+		break;
+	}
+	case 5:   /* GET_DEV_ERROR */
+		tlv[0] = 0x10; tlv[1] = 1; tlv[2] = 0; tlv[3] = 0; extra = 4;
+		break;
+	default:
+		printf("SWEET WIFI: [13] rmtfs: unknown request %#x (%u bytes)\n", message, length);
+		result = WQMI_RESULT_FAILURE; error = WQMI_ERR_MALFORMED;
+		break;
+	}
+	answer[5] = (uint8_t)(7 + extra);
+	answer[6] = (uint8_t)((7 + extra) >> 8);
+	answer[7] = 2; answer[8] = 4; answer[9] = 0;
+	answer[10] = (uint8_t)result; answer[11] = (uint8_t)(result >> 8);
+	answer[12] = (uint8_t)error; answer[13] = (uint8_t)(error >> 8);
+	if (wrmtfs_port != NULL) {
+		(void)wqrtr_send(wrmtfs_port->number, node, port, answer, 14u + extra);
+	}
+}
+
+/* ---- M3b/M3c: pd-mapper (service-registry locator, QMI 64) + tqftpserv (TFTP over QRTR, QMI 4096) ----
+ * Port of hakios.mpss.c's servreg + tftp. The modem, once it has its EFS (rmtfs), asks the locator where
+ * services live (reading the .jsn table beside the firmware) and fetches firmware files (wlanmdsp.mbn,
+ * bdwlan.*) over TFTP -- both needed before the modem spawns its wlan process-domain (-> WLFW service 39).
+ * Firmware + .jsn are pushed to /usr/local/gltest/fw/. Reuses wqrtr_*, wqmi_tlv, wifi_file_size. */
+#define WFW_DIR              "/usr/local/gltest/"   /* flat: modem.* + modemst*.img + wifi fw + .jsn all here */
+#define WTFTP_SERVICE        4096u
+#define WTFTP_RRQ            1u
+#define WTFTP_WRQ            2u
+#define WTFTP_DATA           3u
+#define WTFTP_ACK            4u
+#define WTFTP_ERROR          5u
+#define WTFTP_OACK           6u
+#define WTFTP_ENOENT         1u
+#define WTFTP_EBADOP         4u
+#define WTFTP_END_OF_XFER    9u
+#define WTFTP_MAX_BLOCK      8000u
+#define WTFTP_MAX_WINDOW     4u
+#define WTFTP_WRITE_MAX      (1u << 20)
+#define WSERVREG_SERVICE     64u
+#define WSERVREG_INSTANCE    257u
+#define WSERVREG_GET_DOMAIN_LIST 0x21u
+#define WSERVREG_PFR         0x24u
+
+static struct wqrtr_port *wtftp_port, *wservreg_port;
+
+/* A whole firmware file from WFW_DIR into a fresh buffer the caller frees with wkfree(buf,*size). */
+static uint8_t *
+wfw_read(const char *name, uint64_t *size)
+{
+	char path[192];
+	uint64_t sz = 0, got = 0;
+	vm_offset_t buf = 0;
+	snprintf(path, sizeof(path), "%s%s", WFW_DIR, name);
+	if (wifi_file_size(path, &sz) != 0 || sz == 0 || sz > (16u << 20)) { return NULL; }
+	if (kmem_alloc(kernel_map, &buf, (vm_size_t)sz, KMA_DATA | KMA_ZERO, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) { return NULL; }
+	if (wifi_read_file(path, (uint8_t *)buf, (uint32_t)sz, &got) != 0 || got != sz) { kmem_free(kernel_map, buf, (vm_size_t)sz); return NULL; }
+	*size = sz;
+	return (uint8_t *)buf;
+}
+
+static uint8_t *
+wkalloc(uint64_t n)
+{
+	vm_offset_t v = 0;
+	if (kmem_alloc(kernel_map, &v, (vm_size_t)(n ? n : 1u), KMA_DATA | KMA_ZERO, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) { return NULL; }
+	return (uint8_t *)v;
+}
+
+static void
+wkfree(uint8_t *p, uint64_t n)
+{
+	if (p != NULL) { kmem_free(kernel_map, (vm_offset_t)p, (vm_size_t)(n ? n : 1u)); }
+}
+
+static void
+wqrtr_close(struct wqrtr_port *p)
+{
+	if (p != NULL) { p->number = 0u; p->receive = NULL; p->context = NULL; }
+}
+
+/* ---- tqftpserv: the firmware files the modem asks for, over TFTP in QRTR datagrams ---- */
+struct wtftp_transfer {
+	struct wqrtr_port *port;
+	uint32_t node, peer;
+	const uint8_t *data;            /* a read: the file, whole (wfw_read, or a wtftp_files entry) */
+	uint64_t size;
+	uint32_t blksize, wsize, rsize, seek, sent, expected;
+	uint8_t *written;               /* a write: what has come */
+	uint32_t written_size;
+	char name[160];
+	bool done, writing, borrowed;
+};
+static struct wtftp_transfer wtftp_transfers[4];
+static struct { char name[160]; uint8_t *data; uint64_t size; } wtftp_files[8];
+static uint32_t wtftp_requests, wtftp_served, wtftp_refused, wservreg_requests;
+
+static void wtftp_transfer_receive(void *ctx, uint32_t node, uint32_t port, const void *data, uint32_t length);
+
+static void
+wtftp_error(struct wqrtr_port *from, uint32_t node, uint32_t port, uint16_t code, const char *text)
+{
+	uint8_t packet[64];
+	size_t n = strlen(text) + 1;
+	if (n > sizeof(packet) - 4) { n = sizeof(packet) - 4; }
+	packet[0] = 0; packet[1] = (uint8_t)WTFTP_ERROR;
+	packet[2] = (uint8_t)(code >> 8); packet[3] = (uint8_t)code;
+	memcpy(packet + 4, text, n); packet[4 + n - 1] = 0;
+	(void)wqrtr_send(from->number, node, port, packet, (uint32_t)(4 + n));
+}
+
+static void
+wtftp_transfer_end(struct wtftp_transfer *t)
+{
+	if (t->data != NULL && !t->borrowed) { wkfree((uint8_t *)(uintptr_t)t->data, t->size); }
+	t->data = NULL;
+	if (t->written != NULL) { wkfree(t->written, WTFTP_WRITE_MAX); t->written = NULL; }
+	if (t->port != NULL) { wqrtr_close(t->port); t->port = NULL; }
+	t->done = true;
+}
+
+/* Blocks `from`+1 onward, a window of them (TFTP blocks are numbered from 1). */
+static void
+wtftp_send_window(struct wtftp_transfer *t, uint32_t from)
+{
+	uint8_t *packet = wkalloc(t->blksize + 4u);
+	uint32_t w;
+	if (packet == NULL) { return; }
+	for (w = 0; w < t->wsize; w++) {
+		uint32_t block = from + 1u + w;
+		uint64_t offset = (uint64_t)t->seek + (uint64_t)(block - 1u) * t->blksize;
+		uint32_t n = offset >= t->size ? 0u : (uint32_t)(t->size - offset < t->blksize ? t->size - offset : t->blksize);
+		if (t->rsize != 0u && (uint64_t)(block - 1u) * t->blksize >= t->rsize) { break; }
+		if (t->rsize != 0u && (uint64_t)block * t->blksize > t->rsize) {
+			uint32_t left = (uint32_t)(t->rsize - (uint64_t)(block - 1u) * t->blksize);
+			n = left < n ? left : n;
+		}
+		static uint32_t wtftp_stall_logs;
+		packet[0] = 0; packet[1] = (uint8_t)WTFTP_DATA;
+		packet[2] = (uint8_t)(block >> 8); packet[3] = (uint8_t)block;
+		if (n != 0u) { memcpy(packet + 4, t->data + offset, n); }
+		if (wqrtr_send(t->port->number, t->node, t->peer, packet, 4u + n) != 0) {
+			if ((strnstr(t->name, "mbn", sizeof(t->name)) || strnstr(t->name, "bdwlan", sizeof(t->name))) && wtftp_stall_logs < 24u) {
+				printf("SWEET WIFI: [14] tftp: \"%s\" SEND STALL at block %u (glink backpressure / no intent)\n", t->name, block);
+				wtftp_stall_logs++;
+			}
+			break;
+		}
+		t->sent = block;
+		if (n < t->blksize) { break; }
+	}
+	wkfree(packet, t->blksize + 4u);
+}
+
+static void
+wtftp_transfer_receive(void *ctx, uint32_t node, uint32_t port, const void *data, uint32_t length)
+{
+	struct wtftp_transfer *t = ctx;
+	const uint8_t *m = data;
+	uint16_t opcode, block;
+	if (t->done || node != t->node || port != t->peer || length < 4u) { return; }
+	opcode = (uint16_t)(m[0] << 8 | m[1]);
+	block = (uint16_t)(m[2] << 8 | m[3]);
+	if (t->writing && opcode == WTFTP_DATA) {
+		uint32_t n = length - 4u;
+		uint8_t ack[4] = { 0, (uint8_t)WTFTP_ACK, (uint8_t)(block >> 8), (uint8_t)block };
+		if (block != t->expected) { wtftp_error(t->port, node, port, (uint16_t)WTFTP_EBADOP, "out of sequence"); wtftp_transfer_end(t); return; }
+		if (t->written_size + n > WTFTP_WRITE_MAX) { wtftp_error(t->port, node, port, 3, "too much"); wtftp_transfer_end(t); return; }
+		memcpy(t->written + t->written_size, m + 4, n);
+		t->written_size += n; t->expected++;
+		if (block % t->wsize == 0u || n < t->blksize) { (void)wqrtr_send(t->port->number, node, port, ack, sizeof(ack)); }
+		if (n < t->blksize) {
+			unsigned f, free_slot = 8u;
+			for (f = 0; f < 8u; f++) {
+				if (wtftp_files[f].data != NULL && strcmp(wtftp_files[f].name, t->name) == 0) { break; }
+				if (wtftp_files[f].data == NULL && free_slot == 8u) { free_slot = f; }
+			}
+			if (f == 8u) { f = free_slot; }
+			if (f < 8u) {
+				if (wtftp_files[f].data != NULL) { wkfree(wtftp_files[f].data, wtftp_files[f].size); }
+				wtftp_files[f].data = wkalloc(t->written_size ? t->written_size : 1u);
+				if (wtftp_files[f].data != NULL) {
+					memcpy(wtftp_files[f].data, t->written, t->written_size);
+					wtftp_files[f].size = t->written_size;
+					strlcpy(wtftp_files[f].name, t->name, sizeof(wtftp_files[f].name));
+				}
+			}
+			printf("SWEET WIFI: [14] tftp: modem wrote \"%s\": %u bytes, kept%s\n", t->name, t->written_size, f < 8u ? "" : " NOWHERE");
+			wtftp_served++; wtftp_transfer_end(t);
+		}
+		return;
+	}
+	if (opcode == WTFTP_ERROR) {
+		if (strnstr(t->name, "mbn", sizeof(t->name)) || strnstr(t->name, "bdwlan", sizeof(t->name))) {
+			printf("SWEET WIFI: [14] tftp: \"%s\" ENDED by modem error %u after block %u (%llu of %llu B sent)\n",
+			    t->name, block, t->sent, (uint64_t)t->sent * t->blksize, t->size);
+		} else if (block != WTFTP_END_OF_XFER) { printf("SWEET WIFI: [14] tftp: %s: modem ends with error %u\n", t->name, block); }
+		wtftp_transfer_end(t); return;
+	}
+	if (opcode != WTFTP_ACK) { wtftp_error(t->port, node, port, (uint16_t)WTFTP_EBADOP, "expected ACK"); wtftp_transfer_end(t); return; }
+	if ((strnstr(t->name, "mbn", sizeof(t->name)) || strnstr(t->name, "bdwlan", sizeof(t->name))) && (block % 64u == 0u)) {
+		printf("SWEET WIFI: [14] tftp: \"%s\" ack block %u (~%llu total)\n", t->name, block, t->size / t->blksize + 1u);
+	}
+	if ((uint64_t)t->seek + (uint64_t)block * t->blksize >= t->size || (t->rsize != 0u && (uint64_t)block * t->blksize >= t->rsize)) {
+		if (strnstr(t->name, "mbn", sizeof(t->name)) || strnstr(t->name, "bdwlan", sizeof(t->name))) {
+			printf("SWEET WIFI: [14] tftp: COMPLETED read \"%s\" (seek %u, %u blocks x%u = %llu B of %llu)\n",
+			    t->name, t->seek, block, t->blksize, (uint64_t)block * t->blksize, t->size);
+		}
+		wtftp_served++; wtftp_transfer_end(t); return;
+	}
+	wtftp_send_window(t, block);
+}
+
+static const char *
+wtftp_file_of(const char *path)
+{
+	static const char *const prefixes[] = { "/readonly/firmware/image/", "/readonly/vendor/firmware_mnt/image/",
+		"/readonly/vendor/firmware/", "/readonly/firmware/" };
+	unsigned i;
+	for (i = 0; i < sizeof(prefixes) / sizeof(prefixes[0]); i++) {
+		size_t n = strlen(prefixes[i]);
+		if (strncmp(path, prefixes[i], n) == 0 && strnstr(path + n, "..", strlen(path + n)) == NULL) { return path + n; }
+	}
+	return NULL;
+}
+
+static void
+wtftp_receive(void *ctx, uint32_t node, uint32_t port, const void *data, uint32_t length)
+{
+	const uint8_t *m = data, *endp = m + length;
+	const char *name, *mode, *p;
+	struct wtftp_transfer *t = NULL;
+	uint32_t blksize = 512u, wsize = 1u, rsize = 0u, seek = 0u;
+	bool tsize = false, options = false, writing;
+	char fwname[192];
+	uint64_t size = 0;
+	const uint8_t *file;
+	uint8_t oack[192];
+	unsigned at, i;
+	(void)ctx;
+	if (length < 4u) { return; }
+	wtftp_requests++;
+	writing = (uint32_t)(m[0] << 8 | m[1]) == WTFTP_WRQ;
+	if ((uint32_t)(m[0] << 8 | m[1]) != WTFTP_RRQ && !writing) {
+		wtftp_error(wtftp_port, node, port, (uint16_t)WTFTP_EBADOP, "not read/write"); wtftp_refused++; return;
+	}
+	name = (const char *)m + 2; p = name;
+	while (p < (const char *)endp && *p != 0) { p++; }
+	if (p >= (const char *)endp) { return; }
+	mode = p + 1; p = mode;
+	while (p < (const char *)endp && *p != 0) { p++; }
+	if (p >= (const char *)endp) { return; }
+	p++;
+	while (p < (const char *)endp) {
+		const char *option = p, *value;
+		while (p < (const char *)endp && *p != 0) { p++; }
+		if (p >= (const char *)endp) { break; }
+		value = ++p;
+		while (p < (const char *)endp && *p != 0) { p++; }
+		if (p >= (const char *)endp) { break; }
+		p++; options = true;
+		if (strcmp(option, "blksize") == 0) { blksize = (uint32_t)strtoul(value, NULL, 10); }
+		else if (strcmp(option, "wsize") == 0) { wsize = (uint32_t)strtoul(value, NULL, 10); }
+		else if (strcmp(option, "rsize") == 0) { rsize = (uint32_t)strtoul(value, NULL, 10); }
+		else if (strcmp(option, "seek") == 0) { seek = (uint32_t)strtoul(value, NULL, 10); }
+		else if (strcmp(option, "tsize") == 0) { tsize = true; }
+	}
+	if (blksize < 8u) { blksize = 8u; }
+	if (blksize > WTFTP_MAX_BLOCK) { blksize = WTFTP_MAX_BLOCK; }
+	if (wsize < 1u) { wsize = 1u; }
+	if (wsize > WTFTP_MAX_WINDOW) { wsize = WTFTP_MAX_WINDOW; }
+	for (i = 0; i < 4u && t == NULL; i++) { if (wtftp_transfers[i].port == NULL) { t = &wtftp_transfers[i]; } }
+	if (t == NULL) { wtftp_error(wtftp_port, node, port, (uint16_t)WTFTP_ENOENT, "busy"); wtftp_refused++; return; }
+	if (writing) {
+		bzero(t, sizeof(*t));
+		t->written = wkalloc(WTFTP_WRITE_MAX);
+		t->port = t->written == NULL ? NULL : wqrtr_open(wtftp_transfer_receive, t);
+		if (t->port == NULL) { wtftp_transfer_end(t); wtftp_error(wtftp_port, node, port, (uint16_t)WTFTP_ENOENT, "no port"); return; }
+		t->node = node; t->peer = port; t->writing = true; t->expected = 1u; t->blksize = blksize; t->wsize = wsize;
+		strlcpy(t->name, name, sizeof(t->name));
+		printf("SWEET WIFI: [14] tftp: modem writes \"%s\" (blk %u win %u)\n", name, blksize, wsize);
+		if (!options) { uint8_t ack[4] = { 0, (uint8_t)WTFTP_ACK, 0, 0 }; (void)wqrtr_send(t->port->number, node, port, ack, sizeof(ack)); return; }
+		size = 0; goto oack;
+	}
+	file = NULL;
+	for (i = 0; i < 8u && file == NULL; i++) {
+		if (wtftp_files[i].data != NULL && strcmp(wtftp_files[i].name, name) == 0) { file = wtftp_files[i].data; size = wtftp_files[i].size; t->borrowed = true; }
+	}
+	if (file == NULL && wtftp_file_of(name) == NULL) {
+		printf("SWEET WIFI: [14] tftp: modem reads \"%s\": NOT A PATH SERVED HERE\n", name);
+		wtftp_error(wtftp_port, node, port, (uint16_t)WTFTP_ENOENT, "not found"); wtftp_refused++; return;
+	}
+	if (file == NULL) { file = wfw_read(wtftp_file_of(name), &size); }
+	if (file == NULL) {
+		printf("SWEET WIFI: [14] tftp: modem reads \"%s\" (fw/%s): NOT HERE -- push it to %s\n", name, wtftp_file_of(name) ? wtftp_file_of(name) : "?", WFW_DIR);
+		wtftp_error(wtftp_port, node, port, (uint16_t)WTFTP_ENOENT, "not found"); wtftp_refused++; return;
+	}
+	{ bool borrowed = t->borrowed; bzero(t, sizeof(*t)); t->borrowed = borrowed; }
+	t->port = wqrtr_open(wtftp_transfer_receive, t);
+	if (t->port == NULL) { if (!t->borrowed) { wkfree((uint8_t *)(uintptr_t)file, size); } wtftp_error(wtftp_port, node, port, (uint16_t)WTFTP_ENOENT, "no port"); return; }
+	t->node = node; t->peer = port; t->data = file; t->size = size; t->blksize = blksize; t->wsize = wsize; t->rsize = rsize; t->seek = seek;
+	strlcpy(t->name, name, sizeof(t->name));
+	printf("SWEET WIFI: [14] tftp: modem reads \"%s\": %llu bytes (blk %u win %u seek %u rsize %u)\n", name, size, blksize, wsize, seek, rsize);
+	if (!options) { wtftp_send_window(t, 0); return; }
+oack:
+	oack[0] = 0; oack[1] = (uint8_t)WTFTP_OACK; at = 2;
+	at += (unsigned)snprintf((char *)oack + at, sizeof(oack) - at, "blksize") + 1u;
+	at += (unsigned)snprintf((char *)oack + at, sizeof(oack) - at, "%u", blksize) + 1u;
+	at += (unsigned)snprintf((char *)oack + at, sizeof(oack) - at, "timeoutms") + 1u;
+	at += (unsigned)snprintf((char *)oack + at, sizeof(oack) - at, "1000") + 1u;
+	if (tsize && !t->writing) {
+		at += (unsigned)snprintf((char *)oack + at, sizeof(oack) - at, "tsize") + 1u;
+		at += (unsigned)snprintf((char *)oack + at, sizeof(oack) - at, "%llu", size) + 1u;
+	}
+	at += (unsigned)snprintf((char *)oack + at, sizeof(oack) - at, "wsize") + 1u;
+	at += (unsigned)snprintf((char *)oack + at, sizeof(oack) - at, "%u", wsize) + 1u;
+	if (rsize != 0u) { at += (unsigned)snprintf((char *)oack + at, sizeof(oack) - at, "rsize") + 1u; at += (unsigned)snprintf((char *)oack + at, sizeof(oack) - at, "%u", rsize) + 1u; }
+	if (seek != 0u) { at += (unsigned)snprintf((char *)oack + at, sizeof(oack) - at, "seek") + 1u; at += (unsigned)snprintf((char *)oack + at, sizeof(oack) - at, "%u", seek) + 1u; }
+	(void)wqrtr_send(t->port->number, node, port, oack, at);
+}
+
+/* ---- servreg locator (pd-mapper, QMI service 64): which domain provides a named service ---- */
+static struct { char service[48]; char domain[48]; uint32_t instance; } wservreg_map[32];
+static unsigned wservreg_maps;
+
+static const char *
+wjsn_string(const char *from, const char *end, const char *key, char *out, size_t out_size)
+{
+	char quoted[48];
+	const char *at;
+	snprintf(quoted, sizeof(quoted), "\"%s\"", key);
+	at = strnstr(from, quoted, (size_t)(end - from));
+	if (at == NULL) { return NULL; }
+	at += strlen(quoted);
+	while (at < end && (*at == ':' || *at == ' ' || *at == '\t' || *at == '\n' || *at == '\r')) { at++; }
+	if (at >= end) { return NULL; }
+	if (*at == '"') {
+		const char *close = at + 1;
+		while (close < end && *close != '"') { close++; }
+		if (close >= end) { return NULL; }
+		snprintf(out, out_size, "%.*s", (int)(close - at - 1), at + 1);
+		return close + 1;
+	}
+	{ const char *close = at; while (close < end && ((*close >= '0' && *close <= '9') || *close == '-')) { close++; } snprintf(out, out_size, "%.*s", (int)(close - at), at); return close; }
+}
+
+static void
+wservreg_load(void)
+{
+	static const char *const files[] = { "modemr.jsn", "modemuw.jsn", "adspr.jsn", "adsps.jsn", "adspua.jsn", "cdspr.jsn" };
+	unsigned f;
+	wservreg_maps = 0;
+	for (f = 0; f < sizeof(files) / sizeof(files[0]); f++) {
+		char soc[24], domain[24], subdomain[24], instance[16], provider[24], service[24], full[48];
+		uint64_t size = 0;
+		const uint8_t *data = wfw_read(files[f], &size);
+		const char *text, *end, *at;
+		if (data == NULL) { continue; }
+		text = (const char *)data; end = text + size;
+		if (wjsn_string(text, end, "soc", soc, sizeof(soc)) == NULL || wjsn_string(text, end, "domain", domain, sizeof(domain)) == NULL ||
+		    wjsn_string(text, end, "subdomain", subdomain, sizeof(subdomain)) == NULL ||
+		    wjsn_string(text, end, "qmi_instance_id", instance, sizeof(instance)) == NULL) {
+			printf("SWEET WIFI: [14] servreg: %s: not of the shape this reads\n", files[f]); wkfree((uint8_t *)(uintptr_t)data, size); continue;
+		}
+		snprintf(full, sizeof(full), "%s/%s/%s", soc, domain, subdomain);
+		at = text;
+		while (wservreg_maps < sizeof(wservreg_map) / sizeof(wservreg_map[0]) &&
+		    (at = wjsn_string(at, end, "provider", provider, sizeof(provider))) != NULL &&
+		    wjsn_string(at, end, "service", service, sizeof(service)) != NULL) {
+			snprintf(wservreg_map[wservreg_maps].service, sizeof(wservreg_map[0].service), "%s/%s", provider, service);
+			strlcpy(wservreg_map[wservreg_maps].domain, full, sizeof(wservreg_map[0].domain));
+			wservreg_map[wservreg_maps].instance = (uint32_t)strtoul(instance, NULL, 10);
+			wservreg_maps++;
+		}
+		wkfree((uint8_t *)(uintptr_t)data, size);
+	}
+	printf("SWEET WIFI: [14] servreg: %u services from .jsn\n", wservreg_maps);
+	for (f = 0; f < wservreg_maps; f++) { printf("SWEET WIFI: [14] servreg:   %s at %s, instance %u\n", wservreg_map[f].service, wservreg_map[f].domain, wservreg_map[f].instance); }
+}
+
+static void
+wservreg_receive(void *ctx, uint32_t node, uint32_t port, const void *data, uint32_t length)
+{
+	const uint8_t *m = data, *value;
+	uint8_t answer[512];
+	uint16_t message, size = 0;
+	unsigned at = 7 + 7, found = 0, i;
+	char wanted[64] = "";
+	(void)ctx;
+	if (length < 7u || m[0] != WQMI_REQUEST) { return; }
+	message = (uint16_t)(m[3] | m[4] << 8);
+	wservreg_requests++;
+	bzero(answer, sizeof(answer));
+	answer[0] = WQMI_RESPONSE; answer[1] = m[1]; answer[2] = m[2]; answer[3] = m[3]; answer[4] = m[4];
+	answer[7] = 2; answer[8] = 4;    /* result: success */
+	if (message == WSERVREG_GET_DOMAIN_LIST) {
+		value = wqmi_tlv(m, length, 1, &size);
+		if (value != NULL) { snprintf(wanted, sizeof(wanted), "%.*s", (int)(size < 63u ? size : 63u), (const char *)value); }
+		for (i = 0; i < wservreg_maps; i++) { found += strcmp(wservreg_map[i].service, wanted) == 0; }
+		answer[at++] = 0x10; answer[at++] = 2; answer[at++] = 0; answer[at++] = (uint8_t)found; answer[at++] = (uint8_t)(found >> 8);
+		answer[at++] = 0x11; answer[at++] = 2; answer[at++] = 0; answer[at++] = 1; answer[at++] = 0;
+		if (found != 0u) {
+			unsigned list = at;
+			answer[at++] = 0x12; at += 2; answer[at++] = (uint8_t)found;
+			for (i = 0; i < wservreg_maps && at + 64u < sizeof(answer); i++) {
+				if (strcmp(wservreg_map[i].service, wanted) != 0) { continue; }
+				answer[at++] = (uint8_t)strlen(wservreg_map[i].domain);
+				memcpy(answer + at, wservreg_map[i].domain, strlen(wservreg_map[i].domain));
+				at += (unsigned)strlen(wservreg_map[i].domain);
+				{ unsigned b; for (b = 0; b < 4u; b++) { answer[at++] = (uint8_t)(wservreg_map[i].instance >> (8 * b)); } }
+				answer[at++] = 0; at += 4;
+			}
+			answer[list + 1] = (uint8_t)(at - list - 3);
+			answer[list + 2] = (uint8_t)((at - list - 3) >> 8);
+		}
+		printf("SWEET WIFI: [14] servreg: modem asks where \"%s\" is: %u domain%s\n", wanted, found, found == 1u ? "" : "s");
+	} else if (message == WSERVREG_PFR) {
+		value = wqmi_tlv(m, length, 1, &size);
+		printf("SWEET WIFI: [14] servreg: modem reports a failure of \"%.*s\"\n", value ? (int)(size < 63u ? size : 63u) : 0, value ? (const char *)value : "");
+	} else {
+		printf("SWEET WIFI: [14] servreg: request %#x not known\n", message);
+		answer[10] = WQMI_RESULT_FAILURE; answer[12] = WQMI_ERR_MALFORMED;
+	}
+	answer[5] = (uint8_t)(at - 7); answer[6] = (uint8_t)((at - 7) >> 8);
+	(void)wqrtr_send(wservreg_port->number, node, port, answer, at);
+}
+
+/* ---- servreg NOTIFIER client (PDR): make the modem spawn wlan_pd -------------------------------------
+ * MIUI's wlan driver connects to the modem's notifier (QMI service 66 / 0x42, instance 180) and registers
+ * a listener for "msm/modem/wlan_pd"; the modem then STARTS wlan_pd (loads wlanmdsp.mbn) and sends a
+ * state=UP(0x1fffffff) indication, which the host ACKs -> wlan_pd registers WLFW (service 39). Linux
+ * drivers/soc/qcom/pdr_interface.c. Without this the modem only pre-reads wlanmdsp.mbn and never starts
+ * the PD (seen in wifi23). */
+#define WPDR_REGISTER_LISTENER 0x20u
+#define WPDR_RESTART_PD        0x24u
+#define WPDR_STATE_UPDATED_IND 0x22u
+#define WPDR_SET_ACK           0x23u
+#define WPDR_STATE_UP          0x1fffffffu
+#define WQMI_INDICATION        4u
+#define WPDR_WLAN_PATH         "msm/modem/wlan_pd"
+
+static struct wqrtr_port *wpdr_port;
+static uint16_t wpdr_txn;
+static bool wpdr_restart_sent;
+
+/* SERVREG_RESTART_PD (0x24): ask the modem to (re)start the PD -- a listener alone only subscribes; a
+ * never-started wlan_pd stays down until restarted. TLV 0x01 = service_path. */
+static void
+wpdr_restart(uint32_t node, uint32_t port)
+{
+	uint8_t req[96];
+	unsigned at = 7, plen = (unsigned)strlen(WPDR_WLAN_PATH);
+	if (wpdr_port == NULL) { return; }
+	req[0] = WQMI_REQUEST; req[1] = (uint8_t)(++wpdr_txn); req[2] = (uint8_t)(wpdr_txn >> 8);
+	req[3] = WPDR_RESTART_PD & 0xffu; req[4] = 0;
+	req[at++] = 0x01; req[at++] = (uint8_t)plen; req[at++] = (uint8_t)(plen >> 8); memcpy(req + at, WPDR_WLAN_PATH, plen); at += plen;
+	req[5] = (uint8_t)(at - 7); req[6] = (uint8_t)((at - 7) >> 8);
+	(void)wqrtr_send(wpdr_port->number, node, port, req, at);
+	wpdr_restart_sent = true;
+	printf("SWEET WIFI: [15] pdr: sent RESTART_PD for %s (node %u port %u)\n", WPDR_WLAN_PATH, node, port);
+}
+
+static void
+wpdr_ack(uint32_t node, uint32_t port, const char *path, uint16_t txn)
+{
+	uint8_t req[96];
+	unsigned at = 7, plen = (unsigned)strlen(path);
+	req[0] = WQMI_REQUEST; req[1] = (uint8_t)(++wpdr_txn); req[2] = (uint8_t)(wpdr_txn >> 8);
+	req[3] = WPDR_SET_ACK & 0xffu; req[4] = 0;
+	req[at++] = 0x01; req[at++] = (uint8_t)plen; req[at++] = (uint8_t)(plen >> 8); memcpy(req + at, path, plen); at += plen;
+	req[at++] = 0x02; req[at++] = 2; req[at++] = 0; req[at++] = (uint8_t)txn; req[at++] = (uint8_t)(txn >> 8);
+	req[5] = (uint8_t)(at - 7); req[6] = (uint8_t)((at - 7) >> 8);
+	(void)wqrtr_send(wpdr_port->number, node, port, req, at);
+}
+
+static void
+wpdr_receive(void *ctx, uint32_t node, uint32_t port, const void *data, uint32_t length)
+{
+	const uint8_t *m = data, *v;
+	uint16_t msg, size = 0;
+	(void)ctx;
+	if (length < 5u) { return; }
+	msg = (uint16_t)(m[3] | m[4] << 8);
+	if (m[0] == WQMI_RESPONSE && msg == WPDR_REGISTER_LISTENER) {
+		v = wqmi_tlv(m, length, 0x10, &size);
+		printf("SWEET WIFI: [15] pdr: wlan_pd register-listener response%s%s\n",
+		    v && size >= 4u ? ", current state " : "", v && size >= 4u ? (wle32(v) == WPDR_STATE_UP ? "UP" : "down") : "");
+		if (v && size >= 4u && wle32(v) == WPDR_STATE_UP) { wpdr_wlan_up = true; }
+		(void)wpdr_restart;   /* RESTART_PD disrupted the modem (wifi25) -- disabled; focus on the mbn transfer */
+	} else if (m[0] == WQMI_INDICATION && msg == WPDR_STATE_UPDATED_IND) {
+		uint32_t state = 0; uint16_t txn = 0; char path[64] = "";
+		v = wqmi_tlv(m, length, 0x01, &size); if (v && size >= 4u) { state = wle32(v); }
+		v = wqmi_tlv(m, length, 0x02, &size); if (v) { snprintf(path, sizeof(path), "%.*s", (int)(size < 63u ? size : 63u), (const char *)v); }
+		v = wqmi_tlv(m, length, 0x03, &size); if (v && size >= 2u) { txn = (uint16_t)(v[0] | v[1] << 8); }
+		printf("SWEET WIFI: [15] pdr: >>>>> %s is %s (state %#x) -- ACKing <<<<<\n", path, state == WPDR_STATE_UP ? "UP" : "down", state);
+		wpdr_ack(node, port, path, txn);
+		if (state == WPDR_STATE_UP) { wpdr_wlan_up = true; }
+	}
+}
+
+static void
+wpdr_register_wlan(uint32_t node, uint32_t port)
+{
+	uint8_t req[96];
+	unsigned at = 7, plen = (unsigned)strlen(WPDR_WLAN_PATH);
+	if (wpdr_port == NULL) { wpdr_port = wqrtr_open(wpdr_receive, NULL); }
+	if (wpdr_port == NULL) { return; }
+	req[0] = WQMI_REQUEST; req[1] = (uint8_t)(++wpdr_txn); req[2] = (uint8_t)(wpdr_txn >> 8);
+	req[3] = WPDR_REGISTER_LISTENER & 0xffu; req[4] = 0;
+	req[at++] = 0x01; req[at++] = 1; req[at++] = 0; req[at++] = 1;                   /* enable = 1 */
+	req[at++] = 0x02; req[at++] = (uint8_t)plen; req[at++] = (uint8_t)(plen >> 8);   /* service_path */
+	memcpy(req + at, WPDR_WLAN_PATH, plen); at += plen;
+	req[5] = (uint8_t)(at - 7); req[6] = (uint8_t)((at - 7) >> 8);
+	(void)wqrtr_send(wpdr_port->number, node, port, req, at);
+	wpdr_registered = true;
+	printf("SWEET WIFI: [15] pdr: registered listener for %s with modem notifier (svc 66) node %u port %u\n", WPDR_WLAN_PATH, node, port);
+}
+
+static void
+wrmtfs_start(void)
+{
+	if (wrmtfs_port == NULL) { wrmtfs_port = wqrtr_open(wrmtfs_receive, NULL); }
+	if (wrmtfs_port == NULL) { printf("SWEET WIFI: [13] rmtfs: no free QRTR port\n"); return; }
+	wour_servers[0].service = 14u;
+	wour_servers[0].instance = 1u;   /* RMTFS_VERSION(1) | RMTFS_INSTANCE(0)<<8 */
+	wour_servers[0].port = wrmtfs_port->number;
+	printf("SWEET WIFI: [13] rmtfs: server registered (service 14, instance 1, port %u)\n", wrmtfs_port->number);
+	if (wifi_level >= 14) {   /* M3b/M3c: the modem needs tftp + the locator to spawn wlan_pd */
+		if (wtftp_port == NULL) { wtftp_port = wqrtr_open(wtftp_receive, NULL); }
+		if (wtftp_port != NULL) {
+			wour_servers[1].service = WTFTP_SERVICE; wour_servers[1].instance = 1u; wour_servers[1].port = wtftp_port->number;
+			printf("SWEET WIFI: [14] tqftpserv: server registered (service 4096, instance 1, port %u)\n", wtftp_port->number);
+		}
+		if (wservreg_port == NULL) { wservreg_port = wqrtr_open(wservreg_receive, NULL); }
+		if (wservreg_port != NULL) {
+			wour_servers[2].service = WSERVREG_SERVICE; wour_servers[2].instance = WSERVREG_INSTANCE; wour_servers[2].port = wservreg_port->number;
+			printf("SWEET WIFI: [14] servreg: locator registered (service 64, instance 257, port %u)\n", wservreg_port->number);
+		}
+	}
+}
+
+
+/*
+ * The CPU's clock (boot-arg sweetcpufreq=1), as HackiOS's redwood_cpufreq.c does it on its EPSS: the
+ * boot loader leaves each cluster at a modest frequency and expects the OS to ask for more; the
+ * hardware ("OSM" on this SoC, dt qcom,cpucc@18321000 qcom,clk-cpu-osm-sdmmagpie) has each
+ * cluster's table of frequencies and switches clock source and supply by itself when told which
+ * row is wanted. Register layout: the vendor's drivers/clk/qcom/clk-cpu-osm.c. Every core of every
+ * cluster is asked for its top row; the cluster's hardware limits (qcom,msm-hw-limits) still
+ * throttle it when hot. The real frequency is measured before and after from OSM's own cycle
+ * counters.
+ */
+#define OSM_FREQ_REG(r)      (0x110u + 32u * (r))
+#define OSM_CORE_DCVS_CTRL   0xBCu
+#define OSM_PERF_STATE(n)    (0x920u + 4u * (n))
+#define OSM_CYCLES(n)        (0x9C0u + 4u * (n))
+static const struct { uint32_t pa; unsigned cores; const char *name; } osm_clusters[3] = {
+	{ 0x18321000u, 1, "L3" }, { 0x18323000u, 6, "little (cpu0-5)" }, { 0x18325800u, 2, "big (cpu6-7)" },
+};
+
+static uint32_t
+osm_row_khz(uint32_t data)
+{
+	return (data >> 30) ? 19200u * (data & 0xFFu) : 300000u;
+}
+
+static uint32_t
+osm_measured_mhz(vm_offset_t base, unsigned n)
+{
+	uint32_t c0 = gpu_rd(base, OSM_CYCLES(n)), c1;
+	uint64_t t0 = mach_absolute_time(), ns;
+	delay_for_interval(10, NSEC_PER_MSEC);
+	c1 = gpu_rd(base, OSM_CYCLES(n));
+	absolutetime_to_nanoseconds(mach_absolute_time() - t0, &ns);
+	return ns ? (uint32_t)((uint64_t)(c1 - c0) * 1000u / ns) : 0;
+}
+
+static void
+sweet_cpufreq(void)
+{
+	unsigned c, r, n;
+	for (c = 0; c < 3u; c++) {
+		vm_offset_t base = ml_io_map(osm_clusters[c].pa, 0x1000u);
+		uint32_t top = 0, top_khz = 0, ctrl, was, before;
+		char line[300];
+		int at = 0;
+		bool per_core;
+		if (!base) {
+			continue;
+		}
+		for (r = 0; r < 40u; r++) {
+			uint32_t khz = osm_row_khz(gpu_rd(base, OSM_FREQ_REG(r)));
+			if (r > 0 && khz <= top_khz) {
+				break;                                      /* the table ends by repeating its last row */
+			}
+			top = r;
+			top_khz = khz;
+			if (at < (int)sizeof(line) - 8) {
+				at += snprintf(line + at, sizeof(line) - (size_t)at, " %u", khz / 1000u);
+			}
+		}
+		ctrl = gpu_rd(base, OSM_CORE_DCVS_CTRL);
+		per_core = (ctrl & 1u) != 0;
+		was = gpu_rd(base, OSM_PERF_STATE(0));
+		before = osm_measured_mhz(base, 0);
+		printf("SWEET CPUFREQ: %s: table (MHz):%s; row %u now, measured %u MHz; per-core %d\n", osm_clusters[c].name,
+		    line, was, before, per_core);
+		for (n = 0; n < (per_core ? osm_clusters[c].cores : 1u); n++) {
+			gpu_wr(base, OSM_PERF_STATE(n), top);
+		}
+		__asm__ volatile("dsb sy" ::: "memory");
+		delay_for_interval(20, NSEC_PER_MSEC);
+		printf("SWEET CPUFREQ: %s: row %u (%u MHz) asked; measured %u MHz\n", osm_clusters[c].name, top, top_khz / 1000u,
+		    osm_measured_mhz(base, 0));
+	}
+}
+
+static void
+gpu_thread(void *arg, wait_result_t wr)
+{
+	(void)arg;
+	(void)wr;
+	/* The bring-up used to wait 45 s for the USB log capture to come up, so that its lines were
+	 * not lost -- and the window server, starting at 30-60 s, raced it (see kgsl_open). Now the
+	 * nodes are there first and an open waits for the GPU; boot-arg sweetgpu_delay=S still
+	 * delays the bring-up for a run that needs its lines over USB. */
+	{
+		uint32_t delay_s = 0;
