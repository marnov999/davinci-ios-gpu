+		CW(0x010u, 0x3u);                  /* RBBM_VBIF_CLIENT_QOS_CNTL (a615) */
+		CW(0x50Bu, 0xFFFFFFFFu);           /* RBBM_PERFCTR_GPU_BUSY_MASKED */
+		CW(0xE05u, 0xFFFFFFC0u); CW(0xE06u, 0x0001FFFFu); /* UCHE_WRITE_RANGE_MAX */
+		CW(0xE09u, 0xFFFFF000u); CW(0xE0Au, 0x0001FFFFu); /* UCHE_TRAP_BASE */
+		CW(0xE07u, 0xFFFFF000u); CW(0xE08u, 0x0001FFFFu); /* UCHE_WRITE_THRU_BASE */
+		CW(0xE0Bu, 0x00100000u); CW(0xE0Cu, 0x0u);        /* UCHE_GMEM_RANGE_MIN */
+		CW(0xE0Du, 0x001FFFFFu); CW(0xE0Eu, 0x0u);        /* UCHE_GMEM_RANGE_MAX (full 1MiB a618 GMEM) */
+		CW(0xE18u, 0x804u); CW(0xE17u, 0x4u);  /* UCHE_FILTER_CNTL, CACHE_WAYS */
+		__asm__ volatile("dsb osh" ::: "memory");
+		printf("SWEET GMU: [Ia] VBIF+UCHE ranges written\n"); gmub_flush();
