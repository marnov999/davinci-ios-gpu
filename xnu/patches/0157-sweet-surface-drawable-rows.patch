diff --git a/iokit/Kernel/arm/SweetSurface.cpp b/iokit/Kernel/arm/SweetSurface.cpp
index a538b4c..8e5d99a 100644
--- a/iokit/Kernel/arm/SweetSurface.cpp
+++ b/iokit/Kernel/arm/SweetSurface.cpp
@@ -666,17 +666,26 @@ sweet_surface_layout(SweetSurface *s, OSDictionary *props)
 	 * client-sized row (the first try) sheared images whose writers keep the row they asked for
 	 * (Notes' toolbar icons came out striped).
 	 */
+	/*
+	 * Which ones: the drawable is created without a name (CoreAnimation names it afterwards), as
+	 * BGRA, one plane, exactly width * 4 a row; every image writer seen keeping its own row names
+	 * its surface at creation (CoreUI, QuartzCore, CoreVideo). So: rounded when unnamed and so
