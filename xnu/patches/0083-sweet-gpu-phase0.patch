+
+/*
+ * The dev loop's file daemon (/usr/local/gltest/sweet_push, the launchd job com.sweet.push) must stay
+ * executable: once it was replaced by a copy without the execute bit, launchd could not start it
+ * again ("Missing executable"), and nothing could reach the phone. At every boot, once the root
+ * volume is there, it is made 0755 again. Only that one file, only its mode.
+ */
+extern vnode_t rootvnode;
+static void
+sweet_push_exec_bit(void *arg, wait_result_t wr)
+{
+	static const char path[] = "/usr/local/gltest/sweet_push";
+	unsigned tries;
+	(void)arg; (void)wr;
+	/* As soon as the root volume is there: launchd looks at the job's executable once, in its first
+	 * second, and a job found without one is not tried again ("Missing executable detected"). */
+	for (tries = 0; tries < 6000u; tries++) {               /* 10 minutes at most */
+		vnode_t vp = NULLVP;
+		vfs_context_t ctx;
+		if (rootvnode == NULLVP) {                          /* no lookups before the root volume is mounted */
+			delay_for_interval(100, NSEC_PER_MSEC);
+			continue;
+		}
+		ctx = vfs_context_kernel();
+		if (vnode_lookup(path, 0, &vp, ctx) == 0) {
+			struct vnode_attr va;
+			int e;
+			VATTR_INIT(&va);
+			VATTR_SET(&va, va_mode, 0755);
+			e = vnode_setattr(vp, &va, ctx);
+			vnode_put(vp);
+			printf("SWEET GPU: %s made 0755 (%d)\n", path, e);
+			break;
+		}
+		delay_for_interval(100, NSEC_PER_MSEC);
+	}
+	(void)thread_terminate(current_thread());
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+void
+sweet_gpu_init(void)
+{
+	int enabled = 0;
+	thread_t thread;
+	if (gpu_started) {
+		return;
+	}
+	gpu_started = true;
+	(void)PE_parse_boot_argn("sweetgpu", &enabled, sizeof(enabled));
+	if (!enabled) {
+		printf("SWEET GPU: disabled (pass sweetgpu=1 for Phase 0, =2 for +TZ probe)\n");
+		return;
+	}
+	gpu_level = enabled;
+	{
+		thread_t t2;
+		if (kernel_thread_start(sweet_push_exec_bit, NULL, &t2) == KERN_SUCCESS) {
+			thread_deallocate(t2);
+		}
+	}
+	g_gpu_grp = lck_grp_alloc_init("sweet_gpu", LCK_GRP_ATTR_NULL);
+	g_gpu_mtx = lck_mtx_alloc_init(g_gpu_grp, LCK_ATTR_NULL);
+	kern_return_t kr = kernel_thread_start(gpu_thread, NULL, &thread);
+	if (kr == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	} else {
+		printf("SWEET GPU: kernel_thread_start failed %d\n", kr);
+	}
+}
