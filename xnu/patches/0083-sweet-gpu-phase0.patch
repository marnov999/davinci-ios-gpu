+/* Both device nodes, before the bring-up starts: an open waits for it (kgsl_open). Nothing of
+ * the GPU is touched here. */
+static void
+gpu_nodes_register(void)
+{
+	g_kgsl_major = cdevsw_add(-1, &kgsl_cdevsw);
+	if (g_kgsl_major < 0) {
+		printf("SWEET KGSL: cdevsw_add failed\n");
+	} else {
+		devfs_make_node(makedev(g_kgsl_major, 0), DEVFS_CHAR, UID_ROOT, GID_WHEEL, 0666, "kgsl-3d0");
+	}
+	g_drm_major = cdevsw_add(-1, &drm_cdevsw);
+	if (g_drm_major < 0) {
+		printf("SWEET DRM: cdevsw_add failed\n");
+	} else {
+		/* Mesa's libdrm shim opens this node (drmOpenWithType("msm",...)); drmGetVersion
+		 * must then report name="msm". */
+		devfs_make_node(makedev(g_drm_major, 0), DEVFS_CHAR, UID_ROOT, GID_WHEEL, 0666, "dri/renderD128");
+	}
