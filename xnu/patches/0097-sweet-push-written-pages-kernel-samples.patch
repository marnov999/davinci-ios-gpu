+/*
+ * Only what a processor wrote, pushed out of the cache: XNU sets a page's "modified" bit at the
+ * first write after the bit was cleared (the clear makes every mapping of it read-only again),
+ * so the pages with it set are the ones whose lines may be in the cache. Each is cleared, then
+ * pushed out (a write between the two faults and sets the bit again). Pushing out the whole of
+ * every surface a submission named was 500 MB a second of cache maintenance in the window
+ * server; it draws almost everything with the GPU. Returns the bytes pushed out, or -1 when the
+ * memory is not pages the VM keeps bits for (the panel's): then the caller pushes out all of it.
+ */
+static ppnum_t *
+sweet_surface_pages(SweetSurface *s)
+{
+	ppnum_t *list = s->pages;
+	uint32_t count;
+	if (list != NULL || s->memory == NULL) {
+		return list;
+	}
+	count = (uint32_t)((s->memory->getLength() + PAGE_SIZE - 1) / PAGE_SIZE);
+	list = (ppnum_t *)IOMalloc(count * sizeof(list[0]));
+	if (list == NULL) {
+		return NULL;
+	}
+	for (uint32_t i = 0; i < count; i++) {
+		IOByteCount len = 0;
+		addr64_t pa = s->memory->getPhysicalSegment((IOByteCount)i * PAGE_SIZE, &len, kIOMemoryMapperNone);
+		list[i] = (ppnum_t)(pa >> PAGE_SHIFT);
+		if (pa == 0 || !pmap_valid_page(list[i])) {
+			list[i] = 0;
+		}
+	}
+	IOLockLock(sweet_surface_lock);
+	if (s->pages == NULL) {
+		s->pageCount = count;
+		s->pages = list;
+		list = NULL;
+	}
+	IOLockUnlock(sweet_surface_lock);
+	if (list != NULL) {
+		IOFree(list, count * sizeof(list[0]));
+	}
+	return s->pages;
+}
+
+static int64_t
+sweet_surface_push_written(SweetSurface *s)
+{
+	IOBufferMemoryDescriptor *bmd;
+	ppnum_t *list = sweet_surface_pages(s);
+	uintptr_t va;
+	int64_t pushed = 0;
+	if (list == NULL) {
+		return -1;
+	}
+	bmd = OSDynamicCast(IOBufferMemoryDescriptor, s->memory);
+	va = bmd != NULL ? (uintptr_t)bmd->getBytesNoCopy() : s->kernelAddress();
+	if (va == 0) {
+		return -1;
+	}
+	for (uint32_t i = 0; i < s->pageCount; i++) {
+		if (list[i] == 0) {
+			return -1;
+		}
+		if (!pmap_is_modified(list[i])) {
+			continue;
+		}
+		pmap_clear_modify(list[i]);
+		for (uintptr_t line = va + (uintptr_t)i * PAGE_SIZE, end = line + PAGE_SIZE; line < end; line += 64) {
+			__asm__ volatile ("dc civac, %0" : : "r" (line) : "memory");
+		}
+		pushed += PAGE_SIZE;
+	}
+	if (pushed != 0) {
+		__asm__ volatile ("dsb sy" ::: "memory");
+		OSBitOrAtomic(1u, &s->cpuWritten);
+	}
+	return pushed;
+}
+
+extern "C" int64_t
+sweet_surface_gpu_push_written(void *surface)
+{
+	SweetSurface *s = (SweetSurface *)surface;
+	return s != NULL && s->memory != NULL ? sweet_surface_push_written(s) : -1;
+}
