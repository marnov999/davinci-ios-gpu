+				rb[kk++] = (uint32_t)sh_pa; rb[kk++] = (uint32_t)(sh_pa >> 32);
+				rb[kk++] = cp_type4(0xA9BCu, 1u); rb[kk++] = 0x1u;  /* SP_CS_INSTRLEN (again) */
+				rb[kk++] = cp_type7(52u, 3u);                      /* CP_LOAD_STATE6_FRAG: preload SQE shader */
+				rb[kk++] = 0x00760000u;            /* ST6_SHADER|SS6_INDIRECT|SB6_CS|num_unit=1 */
+				rb[kk++] = (uint32_t)sh_pa & ~3u; rb[kk++] = (uint32_t)(sh_pa >> 32);
+				rb[kk++] = cp_type7(52u, 7u);                      /* CP_LOAD_STATE6_FRAG: const c0 = cres addr */
+				rb[kk++] = 0x00744000u;            /* ST6_CONSTANTS|SS6_DIRECT|SB6_CS|1 vec4 */
+				rb[kk++] = 0u; rb[kk++] = 0u;      /* ext_src_addr lo/hi (DIRECT: data inline) */
+				rb[kk++] = (uint32_t)cres_pa; rb[kk++] = (uint32_t)(cres_pa >> 32); /* c0.x/c0.y */
+				rb[kk++] = 0u; rb[kk++] = 0u;      /* c0.z/c0.w */
+				rb[kk++] = cp_type7(101u, 1u); rb[kk++] = 0x8u;    /* CP_SET_MARKER: RM6_COMPUTE */
+				rb[kk++] = cp_type4(0xB990u, 7u);                  /* HLSQ_CS_NDRANGE_0..6 (1x1x1) */
+				rb[kk++] = 0x1u; rb[kk++] = 0x1u; rb[kk++] = 0x0u; rb[kk++] = 0x1u;
+				rb[kk++] = 0x0u; rb[kk++] = 0x1u; rb[kk++] = 0x0u;
+				rb[kk++] = cp_type4(0xB999u, 3u);                  /* HLSQ_CS_KERNEL_GROUP_X/Y/Z */
+				rb[kk++] = 0x1u; rb[kk++] = 0x1u; rb[kk++] = 0x1u;
+				rb[kk++] = cp_type7(51u, 4u);                      /* CP_EXEC_CS: 1x1x1 workgroups */
+				rb[kk++] = 0x0u; rb[kk++] = 0x1u; rb[kk++] = 0x1u; rb[kk++] = 0x1u;
+				rb[kk++] = cp_type7(38u, 0u);                      /* CP_WAIT_FOR_IDLE */
+				rb[kk++] = cp_type7(0x46u, 4u);                    /* CACHE_FLUSH_TS -> TS2 slot */
+				rb[kk++] = 0x00000004u;
+				rb[kk++] = (uint32_t)(res_pa + 0x80u);
+				rb[kk++] = (uint32_t)((res_pa + 0x80u) >> 32);
+				rb[kk++] = 0x0000C0DEu;            /* compute completion seqno */
+			}
+			/* ---- Stage O: FIRST TRIANGLE. Direct-to-sysmem (no GMEM/binning/
+			 * resolve): render one red triangle into a 256x256 RGBA8888 linear buf
+			 * (CPU pre-cleared to dark blue). All state as PM4 type-4 in-ring, then
+			 * CP_DRAW_INDX_OFFSET(3 verts), flush CCU color -> sysmem. CPU reads
+			 * pixels back. CB0 identity => all GPU addrs == phys. ---- */
+			{
+				unsigned n;
+				rb[kk++] = cp_type7(38u, 0u);                 /* WFI before RB_CCU_CNTL */
+				rb[kk++] = cp_type4(0x8e07u, 1u);             /* RB_CCU_CNTL (a618 sysmem) */
+				rb[kk++] = 0x08000000u;
+				rb[kk++] = cp_type7(0x65u, 1u);               /* CP_SET_MARKER RM6_DIRECT_RENDER */
+				rb[kk++] = 0x00000001u;
+				rb[kk++] = cp_type7(0x1du, 1u); rb[kk++] = 0u;/* SKIP_IB2_ENABLE_GLOBAL=0 */
+				rb[kk++] = cp_type7(0x23u, 1u); rb[kk++] = 1u;/* SKIP_IB2_ENABLE_LOCAL=1 */
+				rb[kk++] = cp_type7(0x64u, 1u); rb[kk++] = 1u;/* SET_VISIBILITY_OVERRIDE=1 */
+				for (n = 0; n < (sizeof(draw_regs)/sizeof(draw_regs[0])); ++n) {
+					rb[kk++] = cp_type4(draw_regs[n][0], 1u);
+					rb[kk++] = draw_regs[n][1];
+				}
+				rb[kk++] = cp_type4(0x8825u, 2u);             /* RB_MRT_BASE[0] lo/hi */
+				rb[kk++] = (uint32_t)rt_pa; rb[kk++] = (uint32_t)(rt_pa >> 32);
+				rb[kk++] = cp_type4(0xa010u, 2u);             /* VFD_FETCH[0].BASE lo/hi */
+				rb[kk++] = (uint32_t)vbo_pa; rb[kk++] = (uint32_t)(vbo_pa >> 32);
+				rb[kk++] = cp_type4(0xa012u, 1u); rb[kk++] = 48u;   /* VFD_FETCH[0].SIZE */
+				rb[kk++] = cp_type4(0xa013u, 1u); rb[kk++] = 16u;   /* VFD_FETCH[0].STRIDE */
+				rb[kk++] = cp_type4(0xa81cu, 2u);             /* SP_VS_OBJ_START lo/hi */
+				rb[kk++] = (uint32_t)vs_pa; rb[kk++] = (uint32_t)(vs_pa >> 32);
+				rb[kk++] = cp_type4(0xa983u, 2u);             /* SP_FS_OBJ_START lo/hi */
+				rb[kk++] = (uint32_t)fs_pa; rb[kk++] = (uint32_t)(fs_pa >> 32);
+				rb[kk++] = cp_type7(0x32u, 3u);               /* CP_LOAD_STATE6_GEOM: VS */
+				rb[kk++] = (0u) | (0u << 14) | (2u << 16) | (8u << 18) | (1u << 22);
+				rb[kk++] = (uint32_t)vs_pa; rb[kk++] = (uint32_t)(vs_pa >> 32);
+				rb[kk++] = cp_type7(0x34u, 3u);               /* CP_LOAD_STATE6_FRAG: FS */
+				rb[kk++] = (0u) | (0u << 14) | (2u << 16) | (0xcu << 18) | (1u << 22);
+				rb[kk++] = (uint32_t)fs_pa; rb[kk++] = (uint32_t)(fs_pa >> 32);
+				rb[kk++] = cp_type7(0x38u, 3u);               /* CP_DRAW_INDX_OFFSET */
+				rb[kk++] = 0x00000084u;      /* TRILIST | AUTO_INDEX | IGNORE_VISIBILITY */
+				rb[kk++] = 1u;               /* num instances */
+				rb[kk++] = 3u;               /* num indices (verts) */
+				rb[kk++] = cp_type7(0x46u, 4u);               /* CP_EVENT_WRITE PC_CCU_FLUSH_COLOR_TS */
+				rb[kk++] = 0x0000001du;
+				rb[kk++] = (uint32_t)(res_pa + 0xC0u); rb[kk++] = (uint32_t)((res_pa + 0xC0u) >> 32);
+				rb[kk++] = 0x0000D3ADu;      /* draw completion seqno */
+				rb[kk++] = cp_type7(0x46u, 4u);               /* CACHE_FLUSH_TS (UCHE) */
+				rb[kk++] = 0x00000004u;
+				rb[kk++] = (uint32_t)(res_pa + 0xC8u); rb[kk++] = (uint32_t)((res_pa + 0xC8u) >> 32);
+				rb[kk++] = 0x0000D3AEu;
+				rb[kk++] = cp_type7(38u, 0u);                 /* WFI */
+			}
+			__asm__ volatile("dsb sy" ::: "memory");
+			printf("SWEET GMU: [L] sqe_pa=%#llx rb_pa=%#llx rp_pa=%#llx res_pa=%#llx wptr=%u "
+			    "me_init_hdr=%#x secmode_hdr=%#x memwr_hdr=%#x event_hdr=%#x\n",
+			    (unsigned long long)sqe_pa, (unsigned long long)rb_pa,
+			    (unsigned long long)rp_pa, (unsigned long long)res_pa, kk,
+			    rb[0], rb[12], rb[14], rb[19]);
+			gmub_flush();
+			gpu_wr(core, 0x804u << 2, (uint32_t)rp_pa);         /* CP_RB_RPTR_ADDR_LO */
+			gpu_wr(core, 0x805u << 2, (uint32_t)(rp_pa >> 32)); /* _HI */
+			gpu_wr(core, 0x802u << 2, 0x0000020Cu);            /* CP_RB_CNTL */
+			gpu_wr(core, 0x800u << 2, (uint32_t)rb_pa);         /* CP_RB_BASE_LO */
+			gpu_wr(core, 0x801u << 2, (uint32_t)(rb_pa >> 32)); /* _HI */
+			gpu_wr(core, 0x830u << 2, (uint32_t)sqe_pa);        /* CP_SQE_INSTR_BASE_LO */
+			gpu_wr(core, 0x831u << 2, (uint32_t)(sqe_pa >> 32));/* _HI */
+			gpu_wr(core, 0x808u << 2, 0x1u);                   /* CP_SQE_CNTL = start */
+			__asm__ volatile("dsb sy" ::: "memory");
+			gmub_udelay(5000);                                 /* CP boots the SQE */
+			printf("SWEET GMU: [L] CP started: sqe_cntl rbbm_status=%#x cp_rb_rptr=%#x\n",
+			    gpu_rd(core, 0x210u << 2), gpu_rd(core, 0x806u << 2));
+			gmub_flush();
+			gpu_wr(core, 0x807u << 2, kk);                     /* CP_RB_WPTR doorbell */
+			__asm__ volatile("dsb sy" ::: "memory");
+			for (p = 0; p < 100000u; ++p) {
+				rptr_sh = *(volatile uint32_t *)rp_nc;         /* NC read of shadow */
+				if (rptr_sh >= kk) {
+					break;
+				}
+				gmub_udelay(10);
+			}
+			rptr_reg = gpu_rd(core, 0x806u << 2);
+			printf("SWEET GMU: [L] SUBMIT: rptr_shadow=%u rptr_reg=%#x wptr=%u "
+			    "rbbm_status=%#x polls=%u -> %s\n", rptr_sh, rptr_reg, kk,
+			    gpu_rd(core, 0x210u << 2), p,
+			    (rptr_sh >= kk) ? "CP CONSUMED RING = FIRST SUBMISSION OK" : "TIMEOUT");
+			gmub_flush();
+			/* ---- Stage M readback: poll res+8 for the CACHE_FLUSH_TS seqno
+			 * (completion), then read back the two CP_MEM_WRITE magics. ---- */
+			{
+				uint32_t ts = 0, r0, r4, r8;
+				unsigned q;
+				for (q = 0; q < 100000u; ++q) {
+					ts = *(volatile uint32_t *)(res_nc + 8u);
+					if (ts == 0x12345678u) {
+						break;
+					}
+					gmub_udelay(10);
+				}
+				r0 = *(volatile uint32_t *)(res_nc + 0u);
+				r4 = *(volatile uint32_t *)(res_nc + 4u);
+				r8 = *(volatile uint32_t *)(res_nc + 8u);
+				printf("SWEET GMU: [M] res+0=%#x(exp cafebabe) res+4=%#x(exp 600df00d) "
+				    "TS res+8=%#x(exp 12345678) tspolls=%u -> %s\n", r0, r4, r8, q,
+				    (r0 == 0xCAFEBABEu && r4 == 0x600DF00Du && r8 == 0x12345678u) ?
+				    "GPU WROTE MEMORY + UCHE FLUSH/EVENT OK" : "PARTIAL/NONE");
+				gmub_flush();
+			}
+			/* ---- Stage N readback: poll res+0x80 for the compute CACHE_FLUSH_TS
+			 * seqno, then read the compute store at res+0x40. 0xDEADBEEF proves the
+			 * shader ALUs executed a global store. ---- */
+			{
+				uint32_t ts2 = 0, cres, rbbm;
+				unsigned q;
+				for (q = 0; q < 200000u; ++q) {
+					ts2 = *(volatile uint32_t *)(res_nc + 0x80u);
+					if (ts2 == 0x0000C0DEu) {
+						break;
+					}
+					gmub_udelay(10);
+				}
+				cres = *(volatile uint32_t *)(res_nc + 0x40u);
+				rbbm = gpu_rd(core, 0x210u << 2);
+				printf("SWEET GMU: [N] COMPUTE: res+0x40=%#x(exp deadbeef) TS res+0x80=%#x"
+				    "(exp c0de) tspolls=%u rbbm_status=%#x -> %s\n", cres, ts2, q, rbbm,
+				    (cres == 0xDEADBEEFu) ? "SHADER ALU EXECUTED = COMPUTE OK" :
+				    (ts2 == 0x0000C0DEu) ? "dispatch completed but store WRONG" :
+				    "TIMEOUT (no completion)");
+				gmub_flush();
+			}
+			/* ---- Stage O readback: poll res+0xC0 for the PC_CCU_FLUSH_COLOR_TS
+			 * seqno, then sample the RT. center (128,128)=inside tri -> red
+			 * 0xff0000ff; corner (10,10)=bg -> 0xff400000. Also count red pixels. ---- */
+			{
+				uint32_t ts3 = 0, cen, cor, rbbm;
+				unsigned q, x, y, red = 0;
+				for (q = 0; q < 300000u; ++q) {
+					ts3 = *(volatile uint32_t *)(res_nc + 0xC0u);
+					if (ts3 == 0x0000D3ADu) {
+						break;
+					}
+					gmub_udelay(10);
+				}
+				cen = *(volatile uint32_t *)(rt_nc + 128u * 1024u + 128u * 4u);
+				cor = *(volatile uint32_t *)(rt_nc + 10u * 1024u + 10u * 4u);
+				for (y = 0; y < 256u; y += 8u) {        /* sparse scan for red frags */
+					for (x = 0; x < 256u; x += 8u) {
+						if (*(volatile uint32_t *)(rt_nc + y * 1024u + x * 4u)
+						    == 0xff0000ffu) {
+							red++;
+						}
+					}
+				}
+				rbbm = gpu_rd(core, 0x210u << 2);
+				printf("SWEET GMU: [O] TRIANGLE: center=%#x(exp ff0000ff) corner=%#x"
+				    "(exp ff400000) redfrags=%u TS=%#x tspolls=%u rbbm=%#x -> %s\n",
+				    cen, cor, red, ts3, q, rbbm,
+				    (cen == 0xff0000ffu && cor == 0xff400000u && red > 10u) ?
+				    "TRIANGLE RASTERIZED = FIRST DRAW OK" :
+				    (red > 0u) ? "some red - partial/misplaced" :
+				    (ts3 == 0x0000D3ADu) ? "draw completed but NO red (raster/shader issue)" :
+				    "TIMEOUT (no completion)");
+				gmub_flush();
+			}
+			/* ---- Stage Q: flip the GPU SMMU to stage-1 page tables and prove GPU
+			 * virtual addressing (runs AFTER the L-P ring is consumed; appends its
+			 * own CP_MEM_WRITE-to-a-VA + re-doorbells the same ring). ---- */
+			kk = gpu_stage_q(smmu, core, rb, kk, res_pa, res_nc);
+			/* ---- Stage S: exercise the KGSL backend (gpumem alloc + IB submit)
+			 * on the live stage-1 pagetable Stage Q left up; appends after Q's
+			 * packets (kk updated) so it doesn't clobber them / rewind WPTR. ---- */
+			kk = gpu_stage_s(core, rb, kk, res_pa, res_nc);
+			/* ---- Publish the live ring + stage-1 pagetable to the KGSL UAPI so
+			 * the /dev/kgsl-3d0 GPU_COMMAND ioctl and the in-kernel self-test can
+			 * submit on this same ring (kk is the post-Stage-S write index). ---- */
+			g_core = core;
+			g_rb = rb;
+			g_wptr = kk % KGSL_RING_DWORDS;
+			g_res_pa = res_pa;
+			g_res_nc = res_nc;
+			*(volatile uint32_t *)(res_nc + 0xF0u) = 0;      /* GPU_FENCE_OFF: no submission done yet */
+			__asm__ volatile("dsb sy" ::: "memory");
+			g_kgsl_ready = 1;
+		}
+	}
+
+	/* Confirm the ARC vote indices from cmd-db (read-only; after the GX test so
+	 * a fault here can't derail BOOT_SLUMBER). Tells us the exact GX/MX idx. */
+	gmub_cmddb_report();
+	return 0;
+}
