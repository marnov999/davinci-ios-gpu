+/* ---- the front camera's pop-up (boot-arg sweetpopup=1) ---------------------------------------------- */
+
+/*
+ * A TI DRV8846 stepper driver (davinci dtbo fragment@87, Xiaomi drivers/misc/drv8846.c): TLMM 55 direction
+ * (0 = up), 91/66 MODE0/MODE1 (step mode 2: 0/1), 88 nSLEEP, 90 power enable, 43 nFAULT; its STEP input is
+ * PM6150L LPG channel 2 (pwms = <&pm6150l_pwm 1 ...>: SID 5, 0xb200) out on PM6150L GPIO 10 as func1.
+ * Open loop as Xiaomi's kernel driver: ramp up 50 ms at 625 us a step, 720 ms at 52.083 us (+5 ms down),
+ * ramp down 50 ms. The LPG makes 640 us and 53.33 us (19.2 MHz, 9 bits, prediv 3 exp 3 / prediv 1 exp 1),
+ * both 2.4 % slower, so every phase is 2.4 % longer: the same number of steps.
+ */
+#define SID_PM6150L_B           5
+#define POPUP_LPG               0xb2u           /* LPG2 */
+#define POPUP_PGPIO             10
+#define POPUP_DIR               55
+#define POPUP_MODE0             91
+#define POPUP_MODE1             66
+#define POPUP_SLEEP             88
+#define POPUP_PWREN             90
+#define POPUP_FAULT             43
+#define LPG_SUBTYPE             0x05
+#define LPG_PWM_SIZE_CLK        0x41
+#define LPG_PWM_PREDIV_CLK      0x42
+#define LPG_PWM_TYPE_CONFIG     0x43
+#define LPG_PWM_VALUE_LSB       0x44
+#define LPG_PWM_VALUE_MSB       0x45
+#define LPG_ENABLE_CONTROL      0x46
+#define LPG_PWM_SYNC            0x47
+#define LPG_PREDIV_SLOW         0x23            /* prediv 3 (index 1), exponent 3: 640 us */
+#define LPG_PREDIV_FAST         0x01            /* prediv 1, exponent 1: 53.33 us */
+
+static bool popup_enabled, popup_is_up, popup_pins_set;
+
+/* One byte of one of the two peripherals the motor needs (PM6150L GPIO 10, LPG 2), by our own channel. */
+static bool
+popup_spmi_put(unsigned sid, uint16_t address, uint8_t value)
+{
+	unsigned owner = 7, apid;
+	bool ok = false;
+	uint8_t back = 0;
+
+	if (!((sid == SID_PM6150L && (address >> 8) == PGPIO_PERIPH(POPUP_PGPIO)) ||
+	    (sid == SID_PM6150L_B && (address >> 8) == POPUP_LPG))) {
+		give_up("a PMIC peripheral the pop-up does not use");
+		return false;
+	}
+	if (!spmi_up()) {
+		return false;
+	}
+	lck_mtx_lock(&spmi_lock);
+	apid = spmi_apid(sid, address >> 8, &owner);
+	if (apid != 0xffff && owner == 0) {
+		vm_offset_t ch = cam_map(SPMI_CHNLS_PHYS + 0x10000UL * apid, 0x1000);
+
+		if (ch != 0) {
+			wr(ch + 0x10, value);
+			__asm__ volatile ("dsb osh" ::: "memory");
+			wr(ch + 0x00, (0u << 27) | ((uint32_t)(address & 0xff) << 4));        /* EXT_WRITEL, 1 byte */
+			for (unsigned i = 0; i < 1000; i++) {
+				uint32_t status = rd(ch + 0x08);
+
+				if (status & 1) {
+					ok = (status & 0x0e) == 0;
+					break;
+				}
+				spin_us(1);
+			}
+		}
+	}
+	lck_mtx_unlock(&spmi_lock);
+	if (apid == 0xffff || owner != 0) {
+		say("pop-up: SID %u %#x: APID %#x owner EE %u: not ours to write\n", sid, address, apid, owner);
+		give_up("a pop-up PMIC peripheral owned by another EE");
+		return false;
+	}
+	/* LPG_PWM_SYNC is a strobe: it does not read back */
+	if (!ok || (!(sid == SID_PM6150L_B && (address & 0xff) == LPG_PWM_SYNC) &&
+	    (!spmi_read(sid, address, &back) || back != value))) {
+		say("pop-up: SID %u %#x <- %#x reads %#x\n", sid, address, value, back);
+		give_up("a pop-up PMIC write that did not take");
+		return false;
+	}
+	return true;
+}
+
+#define LPG(reg)                ((uint16_t)(POPUP_LPG << 8 | (reg)))
+
+static void
+popup_out(unsigned n, bool high)
+{
+	wr(GPIO_IO(n), high ? 2 : 0);
+	wr(GPIO_CFG(n), CFG_OUTPUT | CFG_PULL_UP | CFG_DRIVE_MA(2));   /* motor_gpio_default: pull-up, 2 mA */
+}
+
+/* busy waits: the way down also runs from sweet_camera_quiesce() */
+static void
+popup_wait_ms(uint32_t ms)
+{
+	for (uint32_t i = 0; i < ms; i++) {
+		spin_us(1000);
+	}
+}
+
+static bool
+popup_pins(void)
+{
+	uint8_t subtype = 0;
+
+	if (popup_pins_set) {
+		return true;
+	}
+	if (!spmi_read(SID_PM6150L_B, LPG(LPG_SUBTYPE), &subtype)) {
+		give_up("the pop-up's LPG cannot be read");
+		return false;
+	}
+	/* PM6150L GPIO 10 (pwm_out_gpio10_default): func1 = the LPG, VIN1, no pull, push-pull, strength 3 */
+	static const uint8_t regs[6] = { 0x41, 0x42, 0x40, 0x44, 0x45, 0x46 };
+	static const uint8_t vals[6] = { 0x01, 0x05, 0x01, 0x02, 0x03, 0x80 };
+	for (int i = 0; i < 6; i++) {
+		if (!popup_spmi_put(SID_PM6150L, (uint16_t)(PGPIO_PERIPH(POPUP_PGPIO) << 8 | regs[i]), vals[i])) {
+			return false;
+		}
+	}
+	/* LPG 2: 9-bit PWM of the 19.2 MHz clock (the size bit moves with the subtype), 50 % duty, glitch removal */
+	uint8_t size_clk = (uint8_t)(((subtype == 0x0b) ? (1u << 2) : (1u << 4)) | 3u);
+	if (!popup_spmi_put(SID_PM6150L_B, LPG(LPG_ENABLE_CONTROL), 0) ||
+	    !popup_spmi_put(SID_PM6150L_B, LPG(LPG_PWM_TYPE_CONFIG), 0x20) ||
+	    !popup_spmi_put(SID_PM6150L_B, LPG(LPG_PWM_SIZE_CLK), size_clk) ||
+	    !popup_spmi_put(SID_PM6150L_B, LPG(LPG_PWM_PREDIV_CLK), LPG_PREDIV_SLOW) ||
+	    !popup_spmi_put(SID_PM6150L_B, LPG(LPG_PWM_VALUE_LSB), 0x00) ||
+	    !popup_spmi_put(SID_PM6150L_B, LPG(LPG_PWM_VALUE_MSB), 0x01)) {
+		return false;
+	}
+	wr(GPIO_CFG(POPUP_FAULT), CFG_PULL_UP | CFG_DRIVE_MA(2));      /* input */
+	popup_out(POPUP_SLEEP, false);
+	popup_out(POPUP_MODE0, false);                                  /* step mode 2 */
+	popup_out(POPUP_MODE1, true);
+	popup_out(POPUP_DIR, false);
+	popup_out(POPUP_PWREN, true);
+	say("pop-up: LPG2 subtype %#x, motor pins set, driver powered\n", subtype);
+	popup_pins_set = true;
+	return !broken;
+}
+
+static bool
+popup_move(bool up)
+{
+	if (!popup_enabled || popup_is_up == up) {
+		return true;
+	}
+	if (!popup_pins()) {
+		return false;
+	}
+	popup_out(POPUP_DIR, !up);
+	popup_out(POPUP_SLEEP, true);
+	bool ok = popup_spmi_put(SID_PM6150L_B, LPG(LPG_PWM_PREDIV_CLK), LPG_PREDIV_SLOW) &&
+	    popup_spmi_put(SID_PM6150L_B, LPG(LPG_PWM_SYNC), 1) &&
+	    popup_spmi_put(SID_PM6150L_B, LPG(LPG_ENABLE_CONTROL), 0x84);        /* out on, source PWM value */
+	if (ok) {
+		popup_wait_ms(51);
+		ok = popup_spmi_put(SID_PM6150L_B, LPG(LPG_PWM_PREDIV_CLK), LPG_PREDIV_FAST) &&
+		    popup_spmi_put(SID_PM6150L_B, LPG(LPG_PWM_SYNC), 1);
+		popup_wait_ms(up ? 737 : 742);
+		ok = popup_spmi_put(SID_PM6150L_B, LPG(LPG_PWM_PREDIV_CLK), LPG_PREDIV_SLOW) &&
+		    popup_spmi_put(SID_PM6150L_B, LPG(LPG_PWM_SYNC), 1) && ok;
+		popup_wait_ms(51);
+	}
+	bool fault = (rd(GPIO_IO(POPUP_FAULT)) & 1) == 0;
+	/* always stop, whatever failed on the way */
+	(void)popup_spmi_put(SID_PM6150L_B, LPG(LPG_ENABLE_CONTROL), 0);
+	popup_out(POPUP_SLEEP, false);
+	popup_is_up = up;
+	say("pop-up %s%s%s\n", up ? "raised" : "lowered", ok ? "" : " (a PMIC write failed on the way)",
+	    fault ? "; the DRV8846 reports a FAULT" : "");
+	return ok;
+}
