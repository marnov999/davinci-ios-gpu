+		if (!gpu_done) {
 			static uint32_t told;
 			if (told++ < 8) {
 				IOLog("SWEET FB: present: the GPU is not done with surface %u after %u ms; shown as it is\n",
@@ -809,6 +904,12 @@ AppleCLCD::present(const uint8_t *rec)
