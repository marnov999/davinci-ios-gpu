+/*
+ * kern.sweet_rtc: the PMIC's RTC counter now (PM6150 RTC_RW RDATA 0x6048..0x604b, read twice around
+ * byte 0 for a carry), -1 if it cannot be read. It free-runs (16773 s at 2026-10-26 07:28 -- not UTC):
+ * MIUI keeps the time of day as an offset to it, and so does iOS here, in userland (sweettime: time =
+ * counter + the offset saved when the time was last set).
+ */
+extern int sweet_spmi_init(void);
+extern int sweet_spmi_read(unsigned sid, unsigned addr, uint8_t *out);
+
+static int
+sysctl_sweet_rtc SYSCTL_HANDLER_ARGS
+{
+#pragma unused(oidp, arg1, arg2)
+	int64_t v = -1;
+	uint8_t b[4], again = 0;
+	if (sweet_spmi_init() == 0) {
+		for (int tries = 0; tries < 3 && v < 0; tries++) {
+			bool ok = true;
+			for (unsigned i = 0; i < 4; i++) {
+				ok = ok && sweet_spmi_read(0, 0x6048 + i, &b[i]) == 0;
+			}
+			if (ok && sweet_spmi_read(0, 0x6048, &again) == 0 && again == b[0]) {
+				v = (int64_t)((uint32_t)b[0] | (uint32_t)b[1] << 8 | (uint32_t)b[2] << 16 | (uint32_t)b[3] << 24);
+			}
+		}
+	}
+	return SYSCTL_OUT(req, &v, sizeof(v));
+}
+SYSCTL_PROC(_kern, OID_AUTO, sweet_rtc, CTLTYPE_QUAD | CTLFLAG_RD | CTLFLAG_LOCKED, 0, 0,
+    sysctl_sweet_rtc, "Q", "PMIC RTC counter, seconds (free-running)");
+
 #endif /* ARM64_BOARD_CONFIG_SWEET */
