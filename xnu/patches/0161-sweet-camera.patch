+/*
+ * CSIPHY v1.2 ("qcom,csiphy-v1.2", cam_csiphy_1_2_hwreg.h) -- NOT HackiOS's v1.2.1 values. D-PHY only
+ * (all four davinci sensors are D-PHY). Lane positions: data lane 0, the clock lane, data lanes 1..3.
+ * Each row is csiphy_2ph_v1_2_reg[] for that position; SETTLE marks the settle count's register.
+ */
+#define SETTLE                  0xffffu
+static const struct { uint16_t reg; uint8_t value; } csiphy_2ph[5][22] = {
+	{ {0x030,0x00},{0x904,0x00},{0x910,0x00},{0x900,0x0f},{0x908,0x06},{0x904,0x07},{0x02c,0x01},{0x034,0x0f},{0x010,0x50},
+	  {0x01c,0x0a},{0x014,0x60},{0x028,0x00},{0x03c,0xb8},{0x000,0x91},{0x004,0x0c},{0x020,0x00},{0x008,0x00 /*SETTLE*/},
+	  {0x010,0x52},{0x038,0xfe},{0x05c,0xc0},{0x060,0x0d},{0x800,0x02} },
+	{ {0x730,0x00},{0xc84,0x00},{0xc90,0x00},{0xc80,0x0f},{0xc88,0x06},{0xc84,0x07},{0x72c,0x01},{0x734,0x0f},{0x710,0x50},
+	  {0x71c,0x0a},{0x714,0x60},{0x728,0x04},{0x73c,0xb8},{0x700,0x80},{0x704,0x0c},{0x720,0x00},{0x708,0x00 /*SETTLE*/},
+	  {0x70c,0xff},{0x710,0x52},{0x738,0x1f},{0x800,0x02} },
+	{ {0x230,0x00},{0xa04,0x00},{0xa10,0x00},{0xa00,0x0f},{0xa08,0x06},{0xa04,0x07},{0x22c,0x01},{0x234,0x0f},{0x210,0x50},
+	  {0x21c,0x0a},{0x214,0x60},{0x228,0x00},{0x23c,0xb8},{0x200,0x91},{0x204,0x0c},{0x220,0x00},{0x208,0x00 /*SETTLE*/},
+	  {0x210,0x52},{0x238,0xfe},{0x25c,0xc0},{0x260,0x0d},{0x800,0x02} },
+	{ {0x430,0x00},{0xb04,0x00},{0xb10,0x00},{0xb00,0x0f},{0xb08,0x06},{0xb04,0x07},{0x42c,0x01},{0x434,0x0f},{0x410,0x50},
+	  {0x41c,0x0a},{0x414,0x60},{0x428,0x00},{0x43c,0xb8},{0x400,0x91},{0x404,0x0c},{0x420,0x00},{0x408,0x00 /*SETTLE*/},
+	  {0x410,0x52},{0x438,0xfe},{0x45c,0xc0},{0x460,0x0d},{0x800,0x02} },
+	{ {0x630,0x00},{0xc04,0x00},{0xc10,0x00},{0xc00,0x0f},{0xc08,0x06},{0xc04,0x07},{0x62c,0x01},{0x634,0x0f},{0x610,0x50},
+	  {0x61c,0x0a},{0x614,0x60},{0x628,0x00},{0x63c,0xb8},{0x600,0x91},{0x604,0x0c},{0x620,0x00},{0x608,0x00 /*SETTLE*/},
+	  {0x610,0x52},{0x638,0xfe},{0x65c,0xc0},{0x660,0x0d},{0x800,0x02} },
+};
+#define SETTLE_INDEX            16
+static const uint8_t csiphy_2ph_count[5] = { 22, 21, 22, 22, 22 };     /* (lane 0's base is 0x000: no terminator) */
+
+static void
+csiphy_reset(void)
+{
+	/* csiphy_reset_reg_1_2: 0x814 = 0 (5 ms), 0x818 = 0, 0x81c = 0, 0x800 = 1 (1 ms), 0x800 = 0 */
+	wr(csiphy + 0x814, 0x00);
+	spin_us(5000);
+	wr(csiphy + 0x818, 0x00);
+	wr(csiphy + 0x81c, 0x00);
+	wr(csiphy + 0x800, 0x01);
+	spin_us(1000);
+	wr(csiphy + 0x800, 0x00);
+}
+
+/*
+ * cam_csiphy_config_dev() for D-PHY: Android's lane mask (bit 0 data lane 0, bit 1 the clock lane,
+ * bits 2..4 data lanes 1..3) from the module's lane assignment; lane_enable at 0x814 (data lane n at
+ * bit 2n, the clock lane 0x80: 4 lanes = 0xd5); the common registers; every enabled position's row.
+ */
+static bool
+csiphy_up(unsigned lanes, uint32_t lane_assign, unsigned settle)
+{
+	static const uint8_t irq_masks[11] = { 0xff, 0xff, 0xfb, 0xff, 0x7f, 0xff, 0xff, 0xef, 0xff, 0xff, 0xff };
+	uint32_t lane_enable = 0x80, positions = 1u << 1;       /* the clock lane always */
+
+	for (unsigned l = 0; l < lanes; l++, lane_assign >>= 4) {
+		unsigned n = lane_assign & 0xf;
+
+		if (n > 3) {
+			give_up("a lane assignment not known here");
+			return false;
+		}
+		lane_enable |= 1u << (2 * n);
+		positions |= n == 0 ? 1u : 1u << (n + 1);
+	}
+	csiphy_reset();
+	csiphy_running = true;
+	/* csiphy_common_reg_1_2 */
+	if (!blk_put(csiphy, "CSIPHY", 0x814, lane_enable, true) || !blk_put(csiphy, "CSIPHY", 0x818, 0x01, true) ||
+	    !blk_put(csiphy, "CSIPHY", 0x81c, 0x52, true)) {
+		return false;
+	}
+	wr(csiphy + 0x800, 0x03);
+	spin_us(1000);
+	wr(csiphy + 0x800, 0x02);
+	for (unsigned p = 0; p < 5; p++) {
+		if (!(positions & (1u << p))) {
+			continue;
+		}
+		for (unsigned i = 0; i < csiphy_2ph_count[p]; i++) {
+			uint8_t v = i == SETTLE_INDEX ? (uint8_t)(settle & 0xff) : csiphy_2ph[p][i].value;
+
+			if (!blk_put(csiphy, "CSIPHY", csiphy_2ph[p][i].reg, v, csiphy_2ph[p][i].reg != 0x800)) {
+				return false;
+			}
+		}
+	}
+	for (unsigned i = 0; i < 11; i++) {
+		wr(csiphy + 0x82c + 4 * i, irq_masks[i]);
+		wr(csiphy + 0x858 + 4 * i, 0xff);
+	}
+	wr(csiphy + 0x828, 0x1);
+	wr(csiphy + 0x828, 0x0);
+	say("CSIPHY %u: %u D-PHY lane(s), lane enable %#x, settle %u\n", hw->csiphy, lanes, lane_enable, settle);
+	return true;
+}
+
+static void
+show_csiphy(const char *when)
+{
+	char text[160];
+	int at = snprintf(text, sizeof(text), "CSIPHY %u %s, irq status:", hw->csiphy, when);
+
+	for (unsigned i = 0; i < 11 && at < (int)sizeof(text) - 6; i++) {
+		at += snprintf(text + at, sizeof(text) - (size_t)at, " %02x", rd(csiphy + 0x8b0 + 4 * i) & 0xff);
+	}
+	say("%s\n", text);
+}
+
+static void
+csiphy_down(void)
+{
+	if (csiphy_running) {
+		csiphy_reset();
+		csiphy_running = false;
+	}
+}
+
+/* ---- the Titan blocks up and down ----------------------------------------------------------------- */
+
+static bool
+titan_up(void)
+{
+	if (csid == 0) {
+		csid = cam_map(CSID_PHYS, 0x1000);
+		ife = cam_map(IFE_PHYS, 0x4000);
+	}
+	if (csiphys[hw->csiphy] == 0) {
+		csiphys[hw->csiphy] = cam_map(CSIPHY_PHYS(hw->csiphy), 0x2000);
+	}
+	csiphy = csiphys[hw->csiphy];
+	if (!arcs(true) || !gdsc_on()) {
+		return false;
+	}
+	return pll0_up() && clocks_up();
+}
+
+static void
+titan_down(void)
+{
+	paths_down();
+	smmu_down();
+	clocks_down();
+	pll0_down();
+	(void)arcs(false);
+}
+
+/* ---- frames' memory ---------------------------------------------------------------------------------- */
+
+static bool
+frames_alloc(uint64_t bytes)
+{
+	frames_bytes = round_page(bytes);
+	if (kmem_alloc(kernel_map, &frames, frames_bytes, KMA_KOBJECT | KMA_ZERO | KMA_DATA, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		say("no memory for frames (%llu KB)\n", frames_bytes >> 10);
+		frames = 0;
+		return false;
+	}
+	for (vm_offset_t l = frames; l < frames + frames_bytes; l += 64) {
+		__asm__ volatile ("dc civac, %0" : : "r" (l));
+	}
+	__asm__ volatile ("dsb sy");
+	return true;
+}
+
+static void
+frames_free(void)
+{
+	if (frames != 0) {
+		kmem_free(kernel_map, frames, frames_bytes);
+		frames = 0;
+		frames_bytes = 0;
+	}
+}
+
+static void
+first_bytes(vm_offset_t at, const char *what)
+{
+	const uint8_t *p = (const uint8_t *)at;
+
+	for (vm_offset_t l = at & ~63ul; l < at + 256; l += 64) {
+		__asm__ volatile ("dc civac, %0" : : "r" (l));
+	}
+	__asm__ volatile ("dsb sy");
+	say("%s: first bytes %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x\n", what, p[0], p[1], p[2], p[3], p[4], p[5], p[6],
+	    p[7], p[8], p[9]);
+}
+
+/* sweetcam=3: CSID-lite's colour bars -> RDI 0 -> IFE-lite 0 -> SMMU -> memory; no sensor. */
+static void
+capture_tpg(void)
+{
+	const uint32_t width = 1600, height = 1200, stride = RAW10_STRIDE(width);
+	bool done = false;
+
+	if (!frames_alloc((uint64_t)stride * height) || !titan_up() || !smmu_up() || !csid_reset() ||
+	    !csid_config(-1, 4, 0x3210, TPG_VC, width, height) || !ife_config(FRAME_ADDRESSES, 0)) {
+		titan_down();
+		frames_free();
+		return;
+	}
+	show_paths("configured");
+	if (tpg_start()) {
+		for (unsigned ms = 0; ms < 2000 && !done; ms += 50) {
+			wait_ms(50);
+			done = (rd(ife + BUS_IRQ_STATUS1) & WM0_DONE) != 0;
+		}
+		say("test pattern: %s\n", done ? "write master 0 finished a frame" : "NO FRAME in 2 s");
+	}
+	show_paths("after");
+	smmu_faults();
+	titan_down();
+	first_bytes(frames, "test pattern frame");
+	frames_free();
+}
+
+/* ---- exposure ------------------------------------------------------------------------------------------ */
+
+#define EXPOSURE_MARGIN         40
+#define FRAME_LINES_MAX         0xfff0
+
+static const struct ctab_mode *ios_mode;
+
+static bool
+exposure_write(uint32_t lines, uint32_t gain, uint32_t frame_lines)
+{
+	bool ok;
+
+	switch (hw->regs) {
+	case REGS_SMIA:
+		ok = sensor_table("holdon") && sensor_write(0x0340, (uint16_t)frame_lines, true) && sensor_write(0x0202, (uint16_t)lines, true) &&
+		    sensor_write(0x0204, (uint16_t)gain, true) && sensor_table("holdoff");
+		break;
+	case REGS_SONY: {
+		/* linear gain (256 = 1x) to Sony's code: 1024 - 1024 / gain */
+		uint32_t code = 1024 - (1024u * hw->gain_unity) / (gain ? gain : hw->gain_unity);
+
+		ok = sensor_table("holdon") && sensor_write(0x0340, (uint16_t)(frame_lines >> 8), false) &&
+		    sensor_write(0x0341, (uint16_t)(frame_lines & 0xff), false) && sensor_write(0x0202, (uint16_t)(lines >> 8), false) &&
+		    sensor_write(0x0203, (uint16_t)(lines & 0xff), false) && sensor_write(0x0204, (uint16_t)(code >> 8 & 3), false) &&
+		    sensor_write(0x0205, (uint16_t)(code & 0xff), false) && sensor_table("holdoff");
+		break;
+	}
+	default: {
+		uint32_t e = lines << 4;        /* OV8856: in 1/16 lines */
+
+		ok = sensor_table("holdon") && sensor_write(0x380e, (uint16_t)(frame_lines >> 8), false) &&
+		    sensor_write(0x380f, (uint16_t)(frame_lines & 0xff), false) && sensor_write(0x3500, (uint16_t)(e >> 16 & 0xf), false) &&
+		    sensor_write(0x3501, (uint16_t)(e >> 8 & 0xff), false) && sensor_write(0x3502, (uint16_t)(e & 0xff), false) &&
+		    sensor_write(0x3508, (uint16_t)(gain >> 8 & 0x1f), false) && sensor_write(0x3509, (uint16_t)(gain & 0xff), false) &&
+		    sensor_table("holdoff");
+		break;
+	}
+	}
+	if (!ok) {
+		give_up("a sensor write nobody acknowledged");
+	}
+	return ok;
+}
+
+static void
+exposure_limits(uint32_t *lines, uint32_t *gain, uint32_t *frame_lines)
+{
+	uint32_t shortest = ios_mode->frame_length;
+
+	*gain = *gain < hw->gain_unity ? hw->gain_unity : *gain > hw->gain_max ? hw->gain_max : *gain;
+	*lines = *lines < 4 ? 4 : *lines > FRAME_LINES_MAX - EXPOSURE_MARGIN ? FRAME_LINES_MAX - EXPOSURE_MARGIN : *lines;
+	if (*frame_lines == 0) {
+		*frame_lines = *lines + EXPOSURE_MARGIN > shortest ? *lines + EXPOSURE_MARGIN : shortest;
+	}
+	*frame_lines = *frame_lines < shortest ? shortest : *frame_lines > FRAME_LINES_MAX ? FRAME_LINES_MAX : *frame_lines;
+	if (*lines > *frame_lines - EXPOSURE_MARGIN) {
+		*lines = *frame_lines - EXPOSURE_MARGIN;
+	}
+}
+
+/* ---- sensor bring-up shared by sweetcam=4 and =5 --------------------------------------------------- */
+
+static uint32_t ios_mode_n;
+
+/* The mode: sweetcam_mode, else the 4:3-ish one with the fewest pixels at >= 24 fps (the ultra's 2104x1560@60). */
+static bool
+pick_mode(uint32_t asked)
+{
+	if (asked >= ctab->modes) {
+		uint64_t best = ~0ull;
+
+		asked = 0;
+		for (uint32_t m = 0; m < ctab->modes; m++) {
+			const struct ctab_mode *o = &ctab_modes[m];
+			uint64_t pixels = (uint64_t)o->width * o->height;
+
+			if (o->fps_milli >= 24000 && o->width * 3 <= o->height * 4 + o->width / 8 && pixels < best) {
+				best = pixels;
+				asked = m;
+			}
+		}
+	}
+	ios_mode_n = asked;
+	ios_mode = &ctab_modes[asked];
+	if (ios_mode->lanes < 1 || ios_mode->lanes > 4 || ios_mode->cphy != 0 || ios_mode->data_type != RAW10_DT ||
+	    ios_mode->width % 4 != 0 || ios_mode->fps_milli == 0 || ios_mode->frame_length == 0) {
+		say("mode %u is not what this is written for\n", asked);
+		return false;
+	}
+	return true;
+}
+
+static unsigned
+settle_count(void)
+{
+	uint32_t settle = 0;
+
+	if (!PE_parse_boot_argn("sweetcam_settle", &settle, sizeof(settle)) || settle == 0) {
+		settle = ios_mode->settle;      /* the module's (IMX586/OV8856 14, S5K3L6/S5K3T2 19): see the plan's risks */
+	}
+	return settle;
+}
+
+static bool
+sensor_stream_setup(uint64_t first_address)
+{
+	char res[8];
+
+	snprintf(res, sizeof(res), "res%u", ios_mode_n);
+	return power_up() && read_chip_id() && sensor_table("init") && sensor_table(res) && titan_up() && smmu_up() && csid_reset() &&
+	       csid_config((int)hw->csiphy, ios_mode->lanes, ctab->lane_assign & ((1u << (4 * ios_mode->lanes)) - 1), 0, ios_mode->width,
+	    ios_mode->height) && ife_config(first_address, 0) && csiphy_up(ios_mode->lanes, ctab->lane_assign, settle_count());
+}
+
+/* sweetcam=4: N frames of the sensor into two places, then everything down. */
+static void
+capture_sensor(void)
+{
+	uint32_t mode = ~0u, wanted = 8, stride, frame;
+	unsigned done = 0;
+
+	(void)PE_parse_boot_argn("sweetcam_mode", &mode, sizeof(mode));
+	(void)PE_parse_boot_argn("sweetcam_frames", &wanted, sizeof(wanted));
+	wanted = wanted < 1 ? 1 : wanted > 300 ? 300 : wanted;
+	if (!ctab_load(hw->tab) || !pick_mode(mode)) {
+		return;
+	}
+	stride = RAW10_STRIDE(ios_mode->width);
+	frame = (uint32_t)round_page((uint64_t)stride * ios_mode->height + (256u << 10));
+	if (!frames_alloc(2ull * frame)) {
+		return;
+	}
+	if (!sensor_stream_setup(FRAME_ADDRESSES)) {
+		csiphy_down();
+		titan_down();
+		frames_free();
+		return;
+	}
+	show_paths("configured");
+	if (sensor_table("on")) {
+		uint32_t lines = ios_mode->frame_length - EXPOSURE_MARGIN, gain = 8 * hw->gain_unity, fl = 0;
+
+		exposure_limits(&lines, &gain, &fl);
+		(void)exposure_write(lines, gain, fl);
+		for (unsigned ms = 0; ms < 5000 && done < wanted && !broken; ms += 2) {
+			sensor_delay(2000);
+			if (!(rd(ife + BUS_IRQ_STATUS1) & WM0_DONE)) {
+				continue;
+			}
+			done++;
+			if (done <= 3 || done == wanted) {
+				say("frame %u written, %u ms after stream on\n", done, ms + 2);
+			}
+			blk_put(ife, "IFE", BUS_IRQ_CLEAR1, WM0_DONE, false);
+			blk_put(ife, "IFE", BUS_IRQ_GLOBAL_CLEAR, 1, false);
+			blk_put(ife, "IFE", WM0_IMAGE_ADDR, (uint32_t)(FRAME_ADDRESSES + (uint64_t)(done & 1) * frame), false);
+			blk_put(ife, "IFE", IFE_REG_UPDATE, 0x2, false);
+		}
+		show_paths("after the frames");
+		show_csiphy("after the frames");
+		(void)sensor_table("off");
+	}
+	smmu_faults();
+	csiphy_down();
+	titan_down();
+	power_down();
+	if (done != 0) {
+		first_bytes(frames + (uint64_t)((done - 1) & 1) * frame, "last frame");
+	}
+	frames_free();
+}
+
+/* ---- sweetcam=5: /dev/sweet-camera (HackiOS redwood_camera.c:3233-4107, renamed, davinci sensors) ---- */
+
+#define RING                    3
+#define PLACE_SPARE             (256u << 10)
+#define IDLE_MS                 1000
+#define FRAME_TIMEOUT_MS        1500
+
+enum { PLACE_FREE, PLACE_WRITING, PLACE_READY, PLACE_READING };
+enum { SOURCE_SENSOR, SOURCE_SENSOR_PATTERN, SOURCE_CSID_TPG };
+
+static LCK_MTX_DECLARE(ios_lock, &cam_lck_grp);
+static struct {
+	uint8_t         state;
+	uint64_t        sequence, time;
+	uint32_t        exposure_lines, gain, frame_lines;
+} place[RING];
+static uint64_t ring_place_bytes;
+static uint32_t ring_frame_bytes, ios_line_ns;
+static volatile bool ios_open, ios_streaming, ios_wanted;
+static uint64_t ios_last_read, ios_given, ios_frames_done, ios_writes_late;
+static struct { uint32_t lines, gain, frame_lines; bool pending; } ios_ask;
+static struct { uint32_t lines, gain, frame_lines; uint64_t from; } ios_now, ios_next;
+static int ios_source = SOURCE_SENSOR;
+static volatile unsigned ios_switch_to;
+static uint32_t ios_switch_mode;
+
+static uint64_t
+ios_ms(void)
+{
+	uint64_t ns;
+
+	absolutetime_to_nanoseconds(mach_absolute_time(), &ns);
+	return ns / NSEC_PER_MSEC;
+}
+
+static bool
+ring_alloc(void)
+{
+	ring_frame_bytes = RAW10_STRIDE(ios_mode->width) * ios_mode->height;
+	ring_place_bytes = round_page(ring_frame_bytes) + PLACE_SPARE;
+	return frames_alloc(RING * ring_place_bytes);
+}
+
+static void
+ios_stop(const char *why)
+{
+	lck_mtx_lock(&ios_lock);
+	ios_streaming = false;
+	for (int i = 0; i < RING; i++) {
+		place[i].state = PLACE_FREE;
+	}
+	lck_mtx_unlock(&ios_lock);
+	wakeup(&ios_frames_done);
+	if (!broken && ios_source != SOURCE_CSID_TPG && ctab != NULL) {
+		(void)sensor_table("off");
+	}
+	if (csid_running || ife_running) {
+		show_paths("at the end");
+	}
+	smmu_faults();
+	csiphy_down();
+	titan_down();
+	power_down();
+	frames_free();
+	say("frames for iOS stopped (%s): %llu done, %llu given, %llu written over\n", why, ios_frames_done, ios_given, ios_writes_late);
+}
+
+static bool
+ios_start(void)
+{
+	uint32_t lines, gain, frame_lines;
+
+	ios_frames_done = ios_given = ios_writes_late = 0;
+	if (!ring_alloc()) {
+		return false;
+	}
+	if (ios_source == SOURCE_CSID_TPG) {
+		if (!titan_up() || !smmu_up() || !csid_reset() || !csid_config(-1, 4, 0x3210, TPG_VC, ios_mode->width, ios_mode->height) ||
+		    !ife_config(FRAME_ADDRESSES, 0) || !tpg_start()) {
+			return false;
+		}
+	} else if (!sensor_stream_setup(FRAME_ADDRESSES) || (ios_source == SOURCE_SENSOR_PATTERN && !sensor_table("tpgon"))) {
+		return false;
+	}
+	lck_mtx_lock(&ios_lock);
+	for (int i = 0; i < RING; i++) {
+		place[i].state = PLACE_FREE;
+	}
+	place[0].state = PLACE_WRITING;
+	lines = ios_ask.lines;
+	gain = ios_ask.gain;
+	frame_lines = ios_ask.frame_lines;
+	ios_ask.pending = false;
+	lck_mtx_unlock(&ios_lock);
+	exposure_limits(&lines, &gain, &frame_lines);
+	if (ios_source != SOURCE_CSID_TPG && (!sensor_table("on") || !exposure_write(lines, gain, frame_lines))) {
+		return false;
+	}
+	ios_now.lines = ios_next.lines = lines;
+	ios_now.gain = ios_next.gain = gain;
+	ios_now.frame_lines = ios_next.frame_lines = frame_lines;
+	ios_next.from = 0;
+	say("frames for iOS: %s mode %u %ux%u; exposure %u lines, gain %#x, frame %u lines\n", hw->name, ios_mode_n, ios_mode->width,
+	    ios_mode->height, lines, gain, frame_lines);
+	return true;
+}
+
+/* At each RDI0 SOF the address of the place after it goes to WM0 (latched at the next SOF). */
+static void
+ios_session(void)
+{
+	int writing = 0, next = 0;
+	uint64_t last_frame;
+
+	if (!ios_start()) {
+		give_up("the camera did not start");
+		ios_stop("it did not start");
+		return;
+	}
+	last_frame = ios_ms();
+	blk_put(ife, "IFE", IFE_IRQ_CLEAR0, 0xffffffff, false);
+	blk_put(ife, "IFE", IFE_IRQ_GLOBAL_CLEAR, 1, false);
+	lck_mtx_lock(&ios_lock);
+	ios_streaming = true;
+	ios_last_read = ios_ms();
+	lck_mtx_unlock(&ios_lock);
+	while (!broken && ios_open && ios_switch_to == 0) {
+		uint32_t top, bus;
+		uint64_t now;
+
+		wait_ms(1);
+		now = ios_ms();
+		top = rd(ife + IFE_IRQ_STATUS0);
+		bus = rd(ife + BUS_IRQ_STATUS1);
+		if (!(top & RDI0_SOF) && !(bus & WM0_DONE)) {
+			if (now - last_frame > FRAME_TIMEOUT_MS) {
+				show_paths("no frame");
+				give_up("no frame for 1.5 s");
+				break;
+			}
+			if (now - ios_last_read > IDLE_MS) {
+				break;
+			}
+			continue;
+		}
+		blk_put(ife, "IFE", IFE_IRQ_CLEAR0, top & RDI0_SOF, false);
+		blk_put(ife, "IFE", IFE_IRQ_GLOBAL_CLEAR, 1, false);
+		blk_put(ife, "IFE", BUS_IRQ_CLEAR1, bus & WM0_DONE, false);
+		blk_put(ife, "IFE", BUS_IRQ_GLOBAL_CLEAR, 1, false);
+		lck_mtx_lock(&ios_lock);
+		if (bus & WM0_DONE) {
+			last_frame = now;
+			ios_frames_done++;
+			if (ios_frames_done >= ios_next.from && ios_next.from != 0) {
+				ios_now = ios_next;
+				ios_next.from = 0;
+			}
+			place[writing].state = PLACE_READY;
+			place[writing].sequence = ios_frames_done;
+			place[writing].time = mach_absolute_time();
+			place[writing].exposure_lines = ios_now.lines;
+			place[writing].gain = ios_now.gain;
+			place[writing].frame_lines = ios_now.frame_lines;
+		}
+		if (top & RDI0_SOF) {
+			if (next >= 0) {
+				writing = next;
+				next = -1;
+			} else {
+				ios_writes_late++;
+			}
+			place[writing].state = PLACE_WRITING;
+			for (int i = 0; i < RING; i++) {
+				int c = (writing + 1 + i) % RING;
+
+				if (c != writing && place[c].state != PLACE_READING && (next < 0 || place[c].sequence < place[next].sequence)) {
+					next = c;
+				}
+			}
+			if (next >= 0) {
+				blk_put(ife, "IFE", WM0_IMAGE_ADDR, (uint32_t)(FRAME_ADDRESSES + (uint64_t)next * ring_place_bytes), false);
+				blk_put(ife, "IFE", IFE_REG_UPDATE, 0x2, false);
+			}
+		}
+		bool ask = (bus & WM0_DONE) && ios_ask.pending;
+		uint32_t lines = ios_ask.lines, gain = ios_ask.gain, frame_lines = ios_ask.frame_lines;
+
+		ios_ask.pending = ios_ask.pending && !ask;
+		lck_mtx_unlock(&ios_lock);
+		if (bus & WM0_DONE) {
+			wakeup(&ios_frames_done);
+		}
+		if (ask && ios_source != SOURCE_CSID_TPG) {
+			exposure_limits(&lines, &gain, &frame_lines);
+			if (lines != ios_now.lines || gain != ios_now.gain || frame_lines != ios_now.frame_lines) {
+				if (!exposure_write(lines, gain, frame_lines)) {
+					break;
+				}
+				ios_next.lines = lines;
+				ios_next.gain = gain;
+				ios_next.frame_lines = frame_lines;
+				ios_next.from = ios_frames_done + 2;
+			}
+		}
+		if ((bus & WM0_DONE) && ios_frames_done % 30 == 0) {
+			if (rd(smmu_context + SMMU_CB_FSR) & SMMU_FSR_ALL) {
+				smmu_faults();
+				give_up("the SMMU refused the IFE");
+				break;
+			}
+			if (ios_frames_done == 30 || ios_frames_done % 900 == 0) {
+				show_paths("streaming");
+			}
+		}
+	}
+	ios_stop(broken ? "a fault" : !ios_open ? "closed" : ios_switch_to != 0 ? "another sensor" : "nobody reads");
+}
+
+/* sweetcam_fake=1: synthetic RAW10 colour bars in the sensor's order (HackiOS fake_session), no hardware. */
+static void
+fake_session(void)
+{
+	uint32_t width = ios_mode->width, height = ios_mode->height, stride = RAW10_STRIDE(width);
+
+	ios_frames_done = ios_given = 0;
+	if (!ring_alloc()) {
+		return;
+	}
+	for (int p = 0; p < RING; p++) {
+		uint8_t *at = (uint8_t *)(frames + (uint64_t)p * ring_place_bytes);
+
+		for (uint32_t y = 0; y < height; y++) {
+			for (uint32_t x = 0; x < width; x += 4) {
+				uint8_t level = (uint8_t)(16 + ((x * 8 / width) * 28) + ((y & 1) ? 0 : 8));
+
+				memset(at + (uint64_t)y * stride + x / 4 * 5, level, 4);
+				at[(uint64_t)y * stride + x / 4 * 5 + 4] = 0;
+			}
+		}
+	}
+	lck_mtx_lock(&ios_lock);
+	ios_streaming = true;
+	ios_last_read = ios_ms();
+	lck_mtx_unlock(&ios_lock);
+	while (ios_open && ios_switch_to == 0) {
+		int p = -1;
+
+		wait_ms(100);
+		lck_mtx_lock(&ios_lock);
+		if (ios_ms() - ios_last_read > IDLE_MS) {
+			lck_mtx_unlock(&ios_lock);
+			break;
+		}
+		for (int i = 0; i < RING; i++) {
+			if (place[i].state != PLACE_READING && (p < 0 || place[i].sequence < place[p].sequence)) {
+				p = i;
+			}
+		}
+		if (p >= 0) {
+			place[p].state = PLACE_READY;
+			place[p].sequence = ++ios_frames_done;
+			place[p].time = mach_absolute_time();
+			place[p].exposure_lines = ios_now.lines;
+			place[p].gain = ios_now.gain;
+			place[p].frame_lines = ios_now.frame_lines;
+		}
+		lck_mtx_unlock(&ios_lock);
+		wakeup(&ios_frames_done);
+	}
+	lck_mtx_lock(&ios_lock);
+	ios_streaming = false;
+	for (int i = 0; i < RING; i++) {
+		place[i].state = PLACE_FREE;
+	}
+	lck_mtx_unlock(&ios_lock);
+	wakeup(&ios_frames_done);
+	frames_free();
+}
+
+static int
+camdev_open(__unused dev_t dev, __unused int flags, __unused int type, __unused struct proc *p)
+{
+	if (broken) {
+		return EIO;
+	}
+	ios_open = true;
+	return 0;
+}
+
+static int
+camdev_close(__unused dev_t dev, __unused int flags, __unused int type, __unused struct proc *p)
+{
+	ios_open = false;
+	ios_wanted = false;
+	wakeup(__DEVOLATILE(void *, &ios_open));
+	return 0;
+}
+
+static int
+camdev_read(__unused dev_t dev, struct uio *uio, __unused int ioflag)
+{
+	struct sweet_camera_frame f;
+	uint64_t since = ios_ms();
+	int b, error = 0;
+
+	lck_mtx_lock(&ios_lock);
+	ios_last_read = ios_ms();
+	for (;;) {
+		if (broken) {
+			lck_mtx_unlock(&ios_lock);
+			return EIO;
+		}
+		b = -1;
+		for (int i = 0; i < RING; i++) {
+			if (place[i].state == PLACE_READY && place[i].sequence > ios_given && (b < 0 || place[i].sequence > place[b].sequence)) {
+				b = i;
+			}
+		}
+		if (b >= 0) {
+			break;
+		}
+		if (ios_ms() - since > (ios_streaming ? 3000u : 15000u)) {
+			lck_mtx_unlock(&ios_lock);
+			return EAGAIN;
+		}
+		if (!ios_streaming && !ios_wanted) {
+			ios_wanted = true;
+			wakeup(__DEVOLATILE(void *, &ios_open));
+		}
+		struct timespec ts = { 0, 100 * NSEC_PER_MSEC };
+		error = msleep(&ios_frames_done, &ios_lock, PZERO | PCATCH, "sweet-camera", &ts);
+		if (error != 0 && error != EWOULDBLOCK) {
+			lck_mtx_unlock(&ios_lock);
+			return error;
+		}
+		ios_last_read = ios_ms();
+	}
+	place[b].state = PLACE_READING;
+	ios_given = place[b].sequence;
+	bzero(&f, sizeof(f));
+	memcpy(f.magic, SWEET_CAMERA_MAGIC, 8);
+	f.header_bytes = sizeof(f);
+	f.width = ios_mode->width;
+	f.height = ios_mode->height;
+	f.stride = RAW10_STRIDE(ios_mode->width);
+	f.format = 1;
+	f.bayer = ios_source == SOURCE_CSID_TPG ? 0 : hw->bayer;
+	f.black = 64;
+	f.sequence = place[b].sequence;
+	f.time = place[b].time;
+	f.exposure_lines = place[b].exposure_lines;
+	f.line_ns = ios_line_ns;
+	f.gain = place[b].gain;
+	f.gain_unity = hw->gain_unity;
+	f.gain_max = hw->gain_max;
+	f.frame_lines = place[b].frame_lines;
+	f.frame_lines_min = ios_mode->frame_length;
+	f.frame_lines_max = FRAME_LINES_MAX;
+	f.margin = EXPOSURE_MARGIN;
+	f.sensor = hw_index;
+	f.focus = SWEET_CAMERA_NO_FOCUS;        /* DW9763 (wide/tele) not done yet */
+	lck_mtx_unlock(&ios_lock);
+
+	error = uiomove((caddr_t)&f, (int)MIN(sizeof(f), (size_t)uio_resid(uio)), uio);
+	if (error == 0 && uio_resid(uio) > 0) {
+		vm_offset_t at = frames + (uint64_t)b * ring_place_bytes;
+		uint32_t n = (uint32_t)MIN((uint64_t)ring_frame_bytes, (uint64_t)uio_resid(uio));
+
+		for (vm_offset_t l = at & ~63ul; l < at + n; l += 64) {
+			__asm__ volatile ("dc civac, %0" : : "r" (l));          /* the IFE wrote past the caches */
+		}
+		__asm__ volatile ("dsb sy");
+		error = uiomove((caddr_t)at, (int)n, uio);
+	}
+	lck_mtx_lock(&ios_lock);
+	if (place[b].state == PLACE_READING) {
+		place[b].state = PLACE_READY;
+	}
+	ios_last_read = ios_ms();
+	lck_mtx_unlock(&ios_lock);
+	return error;
+}
+
+static int
+camdev_write(__unused dev_t dev, struct uio *uio, __unused int ioflag)
+{
+	struct sweet_camera_command c;
+
+	if (uio_resid(uio) < (user_ssize_t)sizeof(c) || uiomove((caddr_t)&c, sizeof(c), uio) != 0) {
+		return EINVAL;
+	}
+	if (c.command == SWEET_CAMERA_EXPOSURE) {
+		lck_mtx_lock(&ios_lock);
+		ios_ask.lines = c.a;
+		ios_ask.gain = c.b;
+		ios_ask.frame_lines = c.c;
+		ios_ask.pending = true;
+		lck_mtx_unlock(&ios_lock);
+		return 0;
+	}
+	if (c.command == SWEET_CAMERA_FOCUS) {
+		return 0;                       /* no lens motor driven yet */
+	}
+	if (c.command == SWEET_CAMERA_SENSOR) {
+		if (c.a >= SENSORS) {
+			return EINVAL;
+		}
+		lck_mtx_lock(&ios_lock);
+		ios_switch_mode = c.b;
+		ios_switch_to = c.a + 1;
+		lck_mtx_unlock(&ios_lock);
+		wakeup(__DEVOLATILE(void *, &ios_open));
+		return 0;
+	}
+	return EINVAL;
+}
+
+static const struct cdevsw camdev_cdevsw = {
+	.d_open = camdev_open, .d_close = camdev_close, .d_read = camdev_read, .d_write = camdev_write,
+	.d_ioctl = eno_ioctl, .d_stop = eno_stop, .d_reset = eno_reset, .d_select = eno_select,
+	.d_mmap = eno_mmap, .d_strategy = eno_strat, .d_type = 0
+};
+static bool camdev_made;
+
+/* Made as the thread starts, before mediaserverd (its capture stack looks for cameras once). */
+static void
+camdev_make(void)
+{
+	int major = cdevsw_add(-1, &camdev_cdevsw);
+
+	camdev_made = major >= 0 && devfs_make_node(makedev(major, 0), DEVFS_CHAR, UID_ROOT, GID_WHEEL, 0666, "sweet-camera") != NULL;
+}
+
+static bool
+ios_select(unsigned index, uint32_t mode)
+{
+	uint32_t pattern = 0, count = 0;
+	const struct ctab_entry *tpgon;
+
+	select_sensor(index);
+	if (!fake) {
+		find_pins();
+	}
+	if (!ctab_load(hw->tab) || !pick_mode(mode)) {
+		return false;
+	}
+	ios_line_ns = (uint32_t)(1000000000000ull / ((uint64_t)ios_mode->fps_milli * ios_mode->frame_length));
+	(void)PE_parse_boot_argn("sweetcam_pattern", &pattern, sizeof(pattern));
+	tpgon = ctab_find("tpgon", &count);
+	ios_source = pattern == 0 ? SOURCE_SENSOR : pattern == 1 && tpgon != NULL && count > 0 ? SOURCE_SENSOR_PATTERN : SOURCE_CSID_TPG;
+	ios_ask.lines = ios_mode->frame_length - EXPOSURE_MARGIN;
+	ios_ask.gain = 8 * hw->gain_unity;
+	ios_ask.frame_lines = 0;
+	ios_now.lines = ios_ask.lines;
+	ios_now.gain = ios_ask.gain;
+	ios_now.frame_lines = ios_mode->frame_length;
+	say("/dev/sweet-camera: the %s camera (%s), mode %u %ux%u %u.%03u fps, on demand\n", hw->name, hw->chip, ios_mode_n,
+	    ios_mode->width, ios_mode->height, ios_mode->fps_milli / 1000, ios_mode->fps_milli % 1000);
+	return true;
+}
+
+static void
+serve_ios(void)
+{
+	uint32_t mode = ~0u;
+
+	if (!camdev_made) {
+		say("/dev/sweet-camera cannot be made\n");
+		return;
+	}
+	(void)PE_parse_boot_argn("sweetcam_mode", &mode, sizeof(mode));
+	if (!ios_select(hw_index, mode)) {
+		return;
+	}
+	while (!broken) {
+		unsigned to;
+
+		lck_mtx_lock(&ios_lock);
+		while (!broken && !(ios_open && ios_wanted) && ios_switch_to == 0) {
+			(void)msleep(__DEVOLATILE(void *, &ios_open), &ios_lock, PZERO, "sweet-camera-idle", NULL);
+		}
+		to = ios_switch_to;
+		ios_switch_to = 0;
+		ios_wanted = false;
+		lck_mtx_unlock(&ios_lock);
+		if (broken) {
+			break;
+		}
+		if (to != 0) {
+			if (!ios_select(to - 1, ios_switch_mode)) {
+				give_up("a sensor that cannot be used");
+				break;
+			}
+			continue;
+		}
+		if (fake) {
+			fake_session();
+		} else {
+			ios_session();
+		}
+	}
+	say("/dev/sweet-camera: no more frames in this boot\n");
+}
+
+/* ---- the look (sweetcam=1: reads only), the thread ------------------------------------------------------ */
+
+/*
+ * sweetcam=1 writes nothing and votes nothing. What it reads, and when:
+ *   GCC, TLMM, the SPMI arbiter's core/cnfg tables, the apps SMMU's global registers: always (these
+ *   blocks are on and clocked for the system itself: GCC/TLMM by every driver here, the arbiter by
+ *   sweet_spmi.c at each boot, the SMMU translates the panel's traffic and Linux reads the same
+ *   registers at probe);
+ *   camcc: only if GCC's camera AHB branch is running (CBCR bit 31 clear) -- a gated block aborts;
+ *   a Titan block's own registers (CPAS, CCI, CSID-lite, IFE-lite, CSIPHY): only if, in addition, the
+ *   titan_top GDSC reports PWR_ON and cpas_ahb plus the block's core clock are running;
+ *   PMIC regulator status: never at level 1 by default -- an SPMI observer read is an MMIO command
+ *   write to the arbiter (no PMIC state changes, but a write); boot-arg sweetcam_pmic=1 allows it.
+ */
+static const char *
+onoff(uint32_t cbcr)
+{
+	return (cbcr & CBCR_OFF) ? "off" : "on";
+}
+
+static void
+show_regulator(const char *name, unsigned sid, uint16_t base)
+{
+	uint8_t status = 0, enable = 0, vlo = 0, vhi = 0;
+	bool ok = spmi_read(sid, base + 0x08, &status) && spmi_read(sid, base + 0x46, &enable) && spmi_read(sid, base + 0x40, &vlo) &&
+	    spmi_read(sid, base + 0x41, &vhi);
+
+	say("rail %s (sid %u %#x): %s status %#04x enable %#04x set %u mV\n", name, sid, base, ok ? "read" : "NOT READABLE", status,
+	    enable, (unsigned)vhi << 8 | vlo);
+}
+
+static void
+show_apid(const char *name, unsigned sid, unsigned periph)
+{
+	unsigned owner = 7, apid = spmi_apid(sid, periph, &owner);
+
+	if (apid == 0xffff) {
+		say("SPMI %s (sid %u periph %#x): no APID\n", name, sid, periph);
+	} else {
+		say("SPMI %s (sid %u periph %#x): APID %u owner EE %u%s\n", name, sid, periph, apid, owner,
+		    owner == 0 ? " (apps: writable by us)" : " (NOT ours to write)");
+	}
+}
+
+/* A Titan block's version registers, only with everything it needs running. */
+static void
+titan_read(const char *name, vm_offset_t pa, uint32_t clock_cbcr, uint32_t off0, uint32_t off1, bool titan_ok, const char *why)
+{
+	vm_offset_t va;
+	uint32_t clk;
+
+	if (!titan_ok) {
+		say("titan: %s not read: %s\n", name, why);
+		return;
+	}
+	clk = rd(camcc + clock_cbcr);
+	if (clk & CBCR_OFF) {
+		say("titan: %s not read: its clock (camcc %#x = %#x) is off\n", name, clock_cbcr, clk);
+		return;
+	}
+	va = cam_map(pa, 0x4000);
+	if (va == 0) {
+		return;
+	}
+	say("titan: %s @%#lx: [%#x] %#x [%#x] %#x\n", name, (unsigned long)pa, off0, rd(va + off0), off1, rd(va + off1));
+}
+
+static void
+look_readonly(void)
+{
+	uint32_t ahb = rd(gcc + GCC_CAMERA_AHB_CBCR);
+
+	say("sweetcam=%u: the %s camera (%s); read-only look first (no writes, no votes)\n", level, hw->name, hw->chip);
+	say("GCC: camera_ahb %#x (%s) camera_xo %#x (%s) hf_axi %#x (%s) sf_axi %#x (%s)\n", ahb, onoff(ahb),
+	    rd(gcc + GCC_CAMERA_XO_CBCR), onoff(rd(gcc + GCC_CAMERA_XO_CBCR)), rd(gcc + GCC_CAMERA_HF_AXI_CBCR),
+	    onoff(rd(gcc + GCC_CAMERA_HF_AXI_CBCR)), rd(gcc + GCC_CAMERA_SF_AXI_CBCR), onoff(rd(gcc + GCC_CAMERA_SF_AXI_CBCR)));
+
+	/* camcc and the Titan blocks */
+	if (ahb & CBCR_OFF) {
+		say("camcc: not read: GCC camera_ahb is off (camcc aborts while it is gated; level 2 switches it on)\n");
+		say("titan: CPAS, CCI0/1, CSID-lite, IFE-lite, CSIPHY0-3 not read: camcc not readable\n");
+	} else {
+		uint32_t gdsc = rd(camcc + TITAN_TOP_GDSCR), cpas = rd(camcc + 0xc124);
+		bool titan_ok = (gdsc & GDSC_ON) && !(gdsc & GDSC_COLLAPSE) && !(cpas & CBCR_OFF);
+		const char *why = !(gdsc & GDSC_ON) || (gdsc & GDSC_COLLAPSE) ? "titan_top GDSC off" : "cpas_ahb off";
+
+		say("camcc: titan_top GDSC %#x (%s) gdsc_clk %#x (%s) cpas_ahb %#x (%s) camnoc_axi %#x (%s)\n", gdsc,
+		    (gdsc & GDSC_ON) ? "powered" : "collapsed", rd(camcc + CAMCC_GDSC_CBCR), onoff(rd(camcc + CAMCC_GDSC_CBCR)), cpas,
+		    onoff(cpas), rd(camcc + 0xc148), onoff(rd(camcc + 0xc148)));
+		say("camcc: PLL0 mode %#x L %#x user %#x opmode %#x (%s)\n", rd(camcc + PLL_MODE), rd(camcc + PLL_L_VAL),
+		    rd(camcc + PLL_USER_CTL), rd(camcc + PLL_OPMODE), (rd(camcc + PLL_MODE) & (1u << 31)) ? "locked" : "not locked");
+		for (unsigned i = 0; i < SENSORS; i++) {
+			const struct sensor_hw *s = &sensors[i];
+
+			say("camcc: %s: MCLK RCG %#x cfg %#x branch %#x (%s); CSIPHY%u %#x (%s) timer cfg %#x branch %#x (%s)\n", s->name,
+			    rd(camcc + s->mclk_cmd), rd(camcc + s->mclk_cmd + 4), rd(camcc + s->mclk_cbcr), onoff(rd(camcc + s->mclk_cbcr)),
+			    s->csiphy, rd(camcc + s->phy_cbcr), onoff(rd(camcc + s->phy_cbcr)), rd(camcc + s->timer_cmd + 4),
+			    rd(camcc + s->timer_cbcr), onoff(rd(camcc + s->timer_cbcr)));
+		}
+		say("camcc: ife_lite %#x (%s) ife_lite_csid %#x (%s) ife_lite_cphy_rx %#x (%s) cci0 %#x (%s) cci1 %#x (%s)\n",
+		    rd(camcc + 0xc01c), onoff(rd(camcc + 0xc01c)), rd(camcc + 0xc038), onoff(rd(camcc + 0xc038)), rd(camcc + 0xc040),
+		    onoff(rd(camcc + 0xc040)), rd(camcc + 0xc0dc), onoff(rd(camcc + 0xc0dc)), rd(camcc + 0xc0f8), onoff(rd(camcc + 0xc0f8)));
+		/* CPAS top: its own AHB is cpas_ahb (checked above) */
+		titan_read("CPAS top (hw version, titan version)", 0x0ac40000, 0xc124, 0x0, 0x4, titan_ok, why);
+		titan_read("CCI0 (hw version)", 0x0ac4a000, 0xc0dc, 0x0, 0x4, titan_ok, why);
+		titan_read("CCI1 (hw version)", 0x0ac4b000, 0xc0f8, 0x0, 0x4, titan_ok, why);
+		titan_read("CSID-lite 0 (hw version, rx cfg0)", CSID_PHYS, 0xc038, CSID_HW_VERSION, CSID_CSI2_RX_CFG0, titan_ok, why);
+		titan_read("IFE-lite 0 (hw version, bus version)", IFE_PHYS, 0xc01c, IFE_HW_VERSION, BUS_HW_VERSION, titan_ok, why);
+		for (unsigned n = 0; n < 4; n++) {
+			static const uint32_t phy_cbcr[4] = { 0x6020, 0x6044, 0x6068, 0x608c };
+			char name[48];
+
+			snprintf(name, sizeof(name), "CSIPHY%u (lane enable, ctrl)", n);
+			titan_read(name, CSIPHY_PHYS(n), phy_cbcr[n], 0x814, 0x800, titan_ok, why);
+		}
+	}
+
+	/* pins (TLMM is always readable) */
+	for (unsigned i = 0; i < SENSORS; i++) {
+		const struct sensor_hw *s = &sensors[i];
+		char what[32];
+
+		snprintf(what, sizeof(what), "%s MCLK", s->name);
+		show_pin(s->mclk_pin, what);
+		snprintf(what, sizeof(what), "%s CCI SDA", s->name);
+		show_pin(s->sda, what);
+		snprintf(what, sizeof(what), "%s CCI SCL", s->name);
+		show_pin(s->scl, what);
+		snprintf(what, sizeof(what), "%s reset", s->name);
+		show_pin(s->reset, what);
+		if (s->vdig_kind == VDIG_TLMM) {
+			snprintf(what, sizeof(what), "%s VDIG enable", s->name);
+			show_pin(s->vdig_gpio, what);
+		}
+	}
+
+	/* rails: who owns the PMIC peripherals (arbiter tables: reads); their state only with sweetcam_pmic=1 */
+	if (spmi_up()) {
+		say("SPMI: arbiter %#x, %u APIDs\n", rd(spmi_core), spmi_count);
+		show_apid("PM6150 L16 (VIO)", SID_PM6150, 0x4f);
+		show_apid("PM6150L L9 (CUSTOM)", SID_PM6150L, 0x48);
+		show_apid("PM6150L S8 (VDIG in)", SID_PM6150L, 0x29);
+		show_apid("PM6150L BOB (VANA)", SID_PM6150L, 0xa0);
+		show_apid("PM6150L GPIO3 (wide VDIG enable)", SID_PM6150L, PGPIO_PERIPH(3));
+		show_apid("PM6150L GPIO8 (tele VDIG enable)", SID_PM6150L, PGPIO_PERIPH(8));
+		if (pmic_reads) {
+			show_regulator("L16A (VIO)", SID_PM6150, 0x4f00);
+			show_regulator("L9C (CUSTOM)", SID_PM6150L, 0x4800);
+			show_regulator("S8C (VDIG in)", SID_PM6150L, 0x2900);
+			show_regulator("BOB (VANA)", SID_PM6150L, 0xa000);
+		} else {
+			say("rails: PMIC status not read (an SPMI observer read is a command write to the arbiter); sweetcam_pmic=1 reads it\n");
+		}
+	}
+
+	/* the sensor tables (a file read) */
+	for (unsigned i = 0; i < SENSORS; i++) {
+		if (ctab_load(sensors[i].tab)) {
+			ctab_free();
+		}
+	}
+	if (ctab_load("camera-imx582.tab")) {
+		ctab_free();
+	}
+
+	/* the apps SMMU, last: if a read here faulted, everything above is already in the log */
+	if (smmu == 0) {
+		smmu = cam_map(SMMU_PHYS, 0x1000);
+	}
+	if (smmu != 0) {
+		uint32_t idr0, idr1, smrs, used = 0, overlaps = 0;
+
+		say("SMMU: reading the global registers (a missing next line means the read faulted)\n");
+		idr0 = rd(smmu + SMMU_IDR0);
+		idr1 = rd(smmu + SMMU_IDR1);
+		smrs = idr0 & 0xff;
+		say("SMMU: SCR0 %#x IDR0 %#x IDR1 %#x: %u SMRs, %u contexts, %s pages\n", rd(smmu), idr0, idr1, smrs, idr1 & 0xff,
+		    idr1 >> 31 ? "64K" : "4K");
+		for (uint32_t n = 0; n < smrs && SMMU_SMR(n) < 0xc00; n++) {
+			uint32_t smr = rd(smmu + SMMU_SMR(n)), s2cr;
+
+			if (!(smr >> 31)) {
+				continue;
+			}
+			used++;
+			s2cr = rd(smmu + SMMU_S2CR(n));
+			say("SMMU: SMR %u stream %#x mask %#x -> S2CR %#x (type %u, context %u)\n", n, smr & 0x7fff, smr >> 16 & 0x7fff, s2cr,
+			    s2cr >> 16 & 3, s2cr & 0xff);
+			for (int g = 0; g < IFE_SMRS; g++) {
+				if ((((smr & 0x7fff) ^ ife_streams[g].stream) & ~((smr >> 16 & 0x7fff) | ife_streams[g].mask)) == 0) {
+					overlaps++;
+				}
+			}
+		}
+		say("SMMU: %u SMRs in use, %u free; %u overlap the IFE stream groups 0x900/0x460 0x880/0x460 0x820/0x440\n", used,
+		    smrs - used, overlaps);
+	}
+	say("look done: nothing was written\n");
+}
+
+static void
+camera_thread(__unused void *parameter, __unused wait_result_t result)
+{
+	uint32_t secs = 20;
+	char which[16] = "";
+
+	(void)PE_parse_boot_argn("sweetcam_after", &secs, sizeof(secs));
+	if (level == 5) {
+		camdev_make();
+	}
+	if (PE_parse_boot_arg_str("sweetcam_sensor", which, sizeof(which))) {
+		static const char *const names[SENSORS] = { "wide", "tele", "front", "ultra" };
+
+		for (unsigned i = 0; i < SENSORS; i++) {
+			if (strcmp(which, names[i]) == 0) {
+				hw_index = i;
+			}
+		}
+	}
+	select_sensor(hw_index);
+	if (fake) {
+		say("sweetcam=5 sweetcam_fake=1: synthetic frames, nothing of the phone touched\n");
+		serve_ios();
+		(void)thread_terminate(current_thread());
+		thread_block(THREAD_CONTINUE_NULL);
+		return;
+	}
+	wait_ms(secs * 1000);           /* the system up first */
+	gcc = cam_map(GCC_PHYS, 0x1f0000);
+	camcc = cam_map(CAMCC_PHYS, CAMCC_SIZE);
+	if (gcc == 0 || camcc == 0) {
+		say("cannot map GCC/camcc\n");
+	} else {
+		look_readonly();
+	}
+	/* level 1 stops here; everything below writes */
+	if (level >= 2 && gcc != 0 && camcc != 0 && !broken && gcc_camera_ahb()) {
+		find_pins();
+		if (level == 2) {
+			if (ctab_load(hw->tab) && power_up()) {
+				(void)read_chip_id();
+			}
+			power_down();
+		} else if (level == 3) {
+			capture_tpg();
+			power_down();           /* (the GDSC titan_up switched on) */
+		} else if (level == 4) {
+			capture_sensor();
+		} else if (level == 5) {
+			serve_ios();
+			power_down();
+		}
+	}
+	say("done\n");
+	(void)thread_terminate(current_thread());
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+void
+sweet_camera_init(void)
+{
+	thread_t thread;
+	uint32_t v = 0;
+
+	if (!PE_parse_boot_argn("sweetcam", &level, sizeof(level)) || level == 0) {
+		return;
+	}
+	level = level > 5 ? 5 : level;
+	fake = level == 5 && PE_parse_boot_argn("sweetcam_fake", &v, sizeof(v)) && v != 0;
+	v = 1;
+	(void)PE_parse_boot_argn("sweetcam_rails", &v, sizeof(v));
+	use_rails = v != 0;
+	v = 0;
+	swap_i2c = PE_parse_boot_argn("sweetcam_swapi2c", &v, sizeof(v)) && v != 0;
+	v = 0;
+	pmic_reads = PE_parse_boot_argn("sweetcam_pmic", &v, sizeof(v)) && v != 0;
+	if (kernel_thread_start(camera_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}
+
+/* Halt / restart / panic: whatever was switched on, off (call from sweet_halt_restart()). */
+void
+sweet_camera_quiesce(void)
+{
+	if (level < 2 || camcc == 0) {
+		return;                 /* (sweetcam=1 wrote nothing; nothing to put back) */
+	}
+	leaving = true;
+	broken = false;
+	use_rails = false;              /* no RPMh transactions on the way out (TCS state unknown at panic) */
+	csiphy_down();
+	paths_down();
+	smmu_down();
+	clocks_down();
+	pll0_down();
+	power_down();
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
