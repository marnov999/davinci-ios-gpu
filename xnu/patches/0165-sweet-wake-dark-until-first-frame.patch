 /* The brightness asked for: remembered, and shown unless the display is off. */
+/*
+ * After a wake the panel stays dark -- refresh off, backlight 0 -- until backboardd presents its
+ * first new frame (AppleCLCD::scanOut calls sweet_panel_new_frame), as an iPhone shows nothing
+ * before the lock screen is drawn: lit at once, the panel showed the last frame from before the
+ * sleep (the home screen) for a moment (2026-10-26). If no frame comes within a second, the clocks
+ * thread lights it anyway (sweet_panel_wake_tick).
+ */
+static volatile uint32_t g_wake_pending;
+static uint64_t g_wake_at;
+static int panel_dcs_cmd(uint8_t cmd, bool refresh_stays_off);
+static int panel_dcs_brightness(uint32_t level);
+static uint32_t g_panel_level_shown(void);
+
+static void
+panel_wake_reveal(const char *why)
+{
+	if (!__atomic_exchange_n(&g_wake_pending, 0u, __ATOMIC_ACQ_REL)) {
+		return;
+	}
+	int a = panel_dcs_cmd(0x29, false);             /* display on again, with the refresh back */
+	int b = panel_dcs_brightness(g_panel_level_shown());
+	printf("SWEET PANEL: shown after the wake (%s; display on %d, brightness %d)\n", why, a, b);
+}
+
+void sweet_panel_new_frame(void);
+void
+sweet_panel_new_frame(void)
+{
+	if (g_wake_pending) {
+		panel_wake_reveal("first frame");
+	}
+}
+
+void sweet_panel_wake_tick(void);
+void
+sweet_panel_wake_tick(void)
+{
+	if (g_wake_pending && mach_absolute_time() - g_wake_at > 1000u * 19200u) {   /* 1 s of 19.2 MHz ticks */
+		panel_wake_reveal("no frame in 1 s");
+	}
+}
+
 int
 sweet_panel_brightness(uint32_t level)
 {
@@ -3066,7 +3108,13 @@ sweet_panel_brightness(uint32_t level)
 		last_lit = level;
 	}
 	g_panel_level = level;
-	return g_panel_off ? 0 : panel_dcs_brightness(level);
+	return (g_panel_off || g_wake_pending) ? 0 : panel_dcs_brightness(level);
+}
+
+static uint32_t
+g_panel_level_shown(void)
+{
+	return g_panel_level;
 }
 
