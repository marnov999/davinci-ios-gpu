+/* ======================= /dev/kgsl-3d0 UAPI (cdev) =======================
+ * KGSL-compatible char device so userland Mesa freedreno/turnip (via zink) can
+ * drive the GPU. Tier-1 ioctl contract from Mesa src/freedreno/vulkan/msm_kgsl.h
+ * + tu_knl_kgsl.cc (see gpu/userland/mesa/KGSL-IOCTL-SURFACE.md). The submit path
+ * reuses the proven CP ring + CP_INDIRECT_BUFFER + CACHE_FLUSH_TS published by the
+ * boot code (g_rb/g_core/g_wptr/g_res_*). An in-kernel self-test (gpu_stage_u)
+ * drives create->alloc->submit->timestamp through the same handler helpers, so the
+ * UAPI core is verifiable over the console without a userland client. All structs
+ * are arm64/LP64. cdev pattern from sweet_ufs (0028).
+ *
+ * NOTE on _IOC direction bits: Mesa's msm_kgsl.h uses the Linux encoding, where
+ * _IOW/_IOR are INVERTED vs XNU <sys/ioccom.h> (Linux _IOWR==XNU IN|OUT works, but
+ * Linux _IOW is read by XNU as OUT-only -> the framework won't copyin). We dispatch
+ * on the nr byte and operate on the framework's kernel buffer; the few pure-_IOW
+ * ioctls (WAITTIMESTAMP 0x07, DRAWCTXT_DESTROY 0x14) need the userland side built
+ * with XNU ioccom macros (we control the Mesa build). _IOWR ioctls work as-is. */
+#define KGSL_IOC_TYPE              0x09u
+/* ioctl nrs */
+#define KGSL_IOC_GETPROPERTY       0x02u
+#define KGSL_IOC_WAITTIMESTAMP_CID 0x07u
+#define KGSL_IOC_DRAWCTXT_CREATE   0x13u
+#define KGSL_IOC_DRAWCTXT_DESTROY  0x14u
+#define KGSL_IOC_READTIMESTAMP_CID 0x16u
+#define KGSL_IOC_GPUMEM_ALLOC_ID   0x34u
+#define KGSL_IOC_GPUMEM_FREE_ID    0x35u
+#define KGSL_IOC_GPU_COMMAND       0x4Au
+/* GETPROPERTY types */
+#define KGSL_PROP_DEVICE_INFO      0x1u
+#define KGSL_PROP_DEVICE_SHADOW    0x2u
+#define KGSL_PROP_VERSION          0x8u
+#define KGSL_PROP_UCHE_GMEM_VADDR  0x13u
+#define KGSL_PROP_HIGHEST_BANK_BIT 0x17u
+#define KGSL_PROP_UBWC_MODE        0x1Bu
+#define KGSL_PROP_GPU_VA64_SIZE    0x2Cu
+#define KGSL_PROP_IS_RAYTRACING    0x2Du
+#define KGSL_PROP_GPU_RESET_STAT   0x09u
+#define KGSL_PROP_UCHE_TRAP_BASE   0x2Fu
+/* cmd-object + alloc flags */
+#define KGSL_CMDLIST_IB            0x1u
+#define KGSL_MEMFLAGS_USE_CPU_MAP  (1u << 28)
+#define KGSL_MEMFLAGS_IOCOHERENT   (1u << 31)
+
+struct kgsl_devinfo {                 /* DEVICE_INFO, LP64 size 40 */
+	unsigned int   device_id;      /* @0  */
+	unsigned int   chip_id;        /* @4  */
+	unsigned int   mmu_enabled;    /* @8  (pad @12) */
+	unsigned long  gmem_gpubaseaddr;/*@16 */
+	unsigned int   gpu_id;         /* @24 (pad @28) */
+	unsigned long  gmem_sizebytes; /* @32 */
+};
+struct kgsl_device_getproperty {      /* size 24 */
+	unsigned int   type;           /* @0 (pad @4) */
+	void          *value;          /* @8  user ptr to the reply struct */
+	unsigned long  sizebytes;      /* @16 */
+};
+struct kgsl_drawctxt_create  { unsigned int flags; unsigned int drawctxt_id; };      /* 8  */
+struct kgsl_drawctxt_destroy { unsigned int drawctxt_id; };                          /* 4  */
+struct kgsl_gpumem_alloc_id {         /* size 48 */
+	unsigned int   id;             /* @0  OUT */
+	unsigned int   flags;          /* @4  IN/OUT (echoed) */
+	unsigned long  size;           /* @8  IN/OUT */
+	unsigned long  mmapsize;       /* @16 OUT */
+	unsigned long  gpuaddr;        /* @24 OUT */
+	unsigned long  __pad[2];       /* @32 */
+};
+struct kgsl_gpumem_free_id { unsigned int id; unsigned int __pad; };                 /* 8  */
+struct kgsl_command_object {          /* size 32 */
+	uint64_t offset;               /* @0  */
+	uint64_t gpuaddr;              /* @8  */
+	uint64_t size;                 /* @16 bytes */
+	unsigned int flags;            /* @24 */
+	unsigned int id;               /* @28 */
+};
+struct kgsl_gpu_command {             /* size 64 */
+	uint64_t flags;                /* @0  */
+	uint64_t cmdlist;              /* @8  user ptr to kgsl_command_object[] */
+	unsigned int cmdsize;          /* @16 */
+	unsigned int numcmds;          /* @20 */
+	uint64_t objlist;              /* @24 */
+	unsigned int objsize;          /* @32 */
+	unsigned int numobjs;          /* @36 */
+	uint64_t synclist;             /* @40 */
+	unsigned int syncsize;         /* @48 */
+	unsigned int numsyncs;         /* @52 */
+	unsigned int context_id;       /* @56 */
+	unsigned int timestamp;        /* @60 IN/OUT */
+};
+struct kgsl_cmdstream_readtimestamp_ctxtid { unsigned int context_id, type, timestamp; };  /* 12 */
+struct kgsl_device_waittimestamp_ctxtid    { unsigned int context_id, timestamp, timeout; };/* 12 */
+
+/* ---- context + buffer-object tables ---- */
+#define KGSL_MAX_CTX      32u
+#define KGSL_MAX_BO       4096u
+
+struct kgsl_ctx_ent { int used; uint32_t id; uint32_t ts_issued; uint32_t ts_retired; int pid; };
+struct kgsl_bo_ent  {
+	int used;           /* 0 free; 1 live; 2 being given back (not to be found meanwhile) */
+	uint32_t id; uint64_t gpuaddr; uint64_t pa;
+	vm_offset_t cpu_nc; vm_offset_t cva; vm_size_t size; vm_size_t mmapsize; uint32_t flags; int pid;
+	uint32_t surf_id;   /* 0 = normal BO; nonzero = zero-copy import of that IOSurface (cva==0) */
+	void    *surf;      /* ... and the surface itself, held for as long as the BO is there */
+	uint32_t seed;      /* the surface's seed when it was last pushed out of the cache, */
+	uint64_t pushed;    /* ... and when that was (mach_absolute_time) */
+	uint32_t fence;     /* the last submission that names it (0: none has) */
+};
+
+/* XNU process KPIs: reclaim GPU contexts/BOs whose owning process has died.
+ * (A shared cdev's d_close only fires on last-close, so per-process cleanup can't
+ * live there; instead we lazily reap dead owners at allocation time.) */
+struct proc;
+extern int          proc_selfpid(void);
+extern struct proc *proc_find(int pid);   /* ref'd proc if alive, NULL if dead */
+extern int          proc_rele(struct proc *p);
+static struct kgsl_ctx_ent g_ctx[KGSL_MAX_CTX];
+static struct kgsl_bo_ent  g_bo[KGSL_MAX_BO];
+static uint32_t g_ctx_next = 1;
+static uint32_t g_mmap_page_next = 4;   /* 4K-page units; multiple of 4 keeps id<<12 16K-aligned */
+
+/* SweetSurface.cpp (0046): an IOSurface held by the GPU, its seed, and its pixels pushed out
+ * of this processor's cache. */
+extern void    *sweet_surface_gpu_ref(uint32_t id);
+extern void     sweet_surface_gpu_unref(void *surface);
+extern uint32_t sweet_surface_gpu_seed(void *surface);
+extern void     sweet_surface_gpu_flush(void *surface);
+
+/*
+ * One lock around everything that is the GPU's: the ring, the fence, the address space and
+ * the buffer tables (HackiOS RedwoodGPU.cpp gGPULock). A waiter lets go of it while it waits.
+ */
+static lck_grp_t *g_gpu_grp;
+static lck_mtx_t *g_gpu_mtx;
+static void gpu_lock(void)   { lck_mtx_lock(g_gpu_mtx); }
+static void gpu_unlock(void) { lck_mtx_unlock(g_gpu_mtx); }
+
+static struct kgsl_ctx_ent *kgsl_ctx_find(uint32_t id)
+{
+	unsigned i;
+	for (i = 0; i < KGSL_MAX_CTX; i++) { if (g_ctx[i].used && g_ctx[i].id == id) { return &g_ctx[i]; } }
+	return NULL;
+}
+/* handle -> table index hint (RedwoodGPU indexes handles directly; ours are mmap-offset ids, so
+ * a hint per id hash is checked first, and the table searched when it misses) */
+#define KGSL_BO_HINTS 8192u
+static uint16_t g_bo_hint[KGSL_BO_HINTS];
+static void kgsl_bo_hint(const struct kgsl_bo_ent *b) { g_bo_hint[b->id % KGSL_BO_HINTS] = (uint16_t)(b - g_bo); }
+static struct kgsl_bo_ent *kgsl_bo_find(uint32_t id)
+{
+	unsigned i = g_bo_hint[id % KGSL_BO_HINTS];
+	if (i < KGSL_MAX_BO && g_bo[i].used == 1 && g_bo[i].id == id) { return &g_bo[i]; }
+	for (i = 0; i < KGSL_MAX_BO; i++) {
+		if (g_bo[i].used == 1 && g_bo[i].id == id) { kgsl_bo_hint(&g_bo[i]); return &g_bo[i]; }
+	}
+	return NULL;
+}
+
+/* ===================== the ring and its fence =====================
+ * Ported from HackiOS redwood_adreno.c (redwood_gpu_submit, redwood_gpu_done, redwood_gpu_last,
+ * redwood_gpu_report) and RedwoodGPU.cpp (gpuWait). A submission goes into the ring -- a real
+ * circular one, a packet may run over its end as Linux's do -- and the core is told; nothing
+ * waits for it. Its number, the fence, is written by the core into the result page once it has
+ * finished it and everything before it (CACHE_FLUSH_TS), and into CP_SCRATCH_REG2 for whoever
+ * reads the registers after a hang. Whoever needs a submission done waits for its fence, with
+ * the lock let go. (What this replaces polled every submission to the end under a spinlock,
+ * with three 250 ms log-flush delays in the way, and started the ring over at 0 while the CP
+ * still had the stale words between its read pointer and the end of the ring to run.)
+ */
+#define GPU_FENCE_OFF      0xF0u    /* in the result page: the fence the core has finished */
+#define GPU_PATIENCE_MS    5000u    /* for a wait somebody asks for without a limit (redwood) */
+#define GPU_ASK_AGAIN_US   200u     /* while waiting: between two looks at how far the core is */
+#define GPU_PUSH_AGAIN_MS  4u       /* a surface is pushed out of the cache again this long after the last */
+#define GPU_SUBMIT_CMDS    128u     /* RedwoodGPU: a binned frame takes one command buffer per bin (66+ at 512 KB of GMEM) */
+#define GPU_SUBMIT_BOS     8192u
+#define A6XX_CP_SCRATCH_REG2 0x885u
+static uint32_t g_fence;            /* the last submission's number (redwood gpu_fence) */
+/* redwood ring_time / gpu_times: the core writes a counter at both ends of every submission into the
+ * result page, so what the GPU itself spends is known, not guessed. Not CP_ALWAYS_ON_COUNTER: with a
+ * GMU it does not move here (frozen since the bring-up; kgsl reads the GMU's always-on counter
+ * instead), so RBBM_PERFCTR_CP_0 counting the core's own clocks (Linux's cpcycles), which also tells
+ * the clock the GMU really gave. */
+#define GPU_TIMES_OFF      0x400u   /* 64 slots of { begin, end } u64 */
+#define GPU_TIMES          64u
+#define A6XX_CP_ALWAYS_ON_COUNTER 0x400u   /* (RBBM_PERFCTR_CP_0; the name kept for the ring code) */
+static uint32_t g_timed;            /* the last fence whose times are added up */
+static uint64_t g_gpu_ticks;
+static uint32_t g_gpu_timed;
+static uint32_t g_reports;          /* hang reports printed (the first few) */
+static uint32_t g_gpu_level = 7u;   /* the perf level last acked (bring-up leaves the lowest, 180 MHz) */
+
+static void
+ring_put(uint32_t word)
+{
+	g_rb[g_wptr] = word;
+	g_wptr = (g_wptr + 1u) % KGSL_RING_DWORDS;
+}
+
+/* redwood_gpu_done: how far the 3D core has got (the result page is NC-mapped). */
+static bool
+gpu_done(uint32_t fence)
+{
+	if (!g_kgsl_ready || fence == 0) {
+		return true;
+	}
+	return (int32_t)(*(volatile uint32_t *)(g_res_nc + GPU_FENCE_OFF) - fence) >= 0;
+}
+
+static uint32_t
+gpu_last(void)
+{
+	return g_fence;
+}
+
+/*
+ * The temperatures, as the phone's own thermal zones read them (dt: tsens0 @0xc263000 sensors 0-14,
+ * tsens1 @0xc265000 0-9; TSENS v2: TM_SN_STATUS(n) at +0xa0 + 4n, bits 11:0 signed tenths of a
+ * degree, bit 21 valid). Reads only.
+ */
+static int
+tsens_read(vm_offset_t tm, unsigned n, int *deci)
+{
+	uint32_t v = gpu_rd(tm, 0xA0u + 4u * n);
+	if (!(v & (1u << 21))) {
+		return -1;
+	}
+	*deci = (int)((v & 0xFFFu) ^ 0x800u) - 0x800;
+	return 0;
+}
+static void battery_report(void);
+int sweet_panel_brightness(uint32_t level);
+
+/*
+ * The panel's brightness (davinci: Samsung AMOLED "xiaomi f4 36 02 0b fhd cmd", dt
+ * qcom,mdss-brightness-max-level 0x7ff, bl_ctrl_dcs with dcs-type-ss-ea): DCS 0x51 with two bytes,
+ * high first (mipi_dsi_dcs_set_display_brightness_ss), sent the way the vendor's SDE driver sends a
+ * short command through DSI0 (0xae94000) without memory: the test pattern generator's DMA FIFO
+ * (dsi_ctrl_hw_cmn_kickoff_fifo_command), after the display engine's command stream is idle
+ * (dsi_ctrl_hw_cmn_wait_for_cmd_mode_mdp_idle). The controller is as the boot loader left it;
+ * nothing is done if it is not on.
+ */
+#define DSI0_PA                 0x0ae94000u
+#define DSI_CTRL_R              0x004u
+#define DSI_STATUS_R            0x008u
+#define DSI_CMD_DMA_CTRL_R      0x03Cu
+#define DSI_DMA_CMD_LENGTH_R    0x04Cu
+#define DSI_DMA_SW_TRIGGER_R    0x090u
+#define DSI_INT_CTRL_R          0x110u
+#define DSI_TPG_CTRL_R          0x15Cu
+#define DSI_TPG_DMA_INIT_R      0x17Cu
+#define DSI_TPG_FIFO_RESET_R    0x1ECu
+static uint32_t g_panel_level = 0x218u;    /* what the panel is to show when on (dt bl-default-level) */
+static bool     g_panel_off;               /* the display is off (IOMFB RequestPowerChange 0) */
+static int panel_dcs_brightness(uint32_t level);
+
+/* The brightness asked for: remembered, and shown unless the display is off. */
+int
+sweet_panel_brightness(uint32_t level)
+{
+	if (level > 0x7FFu) {
+		level = 0x7FFu;
+	}
+	g_panel_level = level;
+	return g_panel_off ? 0 : panel_dcs_brightness(level);
+}
+
+/* The display off and on (IOMFB RequestPowerChange from backboardd): dark at level 0, then back. */
+int
+sweet_panel_power(int on)
+{
+	g_panel_off = !on;
+	return panel_dcs_brightness(on ? g_panel_level : 0u);
+}
+
+static int
+panel_dcs_brightness(uint32_t level)
+{
+	static vm_offset_t dsi;
+	static bool told;
+	uint32_t ctrl, reg, i, done = 0;
+	if (!dsi && !(dsi = ml_io_map(DSI0_PA, 0x400u))) {
+		return -1;
+	}
+	if (level > 0x7FFu) {
+		level = 0x7FFu;
+	}
+	ctrl = gpu_rd(dsi, DSI_CTRL_R);
+	if (!told) {
+		told = true;
+		printf("SWEET PANEL: DSI0 ctrl %#x status %#x cmd_dma_ctrl %#x int_ctrl %#x\n", ctrl, gpu_rd(dsi, DSI_STATUS_R),
+		    gpu_rd(dsi, DSI_CMD_DMA_CTRL_R), gpu_rd(dsi, DSI_INT_CTRL_R));
+	}
+	if (!(ctrl & 1u)) {
+		return -2;                              /* the controller is off */
+	}
+	for (i = 0; i < 20000u && (gpu_rd(dsi, DSI_STATUS_R) & (1u << 2)); i++) {   /* CMD_MODE_MDP_BUSY */
+		gmub_udelay(1);
+	}
+	gpu_wr(dsi, DSI_TPG_CTRL_R, (1u << 1) | (1u << 2) | (3u << 16));   /* CMD_DMA_TPG_EN, FIFO mode, custom pattern */
+	/* the packet as dsi_ctrl_copy_and_pad_cmd makes it: header {wc lo, wc hi, type, flags}, payload padded with 0xff;
+	 * DCS long write (0x39), 3 bytes; flags: last command (bit 7), long packet (bit 6) */
+	gpu_wr(dsi, DSI_TPG_DMA_INIT_R, 0x03u | 0x00u << 8 | 0x39u << 16 | 0xC0u << 24);
+	gpu_wr(dsi, DSI_TPG_DMA_INIT_R, 0x51u | (level >> 8) << 8 | (level & 0xFFu) << 16 | 0xFFu << 24);
+	reg = gpu_rd(dsi, DSI_CMD_DMA_CTRL_R);
+	reg &= ~((1u << 31) | (1u << 30));            /* not broadcast, not a master of two */
+	reg |= 1u << 28;                              /* embedded mode */
+	gpu_wr(dsi, DSI_CMD_DMA_CTRL_R, reg);
+	gpu_wr(dsi, DSI_DMA_CMD_LENGTH_R, 8u);
+	__asm__ volatile("dsb sy" ::: "memory");
+	gpu_wr(dsi, DSI_DMA_SW_TRIGGER_R, 1u);
+	for (i = 0; i < 20000u; i++) {                /* CMD_MODE_DMA_DONE: status bit 0 of INT_CTRL */
+		if ((done = gpu_rd(dsi, DSI_INT_CTRL_R)) & 1u) {
+			break;
+		}
+		gmub_udelay(1);
+	}
+	if (done & 1u) {
+		gpu_wr(dsi, DSI_INT_CTRL_R, done);       /* (status bits are cleared by writing them) */
+	}
+	gpu_wr(dsi, DSI_TPG_CTRL_R, 0u);
+	gpu_wr(dsi, DSI_TPG_FIFO_RESET_R, 1u);
+	gmub_udelay(1);
+	gpu_wr(dsi, DSI_TPG_FIFO_RESET_R, 0u);
+	printf("SWEET PANEL: brightness %u: %s\n", level, (done & 1u) ? "sent" : "NO DMA DONE");
+	return (done & 1u) ? 0 : -3;
+}
+static void
+thermal_report(void)
+{
+	static vm_offset_t t0, t1;
+	static const char *const name0[15] = { "aoss0", "cpu0", "cpu1", "cpu2", "cpu3", "cpu4", "cpu5", "cpuss0", "cpuss1",
+		"big0", "big1", "big2", "big3", "gpu0", "gpu1" };
+	static const char *const name1[10] = { "aoss1", "wlan", "audio", "ddr", "hvx", "camera", "mdm", "mdmdsp", "npu", "video" };
+	char line[400];
+	int at = 0, d, little = -1000, big = -1000;
+	unsigned i;
+	if (!t0) {
+		t0 = ml_io_map(0x0c263000u, 0x1000u);
+		t1 = ml_io_map(0x0c265000u, 0x1000u);
+		if (!t0 || !t1) {
+			return;
+		}
+	}
+	for (i = 1; i <= 6u; i++) {
+		if (tsens_read(t0, i, &d) == 0 && d > little) little = d;
+	}
+	for (i = 9; i <= 12u; i++) {
+		if (tsens_read(t0, i, &d) == 0 && d > big) big = d;
+	}
+	at += snprintf(line + at, sizeof(line) - (size_t)at, "little %d.%d big %d.%d", little / 10, little % 10, big / 10, big % 10);
+	for (i = 13; i <= 14u; i++) {
+		if (tsens_read(t0, i, &d) == 0) {
+			at += snprintf(line + at, sizeof(line) - (size_t)at, " %s %d.%d", name0[i], d / 10, (d < 0 ? -d : d) % 10);
+		}
+	}
+	for (i = 0; i < 10u && at < (int)sizeof(line) - 24; i++) {
+		if ((i == 3u || i == 6u || i == 0u) && tsens_read(t1, i, &d) == 0) {
+			at += snprintf(line + at, sizeof(line) - (size_t)at, " %s %d.%d", name1[i], d / 10, (d < 0 ? -d : d) % 10);
+		}
+	}
+	(void)name0;
+	printf("SWEET THERMAL: %s (C)\n", line);
+}
+
+/* redwood gpu_times: add up what the core spent on the submissions done since the last look. */
+static void
+gpu_times(void)
+{
+	volatile uint64_t *times = (volatile uint64_t *)(g_res_nc + GPU_TIMES_OFF);
+	uint32_t done = *(volatile uint32_t *)(g_res_nc + GPU_FENCE_OFF);
+	if (done - g_timed > GPU_TIMES) {
+		g_timed = done - GPU_TIMES;                     /* (the older ones were written over) */
+	}
+	while (g_timed != done) {
+		uint32_t slot = ++g_timed % GPU_TIMES;
+		if (g_timed != 0 && times[2 * slot + 1] > times[2 * slot]) {
+			g_gpu_ticks += times[2 * slot + 1] - times[2 * slot];
+			g_gpu_timed++;
+		}
+	}
+}
+
+/* redwood_gpu_report: a submission does not come back -- what the core and its SMMU context say. */
+static void
+gpu_report(const char *why)
+{
+	if (g_reports >= 8u) {
+		return;
+	}
+	g_reports++;
+	printf("SWEET DRM: GPU %s: submission %u is the last, the core has done %u; ring read up to %u, "
+	    "written up to %u; rbbm %#x; ib1 %#x_%08x rem %#x; ib2 rem %#x; protect %#x; smmu fsr %#x far %#x\n",
+	    why, g_fence, *(volatile uint32_t *)(g_res_nc + GPU_FENCE_OFF),
+	    gpu_rd(g_core, 0x806u << 2), g_wptr, gpu_rd(g_core, 0x210u << 2),
+	    gpu_rd(g_core, 0x929u << 2), gpu_rd(g_core, 0x928u << 2),
+	    gpu_rd(g_core, 0x92Au << 2), gpu_rd(g_core, 0x92Du << 2), gpu_rd(g_core, 0x8CAu << 2),
+	    g_smmu_base ? gpu_rd(g_smmu_base, 0x8000u + 0x058u) : 0,
+	    g_smmu_base ? gpu_rd(g_smmu_base, 0x8000u + 0x060u) : 0);
+}
+
+/* RedwoodGPU gpuWait: wait for the core to be done with `fence`; with the lock held, which is
+ * let go of while waiting. A wait of a second or more that comes to nothing is reported. */
+static uint32_t g_waits;
+static uint64_t g_waiting;
+static bool
+gpu_wait(uint32_t fence, uint64_t milliseconds)
+{
+	uint64_t began = mach_absolute_time(), patience;
+	bool waited = false;
+	nanoseconds_to_absolutetime(milliseconds * NSEC_PER_MSEC, &patience);
+	for (;; waited = true) {
+		if (gpu_done(fence)) {
+			if (waited) {
+				g_waits++;
+				g_waiting += mach_absolute_time() - began;
+			}
+			return true;
+		}
+		if (mach_absolute_time() - began >= patience) {
+			break;
+		}
+		gpu_unlock();
+		gmub_udelay(GPU_ASK_AGAIN_US);
+		gpu_lock();
+	}
+	if (milliseconds >= 1000u) {
+		gpu_report("no answer");
+	}
+	return false;
+}
+
+/* redwood_gpu_submit: command buffers for the core to run, in order, as Linux's a6xx_submit
+ * puts them in the ring. Returns the submission's number; 0: the ring stayed full (the core is
+ * not reading it). With the lock held throughout, as redwood does. */
+static uint32_t
+gpu_submit(const uint64_t *ibva, const uint32_t *ibdw, unsigned n)
+{
+	uint32_t wanted = 8u + 4u + 4u * n + 2u + 5u, room = 0, fence;
+	unsigned i, tries;
+	if (!g_kgsl_ready || n == 0) {
+		return 0;
+	}
+	for (tries = 0; tries < 10000u; tries++) {           /* 2 s */
+		uint32_t rptr = gpu_rd(g_core, 0x806u << 2) % KGSL_RING_DWORDS;   /* CP_RB_RPTR */
+		room = (rptr + KGSL_RING_DWORDS - g_wptr - 1u) % KGSL_RING_DWORDS;
+		if (room >= wanted) {
+			break;
+		}
+		gmub_udelay(GPU_ASK_AGAIN_US);
+	}
+	if (room < wanted) {
+		gpu_report("the ring is full");
+		return 0;
+	}
+	if (++g_fence == 0) {
+		g_fence = 1;
+	}
+	fence = g_fence;
+	{       /* the time at the beginning (redwood ring_time(fence, 0)) */
+		uint64_t at = g_res_pa + GPU_TIMES_OFF + 16u * (fence % GPU_TIMES);
+		ring_put(cp_type7(0x3Eu, 3u));                   /* CP_REG_TO_MEM */
+		ring_put(A6XX_CP_ALWAYS_ON_COUNTER | 2u << 18 | 1u << 30);
+		ring_put((uint32_t)at);
+		ring_put((uint32_t)(at >> 32));
+	}
+	/* Per-submit cache-invalidate preamble: stale depth/colour cache state from the previous
+	 * draw must not corrupt this one. */
+	ring_put(cp_type7(0x46u, 1u));                       /* CP_EVENT_WRITE */
+	ring_put(0x00000018u);                               /* EVENT_INVALIDATE_DEPTH */
+	ring_put(cp_type7(0x46u, 1u));                       /* CP_EVENT_WRITE */
+	ring_put(0x00000019u);                               /* EVENT_INVALIDATE_COLOR */
+	for (i = 0; i < n; i++) {
+		ring_put(cp_type7(0x3Fu, 3u));                   /* CP_INDIRECT_BUFFER */
+		ring_put((uint32_t)ibva[i]);
+		ring_put((uint32_t)(ibva[i] >> 32));
+		ring_put(ibdw[i]);
+	}
+	{       /* the time at the end (redwood ring_time(fence, 1)) */
+		uint64_t at = g_res_pa + GPU_TIMES_OFF + 16u * (fence % GPU_TIMES) + 8u;
+		ring_put(cp_type7(0x3Eu, 3u));                   /* CP_REG_TO_MEM */
+		ring_put(A6XX_CP_ALWAYS_ON_COUNTER | 2u << 18 | 1u << 30);
+		ring_put((uint32_t)at);
+		ring_put((uint32_t)(at >> 32));
+	}
+	ring_put(cp_type4(A6XX_CP_SCRATCH_REG2, 1u));        /* the fence, for a hang's post-mortem */
+	ring_put(fence);
+	ring_put(cp_type7(0x46u, 4u));                       /* CP_EVENT_WRITE CACHE_FLUSH_TS */
+	ring_put(0x00000004u);
+	ring_put((uint32_t)(g_res_pa + GPU_FENCE_OFF));      /* phys, identity-mapped */
+	ring_put((uint32_t)((g_res_pa + GPU_FENCE_OFF) >> 32));
+	ring_put(fence);
+	__asm__ volatile("dsb sy" ::: "memory");             /* the ring is NC: the words are in memory */
+	gpu_wr(g_core, 0x807u << 2, g_wptr);                 /* CP_RB_WPTR doorbell */
+	__asm__ volatile("dsb sy" ::: "memory");
+	return fence;
+}
+
+/* The KGSL front-end (turnip) and the in-kernel self-tests submit synchronously: submit, then
+ * wait for that one fence. With the lock held. */
+static int
+kgsl_submit_ibs(const uint64_t *ibva, const uint32_t *ibdw, unsigned n)
+{
+	uint32_t fence = gpu_submit(ibva, ibdw, n);
+	if (fence == 0) {
+		return -2;
+	}
+	return gpu_wait(fence, 2000u) ? 0 : -2;
+}
+
+/* ===================== buffers given back =====================
+ * Ported from HackiOS RedwoodGPU.cpp (freeBuffer, reap, keep, dropKept, gemNew).
+ *
+ * A buffer given back while the GPU is still at it keeps its memory and its addresses until
+ * its submission is done ("left"), and nobody waits for that. A buffer of a program's own,
+ * given back and done with, is kept -- memory and addresses -- for the next one of the same
+ * size and kind from the same program ("kept"; CoreAnimation makes a texture per frame of an
+ * animation and gives them back a score at a time: each made afresh costs memory got, cleared,
+ * and entered page by page into the GPU's address space). At most GPU_KEPT_BYTES are kept, none
+ * for longer than GPU_KEPT_SECONDS. A buffer is never freed under a GPU that may still use it.
+ */
+struct gpu_left {
+	vm_offset_t cva; uint64_t gpuaddr; vm_size_t mmapsize; uint32_t flags; int pid;
+	void *surf; uint32_t surf_id; uint32_t fence;
+};
+#define GPU_LEFT 256u
+static struct gpu_left g_left[GPU_LEFT];
+static uint32_t g_left_count;
+
+struct gpu_kept {
+	vm_offset_t cva;    /* 0: this place is free */
+	uint64_t gpuaddr, pa, since; vm_size_t mmapsize; uint32_t flags; int pid;
+};
+#define GPU_KEPT          48u
+#define GPU_KEPT_BYTES    (160ull << 20)
+#define GPU_KEPT_SECONDS  60u
+#define GPU_KEEP_FROM     (256u << 10)      /* bytes: smaller ones are not worth it */
+static struct gpu_kept g_kept[GPU_KEPT];
+static uint64_t g_kept_bytes;
+static uint32_t g_bo_count;
+static uint64_t g_bo_bytes;
+
+/* What the last seconds' work was, for one log line every five (RedwoodGPU gGPUStat). */
+static struct {
+	uint64_t since, flushed;
+	uint32_t submissions, commands, buffers, surfaces, made, given_again, closed, left_now;
+} g_stat;
+
+/* A buffer's memory and addresses given up for good: the GPU is done with it. */
+static void
+gpu_bo_destroy(vm_offset_t cva, uint64_t gpuaddr, vm_size_t mmapsize, void *surf)
+{
+	gpu_unmap(gpuaddr, mmapsize);
+	gpu_address_free(gpuaddr, mmapsize);
+	if (cva) {
+		kmem_free(kernel_map, cva, mmapsize);
+	}
+	if (surf) {
+		sweet_surface_gpu_unref(surf);
+	}
+}
+
+static void
+gpu_drop_kept(struct gpu_kept *k)
+{
+	if (k->cva == 0) {
+		return;
+	}
+	gpu_bo_destroy(k->cva, k->gpuaddr, k->mmapsize, NULL);
+	g_kept_bytes -= k->mmapsize;
+	k->cva = 0;
+}
+
+/* RedwoodGPU keep: the GPU done with a buffer of a program's own -- kept if it is worth it
+ * (those kept longest make way). */
+static bool
+gpu_keep(vm_offset_t cva, uint64_t gpuaddr, uint64_t pa, vm_size_t mmapsize, uint32_t flags, int pid)
+{
+	struct gpu_kept *place;
+	unsigned i;
+	if (cva == 0 || mmapsize < GPU_KEEP_FROM || mmapsize > GPU_KEPT_BYTES / 4u) {
+		return false;
+	}
+	for (;;) {
+		struct gpu_kept *oldest = NULL;
+		place = NULL;
+		for (i = 0; i < GPU_KEPT; i++) {
+			if (g_kept[i].cva == 0) {
+				place = place ? place : &g_kept[i];
+			} else if (oldest == NULL || g_kept[i].since < oldest->since) {
+				oldest = &g_kept[i];
+			}
+		}
+		if (place != NULL && g_kept_bytes + mmapsize <= GPU_KEPT_BYTES) {
+			break;
+		}
+		gpu_drop_kept(oldest);
+	}
+	place->cva = cva;
+	place->gpuaddr = gpuaddr;
+	place->pa = pa;
+	place->mmapsize = mmapsize;
+	place->flags = flags;
+	place->pid = pid;
+	place->since = mach_absolute_time();
+	g_kept_bytes += mmapsize;
+	return true;
+}
+
+/* RedwoodGPU freeBuffer: a handle given back. With the lock held. If the GPU is not done
+ * with the buffer it goes on the left list; if that is full, it is waited for; and if the
+ * GPU never answers, the memory stays the GPU's for good (it may yet be written). */
+static void
+gpu_bo_release(struct kgsl_bo_ent *b)
+{
+	bool busy;
+	if (!b || b->used != 1) {
+		return;
+	}
+	b->used = 2;                                   /* nobody finds it while it is given back */
+	busy = b->fence != 0 && !gpu_done(b->fence);
+	if (busy && g_left_count == GPU_LEFT) {
+		busy = !gpu_wait(b->fence, 1000u);         /* nowhere to keep it: this one is waited for */
+	}
+	if (busy && g_left_count < GPU_LEFT) {
+		struct gpu_left *l = &g_left[g_left_count++];
+		l->cva = b->cva;
+		l->gpuaddr = b->gpuaddr;
+		l->mmapsize = b->mmapsize;
+		l->flags = b->flags;
+		l->pid = b->pid;
+		l->surf = b->surf;
+		l->surf_id = b->surf_id;
+		l->fence = b->fence;
+	} else if (busy) {
+		static uint32_t said;
+		if (said++ < 8u) {
+			printf("SWEET DRM: the GPU is not done with what it was given: a buffer of %lu bytes stays its own\n",
+			    (unsigned long)b->mmapsize);
+		}
+	} else if (!(b->surf == NULL && gpu_keep(b->cva, b->gpuaddr, b->pa, b->mmapsize, b->flags, b->pid))) {
+		gpu_bo_destroy(b->cva, b->gpuaddr, b->mmapsize, b->surf);
+	}
+	g_bo_count--;
+	g_bo_bytes -= b->mmapsize;
+	g_stat.closed++;
+	bzero(b, sizeof(*b));
+}
+
+/* RedwoodGPU reap: buffers given back early that the GPU is done with now. With the lock held. */
+static void
+gpu_reap(void)
+{
+	uint32_t i;
+	for (i = 0; i < g_left_count;) {
+		struct gpu_left *l = &g_left[i];
+		if (!gpu_done(l->fence)) {
+			i++;
+			continue;
+		}
+		if (!(l->surf == NULL &&
+		    gpu_keep(l->cva, l->gpuaddr, ptoa_64(pmap_find_phys(kernel_pmap, (addr64_t)l->cva)),
+		    l->mmapsize, l->flags, l->pid))) {
+			gpu_bo_destroy(l->cva, l->gpuaddr, l->mmapsize, l->surf);
+		}
+		*l = g_left[--g_left_count];
+	}
+}
+
+/* Reclaim contexts/BOs whose owning process has exited (pid no longer resolves), at most once
+ * a second: leaked GPU state of dead processes (a SIGKILLed backboardd) is given back the
+ * same way a close gives it back -- never under a GPU that may still use it. With the lock held. */
+static void
+kgsl_reap_dead(void)
+{
+	static uint64_t last;
+	uint64_t now = mach_absolute_time(), second;
+	unsigned i, nctx = 0, nbo = 0;
+	nanoseconds_to_absolutetime(NSEC_PER_SEC, &second);
+	if (last != 0 && now - last < second) {
+		return;
+	}
+	last = now;
+	for (i = 0; i < KGSL_MAX_CTX; i++) {
+		if (g_ctx[i].used && g_ctx[i].pid > 0) {
+			struct proc *p = proc_find(g_ctx[i].pid);
+			if (p) { proc_rele(p); } else { g_ctx[i].used = 0; nctx++; }
+		}
+	}
+	for (i = 0; i < KGSL_MAX_BO; i++) {
+		if (g_bo[i].used == 1 && g_bo[i].pid > 0) {
+			struct proc *p = proc_find(g_bo[i].pid);
+			if (p) { proc_rele(p); } else { gpu_bo_release(&g_bo[i]); nbo++; }
+		}
+	}
+	for (i = 0; i < GPU_KEPT; i++) {
+		if (g_kept[i].cva != 0 && g_kept[i].pid > 0) {
+			struct proc *p = proc_find(g_kept[i].pid);
+			if (p) { proc_rele(p); } else { gpu_drop_kept(&g_kept[i]); }
+		}
+	}
+	gpu_reap();
+	if (nctx || nbo) { printf("SWEET DRM: reaped %u dead ctx, %u dead bo\n", nctx, nbo); }
+}
+
+static int
+kgsl_do_drawctxt_create(uint32_t flags, uint32_t *out_id)
+{
+	unsigned i;
+	(void)flags;
+	kgsl_reap_dead();
+	for (i = 0; i < KGSL_MAX_CTX; i++) {
+		if (!g_ctx[i].used) {
+			g_ctx[i].used = 1;
+			g_ctx[i].id = g_ctx_next++;
+			g_ctx[i].ts_issued = 0;
+			g_ctx[i].ts_retired = 0;
+			g_ctx[i].pid = proc_selfpid();
+			*out_id = g_ctx[i].id;
+			return 0;
+		}
+	}
+	return -1;
+}
+static int
+kgsl_do_drawctxt_destroy(uint32_t id)
+{
+	struct kgsl_ctx_ent *c = kgsl_ctx_find(id);
+	if (!c) { return -1; }
+	c->used = 0;
+	return 0;
+}
+
+/* A free slot of the BO table; NULL: none. */
+static struct kgsl_bo_ent *
+kgsl_bo_slot(void)
+{
+	static unsigned next;
+	unsigned n;
+	for (n = 0; n < KGSL_MAX_BO; n++) {
+		unsigned i = (next + n) % KGSL_MAX_BO;      /* one given back is not the next given */
+		if (g_bo[i].used == 0) {
+			next = i + 1u;
+			return &g_bo[i];
+		}
+	}
+	return NULL;
+}
+
+/* GEM_NEW / GPUMEM_ALLOC (RedwoodGPU gemNew): one kept of this size and kind of this program's,
+ * if there is one (the one kept last), else made. With the lock held. */
+static int
+kgsl_do_gpumem_alloc(vm_size_t size, uint32_t flags, struct kgsl_bo_ent **out)
+{
+	struct kgsl_bo_ent *b;
+	struct gpu_kept *found = NULL;
+	uint64_t gpuaddr = 0, pa = 0, now = mach_absolute_time(), old;
+	vm_offset_t nc = 0, cva = 0;
+	vm_size_t asize = (size + (vm_size_t)PAGE_SIZE - 1) & ~((vm_size_t)PAGE_SIZE - 1);
+	uint32_t kflags = flags & ~(KGSL_MEMFLAGS_USE_CPU_MAP | KGSL_MEMFLAGS_IOCOHERENT);
+	int pid = proc_selfpid();
+	unsigned i;
+	if (asize == 0 || asize > (256u << 20)) {
+		return -1;
+	}
+	kgsl_reap_dead();
+	if ((b = kgsl_bo_slot()) == NULL) {
+		printf("SWEET DRM: no handles left for a buffer of %lu bytes (%u buffers, %llu MB)\n",
+		    (unsigned long)asize, g_bo_count, g_bo_bytes >> 20);
+		return -1;
+	}
+	nanoseconds_to_absolutetime((uint64_t)GPU_KEPT_SECONDS * NSEC_PER_SEC, &old);
+	for (i = 0; i < GPU_KEPT; i++) {
+		struct gpu_kept *k = &g_kept[i];
+		if (k->cva != 0 && now - k->since > old) {
+			gpu_drop_kept(k);
+		}
+		if (k->cva != 0 && k->mmapsize == asize && k->flags == kflags && k->pid == pid &&
+		    (found == NULL || k->since > found->since)) {
+			found = k;
+		}
+	}
+	if (found != NULL) {
+		cva = found->cva;
+		nc = found->cva;
+		gpuaddr = found->gpuaddr;
+		pa = found->pa;
+		g_kept_bytes -= found->mmapsize;
+		found->cva = 0;
+		g_stat.given_again++;
+	} else if (gpu_gpumem_alloc(asize, &gpuaddr, &nc, &pa, &cva) != 0) {
+		printf("SWEET DRM: no memory for a buffer of %lu bytes (%u buffers, %llu MB; va %llu MB used, %u refused)\n",
+		    (unsigned long)asize, g_bo_count, g_bo_bytes >> 20, gpu_va_used >> 20, gpu_va_refused);
+		return -1;
+	} else {
+		g_stat.made++;
+	}
+	bzero(b, sizeof(*b));
+	b->used = 1;
+	b->id = g_mmap_page_next;                    /* id = 4K-page offset base (16K aligned) */
+	g_mmap_page_next += (uint32_t)(asize / 0x1000u);
+	b->gpuaddr = gpuaddr;
+	b->pa = pa;
+	b->cpu_nc = nc;
+	b->cva = cva;                                /* cacheable kernel VA for BO CPU-map */
+	b->size = size;
+	b->mmapsize = asize;
+	/* we honour only WRITECOMBINE (cachemode bits[27:26]=0); drop capability bits we
+	 * don't implement so turnip's (flags & requested)==requested probe degrades */
+	b->flags = kflags;
+	b->pid = pid;
+	g_bo_count++;
+	g_bo_bytes += asize;
+	kgsl_bo_hint(b);
+	*out = b;
+	return 0;
+}
+static int
+kgsl_do_gpumem_free(uint32_t id)
+{
+	struct kgsl_bo_ent *b = kgsl_bo_find(id);
+	if (!b) { return -1; }
+	gpu_bo_release(b);
+	gpu_reap();
+	return 0;
+}
+
+/* GPU_COMMAND: copyin the IB list, submit the KGSL_CMDLIST_IB entries, assign the
+ * per-context timestamp (synchronous -> retired == issued on return). */
+static int
+kgsl_do_gpu_command(struct kgsl_gpu_command *gc, uint32_t *out_ts)
+{
+	struct kgsl_ctx_ent *c = kgsl_ctx_find(gc->context_id);
+	struct kgsl_command_object obj;
+	uint64_t ibva[16];
+	uint32_t ibdw[16];
+	unsigned n = 0, i;
+	int rc;
+	if (!c || gc->numcmds == 0 || gc->numcmds > 16u || gc->cmdsize < sizeof(obj)) {
+		return -1;
+	}
+	for (i = 0; i < gc->numcmds; i++) {
+		user_addr_t ea = (user_addr_t)(gc->cmdlist + (uint64_t)i * gc->cmdsize);
+		if (copyin(ea, &obj, sizeof(obj)) != 0) { return -1; }
+		if (obj.flags & KGSL_CMDLIST_IB) {
+			ibva[n] = obj.gpuaddr + obj.offset;
+			ibdw[n] = (uint32_t)(obj.size / 4u);
+			n++;
+		}
+	}
+	if (n == 0) { return -1; }
+	rc = kgsl_submit_ibs(ibva, ibdw, n);
+	if (rc != 0) { return rc; }
+	c->ts_issued++;
+	c->ts_retired = c->ts_issued;
+	*out_ts = c->ts_issued;
+	return 0;
+}
+
+static void
+kgsl_fill_devinfo(struct kgsl_devinfo *di)
+{
+	bzero(di, sizeof(*di));
+	di->device_id = 1;
+	di->chip_id = 0x06010800u;         /* Adreno a618 - the field turnip derives gpu_id 618 from */
+	di->mmu_enabled = 1;               /* stage-1 pagetables are up */
+	di->gpu_id = 618;
+	di->gmem_sizebytes = 0x80000u;     /* a618 GMEM = 512 KB (Linux adreno_device.c SZ_512K) */
+}
+
+/*
+ * The device nodes are there from the start (gpu_nodes_register), and an open waits until the
+ * GPU's bring-up is over: whoever opens one -- backboardd's GLES context for CoreAnimation --
+ * gets the GPU, or ENXIO if the bring-up failed, never "no such file" because it was early.
+ * (HackiOS's system does not go on starting until the GPU is up; here the bring-up runs in its
+ * own thread, and it was a race: the window server sometimes started before the GPU was there
+ * and drew in software for the rest of the run.)
+ */
+static volatile int g_gpu_boot_done;   /* the bring-up thread is through (g_kgsl_ready says how) */
+static int
+kgsl_open(__unused dev_t dev, __unused int f, __unused int dt, __unused struct proc *p)
+{
+	unsigned waited;
+	for (waited = 0; !g_gpu_boot_done && waited < 1200u; waited++) {   /* 120 s at most */
+		uint64_t deadline;
+		clock_interval_to_deadline(100, NSEC_PER_MSEC, &deadline);
+		assert_wait_deadline((event_t)&g_gpu_boot_done, THREAD_UNINT, deadline);
+		thread_block(THREAD_CONTINUE_NULL);
+	}
+	if (waited != 0) {
+		printf("SWEET GPU: an open waited %u ms for the bring-up: %s\n", waited * 100u,
+		    g_kgsl_ready ? "the GPU is there" : "NO GPU");
+	}
+	return g_kgsl_ready ? 0 : ENXIO;
+}
+static int kgsl_close(__unused dev_t dev, __unused int f, __unused int dt, __unused struct proc *p) { return 0; }
+static int kgsl_norw(__unused dev_t dev, __unused struct uio *uio, __unused int ioflag) { return ENODEV; }
+
+/* copy a kernel scalar out to the getproperty.value user ptr */
+static int
+kgsl_prop_out(struct kgsl_device_getproperty *gp, const void *src, vm_size_t len)
+{
+	if (!gp->value || gp->sizebytes < len) { return EINVAL; }
+	return copyout(src, (user_addr_t)(uintptr_t)gp->value, len);
+}
+
+static int drm_do_gem_mmap(struct kgsl_bo_ent *bo, uint64_t *out_uaddr);
+/* With the lock held (kgsl_ioctl). */
+static int
+kgsl_ioctl_locked(unsigned nr, caddr_t data)
+{
+	switch (nr) {
+	case KGSL_IOC_GETPROPERTY: {
+		struct kgsl_device_getproperty *gp = (struct kgsl_device_getproperty *)data;
+		switch (gp->type) {
+		case KGSL_PROP_DEVICE_INFO: {
+			struct kgsl_devinfo di; kgsl_fill_devinfo(&di);
+			return kgsl_prop_out(gp, &di, sizeof(di));
+		}
+		case KGSL_PROP_UCHE_GMEM_VADDR: { uint64_t v = 0x100000000ull; return kgsl_prop_out(gp, &v, 8); }
+		case KGSL_PROP_HIGHEST_BANK_BIT:{ uint32_t v = 14u; return kgsl_prop_out(gp, &v, 4); }   /* a618 (VERIFY) */
+		case KGSL_PROP_UBWC_MODE:       { uint32_t v = 1u;  return kgsl_prop_out(gp, &v, 4); }   /* UBWC enabled (VERIFY) */
+		case KGSL_PROP_UCHE_TRAP_BASE:  { uint64_t v = 0x1fffffffff000ull; return kgsl_prop_out(gp, &v, 8); }
+		case KGSL_PROP_GPU_VA64_SIZE:   { uint64_t v = (1ull << 48); return kgsl_prop_out(gp, &v, 8); }
+		case KGSL_PROP_IS_RAYTRACING:   { uint32_t v = 0u; return kgsl_prop_out(gp, &v, 4); }
+		case KGSL_PROP_GPU_RESET_STAT:  { uint32_t v = 0u; return kgsl_prop_out(gp, &v, 4); }  /* NO_ERROR: never report a GPU reset (synchronous submits) -> turnip check_status passes */
+		default:
+			return EINVAL;   /* turnip falls back / treats unknown props as unsupported */
+		}
+	}
+	case KGSL_IOC_DRAWCTXT_CREATE: {
+		struct kgsl_drawctxt_create *dc = (struct kgsl_drawctxt_create *)data;
+		uint32_t id = 0;
+		if (kgsl_do_drawctxt_create(dc->flags, &id) != 0) { return ENOMEM; }
+		dc->drawctxt_id = id;
+		return 0;
+	}
+	case KGSL_IOC_DRAWCTXT_DESTROY: {
+		struct kgsl_drawctxt_destroy *dd = (struct kgsl_drawctxt_destroy *)data;
+		return kgsl_do_drawctxt_destroy(dd->drawctxt_id) == 0 ? 0 : EINVAL;
+	}
+	case KGSL_IOC_GPUMEM_ALLOC_ID: {
+		struct kgsl_gpumem_alloc_id *ga = (struct kgsl_gpumem_alloc_id *)data;
+		struct kgsl_bo_ent *bo = NULL;
+		if (kgsl_do_gpumem_alloc((vm_size_t)ga->size, ga->flags, &bo) != 0) { return ENOMEM; }
+		ga->id = bo->id;
+		ga->flags = bo->flags;          /* echo honoured flags (capability probe) */
+		ga->size = bo->size;
+		ga->mmapsize = bo->mmapsize;
+		ga->gpuaddr = bo->gpuaddr;
+		return 0;
+	}
+	case KGSL_IOC_GPUMEM_FREE_ID: {
+		struct kgsl_gpumem_free_id *gf = (struct kgsl_gpumem_free_id *)data;
+		return kgsl_do_gpumem_free(gf->id) == 0 ? 0 : EINVAL;
+	}
+	case KGSL_IOC_GPU_COMMAND: {
+		struct kgsl_gpu_command *gc = (struct kgsl_gpu_command *)data;
+		uint32_t ts = 0;
+		int rc = kgsl_do_gpu_command(gc, &ts);
+		if (rc != 0) { return (rc == -1) ? EINVAL : EIO; }
+		gc->timestamp = ts;
+		return 0;
+	}
+	case KGSL_IOC_READTIMESTAMP_CID: {
+		struct kgsl_cmdstream_readtimestamp_ctxtid *rt =
+		    (struct kgsl_cmdstream_readtimestamp_ctxtid *)data;
+		struct kgsl_ctx_ent *c = kgsl_ctx_find(rt->context_id);
+		if (!c) { return EINVAL; }
+		rt->timestamp = c->ts_retired;   /* synchronous submit: retired == latest */
+		return 0;
+	}
+	case KGSL_IOC_WAITTIMESTAMP_CID: {
+		/* NOTE: pure _IOW -> under Linux ioccom XNU won't copyin (see banner); the
+		 * Mesa build must use XNU ioccom for this nr. Synchronous submit means the
+		 * target is already retired, so success is immediate when the ctx exists. */
+		struct kgsl_device_waittimestamp_ctxtid *wt =
+		    (struct kgsl_device_waittimestamp_ctxtid *)data;
+		struct kgsl_ctx_ent *c = kgsl_ctx_find(wt->context_id);
+		if (!c) { return EINVAL; }
+		return 0;
+	}
+	case 0x60: {   /* IOCTL_KGSL_SWEET_BO_MAP: map a BO into the caller, return uaddr.
+	                * XNU won't route mmap() to d_mmap, so turnip calls this instead. */
+		struct sweet_bo_map { uint32_t id; uint32_t pad; uint64_t uaddr; };
+		struct sweet_bo_map *mp = (struct sweet_bo_map *)data;
+		struct kgsl_bo_ent *bo = kgsl_bo_find(mp->id);
+		uint64_t ua = 0;
+		if (!bo) { return EINVAL; }
+		if (drm_do_gem_mmap(bo, &ua) != 0) { return ENOMEM; }
+		mp->uaddr = ua;
+		return 0;
+	}
+	default:
+		return 0;   /* accepted (Tier-2/3 stub) */
+	}
+}
+
+static int
+kgsl_ioctl(__unused dev_t dev, u_long cmd, caddr_t data, __unused int flag, __unused struct proc *p)
+{
+	unsigned nr  = (unsigned)(cmd & 0xffu);
+	unsigned grp = (unsigned)((cmd >> 8) & 0xffu);
+	int e;
+	if (grp != KGSL_IOC_TYPE) {
+		return ENOTTY;
+	}
+	gpu_lock();
+	e = kgsl_ioctl_locked(nr, data);
+	gpu_unlock();
+	return e;
+}
+
+/* mmap() of a GPU object: userland (turnip on /dev/kgsl, freedreno on the DRM node)
+ * maps a BO at file offset (bo->id << 12; MSM_INFO_GET_OFFSET also returns that).
+ * Each BO owns a disjoint offset range [id<<12, id<<12+mmapsize) and is physically
+ * contiguous from bo->pa, so return the 16K page frame for the faulting page.
+ * The device_pager calls this per page with off advancing by PAGE_SIZE. */
+static int
+kgsl_mmap(__unused dev_t dev, off_t off, __unused int prot)
+{
+	unsigned i;
+	uint64_t o = (uint64_t)off;
+	for (i = 0; i < KGSL_MAX_BO; i++) {
+		uint64_t base;
+		if (!g_bo[i].used) { continue; }
+		base = (uint64_t)g_bo[i].id << 12;
+		if (o >= base && o < base + (uint64_t)g_bo[i].mmapsize) {
+			uint64_t pa = g_bo[i].pa + (o - base);
+			return (int)(ppnum_t)(pa >> 14);   /* 16K page frame number */
+		}
+	}
+	printf("SWEET KGSL: mmap miss off=%#llx\n", (unsigned long long)off);
+	return -1;
+}
+
+static const struct cdevsw kgsl_cdevsw = {
+	.d_open       = kgsl_open,
+	.d_close      = kgsl_close,
+	.d_read       = kgsl_norw,
+	.d_write      = kgsl_norw,
+	.d_ioctl      = kgsl_ioctl,
+	.d_stop       = eno_stop,
+	.d_reset      = eno_reset,
+	.d_ttys       = NULL,
+	.d_select     = eno_select,
+	.d_mmap       = kgsl_mmap,   /* map GPUOBJ BOs to userland (turnip BO map) */
+	.d_strategy   = eno_strat,
+	.d_reserved_1 = eno_getc,
+	.d_reserved_2 = eno_putc,
+	.d_type       = 0,
+};
+
+/* In-kernel self-test of the UAPI core: create a context, alloc two BOs via the
+ * GPUMEM_ALLOC handler, build a CP_MEM_WRITE IB in one that stores a magic to the
+ * other's GPU VA, submit it via the submit path, assign the timestamp, and verify
+ * the store landed. Runs in the boot/probe thread (same as gpu_stage_s), so it is
+ * as safe as the existing stages and needs no userland client. */
+static void
+gpu_stage_u(void)
+{
+	uint32_t cid = 0, got;
+	struct kgsl_bo_ent *ib = NULL, *dst = NULL;
+	struct kgsl_ctx_ent *c;
+	uint64_t ibva;
+	uint32_t ibdw;
+	int rc;
+	if (!g_kgsl_ready) {
+		printf("SWEET KGSL: [U] selftest skipped (submit path not published)\n");
+		return;
+	}
+	if (kgsl_do_drawctxt_create(0x13u, &cid) != 0) {
+		printf("SWEET KGSL: [U] drawctxt_create FAIL\n"); return;
+	}
+	gpu_lock();
+	if (kgsl_do_gpumem_alloc(PAGE_SIZE, 0, &ib) != 0 ||
+	    kgsl_do_gpumem_alloc(PAGE_SIZE, 0, &dst) != 0) {
+		gpu_unlock();
+		printf("SWEET KGSL: [U] gpumem_alloc FAIL\n"); return;
+	}
+	gpu_unlock();
+	*(volatile uint32_t *)dst->cpu_nc = 0;
+	((volatile uint32_t *)ib->cpu_nc)[0] = cp_type7(0x3Du, 3u);     /* CP_MEM_WRITE -> dst gpuaddr */
+	((volatile uint32_t *)ib->cpu_nc)[1] = (uint32_t)dst->gpuaddr;
+	((volatile uint32_t *)ib->cpu_nc)[2] = (uint32_t)(dst->gpuaddr >> 32);
+	((volatile uint32_t *)ib->cpu_nc)[3] = 0x5AFE600Du;
+	gpu_dcache_clean(ib->cpu_nc, PAGE_SIZE);    /* cacheable cva: flush IB + cleared dst to DRAM */
+	gpu_dcache_clean(dst->cpu_nc, PAGE_SIZE);
+	__asm__ volatile("dsb sy" ::: "memory");
+	ibva = ib->gpuaddr;
+	ibdw = 4u;
+	gpu_lock();
+	rc = kgsl_submit_ibs(&ibva, &ibdw, 1);
+	gpu_unlock();
+	c = kgsl_ctx_find(cid);
+	if (c && rc == 0) { c->ts_issued++; c->ts_retired = c->ts_issued; }
+	gpu_dcache_clean(dst->cpu_nc, PAGE_SIZE);   /* invalidate: CPU re-reads GPU-written DRAM */
+	got = *(volatile uint32_t *)dst->cpu_nc;
+	printf("SWEET KGSL: [U] UAPI SELFTEST ctx=%u ib_id=%u(va=%#llx) dst_id=%u(va=%#llx) "
+	    "submit_rc=%d ts=%u readback=%#x(exp 5afe600d) -> %s\n",
+	    cid, ib->id, (unsigned long long)ib->gpuaddr, dst->id, (unsigned long long)dst->gpuaddr,
+	    rc, c ? c->ts_retired : 0, got,
+	    (rc == 0 && got == 0x5AFE600Du) ?
+	    "KGSL UAPI SUBMIT OK (create+alloc+submit+ts via ioctl handlers)" : "FAIL");
+	gmub_flush();
+}
+
+static int g_kgsl_major = -1;
+static void
+gpu_kgsl_init(void)
+{
+	struct kgsl_devinfo di;
+	if (g_kgsl_major < 0) {
+		return;                 /* not registered (gpu_nodes_register) */
+	}
+	kgsl_fill_devinfo(&di);     /* in-kernel self-test of the DEVICE_INFO reply */
+	printf("SWEET KGSL: /dev/kgsl-3d0 registered (major=%d); devinfo chip_id=%#x gpu_id=%u -> %s\n",
+	    g_kgsl_major, di.chip_id, di.gpu_id,
+	    (di.chip_id == 0x06010800u) ? "DEVINFO OK (a618) = cdev ready for userland freedreno"
+	    : "BAD chip_id");
+	gpu_stage_u();              /* exercise create+alloc+submit+timestamp through the handlers */
+}
+
+/* ===================== /dev/dri/renderD128 MSM-DRM UAPI =====================
+ * Second GPU front-end: the upstream-Linux MSM DRM render-node ioctls that Mesa's
+ * gallium **freedreno** OpenGL-ES driver speaks (contract in gpu/userland/mesa/
+ * MSM-DRM-IOCTL-SURFACE.md). This is the collaborator's path (gallium-freedreno
+ * GLES injected into backboardd; no zink/turnip/Metal). It wraps the SAME proven
+ * ring/iova/submit core (kgsl_submit_ibs + gpu_gpumem_alloc + the g_bo table) as
+ * the KGSL front-end; only the ioctl envelope differs: BOs are GEM handles, iova
+ * comes from GEM_INFO(GET_IOVA), and the retire token is a per-queue fence seqno.
+ * DRM ioctls use type 'd'=0x64. All structs arm64/LP64. An in-kernel self-test
+ * (gpu_stage_v) exercises GEM_NEW->submit->fence through the shared core.
+ *
+ * NOTE (same _IOC gotcha as KGSL): Mesa talks through a libdrm shim we control
+ * (mesa/ios-libdrm-shim/xf86drm.h). _IOWR ioctls (VERSION/GET_PARAM/GEM_NEW/
+ * GEM_INFO/GEM_SUBMIT) copyin+out fine under XNU; the pure-_IOW ones (GEM_CLOSE,
+ * GEM_CPU_PREP, WAIT_FENCE, SUBMITQUEUE_CLOSE) are XNU-IOC_OUT-only, so the shim
+ * must encode those with IOC_IN for the kernel to receive their input. */
+#define DRM_IOC_TYPE 0x64u       /* 'd' */
+/* core DRM nrs */
+#define DRM_NR_VERSION      0x00u
+#define DRM_NR_GET_CAP      0x0cu
+#define DRM_NR_GEM_CLOSE    0x09u
+/* MSM nrs (0x40 + index) */
+#define DRM_NR_MSM_GET_PARAM       0x40u
+#define DRM_NR_MSM_GEM_NEW         0x42u
+#define DRM_NR_MSM_GEM_INFO        0x43u
+#define DRM_NR_MSM_GEM_CPU_PREP    0x44u
+#define DRM_NR_MSM_GEM_SUBMIT      0x46u
+#define DRM_NR_MSM_WAIT_FENCE      0x47u
+#define DRM_NR_MSM_GEM_MADVISE     0x48u
+#define DRM_NR_MSM_SUBMITQUEUE_NEW 0x4Au
+#define DRM_NR_MSM_SUBMITQUEUE_CLOSE 0x4Bu
+#define DRM_NR_MSM_SUBMITQUEUE_QUERY 0x4Cu
+/* MSM_PARAM_* */
+#define MSM_PARAM_GPU_ID    0x01u
+#define MSM_PARAM_GMEM_SIZE 0x02u
+#define MSM_PARAM_CHIP_ID   0x03u
+#define MSM_PARAM_MAX_FREQ  0x04u
+#define MSM_PARAM_TIMESTAMP 0x05u
+#define MSM_PARAM_GMEM_BASE 0x06u
+#define MSM_PARAM_PRIORITIES 0x07u
+#define MSM_PARAM_VA_START  0x0eu
+#define MSM_PARAM_VA_SIZE   0x0fu
+/* MSM_INFO_* */
+#define MSM_INFO_GET_OFFSET 0x00u
+#define MSM_INFO_GET_IOVA   0x01u
+#define MSM_SUBMIT_CMD_BUF  0x01u
+
+struct drm_version {                  /* size 64 */
+	int           version_major;
+	int           version_minor;
+	int           version_patchlevel;
+	unsigned long name_len;           /* @16 */
+	char         *name;               /* @24 */
+	unsigned long date_len;
+	char         *date;
+	unsigned long desc_len;
+	char         *desc;
+};
+struct drm_get_cap   { uint64_t capability; uint64_t value; };          /* 16 */
+struct drm_gem_close { uint32_t handle; uint32_t pad; };                /* 8  */
+struct drm_msm_param { uint32_t pipe; uint32_t param; uint64_t value; uint32_t len; uint32_t pad; }; /* 24 */
+struct drm_msm_gem_new  { uint64_t size; uint32_t flags; uint32_t handle; };  /* 16 */
+struct drm_msm_gem_info { uint32_t handle; uint32_t info; uint64_t value; uint32_t len; uint32_t pad; }; /* 24 */
+struct drm_msm_timespec { int64_t tv_sec; int64_t tv_nsec; };           /* 16 */
+struct drm_msm_gem_cpu_prep { uint32_t handle; uint32_t op; struct drm_msm_timespec timeout; }; /* 24 */
+struct drm_msm_gem_submit {           /* size 72 */
+	uint32_t flags; uint32_t fence; uint32_t nr_bos; uint32_t nr_cmds;
+	uint64_t bos; uint64_t cmds; int32_t fence_fd; uint32_t queueid;
+	uint64_t in_syncobjs; uint64_t out_syncobjs;
+	uint32_t nr_in_syncobjs; uint32_t nr_out_syncobjs; uint32_t syncobj_stride; uint32_t pad;
+};
+struct drm_msm_gem_submit_bo  { uint32_t flags; uint32_t handle; uint64_t presumed; };  /* 16 */
+struct drm_msm_gem_submit_cmd { uint32_t type; uint32_t submit_idx; uint32_t submit_offset;
+	uint32_t size; uint32_t pad; uint32_t nr_relocs; uint64_t relocs; };                /* 40 */
+struct drm_msm_wait_fence { uint32_t fence; uint32_t flags; struct drm_msm_timespec timeout;
+	uint32_t queueid; uint32_t pad; };                                                  /* 32 */
+struct drm_msm_submitqueue { uint32_t flags; uint32_t prio; uint32_t id; };             /* 12 */
+struct drm_msm_gem_madvise  { uint32_t handle; uint32_t madv; uint32_t retained; };     /* 12 */
+
+static uint32_t g_sq_next = 1;      /* submitqueue id counter */
+
+static int
+drm_do_get_param(uint32_t param, uint64_t *out)
+{
+	switch (param) {
+	case MSM_PARAM_CHIP_ID:   *out = 0x06010800ull; return 0;  /* the field freedreno derives gen from */
+	case MSM_PARAM_GPU_ID:    *out = 618u;          return 0;
+	case MSM_PARAM_GMEM_SIZE: *out = 0x80000u;      return 0;  /* a618: 512 KB (Linux adreno_device.c SZ_512K); 1 MB made Mesa's bins overlap */
+	case MSM_PARAM_GMEM_BASE: *out = 0x100000u;     return 0;
+	case MSM_PARAM_MAX_FREQ:  *out = 500000000u;    return 0;
+	case MSM_PARAM_TIMESTAMP: *out = mach_absolute_time(); return 0;
+	case MSM_PARAM_PRIORITIES:*out = 1;             return 0;
+	case MSM_PARAM_VA_START:  *out = (uint64_t)GPU_VA_L1_FIRST << 30; return 0;  /* where buffers are put (the kernel puts them) */
+	case MSM_PARAM_VA_SIZE:   *out = GPU_VA_END - ((uint64_t)GPU_VA_L1_FIRST << 30); return 0;
+	default: return EINVAL;    /* freedreno treats most params as optional */
+	}
+}
+
+/* GEM_SUBMIT (port of HackiOS RedwoodGPU::submit). With the lock held.
+ *  - each CMD_BUF resolved to its BO's address, checked to lie inside the BO;
+ *  - every IOSurface the submission names pushed out of this processor's cache when its seed
+ *    says it has changed, and in any case once in GPU_PUSH_AGAIN_MS (not everybody who draws
+ *    into a surface says so): the GPU reads memory, uncached;
+ *  - the submission put in the ring, not waited for;
+ *  - every BO it names given its fence: a BO given back before that fence is done keeps its
+ *    memory and addresses until it is (gpu_bo_release), and the display waits for a surface's
+ *    fence before it shows it (sweet_gpu_surface_wait). */
+static int
+drm_do_gem_submit(struct drm_msm_gem_submit *s, uint32_t *out_fence)
+{
+	uint64_t ibva[GPU_SUBMIT_CMDS];
+	uint32_t ibdw[GPU_SUBMIT_CMDS];
+	struct drm_msm_gem_submit_bo chunk[32];
+	uint64_t began = mach_absolute_time(), again, nanos;
+	unsigned n = 0, i, j;
+	uint32_t fence;
+	if (s->nr_cmds == 0 || s->nr_cmds > GPU_SUBMIT_CMDS || s->nr_bos == 0 || s->nr_bos > GPU_SUBMIT_BOS) {
+		printf("SWEET DRM: a submission of %u command buffers in %u buffers: not taken\n", s->nr_cmds, s->nr_bos);
+		return EINVAL;
+	}
+	for (i = 0; i < s->nr_cmds; i++) {
+		struct drm_msm_gem_submit_cmd c;
+		struct drm_msm_gem_submit_bo  b;
+		struct kgsl_bo_ent *bo;
+		if (copyin((user_addr_t)(s->cmds + (uint64_t)i * sizeof(c)), &c, sizeof(c)) != 0) { return EFAULT; }
+		if (c.type != MSM_SUBMIT_CMD_BUF) { continue; }   /* the other kinds are for a GPU shared between address spaces */
+		if (c.submit_idx >= s->nr_bos) { return EINVAL; }
+		if (copyin((user_addr_t)(s->bos + (uint64_t)c.submit_idx * sizeof(b)), &b, sizeof(b)) != 0) { return EFAULT; }
+		bo = kgsl_bo_find(b.handle);
+		if (!bo || c.nr_relocs != 0 || (c.size & 3u) || (c.submit_offset & 3u) ||
+		    (uint64_t)c.submit_offset + c.size > bo->mmapsize) {
+			printf("SWEET DRM: command buffer %u of a submission: buffer %u, offset %u, %u bytes, %u relocations: not taken\n",
+			    i, b.handle, c.submit_offset, c.size, c.nr_relocs);
+			return EINVAL;
+		}
+		ibva[n] = bo->gpuaddr + c.submit_offset;
+		ibdw[n] = c.size / 4u;
+		n++;
+	}
+	if (n == 0) { return EINVAL; }
+	nanoseconds_to_absolutetime((uint64_t)GPU_PUSH_AGAIN_MS * NSEC_PER_MSEC, &again);
+	for (i = 0; i < s->nr_bos; i += j) {
+		unsigned m = s->nr_bos - i < 32u ? s->nr_bos - i : 32u;
+		if (copyin((user_addr_t)(s->bos + (uint64_t)i * sizeof(chunk[0])), chunk, m * sizeof(chunk[0])) != 0) { return EFAULT; }
+		for (j = 0; j < m; j++) {
+			struct kgsl_bo_ent *b = kgsl_bo_find(chunk[j].handle);
+			uint32_t seed;
+			if (b == NULL || b->surf == NULL) { continue; }
+			seed = sweet_surface_gpu_seed(b->surf);
+			if (seed == b->seed && began - b->pushed < again) { continue; }
+			b->seed = seed;
+			b->pushed = began;
+			sweet_surface_gpu_flush(b->surf);
+			g_stat.flushed += b->mmapsize;
+		}
+	}
+	__asm__ volatile("dsb sy" ::: "memory");             /* and what was written last is in memory */
+	fence = gpu_submit(ibva, ibdw, n);
+	if (fence == 0) {
+		return EIO;                                      /* the ring stayed full: the core is not reading it */
+	}
+	for (i = 0; i < s->nr_bos; i += j) {
+		unsigned m = s->nr_bos - i < 32u ? s->nr_bos - i : 32u;
+		if (copyin((user_addr_t)(s->bos + (uint64_t)i * sizeof(chunk[0])), chunk, m * sizeof(chunk[0])) != 0) { break; }
+		for (j = 0; j < m; j++) {
+			struct kgsl_bo_ent *b = kgsl_bo_find(chunk[j].handle);
+			if (b != NULL) { b->fence = fence; }
+		}
+	}
+	gpu_reap();
+	/* every five seconds in which something was submitted: how much, and what it cost (RedwoodGPU) */
+	g_stat.submissions++;
+	g_stat.commands += n;
+	g_stat.buffers += s->nr_bos;
+	if (g_stat.since == 0) { g_stat.since = began; }
+	absolutetime_to_nanoseconds(mach_absolute_time() - g_stat.since, &nanos);
+	if (nanos >= 5ull * NSEC_PER_SEC) {
+		uint64_t waiting;
+		absolutetime_to_nanoseconds(g_waiting, &waiting);
+		gpu_times();
+		thermal_report();
+		{
+			static unsigned every;
+			if (every++ % 6u == 0) {
+				battery_report();
+			}
+		}
+		{
+			volatile uint64_t *tm = (volatile uint64_t *)(g_res_nc + GPU_TIMES_OFF);
+			uint32_t last = *(volatile uint32_t *)(g_res_nc + GPU_FENCE_OFF) % GPU_TIMES;
+			uint64_t mhz = g_gpu_nlevels ? g_gpu_mhz[g_gpu_level < g_gpu_nlevels ? g_gpu_level : g_gpu_nlevels - 1u] : 180u;
+			printf("SWEET DRM: the GPU worked %llu us on each of %u submissions (%llu ms in all, %llu Mcycles), level %u "
+			    "(%llu MHz); last slot %u begin %#llx end %#llx\n",
+			    g_gpu_timed ? g_gpu_ticks / mhz / g_gpu_timed : 0, g_gpu_timed, g_gpu_ticks / mhz / 1000,
+			    g_gpu_ticks / 1000000u, g_gpu_level, mhz, last, tm[2 * last], tm[2 * last + 1]);
+		}
+		g_gpu_ticks = 0;
+		g_gpu_timed = 0;
+		printf("SWEET DRM: %u submissions in %llu ms (%u IBs, %u buffers named, %llu KB of surfaces out of the cache); "
+		    "fence %u done %u; buffers: %u made, %u kept ones given again, %u given back, %u left, %llu MB kept; "
+		    "%u buffers %llu MB; %u waits of %llu us; va %llu MB in %u, %u holes (%u most), %llu KB lost, %u refused\n",
+		    g_stat.submissions, nanos / NSEC_PER_MSEC, g_stat.commands, g_stat.buffers, g_stat.flushed >> 10,
+		    g_fence, *(volatile uint32_t *)(g_res_nc + GPU_FENCE_OFF),
+		    g_stat.made, g_stat.given_again, g_stat.closed, g_left_count, g_kept_bytes >> 20,
+		    g_bo_count, g_bo_bytes >> 20, g_waits, g_waits ? waiting / NSEC_PER_USEC / g_waits : 0,
+		    gpu_va_used >> 20, gpu_va_live, gpu_free_count, gpu_va_holes, gpu_va_lost >> 10, gpu_va_refused);
+		bzero(&g_stat, sizeof(g_stat));
+		g_waits = 0;
+		g_waiting = 0;
+	}
+	*out_fence = fence;
+	return 0;
+}
+
+/* How long from now an msm time is, in milliseconds (0: now or past), at most GPU_PATIENCE_MS.
+ * msm's clock goes on while the machine sleeps (CLOCK_MONOTONIC on Darwin), as RedwoodGPU has it. */
+static uint64_t
+drm_ms_until(const struct drm_msm_timespec *when)
+{
+	uint64_t now;
+	int64_t left;
+	absolutetime_to_nanoseconds(mach_continuous_time(), &now);
+	left = when->tv_sec * (int64_t)NSEC_PER_SEC + when->tv_nsec - (int64_t)now;
+	if (left <= 0) {
+		return 0;
+	}
+	return (uint64_t)left / NSEC_PER_MSEC > GPU_PATIENCE_MS ? GPU_PATIENCE_MS : (uint64_t)left / NSEC_PER_MSEC;
+}
+
+/* ---- BO CPU-map (Route B): iOS has no cdev mmap() path, so instead of
+ * mmap(fd, offset) we expose a private GEM_INFO op (MSM_INFO_IOS_MMAP) that maps
+ * the BO's physically-contiguous pages into the calling (Mesa) task as write-
+ * combine (Normal-NC) and returns the user VA. WC matches the GPU's stage-1
+ * Normal-NC view, so CPU<->GPU stay coherent with only the submit path's dsb sy.
+ * See gpu/userland/mesa/BO-MMAP-DESIGN.md. Our patched msm_bo.c calls this. ---- */
+#define MSM_INFO_IOS_MMAP 0x80u    /* private, outside the real 0x00..0x07 range */
+extern vm_map_t      current_map(void);
+extern kern_return_t mach_make_memory_entry_64(vm_map_t target_map,
+                         memory_object_size_t *size, memory_object_offset_t offset,
+                         vm_prot_t permission, ipc_port_t *object_handle,
+                         ipc_port_t parent_handle);
+extern kern_return_t mach_vm_map_external(vm_map_t target_map,
+                         mach_vm_offset_t *address, mach_vm_size_t initial_size,
+                         mach_vm_offset_t mask, int flags, ipc_port_t port,
+                         vm_object_offset_t offset, boolean_t copy,
+                         vm_prot_t cur_protection, vm_prot_t max_protection,
+                         vm_inherit_t inheritance);
+extern void          mach_memory_entry_port_release(ipc_port_t port);
+
+static int
+drm_do_gem_mmap(struct kgsl_bo_ent *bo, uint64_t *out_uaddr)
+{
+	kern_return_t        kr;
+	ipc_port_t           entry      = IPC_PORT_NULL;
+	memory_object_size_t entry_size = (memory_object_size_t)bo->mmapsize;
+	mach_vm_offset_t     uaddr      = 0;
+	vm_prot_t            perm;
+
+	if (!bo->cva || bo->mmapsize == 0) {
+		return EINVAL;
+	}
+	/* named entry over the BO's object-backed cacheable kernel range, forcing WC
+	 * (cache mode = bits[31:24] of permission; MAP_MEM_WCOMB<<24, outside the flag mask) */
+	perm = VM_PROT_READ | VM_PROT_WRITE | ((vm_prot_t)MAP_MEM_WCOMB << 24);
+	kr = mach_make_memory_entry_64(kernel_map, &entry_size,
+	        (memory_object_offset_t)bo->cva, perm, &entry, IPC_PORT_NULL);
+	if (kr != KERN_SUCCESS || entry == IPC_PORT_NULL) {
+		printf("SWEET DRM: gem_mmap mem_entry id=%u kr=%d\n", bo->id, kr);
+		return ENOMEM;
+	}
+	kr = mach_vm_map_external(current_map(), &uaddr,
+	        (mach_vm_size_t)entry_size, 0, VM_FLAGS_ANYWHERE, entry,
+	        0, FALSE, VM_PROT_READ | VM_PROT_WRITE, VM_PROT_READ | VM_PROT_WRITE,
+	        VM_INHERIT_SHARE);
+	mach_memory_entry_port_release(entry);
+	if (kr != KERN_SUCCESS) {
+		printf("SWEET DRM: gem_mmap vm_map id=%u kr=%d\n", bo->id, kr);
+		return ENOMEM;
+	}
+	{
+		static uint32_t told;
+		if (told++ < 16u) {
+			printf("SWEET DRM: gem_mmap id=%u iova=%#llx -> uva=%#llx size=%#lx (WC)\n",
+			    bo->id, (unsigned long long)bo->gpuaddr, (unsigned long long)uaddr,
+			    (unsigned long)bo->mmapsize);
+		}
+	}
+	*out_uaddr = (uint64_t)uaddr;
+	return 0;
+}
+
+/* ---- Zero-copy IOSurface import (MSM_INFO_IOS_IMPORT) ---------------------
+ * Port of HackiOS RedwoodGPUUserClient::surfaceBuffer: the memory of an IOSurface as a GEM
+ * buffer, which freedreno samples or draws into DIRECTLY (eglCreateImageKHR dma-buf path,
+ * fd==handle) instead of a glTexImage2D copy per frame. The surface is held for as long as the
+ * buffer is there (a surface freed under a GPU mapping would be memory the GPU still writes).
+ * A surface that is a buffer already is that buffer again, as with Linux's handles. Mapped
+ * uncached; its CPU-written pixels are pushed out of the cache by the submissions naming it. */
+#define MSM_INFO_IOS_IMPORT 0x85u
+extern int sweet_surface_gpu_pages(uint32_t id, uint64_t *pa, unsigned maxpages,
+    unsigned *npages, uint32_t *allocSize, uint32_t *width, uint32_t *height,
+    uint32_t *bytesPerRow, uint32_t *pixelFormat);
+#define SWEET_IMPORT_MAX_PAGES 4096u    /* 16 MB: covers a full-screen BGRA surface */
+static uint64_t g_import_pa[SWEET_IMPORT_MAX_PAGES];
+static int
+drm_do_ios_import(uint32_t surf_id, uint32_t *out_handle)
+{
+	unsigned i, npages = 0;
+	uint32_t allocSize = 0, w = 0, h = 0, bpr = 0, fmt = 0;
+	uint64_t gpuaddr = 0;
+	struct kgsl_bo_ent *b;
+	void *surf;
+	if (surf_id == 0u) { return EINVAL; }
+	for (i = 0; i < KGSL_MAX_BO; i++) {   /* a surface that is a buffer already is that buffer */
+		if (g_bo[i].used == 1 && g_bo[i].surf_id == surf_id) { *out_handle = g_bo[i].id; return 0; }
+	}
+	if ((b = kgsl_bo_slot()) == NULL) { return ENOMEM; }
+	if ((surf = sweet_surface_gpu_ref(surf_id)) == NULL) { return ENOENT; }
+	if (sweet_surface_gpu_pages(surf_id, g_import_pa, SWEET_IMPORT_MAX_PAGES, &npages,
+	        &allocSize, &w, &h, &bpr, &fmt) != 0 || npages == 0u) {
+		sweet_surface_gpu_unref(surf);
+		printf("SWEET DRM: ios_import surf %u FAILED (pages)\n", surf_id);
+		return EINVAL;
+	}
+	if (gpu_gpumem_map_phys(g_import_pa, npages, &gpuaddr) != 0) {
+		sweet_surface_gpu_unref(surf);
+		printf("SWEET DRM: ios_import surf %u FAILED (map %u pages)\n", surf_id, npages);
+		return ENOMEM;
+	}
+	bzero(b, sizeof(*b));
+	b->used = 1;
+	b->id = g_mmap_page_next;
+	g_mmap_page_next += npages;
+	b->gpuaddr = gpuaddr;
+	b->pa = g_import_pa[0];
+	b->cpu_nc = 0;
+	b->cva = 0;                 /* the surface's memory: never kmem_free'd here */
+	b->size = allocSize;
+	b->mmapsize = (vm_size_t)npages * 0x1000u;
+	b->flags = 0;
+	b->pid = proc_selfpid();
+	b->surf_id = surf_id;
+	b->surf = surf;
+	b->seed = sweet_surface_gpu_seed(surf) - 1u;   /* pushed out of the cache before its first use */
+	g_bo_count++;
+	g_bo_bytes += b->mmapsize;
+	kgsl_bo_hint(b);
+	g_stat.surfaces++;
+	*out_handle = b->id;
+	{
+		static uint32_t told;
+		if (told++ < 16u) {
+			printf("SWEET DRM: ios_import surf %u -> handle %u gpuaddr %#llx %ux%u fmt %#x (%u pages, zero-copy)\n",
+			    surf_id, b->id, (unsigned long long)gpuaddr, w, h, fmt, npages);
+		}
+	}
+	return 0;
+}
+
+/* For the display (SweetSurface.cpp AppleCLCD::swap, as HackiOS MiniIOSurfaceDrawn): wait,
+ * at most `ms`, for the GPU to be done with the last submission that named surface `surf_id`.
+ * 1: done (or the GPU never had it); 0: not done in time -- shown as it is. */
+int
+sweet_gpu_surface_wait(uint32_t surf_id, uint32_t ms)
+{
+	uint32_t fence = 0;
+	unsigned i;
+	int done = 1;
+	if (g_gpu_mtx == NULL || !g_kgsl_ready || surf_id == 0u) {
+		return 1;
+	}
+	gpu_lock();
+	for (i = 0; i < KGSL_MAX_BO; i++) {
+		if (g_bo[i].used == 1 && g_bo[i].surf_id == surf_id && g_bo[i].fence != 0 &&
+		    (fence == 0 || (int32_t)(g_bo[i].fence - fence) > 0)) {
+			fence = g_bo[i].fence;
+		}
+	}
+	for (i = 0; i < g_left_count; i++) {      /* given back already, the GPU still at it */
+		if (g_left[i].surf_id == surf_id && (fence == 0 || (int32_t)(g_left[i].fence - fence) > 0)) {
+			fence = g_left[i].fence;
+		}
+	}
+	if (fence != 0 && !gpu_wait(fence, ms)) {
+		done = 0;
+	}
+	gpu_unlock();
+	return done;
+}
+
+/* ---- On-screen present (Stage P1) ----------------------------------------
+ * Copy a rendered BO to the live scanout at FB_PHYS (= boot_args.Video.v_baseAddr,
+ * loader.c). The display controller is ALREADY scanning this region out (the shim
+ * console + XNU panic UI draw here), so no DSI/DPU bringup is needed to light the
+ * panel. The BO is expected to hold FB_W x FB_H pixels in GL_RGBA8 (glReadPixels
+ * byte order R,G,B,A), bottom-up (GL origin = lower-left). We flip vertically and
+ * swizzle R<->B into the panel's a8r8g8b8. This CPU blit is the first step toward
+ * a zero-copy GPU scanout (P2: wrap FB_PHYS as a BO and let freedreno render into
+ * it directly). ------------------------------------------------------------- */
+#define SWEET_FB_PHYS        0x9c000000ull
+#define SWEET_FB_W           1080u
+#define SWEET_FB_H           2340u
+#define SWEET_FB_STRIDE      (SWEET_FB_W * 4u)
+#define SWEET_FB_SIZE        ((vm_size_t)SWEET_FB_H * SWEET_FB_STRIDE)
+#define MSM_INFO_IOS_PRESENT     0x81u   /* private GEM_INFO op: fill scanout w/ colour word */
+#define MSM_INFO_IOS_PRESENT_IMG 0x82u   /* private GEM_INFO op: upscale small image to scanout */
+
+/* The kernel fbcon already maps the scanout (write-combine) at this global and
+ * draws boot/panic text to it. We reuse that exact mapping: a fresh ml_io_map of
+ * the 10MB framebuffer panics with kmem_alloc KERN_NO_SPACE (no second 10MB VA
+ * window in the constrained IO map). de-static'd in 0003-sweet-framebuffer-*. */
+extern volatile uint32_t *fbcon_base;
+extern uint32_t fbcon_width, fbcon_height, fbcon_stride;
+
+/* Present a SOLID colour to the whole scanout. The app passes the GPU-produced
+ * pixel as a GL_RGBA8 word (byte order R,G,B,A, i.e. u32 = A<<24|B<<16|G<<8|R);
+ * we swizzle R<->B into the panel's a8r8g8b8 and fill every pixel via the fbcon
+ * mapping. No userland buffer / copyin / new mapping. Proves GPU-render -> colour
+ * -> scanout -> glass; full-frame content comes with the zero-copy P2 path. */
+static int
+drm_do_present(uint32_t gl_rgba)
+{
+	volatile uint32_t *dst = fbcon_base;
+	uint32_t panel, i, n;
+	if (!dst || !fbcon_stride || !fbcon_height) {
+		printf("SWEET DRM: present no fbcon mapping (base=%p stride=%u h=%u)\n",
+		    (void *)dst, fbcon_stride, fbcon_height);
+		return ENXIO;
+	}
+	/* (A<<24|B<<16|G<<8|R) -> (A<<24|R<<16|G<<8|B) */
+	panel = (gl_rgba & 0xFF00FF00u) | ((gl_rgba & 0x000000FFu) << 16) | ((gl_rgba & 0x00FF0000u) >> 16);
+	n = (fbcon_stride / 4u) * fbcon_height;   /* words in the real fbcon mapping */
+	for (i = 0; i < n; i++) { dst[i] = panel; }
+	__asm__ volatile("dsb sy" ::: "memory");
+	printf("SWEET DRM: present gl=%#x -> panel=%#x filled %u px (%ux%u)\n",
+	    gl_rgba, panel, n, fbcon_width, fbcon_height);
+	return 0;
+}
+
+/* Present a SMALL GPU-rendered image (w x h, GL_RGBA8) by nearest-neighbour
+ * upscaling it across the whole scanout. The app renders a real fragment shader
+ * into a small FBO and reads it back (small => safe: avoids the big-readback
+ * overrun and the ~1.6MB userland heap ceiling on this port), then hands us the
+ * w*h*4 pixels. We copyin once, build per-axis nearest maps (cached per w/h),
+ * and fill the panel. Stepping stone to zero-copy full-res. */
+#define PIMG_MAXW 128u
+#define PIMG_MAXH 256u
+static uint32_t g_pimg[PIMG_MAXW * PIMG_MAXH];   /* small source bounce (<=128KB) */
+static uint16_t g_xmap[1080];                    /* nearest-x map (built per src w) */
+static uint16_t g_ymap[2340];                    /* nearest-y map (built per src h) */
+static uint32_t g_pw, g_ph;
+
+static int
+drm_do_present_img(user_addr_t usrc, uint32_t w, uint32_t h)
+{
+	volatile uint32_t *dst = fbcon_base;
+	uint32_t X, Y;
+	if (!dst || !fbcon_stride || !fbcon_height) { return ENXIO; }
+	if (w == 0u || h == 0u || w > PIMG_MAXW || h > PIMG_MAXH) {
+		printf("SWEET DRM: present_img bad dims %ux%u\n", w, h);
+		return EINVAL;
+	}
+	if (fbcon_width > 1080u || fbcon_height > 2340u) { return EINVAL; }
+	if (copyin(usrc, (void *)g_pimg, (user_size_t)w * h * 4u) != 0) {
+		printf("SWEET DRM: present_img copyin fault\n");
+		return EFAULT;
+	}
+	if (w != g_pw) {
+		for (X = 0; X < fbcon_width; X++) { g_xmap[X] = (uint16_t)((uint64_t)X * w / fbcon_width); }
+		g_pw = w;
+	}
+	if (h != g_ph) {
+		for (Y = 0; Y < fbcon_height; Y++) { g_ymap[Y] = (uint16_t)((uint64_t)Y * h / fbcon_height); }
+		g_ph = h;
+	}
+	for (Y = 0; Y < fbcon_height; Y++) {
+		volatile uint32_t *drow = dst + (uint32_t)Y * (fbcon_stride / 4u);
+		const uint32_t *srow = g_pimg + (uint32_t)g_ymap[Y] * w;
+		for (X = 0; X < fbcon_width; X++) {
+			uint32_t g = srow[g_xmap[X]];     /* GL RGBA, LE: A<<24|B<<16|G<<8|R */
+			drow[X] = (g & 0xFF00FF00u) | ((g & 0x000000FFu) << 16) | ((g & 0x00FF0000u) >> 16);
+		}
+	}
+	__asm__ volatile("dsb sy" ::: "memory");
+	return 0;
+}
+
+/* Present a GPU-RENDERED BO (freedreno rendered straight into it via the Mesa
+ * GEM-import path) by nearest-upscaling it to the scanout. The BO is one of our
+ * GEM BOs (kmem-backed, kernel-readable via cva); we invalidate the cacheable
+ * view (the GPU wrote it NC), then upscale + swizzle to the panel. No readback,
+ * no userland copy -- the GPU produced the final pixels. src = ABGR8888 linear
+ * (GL byte order R,G,B,A); stride is the BO row pitch (align(w*4,64)). */
+#define MSM_INFO_IOS_PRESENT_BO 0x83u
+static int
+drm_do_present_bo(uint32_t handle, uint32_t w, uint32_t h, uint32_t stride)
+{
+	struct kgsl_bo_ent *bo = kgsl_bo_find(handle);
+	volatile uint32_t *dst = fbcon_base;
+	uint32_t X, Y;
+	if (!dst || !fbcon_stride || !fbcon_height) { return ENXIO; }
+	if (!bo || !bo->cva) { printf("SWEET DRM: present_bo bad handle %u\n", handle); return EINVAL; }
+	if (w == 0u || h == 0u || w > 4096u || h > 8192u || stride < w * 4u) { return EINVAL; }
+	if (fbcon_width > 1080u || fbcon_height > 2340u) { return EINVAL; }
+	if (bo->mmapsize < (vm_size_t)stride * h) {
+		printf("SWEET DRM: present_bo id=%u too small %#lx < %u*%u\n",
+		    handle, (unsigned long)bo->mmapsize, stride, h);
+		return EINVAL;
+	}
+	gpu_dcache_clean(bo->cva, (vm_size_t)stride * h);   /* GPU wrote NC; drop stale cache lines */
+	__asm__ volatile("dsb sy" ::: "memory");
+	if (w != g_pw) {
+		for (X = 0; X < fbcon_width; X++) { g_xmap[X] = (uint16_t)((uint64_t)X * w / fbcon_width); }
+		g_pw = w;
+	}
+	if (h != g_ph) {
+		for (Y = 0; Y < fbcon_height; Y++) { g_ymap[Y] = (uint16_t)((uint64_t)Y * h / fbcon_height); }
+		g_ph = h;
+	}
+	for (Y = 0; Y < fbcon_height; Y++) {
+		volatile uint32_t *drow = dst + (uint32_t)Y * (fbcon_stride / 4u);
+		const uint32_t *srow = (const uint32_t *)((const uint8_t *)bo->cva + (uint32_t)g_ymap[Y] * stride);
+		for (X = 0; X < fbcon_width; X++) {
+			uint32_t g = srow[g_xmap[X]];     /* ABGR8888 LE: A<<24|B<<16|G<<8|R */
+			drow[X] = (g & 0xFF00FF00u) | ((g & 0x000000FFu) << 16) | ((g & 0x00FF0000u) >> 16);
+		}
+	}
+	__asm__ volatile("dsb sy" ::: "memory");
+	return 0;
+}
+
+/* Read back the live scanout as a small thumbnail so a host tool can SEE what is
+ * actually on the panel (debug visibility). User passes value=buffer, handle=gw,
+ * len=gh; we point-sample the fbcon (a8r8g8b8) into gw*gh u32 and copyout. */
+#define MSM_INFO_IOS_READ_PANEL 0x84u
+static uint32_t g_panel_thumb[32 * 48];
+static int
+drm_do_read_panel(user_addr_t ubuf, uint32_t gw, uint32_t gh)
+{
+	volatile uint32_t *src = fbcon_base;
+	uint32_t x, y;
+	if (!src || !fbcon_stride || !fbcon_height || !fbcon_width) { return ENXIO; }
+	if (gw == 0u || gh == 0u || gw > 32u || gh > 48u || !ubuf) { return EINVAL; }
+	for (y = 0; y < gh; y++) {
+		uint32_t sy = y * fbcon_height / gh;
+		volatile uint32_t *srow = src + (uint32_t)sy * (fbcon_stride / 4u);
+		for (x = 0; x < gw; x++) {
+			uint32_t sx = x * fbcon_width / gw;
+			g_panel_thumb[y * gw + x] = srow[sx];
+		}
+	}
+	return copyout(g_panel_thumb, ubuf, (vm_size_t)gw * gh * 4u);
+}
+
+#define MSM_PREP_NOSYNC 0x04u
+#define MSM_INFO_IOS_GPU_LEVEL 0x87u   /* private: value = GPU perf level 0 (825 MHz) .. 7 (180 MHz); out: DCVS return */
+static int gpu_set_level(uint32_t level, uint64_t *out);
+#define MSM_INFO_IOS_REBOOT 0x86u      /* private: value 0 = set the PMIC reboot reason "bootloader" and
+                                         * report; 1 = set it and reset (-> fastboot) */
+static int sweet_reboot_fastboot(uint32_t mode);
+/* With the lock held (drm_ioctl). */
+static int
+drm_ioctl_locked(unsigned nr, caddr_t data)
+{
+	switch (nr) {
+	case DRM_NR_VERSION: {
+		struct drm_version *v = (struct drm_version *)data;
+		static const char nm[] = "msm";
+		v->version_major = 1; v->version_minor = 10; v->version_patchlevel = 0;
+		if (v->name && v->name_len >= 3u) {
+			if (copyout(nm, (user_addr_t)(uintptr_t)v->name, 3) != 0) { return EFAULT; }
+		}
+		v->name_len = 3u;        /* drmGetVersion reads this, then re-calls with a buffer */
+		v->date_len = 0u;
+		v->desc_len = 0u;
+		return 0;
+	}
+	case DRM_NR_GET_CAP: {
+		struct drm_get_cap *gc = (struct drm_get_cap *)data;
+		gc->value = 0;           /* no syncobj/prime for first light */
+		return 0;
+	}
+	case DRM_NR_GEM_CLOSE: {
+		struct drm_gem_close *gc = (struct drm_gem_close *)data;
+		return kgsl_do_gpumem_free(gc->handle) == 0 ? 0 : EINVAL;
+	}
+	case DRM_NR_MSM_GET_PARAM: {
+		struct drm_msm_param *mp = (struct drm_msm_param *)data;
+		uint64_t val = 0;
+		int e = drm_do_get_param(mp->param, &val);
+		if (e) { return e; }
+		mp->value = val;
+		return 0;
+	}
+	case DRM_NR_MSM_GEM_NEW: {
+		struct drm_msm_gem_new *gn = (struct drm_msm_gem_new *)data;
+		struct kgsl_bo_ent *bo = NULL;
+		if (kgsl_do_gpumem_alloc((vm_size_t)gn->size, gn->flags, &bo) != 0) { return ENOMEM; }
+		gn->handle = bo->id;
+		return 0;
+	}
+	case DRM_NR_MSM_GEM_INFO: {
+		struct drm_msm_gem_info *gi = (struct drm_msm_gem_info *)data;
+		struct kgsl_bo_ent *bo;
+		if (gi->info == MSM_INFO_IOS_PRESENT) {   /* Stage P1: fill scanout with a solid colour */
+			return drm_do_present((uint32_t)gi->value);
+		}
+		if (gi->info == MSM_INFO_IOS_PRESENT_IMG) {  /* P2a: upscale small GPU image to scanout */
+			return drm_do_present_img((user_addr_t)gi->value, gi->handle, gi->pad);
+		}
+		if (gi->info == MSM_INFO_IOS_PRESENT_BO) {   /* P2b: present a GPU-rendered BO (no readback) */
+			return drm_do_present_bo(gi->handle, (uint32_t)(gi->value & 0xffffu),
+			    (uint32_t)((gi->value >> 16) & 0xffffu), gi->len);
+		}
+		if (gi->info == MSM_INFO_IOS_READ_PANEL) {   /* debug: read scanout thumbnail */
+			return drm_do_read_panel((user_addr_t)gi->value, gi->handle, gi->len);
+		}
+		if (gi->info == MSM_INFO_IOS_GPU_LEVEL) {   /* the GPU's clock (legacy GMU DCVS by register) */
+			uint64_t o = 0;
+			int e = gpu_set_level((uint32_t)gi->value, &o);
+			gi->value = o;
+			return e;
+		}
+		if (gi->info == 0x88u) {   /* private: the panel's brightness, 0..2047 (DCS 0x51); out: DMA done */
+			int e = sweet_panel_brightness((uint32_t)gi->value);
+			gi->value = (uint64_t)(e == 0);
+			return e == 0 ? 0 : EIO;
+		}
+		if (gi->info == MSM_INFO_IOS_REBOOT) {   /* dev loop: reboot into fastboot (see sweet_reboot_fastboot) */
+			return sweet_reboot_fastboot((uint32_t)gi->value) == 0 ? 0 : EIO;
+		}
+		if (gi->info == MSM_INFO_IOS_IMPORT) {   /* zero-copy: IOSurface id (value) -> GEM handle */
+			uint32_t hnd = 0;
+			int e = drm_do_ios_import((uint32_t)gi->value, &hnd);
+			if (e) { return e; }
+			gi->handle = hnd;
+			return 0;
+		}
+		bo = kgsl_bo_find(gi->handle);
+		if (!bo) { return EINVAL; }
+		switch (gi->info) {
+		case MSM_INFO_GET_IOVA:   gi->value = bo->gpuaddr;                  return 0;
+		case MSM_INFO_GET_OFFSET: gi->value = (uint64_t)bo->id << 12;       return 0;  /* mmap token */
+		case MSM_INFO_IOS_MMAP: {     /* Route B: map the BO into this task, WC; return user VA */
+			uint64_t uva = 0;
+			int e = drm_do_gem_mmap(bo, &uva);
+			if (e) { return e; }
+			gi->value = uva;
+			return 0;
+		}
+		default: return EINVAL;   /* SET_NAME/METADATA optional; freedreno degrades */
+		}
+	}
+	case DRM_NR_MSM_GEM_CPU_PREP: {
+		/* Is the GPU done with a buffer (RedwoodGPU kMsmGemCpuPrep): its last submission here,
+		 * all it has been given if the buffer is not known. NOTE the shim encodes this request
+		 * Linux-_IOW, which XNU reads as IOC_OUT: nothing is copied in, so the request comes
+		 * zeroed -- then it is waited for as for no limit, all the GPU has been given. */
+		struct drm_msm_gem_cpu_prep *cp = (struct drm_msm_gem_cpu_prep *)data;
+		struct kgsl_bo_ent *bo = cp->handle ? kgsl_bo_find(cp->handle) : NULL;
+		uint32_t fence = bo ? bo->fence : gpu_last();
+		uint64_t ms;
+		if (cp->op & MSM_PREP_NOSYNC) {
+			ms = 0;
+		} else if (cp->timeout.tv_sec == 0 && cp->timeout.tv_nsec == 0) {
+			ms = GPU_PATIENCE_MS;
+		} else {
+			ms = drm_ms_until(&cp->timeout);
+		}
+		return gpu_wait(fence, ms) ? 0 : EBUSY;
+	}
+	case DRM_NR_MSM_GEM_SUBMIT: {
+		struct drm_msm_gem_submit *s = (struct drm_msm_gem_submit *)data;
+		uint32_t fence = 0;
+		int e = drm_do_gem_submit(s, &fence);
+		if (e) { return e; }
+		s->fence = fence;
+		return 0;
+	}
+	case DRM_NR_MSM_WAIT_FENCE: {
+		/* RedwoodGPU kMsmWaitFence. Zeroed (see CPU_PREP): all the GPU has been given. */
+		struct drm_msm_wait_fence *wf = (struct drm_msm_wait_fence *)data;
+		uint32_t fence = wf->fence ? wf->fence : gpu_last();
+		uint64_t ms = (wf->timeout.tv_sec == 0 && wf->timeout.tv_nsec == 0) ? GPU_PATIENCE_MS :
+		    drm_ms_until(&wf->timeout);
+		return gpu_wait(fence, ms) ? 0 : ETIMEDOUT;
+	}
+	case DRM_NR_MSM_GEM_MADVISE: {
+		/* RedwoodGPU: retained, always. Nothing here takes a buffer's memory away while its
+		 * handle is somebody's -- Mesa's cache gives an idle buffer back itself (GEM_CLOSE),
+		 * and freeing it under the handle (as was done here) left Mesa a mapped, cached,
+		 * possibly still-submitted buffer whose memory and addresses were someone else's. */
+		struct drm_msm_gem_madvise *gm = (struct drm_msm_gem_madvise *)data;
+		gm->retained = 1u;
+		return 0;
+	}
+	case DRM_NR_MSM_SUBMITQUEUE_NEW: {
+		struct drm_msm_submitqueue *sq = (struct drm_msm_submitqueue *)data;
+		sq->id = g_sq_next++;
+		return 0;
+	}
+	case DRM_NR_MSM_SUBMITQUEUE_CLOSE:
+	case DRM_NR_MSM_SUBMITQUEUE_QUERY:
+		return 0;
+	default:
+		return ENOTTY;
+	}
+}
+
+static int
+drm_ioctl(__unused dev_t dev, u_long cmd, caddr_t data, __unused int flag, __unused struct proc *p)
+{
+	unsigned nr  = (unsigned)(cmd & 0xffu);
+	unsigned typ = (unsigned)((cmd >> 8) & 0xffu);
+	int e;
+	if (typ != DRM_IOC_TYPE) {
+		return ENOTTY;
+	}
+	gpu_lock();
+	e = drm_ioctl_locked(nr, data);
+	gpu_unlock();
+	if (e == ENOTTY) {
+		printf("SWEET DRM: ioctl nr=%#x is not known here\n", nr);
+	}
+	return e;
+}
+
+static const struct cdevsw drm_cdevsw = {
+	.d_open       = kgsl_open,
+	.d_close      = kgsl_close,
+	.d_read       = kgsl_norw,
+	.d_write      = kgsl_norw,
+	.d_ioctl      = drm_ioctl,
+	.d_stop       = eno_stop,
+	.d_reset      = eno_reset,
+	.d_ttys       = NULL,
+	.d_select     = eno_select,
+	.d_mmap       = kgsl_mmap,   /* map GEM BOs to userland (MSM_INFO_GET_OFFSET token) */
+	.d_strategy   = eno_strat,
+	.d_reserved_1 = eno_getc,
+	.d_reserved_2 = eno_putc,
+	.d_type       = 0,
+};
+
+/* In-kernel self-test of the MSM-DRM GEM path: GET_PARAM(CHIP_ID), GEM_NEW x2,
+ * build a CP_MEM_WRITE IB in one targeting the other's iova, submit it via the
+ * shared ring core (the GEM_SUBMIT inner path), assign a fence, verify the store. */
+static void
+gpu_stage_v(void)
+{
+	uint64_t chip = 0;
+	struct kgsl_bo_ent *ib = NULL, *dst = NULL;
+	uint64_t ibva;
+	uint32_t ibdw, fence;
+	int rc;
+	uint32_t got;
+	if (!g_kgsl_ready) {
+		printf("SWEET DRM: [V] selftest skipped (submit path not published)\n");
+		return;
+	}
+	(void)drm_do_get_param(MSM_PARAM_CHIP_ID, &chip);
+	gpu_lock();
+	if (kgsl_do_gpumem_alloc(PAGE_SIZE, 0x20000u /*MSM_BO_WC*/, &ib) != 0 ||
+	    kgsl_do_gpumem_alloc(PAGE_SIZE, 0x20000u, &dst) != 0) {
+		gpu_unlock();
+		printf("SWEET DRM: [V] GEM_NEW FAIL\n"); return;
+	}
+	gpu_unlock();
+	*(volatile uint32_t *)dst->cpu_nc = 0;
+	((volatile uint32_t *)ib->cpu_nc)[0] = cp_type7(0x3Du, 3u);     /* CP_MEM_WRITE -> dst iova */
+	((volatile uint32_t *)ib->cpu_nc)[1] = (uint32_t)dst->gpuaddr;
+	((volatile uint32_t *)ib->cpu_nc)[2] = (uint32_t)(dst->gpuaddr >> 32);
+	((volatile uint32_t *)ib->cpu_nc)[3] = 0x5AFEDA7Au;
+	gpu_dcache_clean(ib->cpu_nc, PAGE_SIZE);    /* cacheable cva: flush IB + cleared dst to DRAM */
+	gpu_dcache_clean(dst->cpu_nc, PAGE_SIZE);
+	__asm__ volatile("dsb sy" ::: "memory");
+	ibva = ib->gpuaddr; ibdw = 4u;
+	gpu_lock();
+	rc = kgsl_submit_ibs(&ibva, &ibdw, 1);
+	fence = rc == 0 ? gpu_last() : 0;
+	gpu_unlock();
+	gpu_dcache_clean(dst->cpu_nc, PAGE_SIZE);   /* invalidate: CPU re-reads GPU-written DRAM */
+	got = *(volatile uint32_t *)dst->cpu_nc;
+	printf("SWEET DRM: [V] MSM GEM SELFTEST chip_id=%#llx gem_ib=%u(iova=%#llx) gem_dst=%u(iova=%#llx) "
+	    "submit_rc=%d fence=%u readback=%#x(exp 5afeda7a) -> %s\n",
+	    (unsigned long long)chip, ib->id, (unsigned long long)ib->gpuaddr,
+	    dst->id, (unsigned long long)dst->gpuaddr, rc, fence, got,
+	    (rc == 0 && got == 0x5AFEDA7Au && chip == 0x06010800ull) ?
+	    "MSM-DRM GEM NEW+SUBMIT+FENCE OK (gallium-freedreno path)" : "FAIL");
+	gmub_flush();
+}
