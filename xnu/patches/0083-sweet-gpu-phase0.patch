+/* Bounded poll on a GMU-window register: wait (rd(idx)&mask)==want. */
+static int
+gmub_poll(uint32_t idx, uint32_t mask, uint32_t want, unsigned *polls_out)
+{
+	unsigned i;
+	for (i = 0; i < GMUB_POLL_US; ++i) {
+		if ((gmub_rd(idx) & mask) == want) {
+			if (polls_out) {
+				*polls_out = i;
+			}
+			return 0;
+		}
+		gmub_udelay(1);
+	}
+	if (polls_out) {
+		*polls_out = i;
+	}
+	return -1;
+}
