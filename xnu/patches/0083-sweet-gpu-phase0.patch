+	 * Split into flushed groups [Ia]..[Id] - the LAST marker that prints tells us
+	 * which group's writes faulted. Suspect: SP/TPL1 NC_MODE (group c) if those
+	 * blocks aren't clocked yet. ---- */
+	{
+		vm_offset_t co = ml_io_map(A6XX_GPU_CORE_PA_, A6XX_GPU_CORE_SIZE_);
+		if (!co) {
+			printf("SWEET GMU: [I] core map failed\n");
+			gmub_flush();
+			gmub_cmddb_report();
+			return 0;
+		}
