+		printf("SWEET GMU: [F] fault-dbg: nmi=%#x ao_intr=%#x fence_sts=%#x "
+		    "fence_ctl=%#x rpmh_pwr=%#x fw_init=%#x\n",
+		    gmub_rd(GMUB_NMI_CONTROL_STATUS), gmub_rd(GMUB_AO_HOST_INTR_STATUS),
+		    gmub_rd(GMUB_AHB_FENCE_STATUS), gmub_rd(GMUB_AO_AHB_FENCE_CTRL),
+		    gmub_rd(GMUB_CX_GMU_RPMH_PWR_STATE), gmub_rd(GMUB_CM3_FW_INIT_RESULT));
