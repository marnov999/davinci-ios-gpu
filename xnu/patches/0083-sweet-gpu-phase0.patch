+/* In-kernel self-test of the MSM-DRM GEM path: GET_PARAM(CHIP_ID), GEM_NEW x2,
+ * build a CP_MEM_WRITE IB in one targeting the other's iova, submit it via the
+ * shared ring core (the GEM_SUBMIT inner path), assign a fence, verify the store. */
+static void
+gpu_stage_v(void)
+{
+	uint64_t chip = 0;
+	struct kgsl_bo_ent *ib = NULL, *dst = NULL;
+	uint64_t ibva;
+	uint32_t ibdw, fence;
+	int rc;
+	uint32_t got;
+	if (!g_kgsl_ready) {
+		printf("SWEET DRM: [V] selftest skipped (submit path not published)\n");
+		return;
+	}
+	(void)drm_do_get_param(MSM_PARAM_CHIP_ID, &chip);
+	if (kgsl_do_gpumem_alloc(PAGE_SIZE, 0x20000u /*MSM_BO_WC*/, &ib) != 0 ||
+	    kgsl_do_gpumem_alloc(PAGE_SIZE, 0x20000u, &dst) != 0) {
+		printf("SWEET DRM: [V] GEM_NEW FAIL\n"); return;
+	}
+	*(volatile uint32_t *)dst->cpu_nc = 0;
+	((volatile uint32_t *)ib->cpu_nc)[0] = cp_type7(0x3Du, 3u);     /* CP_MEM_WRITE -> dst iova */
+	((volatile uint32_t *)ib->cpu_nc)[1] = (uint32_t)dst->gpuaddr;
+	((volatile uint32_t *)ib->cpu_nc)[2] = (uint32_t)(dst->gpuaddr >> 32);
+	((volatile uint32_t *)ib->cpu_nc)[3] = 0x5AFEDA7Au;
+	gpu_dcache_clean(ib->cpu_nc, PAGE_SIZE);    /* cacheable cva: flush IB + cleared dst to DRAM */
+	gpu_dcache_clean(dst->cpu_nc, PAGE_SIZE);
+	__asm__ volatile("dsb sy" ::: "memory");
+	ibva = ib->gpuaddr; ibdw = 4u;
+	rc = kgsl_submit_ibs(&ibva, &ibdw, 1);
+	if (rc == 0) { fence = ++g_drm_fence; } else { fence = 0; }
+	gpu_dcache_clean(dst->cpu_nc, PAGE_SIZE);   /* invalidate: CPU re-reads GPU-written DRAM */
+	got = *(volatile uint32_t *)dst->cpu_nc;
+	printf("SWEET DRM: [V] MSM GEM SELFTEST chip_id=%#llx gem_ib=%u(iova=%#llx) gem_dst=%u(iova=%#llx) "
+	    "submit_rc=%d fence=%u readback=%#x(exp 5afeda7a) -> %s\n",
+	    (unsigned long long)chip, ib->id, (unsigned long long)ib->gpuaddr,
+	    dst->id, (unsigned long long)dst->gpuaddr, rc, fence, got,
+	    (rc == 0 && got == 0x5AFEDA7Au && chip == 0x06010800ull) ?
+	    "MSM-DRM GEM NEW+SUBMIT+FENCE OK (gallium-freedreno path)" : "FAIL");
+	gmub_flush();
+}
+
+static int g_drm_major = -1;
+static void
+gpu_drm_init(void)
+{
+	g_drm_major = cdevsw_add(-1, &drm_cdevsw);
+	if (g_drm_major < 0) {
+		printf("SWEET DRM: cdevsw_add failed\n");
+		return;
+	}
+	/* Mesa's libdrm shim opens this node (drmOpenWithType("msm",...)); drmGetVersion
+	 * must then report name="msm". If devfs rejects the subdir form, fall back to a
+	 * flat name and point the shim's IOS_DRM_RENDER_NODE at it. */
+	devfs_make_node(makedev(g_drm_major, 0), DEVFS_CHAR, UID_ROOT, GID_WHEEL, 0666, "dri/renderD128");
+	printf("SWEET DRM: /dev/dri/renderD128 registered (major=%d) name=msm -> MSM-DRM render node "
+	    "for gallium-freedreno GLES\n", g_drm_major);
+	gpu_stage_v();
+}
+
+static void
+gpu_probe(void)
+{
+	gpu_gcc = ml_io_map(GPU_GCC_PA, GPU_GCC_SIZE);
+	if (!gpu_gcc) {
+		printf("SWEET GPU: GCC map failed\n");
+		return;
+	}
+	/* GCC is always-on; these reads are safe and show the GPU clock state. */
+	printf("SWEET GPU: GCC gpu clk status (pre): ahb=%#x memnoc=%#x snoc=%#x axi=%#x\n",
+	    gpu_rd(gpu_gcc, GCC_GPU_CFG_AHB_CLK), gpu_rd(gpu_gcc, GCC_GPU_MEMNOC_GFX_CLK),
+	    gpu_rd(gpu_gcc, GCC_GPU_SNOC_DVM_CLK), gpu_rd(gpu_gcc, GCC_DDRSS_GPU_AXI_CLK));
+	/* Enable the GPU config/AHB + NoC branches so the GPUCC window is clocked.
+	 * BIT(0) turns a branch on; we never clear bits (never disable a live clock). */
+	gpu_wr(gpu_gcc, GCC_GPU_CFG_AHB_CLK,
+	    gpu_rd(gpu_gcc, GCC_GPU_CFG_AHB_CLK) | GCC_BRANCH_ENABLE);
+	gpu_wr(gpu_gcc, GCC_DDRSS_GPU_AXI_CLK,
+	    gpu_rd(gpu_gcc, GCC_DDRSS_GPU_AXI_CLK) | GCC_BRANCH_ENABLE);
+	gpu_wr(gpu_gcc, GCC_GPU_MEMNOC_GFX_CLK,
+	    gpu_rd(gpu_gcc, GCC_GPU_MEMNOC_GFX_CLK) | GCC_BRANCH_ENABLE);
+	gpu_wr(gpu_gcc, GCC_GPU_SNOC_DVM_CLK,
+	    gpu_rd(gpu_gcc, GCC_GPU_SNOC_DVM_CLK) | GCC_BRANCH_ENABLE);
+	delay_for_interval(200, NSEC_PER_USEC); /* ~200us for branches to settle */
+	printf("SWEET GPU: GCC gpu clk status (post): ahb=%#x memnoc=%#x snoc=%#x axi=%#x\n",
+	    gpu_rd(gpu_gcc, GCC_GPU_CFG_AHB_CLK), gpu_rd(gpu_gcc, GCC_GPU_MEMNOC_GFX_CLK),
+	    gpu_rd(gpu_gcc, GCC_GPU_SNOC_DVM_CLK), gpu_rd(gpu_gcc, GCC_DDRSS_GPU_AXI_CLK));
+
+	/* Now GPUCC should be reachable. This read is the Phase-0 make-or-break. */
+	gpu_gpucc = ml_io_map(GPU_GPUCC_PA, GPU_GPUCC_SIZE);
+	if (!gpu_gpucc) {
+		printf("SWEET GPU: GPUCC map failed\n");
+		return;
+	}
+	uint32_t cc = gpu_rd(gpu_gpucc, 0);
+	printf("SWEET GPU: davinci a618 (DT chipid %#x); gpucc[0]=%#x\n", GPU_DT_CHIPID, cc);
+	if (cc == 0xffffffffu) {
+		printf("SWEET GPU: GPUCC reads 0xffffffff - still gated (need GPU CX GDSC vote).\n");
+	} else {
+		printf("SWEET GPU: Phase 0 OK - GPUCC reachable after enabling GCC gpu clocks.\n");
+	}
+	/* Map the GPU power/clock state (all reads inside the reachable GPUCC
+	 * window). GDSCR bit31 = PWR_ON. Tells us what is already powered before we
+	 * attempt the GMU boot. Offsets from gpucc-sdmmagpie.c / a6xx_regs.h. */
+	uint32_t gx = gpu_rd(gpu_gpucc, GPUCC_GX_GDSCR);
+	uint32_t cx = gpu_rd(gpu_gpucc, GPUCC_CX_GDSCR);
+	uint32_t gmuclk = gpu_rd(gpu_gpucc, GPUCC_CX_GMU_CLK);
+	uint32_t cxoclk = gpu_rd(gpu_gpucc, GPUCC_CXO_CLK);
+	printf("SWEET GPU: GPUCC gx_gdsc=%#x(pwr_on=%d) cx_gdsc=%#x(pwr_on=%d) cx_gmu_clk=%#x cxo_clk=%#x\n",
+	    gx, (gx >> 31) & 1u, cx, (cx >> 31) & 1u, gmuclk, cxoclk);
+
+	if (gpu_level >= 2) {
+		gpu_tz_probe();
+	}
+	if (gpu_level >= 4) {
+		gpu_gmu_step1();
+	}
+	if (gpu_level >= 5) {
+		gpu_gmu_step2();
+	}
+	if (gpu_level >= 6) {
+		(void)gpu_gmu_boot();
+	}
+	/* Register the /dev/kgsl-3d0 UAPI node (+ in-kernel devinfo self-test) so
+	 * userland freedreno can bind once the root carries a client. */
+	gpu_kgsl_init();
+	/* Register the MSM-DRM render node (/dev/dri/renderD128) for the gallium-
+	 * freedreno GLES path, over the same proven ring/iova/submit core. */
+	gpu_drm_init();
+}
+
+/* Block (not busy-wait) for `secs` so the probe prints after USB + the host
+ * capture are up; the early-boot prints were scrolling past otherwise. */
+static void
+gpu_sleep(uint32_t secs)
+{
+	uint64_t deadline;
+	clock_interval_to_deadline(secs, NSEC_PER_SEC, &deadline);
+	assert_wait_deadline(&gpu_started, THREAD_UNINT, deadline);
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+/* ---- SPMI PMIC-arbiter WRITE: set PON_SOFT_RB_SPARE = BOOTLOADER reason ----
+ * davinci's UEFI ABL reads the reboot target from the PMIC PON register (it
+ * persists across SoC reset), NOT the IMEM cookie (IMEM/PS_HOLD both went to
+ * MIUI). Mirror the proven observer-READ path (sweet_spmi.c) with an EXT_WRITEL
+ * on the chnls region. SPMI v5 regions (davinci DTB): core 0xc440000,
+ * chnls 0xc600000, obsrvr 0xe600000, cnfg 0xc40a000. Per-APID stride 0x80;
+ * CMD@+0 STATUS@+8 WDATA0@+0x10 RDATA0@+0x18. cmd=(opc<<27)|((addr&0xff)<<4);
+ * EXT_READL opc=1 (proven in the read path), EXT_WRITEL opc=0. Target =
+ * PON periph 0x08 reg SOFT_RB_SPARE 0x8f; BOOTLOADER reason 0x02 -> bits[7:1]. */
+#define SPMI_CORE_PA      0x0c440000u
+#define SPMI_CHNLS_PA     0x0c600000u
+#define SPMI_OBS_PA       0x0e600000u
+#define SPMI_CFG_PA       0x0c40a000u
+#define PON_PERIPH        0x08u
+#define PON_SOFT_RB_SPARE 0x8fu
+#define PON_REASON_BL     0x02u
+
+/* Read SOFT_RB_SPARE (periph 0x08 reg 0x8f) via the observer channel (direct
+ * reads work). Returns byte in *out; apid in *apid_out. -1 on failure. */
+static int
+spmi_pon_read(vm_offset_t core, vm_offset_t cfg, vm_offset_t obs,
+    unsigned count, unsigned *apid_out, uint8_t *out)
+{
+	unsigned i, apid = 0xffffu, ppid = (0u << 8) | PON_PERIPH;
+	for (i = 0; i < count; ++i) {               /* find APID; prefer owner EE 0 */
+		uint32_t map = *(volatile uint32_t *)(core + 0x900u + 4u * i);
+		if (!map || ((map >> 8) & 0xfffu) != ppid) {
+			continue;
+		}
+		if (apid == 0xffffu ||
+		    ((*(volatile uint32_t *)(cfg + 0x700u + 4u * i)) & 7u) == 0u) {
+			apid = i;
+		}
+	}
+	if (apid == 0xffffu) {
+		return -1;
+	}
+	*apid_out = apid;
+	unsigned off = 0x80u * apid;
+	*(volatile uint32_t *)(obs + off) = (1u << 27) | ((PON_SOFT_RB_SPARE & 0xffu) << 4);
+	__asm__ volatile("dsb osh" ::: "memory");
+	for (i = 0; i < 1000u; ++i) {
+		uint32_t st = *(volatile uint32_t *)(obs + off + 0x08u);
+		if (st & 1u) {
+			if (st & 0x0eu) {
+				return -1;
+			}
+			*out = (uint8_t)*(volatile uint32_t *)(obs + off + 0x18u);
+			return 0;
+		}
+		gmub_udelay(1);
+	}
+	return -1;
+}
+
+static int
+spmi_set_pon_bootloader(void)
+{
+	vm_offset_t core = ml_io_map(SPMI_CORE_PA, 0x2000u);
+	vm_offset_t cfg  = ml_io_map(SPMI_CFG_PA, 0x1000u);
+	vm_offset_t obs  = ml_io_map(SPMI_OBS_PA, 0x10000u);
+	unsigned count, apid = 0xffffu;
+	uint32_t ver;
+	uint8_t old = 0, val, rb = 0xff;
+	uint64_t r[4];
+
+	if (!core || !cfg || !obs) {
+		printf("SWEET GPU: SPMI map failed\n");
+		return -1;
+	}
+	ver = *(volatile uint32_t *)core;
+	count = (*(volatile uint32_t *)(core + 4)) & 0x7ffu;
+	if (ver < 0x50000000u || ver >= 0x70000000u || !count || count > 512) {
+		printf("SWEET GPU: SPMI arb=%#x count=%u unsupported\n", ver, count);
+		return -1;
+	}
+	if (spmi_pon_read(core, cfg, obs, count, &apid, &old) != 0) {
+		printf("SWEET GPU: SPMI PON read failed (no APID / read err)\n");
+		return -1;
+	}
+	val = (uint8_t)((old & 0x01u) | (PON_REASON_BL << 1));  /* 0x04 in bits[7:1] */
+	/* WRITE via TZ SCM_IO_WRITE: EL3 stores to the XPU-blocked chnls region.
+	 * WDATA0 (chnls+off+0x10) = byte, then CMD (chnls+off) = EXT_WRITEL(opc0). */
+	unsigned off = 0x80u * apid;
+	gpu_smc(QCOM_SCM_IO_WRITE_FNID, 2, (uint64_t)SPMI_CHNLS_PA + off + 0x10u, val,
+	    0, 0, 0, r);
+	uint64_t w1 = r[0];
+	gpu_smc(QCOM_SCM_IO_WRITE_FNID, 2, (uint64_t)SPMI_CHNLS_PA + off,
+	    (0u << 27) | ((PON_SOFT_RB_SPARE & 0xffu) << 4), 0, 0, 0, r);
+	uint64_t w2 = r[0];
+	gmub_udelay(50);
+	(void)spmi_pon_read(core, cfg, obs, count, &apid, &rb);  /* confirm */
+	printf("SWEET GPU: PON via SCM apid=%u old=%#x new=%#x readback=%#x scm=%lld,%lld\n",
+	    apid, old, val, rb, (long long)w1, (long long)w2);
+	return (rb == val) ? 0 : -1;
+}
+
+/* Reboot to fastboot via the PMIC PON reason, then reset. Does not return on
+ * success. Lets the host drive the GPU dev loop hands-free. */
+static void
+gpu_reboot_fastboot(void)
+{
+	(void)spmi_set_pon_bootloader();   /* PON reason persists across the reset */
+	gmub_flush();                      /* flush the USB log before resetting */
+	uint64_t r[4];
+	gpu_smc(PSCI_SYSTEM_RESET, 0, 0, 0, 0, 0, 0, r);
+	vm_offset_t ph = ml_io_map(PSHOLD_PA, 0x1000u);   /* fallback if PSCI returns */
+	if (ph) {
+		*(volatile uint32_t *)ph = 0u;
+		__asm__ volatile("dsb sy" ::: "memory");
+	}
+	for (;;) {
+		__asm__ volatile("wfe");
+	}
+}
+
+static void
+gpu_thread(void *arg, wait_result_t wr)
+{
+	(void)arg;
+	(void)wr;
+	gpu_sleep(45); /* let USB CDC-ECM + host log capture fully come up first;
+	                * v19 printed the probe before the link flowed -> lost. 45s
+	                * puts the probe well after the link is stable. */
+	gpu_probe();
+	/* Auto-reboot to fastboot via TZ-mediated PON write (SCM_IO_WRITE) for a
+	 * HANDS-FREE dev loop. Direct EL1 SPMI write XPU-faults (v17), so the write
+	 * now goes through EL3. Runs AFTER all GPU output is printed+flushed (6s), so
+	 * the GX result is never truncated. If the SCM write is rejected / reset path
+	 * misbehaves, worst case is a reboot to MIUI or a hang - both recoverable via
+	 * manual fastboot; the GX data is already captured. Level 3 and GMU (>=6). */
+	/* Auto-reboot DISABLED again: v18b proved SCM_IO_WRITE also returns -2 (TZ
+	 * rejects it), so no programmatic reboot path works - it just PSCI-resets to
+	 * MIUI. Stay in iOS after the probe; dev loop = manual fastboot. Kept dormant. */
+	if (gpu_level == 3) {
+		gpu_sleep(6);
+		printf("SWEET GPU: auto-reboot to fastboot (TZ SCM_IO_WRITE PON)\n");
+		gpu_sleep(1);
+		gpu_reboot_fastboot();
+	}
+	(void)thread_terminate(current_thread());
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+void
+sweet_gpu_init(void)
+{
+	int enabled = 0;
+	thread_t thread;
+	if (gpu_started) {
+		return;
+	}
+	gpu_started = true;
+	(void)PE_parse_boot_argn("sweetgpu", &enabled, sizeof(enabled));
+	if (!enabled) {
+		printf("SWEET GPU: disabled (pass sweetgpu=1 for Phase 0, =2 for +TZ probe)\n");
+		return;
+	}
+	gpu_level = enabled;
+	kern_return_t kr = kernel_thread_start(gpu_thread, NULL, &thread);
+	if (kr == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	} else {
+		printf("SWEET GPU: kernel_thread_start failed %d\n", kr);
+	}
+}
