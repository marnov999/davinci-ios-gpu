diff --git a/bsd/sys/sweet_camera.h b/bsd/sys/sweet_camera.h
new file mode 100644
index 0000000..9ec814c
--- /dev/null
+++ b/bsd/sys/sweet_camera.h
@@ -0,0 +1,73 @@
+/*
+ * /dev/sweet-camera: a Mi 9T (davinci) camera for iOS (boot-arg sweetcam=5; bsd/dev/sweet_camera.c).
+ *
+ * The same contract as HackiOS's /dev/redwood-camera (bsd/sys/redwood_camera.h), so that its
+ * userland (camera_device.c, camera_isp.c, camera_test.c) ports by renaming only:
+ *
+ *   open()   marks the device open; the first read() powers the sensor up and starts its frames;
+ *            the last close (or IDLE_MS without a read) puts everything down again.
+ *   read()   waits (3 s while streaming, 15 s while starting) for the newest frame not read yet:
+ *            a struct sweet_camera_frame, then as many of the frame's RAW10 bytes as fit.
+ *            A buffer of the header's size gets the header only. EIO after a fault (the camera
+ *            then stays off for the rest of the boot).
+ *   write()  a struct sweet_camera_command, then what it says follows.
+ *
+ * Layout is identical to struct redwood_camera_frame / redwood_camera_command (only the magic and
+ * the sensor numbering differ).
+ */
+#ifndef _SYS_SWEET_CAMERA_H_
+#define _SYS_SWEET_CAMERA_H_
+
+#include <stdint.h>
+
+#define SWEET_CAMERA_DEVICE             "/dev/sweet-camera"
+#define SWEET_CAMERA_MAGIC              "SWFRAME1"
+
+/* davinci's sensors, numbered as Android's cam-sensor@N cell-index */
+enum {
+	SWEET_CAMERA_WIDE = 0,          /* Sony IMX586 (or IMX582), 48 MP, CSIPHY 0, CCI0 master 0 */
+	SWEET_CAMERA_TELE = 1,          /* OmniVision OV8856, 8 MP, CSIPHY 3 (2 lanes), CCI0 master 1 */
+	SWEET_CAMERA_FRONT = 2,         /* Samsung S5K3T2, 20 MP pop-up, CSIPHY 1, CCI0 master 0 */
+	SWEET_CAMERA_ULTRA = 3,         /* Samsung S5K3L6, 13 MP ultra-wide, CSIPHY 2, CCI1 master 0 */
+};
+
+struct sweet_camera_frame {
+	char            magic[8];       /* SWEET_CAMERA_MAGIC */
+	uint32_t        header_bytes;   /* this structure's size: the frame's bytes follow */
+	uint32_t        width, height;  /* pixels */
+	uint32_t        stride;         /* bytes from one line to the next */
+	uint32_t        format;         /* 1: MIPI RAW10, four pixels in five bytes */
+	uint32_t        bayer;          /* 2x2 cell order: 0 RGGB, 1 GRBG, 2 GBRG, 3 BGGR */
+	uint32_t        black;          /* black level, 10-bit steps */
+	uint64_t        sequence;       /* frame number since the sensor started, from 1 */
+	uint64_t        time;           /* mach_absolute_time() when the frame was done */
+	uint32_t        exposure_lines; /* exposure, in lines ... */
+	uint32_t        line_ns;        /* ... of this many nanoseconds */
+	uint32_t        gain;           /* analog gain, in the units below ... */
+	uint32_t        gain_unity;     /* ... where this is 1x */
+	uint32_t        gain_max;       /* the most it may be given */
+	uint32_t        frame_lines;    /* frame length in lines */
+	uint32_t        frame_lines_min;
+	uint32_t        frame_lines_max;
+	uint32_t        margin;         /* exposure_lines <= frame_lines - margin */
+	uint32_t        sensor;         /* SWEET_CAMERA_* */
+	uint32_t        focus;          /* lens position 0..1023, SWEET_CAMERA_NO_FOCUS without a motor */
+	uint32_t        reserved[5];
+};
+
+#define SWEET_CAMERA_NO_FOCUS   0xffffffffu
+
+enum {
+	SWEET_CAMERA_EXPOSURE = 1,      /* a: lines, b: gain (gain_unity = 1x), c: frame lines (0: shortest that holds it) */
+	SWEET_CAMERA_KEEP = 2,          /* reserved (HackiOS: a picture for the host); EINVAL here */
+	SWEET_CAMERA_SENSOR = 3,        /* a: SWEET_CAMERA_*, b: mode (~0: the default); frames stop, next read starts it */
+	SWEET_CAMERA_FOCUS = 4,         /* a: lens 0 (far) .. 1023, from the next frame or so */
+};
+
+struct sweet_camera_command {
+	uint32_t        command;
+	uint32_t        bytes;          /* of what follows this structure */
+	uint32_t        a, b, c, d;
+};
+
+#endif /* _SYS_SWEET_CAMERA_H_ */
