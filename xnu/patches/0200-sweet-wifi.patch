+++ b/bsd/sys/hakios.qrtr.h
@@ -0,0 +1,49 @@
+/*
+ * QRTR as the QMI helpers (sys/hakios.qmi.h) need it: datagrams to and from a port of a node of
+ * Qualcomm's IPC router, and the question "where is that service".
+ *
+ * On the phone the router's other nodes are the processors beside ours (the Wi-Fi DSP is one), and
+ * the datagrams travel over GLINK; whoever implements that hands these four calls to the QMI
+ * helpers with hakios_qmi_set_transport(). On a development machine a test puts a fake in the
+ * same place. Nothing here knows what is inside a datagram.
+ */
+#ifndef _SYS_HAKIOS_QRTR_H_
+#define _SYS_HAKIOS_QRTR_H_
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+
+struct hakios_qrtr_port;
+
+/*
+ * A datagram for the port has arrived from (node, port). The data is the caller's again on return.
+ */
+typedef void (*hakios_qrtr_receive_t)(void *context, uint32_t node, uint32_t port, const void *data, size_t length);
+/*
+ * A server of a service that was asked for with lookup() has appeared at (node, port), or the one
+ * that was there has gone. Called once for each that exists when the question is asked, too.
+ */
+typedef void (*hakios_qrtr_server_t)(void *context, bool arrived, uint32_t service, uint32_t version, uint32_t instance,
+    uint32_t node, uint32_t port);
+
+/*
+ * Both callbacks come from one thread at a time, never from interrupt context, and may sleep
+ * (the QMI helpers take a mutex in them and call their user's handlers from them). `context` is
+ * what open() was given.
+ */
+struct hakios_qrtr_ops {
+	/* A port of our own node; NULL if there is none to be had. */
+	struct hakios_qrtr_port *(*open)(hakios_qrtr_receive_t receive, hakios_qrtr_server_t server, void *context);
+	/* One datagram to (node, port); 0, or an errno. May sleep. Up to 8192 bytes. */
+	int (*send)(struct hakios_qrtr_port *port, uint32_t node, uint32_t to_port, const void *data, size_t length);
+	/* Tell this port's `server` callback about the servers of that service, now and from now on; 0, or an errno. */
+	int (*lookup)(struct hakios_qrtr_port *port, uint32_t service, uint32_t version, uint32_t instance);
+	/* No callback comes after this has returned. */
+	void (*close)(struct hakios_qrtr_port *port);
+};
+
+/* The transport there is; NULL takes it away (handles made before keep the one they were made with). */
+void hakios_qmi_set_transport(const struct hakios_qrtr_ops *ops);
+
+#endif /* _SYS_HAKIOS_QRTR_H_ */
--- /dev/null
+++ b/bsd/sys/hakios.qmi.h
@@ -0,0 +1,219 @@
+/*
+ * QMI, the message protocol the firmware of Qualcomm's processors speaks (the Wi-Fi DSP's
+ * "WLFW" service among them): the helpers a client needs, under the names and with the meaning
+ * of Linux's <linux/soc/qcom/qmi.h>, so that a driver written for Linux -- ath11k's qmi.c --
+ * compiles against this header unchanged. The implementation (bsd/dev/hakios.qmi.c) is ours,
+ * written from what the interface and the wire format are publicly described to be; nothing of
+ * Linux's implementation is in it.
+ *
+ * What is here: messages described by tables of struct qmi_elem_info and coded to and from C
+ * structures by them; a handle that owns a port of the IPC router (sys/hakios.qrtr.h), looks a
+ * service up and tells its user when the service appears and goes; requests as transactions
+ * (init, send, wait or cancel) whose reply is decoded into the caller's structure; indications
+ * handed to handlers. What is not: serving (no qmi_add_server, no replies of our own).
+ *
+ * Only <stdint.h> types are used, so that the header does not care what the driver's own
+ * compatibility headers call a byte or a mutex.
+ *
+ * Who calls what from where: new_server, del_server and the indication handlers are called
+ * from the router's delivery thread, with no lock of the helpers held; they may send. A reply
+ * wakes the thread waiting in qmi_txn_wait().
+ */
+#ifndef _SYS_HAKIOS_QMI_H_
+#define _SYS_HAKIOS_QMI_H_
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+
+/* ---- messages -------------------------------------------------------------------------------- */
+
+/* The first seven bytes of every message, little-endian. */
+#define QMI_REQUEST             0
+#define QMI_RESPONSE            2
+#define QMI_INDICATION          4
+#define QMI_HEADER_SIZE         7       /* type (1), transaction (2), message id (2), length of the rest (2) */
+
+/* The kind of an element of a message's description. */
+enum qmi_elem_type {
+	QMI_EOTI,                       /* the end of the table */
+	QMI_OPT_FLAG,                   /* a byte of the C structure, not of the message: whether the element after it is there */
+	QMI_DATA_LEN,                   /* the number of entries in the array after it: a uint32_t in C; elem_size 1
+	                                 * or 2 is its size in the message */
+	QMI_UNSIGNED_1_BYTE,
+	QMI_UNSIGNED_2_BYTE,
+	QMI_UNSIGNED_4_BYTE,
+	QMI_UNSIGNED_8_BYTE,
+	QMI_SIGNED_2_BYTE_ENUM,
+	QMI_SIGNED_4_BYTE_ENUM,
+	QMI_STRUCT,                     /* described by ei_array */
+	QMI_STRING,                     /* in C: characters and a zero in elem_len bytes */
+};
+
+enum qmi_array_type {
+	NO_ARRAY,
+	STATIC_ARRAY,                   /* always elem_len entries */
+	VAR_LEN_ARRAY,                  /* as many as the QMI_DATA_LEN element before it says, at most elem_len */
+};
+
+struct qmi_elem_info {
+	enum qmi_elem_type      data_type;
+	uint32_t                elem_len;       /* entries (for a string: bytes in C, the zero included) */
+	uint32_t                elem_size;      /* bytes of one entry in C; of a basic type, on the wire as well */
+	enum qmi_array_type     array_type;
+	uint8_t                 tlv_type;       /* at the top level: the type of the TLV the element is in */
+	uint32_t                offset;         /* where it is in the C structure */
+	const struct qmi_elem_info *ei_array;   /* QMI_STRUCT: its elements */
+};
+
+#define QMI_COMMON_TLV_TYPE     0
+
+/* The TLV of type 2 that every reply starts with. */
+struct qmi_response_type_v01 {
+	uint16_t result;
+	uint16_t error;
+};
+extern const struct qmi_elem_info qmi_response_type_v01_ei[];
+
+#define QMI_RESULT_SUCCESS_V01          0
+#define QMI_RESULT_FAILURE_V01          1
+
+#define QMI_ERR_NONE_V01                0
+#define QMI_ERR_MALFORMED_MSG_V01       1
+#define QMI_ERR_NO_MEMORY_V01           2
+#define QMI_ERR_INTERNAL_V01            3
+#define QMI_ERR_CLIENT_IDS_EXHAUSTED_V01 5
+#define QMI_ERR_INVALID_ID_V01          41
+#define QMI_ERR_ENCODING_V01            58
+#define QMI_ERR_DISABLED_V01            69
+#define QMI_ERR_INCOMPATIBLE_STATE_V01  90
+#define QMI_ERR_NOT_SUPPORTED_V01       94
+
+/*
+ * The coding by itself (the helpers below use it; tests call it directly). Both return the
+ * number of bytes of the message, header included, or a negative errno.
+ *   encode: `structure` by `ei` into `buffer` of `size` bytes, behind a header of that type,
+ *           message id and transaction;
+ *   decode: the message of `length` bytes at `buffer` by `ei` into `structure` (which the caller
+ *           has zeroed: what the message does not have is left as it is).
+ */
+int hakios_qmi_encode(uint8_t type, uint16_t message, uint16_t transaction, const struct qmi_elem_info *ei, const void *structure,
+    void *buffer, size_t size);
+int hakios_qmi_decode(const void *buffer, size_t length, const struct qmi_elem_info *ei, void *structure);
+
+/* ---- the router's addresses -------------------------------------------------------------------- */
+
+#ifndef AF_QIPCRTR
+#define AF_QIPCRTR              42
+#endif
+struct sockaddr_qrtr {
+	uint16_t sq_family;
+	uint32_t sq_node;
+	uint32_t sq_port;
+};
+
+/* ---- a handle, services, transactions ------------------------------------------------------------ */
+
+struct qmi_handle;
+struct qmi_txn;
+struct socket;                          /* (only ever a pointer here: what a handle's `sock` is called in Linux) */
+
+/* A server of a service that was looked up. */
+struct qmi_service {
+	unsigned int service, version, instance;
+	unsigned int node, port;
+	void *priv;                     /* the user's */
+	struct qmi_service *next;       /* the helpers' */
+};
+
+struct qmi_ops {
+	/* a server has appeared; a negative answer and it is forgotten again */
+	int (*new_server)(struct qmi_handle *qmi, struct qmi_service *service);
+	/* ... and has gone */
+	void (*del_server)(struct qmi_handle *qmi, struct qmi_service *service);
+	/* (the rest of Linux's structure, for sources that fill it in; never called here) */
+	void (*net_reset)(struct qmi_handle *qmi);
+	void (*msg_handler)(struct qmi_handle *qmi, struct sockaddr_qrtr *sq, const void *data, size_t length);
+	void (*bye)(struct qmi_handle *qmi, unsigned int node);
+	void (*del_client)(struct qmi_handle *qmi, unsigned int node, unsigned int port);
+};
+
+/* What to do with a message that is no reply to a transaction; the list ends with an entry without fn. */
+struct qmi_msg_handler {
+	unsigned int type;              /* QMI_INDICATION (or QMI_REQUEST, QMI_RESPONSE) */
+	unsigned int msg_id;
+	const struct qmi_elem_info *ei;
+	size_t decoded_size;            /* of the C structure, which is made, filled in and freed around fn */
+	void (*fn)(struct qmi_handle *qmi, struct sockaddr_qrtr *sq, struct qmi_txn *txn, const void *decoded);
+};
+
+struct qmi_handle {
+	struct socket *sock;            /* what kernel_connect() is given; not NULL while the handle is in use */
+};
+
+struct hakios_qrtr_ops;
+
+struct qmi_txn {
+	struct qmi_handle *qmi;
+	uint16_t id;
+	int result;                     /* of decoding the reply */
+	const struct qmi_elem_info *ei; /* the reply's description, and ... */
+	void *dest;                     /* ... the structure it goes into */
+	struct qmi_txn *next;           /* the helpers' */
+	bool done, waiting;
+};
+
+/*
+ * `largest`: the biggest message that will be taken (bigger ones are dropped). 0, or a negative
+ * errno: -ENXIO where there is no router (hakios_qmi_set_transport() has not been called).
+ */
+int qmi_handle_init(struct qmi_handle *qmi, size_t largest, const struct qmi_ops *ops, const struct qmi_msg_handler *handlers);
+/* Bind a handle to a specific processor's QRTR transport (e.g. WPSS or MPSS). */
+int hakios_qmi_handle_init_transport(struct qmi_handle *qmi, size_t largest, const struct qmi_ops *ops,
+    const struct qmi_msg_handler *handlers, const struct hakios_qrtr_ops *transport);
+void qmi_handle_release(struct qmi_handle *qmi);
+/* Ask for a service: ops->new_server is called for every server of it there is and will be. */
+int qmi_add_lookup(struct qmi_handle *qmi, unsigned int service, unsigned int version, unsigned int instance);
+
+/* A transaction: its number (not negative), or a negative errno. The reply will be decoded by `ei` into `structure`. */
+int qmi_txn_init(struct qmi_handle *qmi, struct qmi_txn *txn, const struct qmi_elem_info *ei, void *structure);
+/*
+ * Send the request of that transaction to `sq`, or with sq NULL to the server the handle was
+ * connected to. `largest`: the most the encoded message may take, header not counted.
+ */
+int qmi_send_request(struct qmi_handle *qmi, struct sockaddr_qrtr *sq, struct qmi_txn *txn, int msg_id, size_t largest,
+    const struct qmi_elem_info *ei, const void *structure);
+/* Give a transaction up that will not be waited for. */
+void qmi_txn_cancel(struct qmi_txn *txn);
+/*
+ * Wait for the reply: what decoding it gave (not negative: the bytes decoded), -ETIMEDOUT, or
+ * the error of a reply that could not be decoded. The transaction is over either way.
+ */
+int hakios_qmi_txn_wait_ms(struct qmi_txn *txn, uint64_t milliseconds);
+
+/*
+ * Linux's qmi_txn_wait() takes the time in "jiffies", of which the caller's Linux has HZ a second.
+ * HZ is looked up where qmi_txn_wait() is used, so it is the caller's whatever it is (a number,
+ * a variable); a caller without one defines HAKIOS_QMI_JIFFIES_TO_MS(j) itself before this.
+ */
+#ifndef HAKIOS_QMI_JIFFIES_TO_MS
+#define HAKIOS_QMI_JIFFIES_TO_MS(j)    ((uint64_t)(j) * 1000 / HZ)
+#endif
+#define qmi_txn_wait(txn, timeout)      hakios_qmi_txn_wait_ms((txn), HAKIOS_QMI_JIFFIES_TO_MS(timeout))
+
+/*
+ * The server that requests without an address go to. In Linux this is a connect() on the
+ * handle's socket, which is how ath11k does it; here that call is this one.
+ */
+int hakios_qmi_connect(struct socket *sock, uint32_t node, uint32_t port);
+#ifndef HAKIOS_QMI_NO_KERNEL_CONNECT
+static inline int
+kernel_connect(struct socket *sock, void *address, __attribute__((unused)) int length, __attribute__((unused)) int flags)
+{
+	const struct sockaddr_qrtr *sq = address;       /* (a pointer of whatever type the caller's Linux has for it) */
+
+	return hakios_qmi_connect(sock, sq->sq_node, sq->sq_port);
+}
+#endif
+
+#endif /* _SYS_HAKIOS_QMI_H_ */
--- /dev/null
+++ b/bsd/sys/hakios.sta.h
@@ -0,0 +1,122 @@
+/*
+ * Darwin-on-hakios: the station boundary.
+ *
+ * On one side whatever does the scanning and the joining with a radio: the station logic over
+ * ath11k on the phone (wifi/lx in the repository). On the other whoever wants a network: the
+ * Apple80211 requests of iOS's Wi-Fi side, answered in bsd/dev/hakios.apple80211.c, and the
+ * kernel's own join of the network it was given in a file (bsd/dev/hakios.wifi.c). Frames do
+ * not pass here, and neither does "the link is up": those go through bsd/sys/hakios.net.h,
+ * which the station side calls itself.
+ *
+ * Between the two stands bsd/dev/hakios.sta.c: one thread, on which every call into the station
+ * side is made, one at a time, and what the last scan heard, kept for whoever asks.
+ *
+ * Nothing but C's own types here: the station side is not compiled as XNU's code.
+ */
+#ifndef _SYS_HAKIOS_STA_H_
+#define _SYS_HAKIOS_STA_H_
+
+#include <stdbool.h>
+#include <stdint.h>
+
+#define HAKIOS_STA_ELEMENTS_MOST       1024
+
+/* One access point, as a scan heard it. */
+struct hakios_sta_bss {
+	uint8_t bssid[6];
+	uint8_t ssid[32], ssid_length;
+	uint16_t frequency;                     /* MHz */
+	int16_t rssi;                           /* dBm */
+	uint16_t beacon_interval;               /* in units of 1024 microseconds */
+	uint16_t capability;                    /* the beacon's capability field */
+	uint32_t age_ms;                        /* how long ago it was last heard */
+	uint16_t elements_length;               /* the beacon's information elements as received: who asks */
+	uint8_t elements[HAKIOS_STA_ELEMENTS_MOST];    /* reads the network's protection out of them itself */
+};
+
+/* What to scan for. All zero: every channel, the radio's own way. */
+struct hakios_sta_scan {
+	uint8_t ssid[32], ssid_length;          /* ask for this network by name (a hidden one answers only then) */
+	uint16_t frequencies[64], frequency_count;      /* only these channels */
+	bool passive;                           /* only listen */
+	uint16_t dwell_ms;                      /* on each channel; 0: the radio's own */
+};
+
+enum { HAKIOS_STA_OPEN, HAKIOS_STA_WPA2_PSK, HAKIOS_STA_WPA3_SAE };
+
+struct hakios_sta_join {
+	uint8_t ssid[32], ssid_length;
+	uint8_t bssid[6];                       /* all zero: the access point of that name heard best */
+	int security;
+	uint8_t pmk[32];                        /* WPA2 with a passphrase: the key made of the passphrase and the name ... */
+	uint8_t passphrase[64], passphrase_length;      /* ... or, if this is not empty, the passphrase itself */
+};
+
+enum hakios_sta_phase { HAKIOS_STA_OFF, HAKIOS_STA_IDLE, HAKIOS_STA_SCANNING, HAKIOS_STA_JOINING, HAKIOS_STA_JOINED };
+
+struct hakios_sta_state {
+	enum hakios_sta_phase phase;
+	struct hakios_sta_bss bss;             /* the network joined or being joined */
+	int last_error;                         /* why the last join failed or the network was lost (an errno); 0: it was not */
+};
+
+#define HAKIOS_STA_CHANNEL_PASSIVE     1u      /* the radio may only listen there */
+#define HAKIOS_STA_CHANNEL_RADAR       2u      /* ... and has to look out for radar */
+
+struct hakios_sta_channel {
+	uint16_t frequency;                     /* MHz */
+	uint16_t flags;
+};
+
+/*
+ * What the station side supplies. All but state() are called on one thread, one at a time, and
+ * may take as long as the thing takes: scan() returns when the scan is over, join() when frames
+ * can pass or it is known why not. Each gives 0 or an errno.
+ */
+struct hakios_sta_ops {
+	int (*power)(bool on);                  /* off: leave the network, stop the radio; on: start it */
+	int (*scan)(const struct hakios_sta_scan *what);
+	void (*heard)(void (*each)(const struct hakios_sta_bss *bss, void *context), void *context);   /* by the last scan */
+	int (*join)(const struct hakios_sta_join *what);
+	int (*leave)(void);
+	void (*state)(struct hakios_sta_state *state);         /* on any thread; does not sleep */
+	unsigned (*channels)(struct hakios_sta_channel *channels, unsigned most);      /* what the radio may tune to */
+	uint8_t address[6];
+};
+
+/* What happens, said to whoever listens (the Apple80211 side). */
+enum hakios_sta_event {
+	HAKIOS_STA_POWER,                      /* status: 1 on, 0 off */
+	HAKIOS_STA_SCAN_DONE,                  /* status: 0, or the scan's errno */
+	HAKIOS_STA_JOIN_DONE,                  /* status: 0, or the join's errno */
+	HAKIOS_STA_LINK,                       /* status: 1 a network is joined, 0 it has been left when asked,
+	                                         * an errno: it was lost (the access point showed us the door) */
+};
+
+#ifdef KERNEL
+/* ---- the station side ---- */
+void     hakios_sta_attach(const struct hakios_sta_ops *ops);         /* NULL: it is going away (waits for a call under way) */
+void     hakios_sta_lost(int error);                                   /* the network joined is gone by itself */
+
+/* ---- who wants a network: each asks and returns; the outcome is an event. 0, or an errno ---- */
+bool     hakios_sta_present(void);
+int      hakios_sta_ask_power(bool on);
+int      hakios_sta_ask_scan(const struct hakios_sta_scan *what);
+int      hakios_sta_ask_join(const struct hakios_sta_join *what);
+/* ... and joined again whenever the radio is turned on, until some other network is asked for */
+int      hakios_sta_ask_join_standing(const struct hakios_sta_join *what);
+int      hakios_sta_ask_leave(void);
+bool     hakios_sta_busy(void);                                        /* something asked for is not over yet */
+bool     hakios_sta_powered(void);
+/* the `index`th access point the last scan heard: true, or false when there are not that many */
+bool     hakios_sta_heard(unsigned index, struct hakios_sta_bss *bss);
+void     hakios_sta_state(struct hakios_sta_state *state);
+unsigned hakios_sta_channels(struct hakios_sta_channel *channels, unsigned most);
+bool     hakios_sta_address(uint8_t *address);
+
+/* ---- the listener: bsd/dev/hakios.apple80211.c ---- */
+void     hakios_apple80211_event(enum hakios_sta_event event, int status);
+void     hakios_apple80211_summary(void);                              /* what was asked in this run, to the log */
+#endif
+
+#endif
--- /dev/null
+++ b/bsd/sys/hakios.net.h
@@ -0,0 +1,67 @@
+/*
+ * en0, and what stands behind it.
+ *
+ * The network interface iOS uses here is made in bsd/dev/hakios.net.c with the kernel's own
+ * interface KPI: Ethernet as far as the rest of the kernel and user space can tell. What carries
+ * the frames is a "link", a driver of its own that knows nothing about interfaces: QEMU's virtio
+ * network device today (bsd/dev/hakios.virtio_net.c), the phone's radio or frames carried over
+ * the boot loader's USB channel tomorrow. This is all the two know of each other.
+ *
+ * A link driver
+ *   - fills in a struct hakios_net_link and calls hakios_net_attach() once, when it is ready
+ *     to carry frames (for a radio: when its firmware is up, not when it has joined a network);
+ *   - hands every frame that arrives to hakios_net_input(): from its own thread, or from
+ *     the poll function the interface's thread calls for it. Not from interrupt context;
+ *   - says with hakios_net_link_state() when frames can pass and when they no longer can
+ *     (the cable, or for a radio: associated and the keys set). configd starts DHCP on that.
+ * A frame is what goes over an Ethernet cable without the checksum at its end: destination,
+ * source, type, payload; at most HAKIOS_NET_FRAME_MAX bytes. A radio whose frames are 802.11
+ * converts in its driver (or has its firmware do it: "Ethernet decap/encap").
+ */
+#ifndef _SYS_HAKIOS_NET_H_
+#define _SYS_HAKIOS_NET_H_
+
+#ifdef KERNEL
+#include <sys/kpi_mbuf.h>
+
+#define HAKIOS_NET_FRAME_MAX   1514
+#define HAKIOS_NET_UNITS       2       /* en0: the radio (or virtio); en1: the modem's packets (hakios.cell.c) */
+
+struct hakios_net_link {
+	const char *    name;           /* for the log */
+	unsigned        unit;           /* which enN this is (0 unless said otherwise) */
+	uint8_t         address[6];     /* the interface's Ethernet address */
+	bool            wireless;       /* the interface is told to be Wi-Fi (its "subfamily"), which is how the
+	                                 * network stack and configd tell a radio from a cable */
+	bool            up;             /* frames can pass from the start (else: wait for hakios_net_link_state()) */
+	/*
+	 * Send one frame: a chain of mbufs, `length` bytes in all, the Ethernet header first. The
+	 * packet stays the caller's: copy it (mbuf_copydata()). Returns false if it had to be dropped.
+	 * Called by one thread at a time, never from interrupt context.
+	 */
+	bool            (*transmit)(mbuf_t packet, size_t length);
+	/*
+	 * Optional. Look whether frames have arrived and call hakios_net_input() for each; returns
+	 * how many there were. The interface's thread calls it every 2 ms while frames are coming and
+	 * every 10 ms when none has for a while. A link that has a thread or an interrupt of its own
+	 * leaves it NULL.
+	 */
+	unsigned        (*poll)(void);
+};
+
+/* Make en<unit> on top of that link (the structure must stay). One link per unit, once: false if there is one already. */
+bool hakios_net_attach(const struct hakios_net_link *link);
+/* A frame has arrived (on en0 / on en<unit>). Copied; the buffer is the caller's again on return. */
+void hakios_net_input(const uint8_t *frame, size_t length);
+void hakios_net_input_unit(unsigned unit, const uint8_t *frame, size_t length);
+/* Frames can pass now / can no longer pass (on en0 / on en<unit>). */
+void hakios_net_link_state(bool up);
+void hakios_net_link_state_unit(unsigned unit, bool up);
+
