+			sweet_tl_n = i + 1;
+		}
+	}
 	IOLockUnlock(fLock);
 	if (fImmediate && fScanout > 0) {
 		presentPending();
@@ -662,6 +741,7 @@ AppleCLCD::swapShown(uint32_t id, uint64_t timeoutMS)
 	static uint32_t told;
 	uint64_t began = mach_absolute_time(), deadline, ns = 0;
 	bool shown = true;
