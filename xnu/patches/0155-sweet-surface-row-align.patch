diff --git a/iokit/Kernel/arm/SweetSurface.cpp b/iokit/Kernel/arm/SweetSurface.cpp
index 3a33ba5..a538b4c 100644
--- a/iokit/Kernel/arm/SweetSurface.cpp
+++ b/iokit/Kernel/arm/SweetSurface.cpp
@@ -657,6 +657,28 @@ sweet_surface_layout(SweetSurface *s, OSDictionary *props)
 	if (s->bytesPerRow < (uint64_t)sweet_div_up(s->width, s->elementWidth) * s->bytesPerElement) {
 		return kIOReturnBadArgument;
 	}
+	/*
+	 * CAMetalLayer's drawables ("CAMetalLayer Display Drawable") are asked for at width * 4 bytes a
+	 * row -- PencilKit's 1128-pixel canvas came as 4512 -- which a6xx cannot import
+	 * (fd_resource_from_handle's pitchalign 6: 64 bytes), so the Metal driver had no drawable and
+	 * Notes' ink was never drawn. Those rows are rounded up to the alignment this kernel advertises;
+	 * CoreAnimation and the GPU both read a drawable's row back. Only those: rounding every
+	 * client-sized row (the first try) sheared images whose writers keep the row they asked for
+	 * (Notes' toolbar icons came out striped).
+	 */
+	OSString *name = OSDynamicCast(OSString, props->getObject("IOSurfaceName"));
+	if ((s->bytesPerRow % SWEET_SURFACE_ROW_ALIGN) != 0 && props->getObject("IOSurfacePlaneInfo") == NULL &&
+	    name != NULL && strncmp(name->getCStringNoCopy(), "CAMetalLayer", 12) == 0) {
+		s->bytesPerRow = (uint32_t)((s->bytesPerRow + SWEET_SURFACE_ROW_ALIGN - 1) &
+		    ~(uint64_t)(SWEET_SURFACE_ROW_ALIGN - 1));
+	} else if ((s->bytesPerRow % SWEET_SURFACE_ROW_ALIGN) != 0) {
+		static unsigned told;
+		if (told < 12) {
+			told++;
+			IOLog("SWEET SURF: %ux%u asked %u bytes a row (not a multiple of %u), name %s: kept\n", s->width,
+			    s->height, s->bytesPerRow, SWEET_SURFACE_ROW_ALIGN, name ? name->getCStringNoCopy() : "(none)");
+		}
+	}
 	end = (uint64_t)s->offset + (uint64_t)s->bytesPerRow * sweet_div_up(s->height, s->elementHeight);
 
 	OSArray *planes = sweet_fmt_subst ? NULL : OSDynamicCast(OSArray, props->getObject("IOSurfacePlaneInfo"));
