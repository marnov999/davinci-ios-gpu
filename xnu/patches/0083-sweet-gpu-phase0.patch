+		/* a6xx_enable_64bit: ALL blocks must be in 64-bit addr mode, else they drop
+		 * the hi dword of freedreno's >=4GiB stage-1 VAs -> mis-fetch/hang (the self-
+		 * tests can't hit this; their gmub_alloc_phys VAs are all <4GiB, hi=0). */
+		CW(0xC01u,  0x1u);                 /* VSC_ADDR_MODE_CNTL  */
+		CW(0x8601u, 0x1u);                 /* GRAS_ADDR_MODE_CNTL */
+		CW(0x8E05u, 0x1u);                 /* RB_ADDR_MODE_CNTL   */
+		CW(0x9E01u, 0x1u);                 /* PC_ADDR_MODE_CNTL   */
+		CW(0xBE05u, 0x1u);                 /* HLSQ_ADDR_MODE_CNTL */
+		CW(0xA601u, 0x1u);                 /* VFD_ADDR_MODE_CNTL  */
+		CW(0x9601u, 0x1u);                 /* VPC_ADDR_MODE_CNTL  */
+		CW(0xE00u,  0x1u);                 /* UCHE_ADDR_MODE_CNTL */
+		CW(0xAE01u, 0x1u);                 /* SP_ADDR_MODE_CNTL   */
+		CW(0xB601u, 0x1u);                 /* TPL1_ADDR_MODE_CNTL */
+		__asm__ volatile("dsb osh" ::: "memory");
+		printf("SWEET GMU: [Id] protect+addrmode written\n");
+		gmub_flush();
