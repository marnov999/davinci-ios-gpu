diff --git a/bsd/dev/sweet_keys.c b/bsd/dev/sweet_keys.c
index a148608..605cc47 100644
--- a/bsd/dev/sweet_keys.c
+++ b/bsd/dev/sweet_keys.c
@@ -93,14 +93,27 @@ keys_wait(void)
 static void
 keys_thread(void *arg, wait_result_t result)
 {
-	int state[3] = {0, 0, 0};
-	unsigned errors = 0;
+	int state[3] = {0, 0, 0}, last[3] = {0, 0, 0};
+	unsigned errors = 0, junk = 0;
 	(void)arg;
 	(void)result;
 	for (;;) {
 		uint8_t pon = 0, gpio = 0;
 		bool pok = keys_read(keys_pon_apid, KEYS_PON_RT, &pon);
 		bool gok = keys_read(keys_gpio_apid, KEYS_GPIO_RT, &gpio);
+		/*
+		 * Now and then a read of PON's real-time status comes back as junk -- 0x6f, 0xeb: bits no
+		 * button state has -- for one sample; taken as it was, it was the power key and volume
+		 * down pressed for 20 ms, and the display went off or on by itself (2026-10-26, 6 of 13
+		 * "volume down" presses that day). Such a read is dropped, and a key changes only when two
+		 * samples in a row agree (40 ms; a press is 80 ms or more).
+		 */
+		if (pok && (pon & 0xf8u)) {
+			if ((junk++ % 50u) == 0) {
+				printf("SWEET KEYS: PON status read %#x dropped (%u so far)\n", pon, junk);
+			}
+			pok = false;
+		}
 		int now[3] = {!!(pon & 1u), !(gpio & 1u), !!(pon & 2u)};
 		if (!pok || !gok) {
 			if ((errors++ % 250u) == 0) {
@@ -111,7 +124,12 @@ keys_thread(void *arg, wait_result_t result)
 			errors = 0;
 		}
 		for (int k = 0; k < 3; ++k) {
-			if ((k == 1 ? gok : pok) && now[k] != state[k]) {
+			if (!(k == 1 ? gok : pok)) {
+				continue;
+			}
+			bool steady = now[k] == last[k];
+			last[k] = now[k];
+			if (steady && now[k] != state[k]) {
 				state[k] = now[k];
 				printf("SWEET KEYS: key=%d down=%d pon=%#x gpio4:c110=%#x\n",
 				    k, state[k], pon, gpio);
