+/*
+ * Show the swap waiting to be shown (the earlier of two first). From the vsync tick, and with
+ * scanout from SwapEnd itself (fImmediate): CoreAnimation waits for each swap to be on the
+ * panel before it draws the next (SwapWait), so a swap kept for the next tick of a timer that
+ * is not the panel's cost it up to a frame every frame. Flipped at once, the display engine
+ * takes it at the start of the panel's next frame, as a phone's display does. A flip the
+ * engine has not taken yet is waited for first (not overwritten: that frame would be lost).
+ */
+void
+AppleCLCD::presentPending(void)
+{
+	uint8_t *rec = (uint8_t *)IOMallocData(SWEET_FB_SWAP_REC_SIZE);
+	if (rec == NULL) {
+		return;
+	}
+	IOLockLock(fPresentLock);
+	IOLockLock(fLock);
+	bool have = fDirty;
+	if (have && fHasEarly) {
+		memcpy(rec, fEarly, SWEET_FB_SWAP_REC_SIZE);   /* (the latest stays for the next) */
+		fHasEarly = false;
+	} else if (have) {
+		memcpy(rec, fPending, SWEET_FB_SWAP_REC_SIZE);
+		fDirty = false;
+	}
+	IOLockUnlock(fLock);
+	if (have) {
+		uint32_t flips = fFlips;
+		uint64_t now = mach_absolute_time(), ns = 0, until = 0;
+		if (fScanning && fMdp != 0) {
+			volatile uint32_t *r = (volatile uint32_t *)fMdp;
+			clock_interval_to_deadline(20, kMillisecondScale, &until);
+			while ((r[SWEET_MDP_CTL0_FLUSH / 4] & SWEET_MDP_FLUSH_VIG0) != 0 && mach_absolute_time() < until) {
+				IODelay(100);
+			}
+		}
+		present(rec);
+		IOLockLock(fLock);
+		memcpy((void *)&fShownSwap, rec + 0x50, sizeof(uint32_t));   /* (the swap's id, +0x50) */
+		IOLockWakeup(fLock, (event_t)&fShownSwap, false);
+		IOLockUnlock(fLock);
+		fRateShown++;
+		fRateFlips += fFlips - flips;
+		if (fLastShown != 0) {
+			absolutetime_to_nanoseconds(now - fLastShown, &ns);
+			fRateLate += ns > 20000000ull;
+		}
+		fLastShown = now;
+	}
+	IOLockUnlock(fPresentLock);
+	IOFreeData(rec, SWEET_FB_SWAP_REC_SIZE);
+}
